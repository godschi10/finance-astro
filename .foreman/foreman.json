{
  "worker": {
    "command": "opencode run --standalone --model {{model}} --session {{sessionID}}",
    "timeoutMinutes": 45,
    "idleMinutes": 5
  },
  "tiers": {
    "premium": {
      "model": "nvidia/minimaxai/minimax-m3",
      "ctxCap": 90000,
      "ctxKill": 180000,
      "maxOut": 12000,
      "inputPerM": 0.15,
      "outputPerM": 0.6,
      "use": [
        "plan",
        "review",
        "feedback",
        "decide"
      ]
    },
    "standard": {
      "model": "opencode/muse-spark-1.2",
      "ctxCap": 60000,
      "ctxKill": 140000,
      "maxOut": 30000,
      "inputPerM": 0.05,
      "outputPerM": 0.2,
      "use": [
        "implement",
        "fix",
        "test"
      ]
    },
    "economy": {
      "model": "opencode/hy3-free",
      "ctxCap": 40000,
      "ctxKill": 90000,
      "maxOut": 8000,
      "inputPerM": 0,
      "outputPerM": 0,
      "use": [
        "report",
        "chore",
        "research",
        "summarise"
      ]
    }
  },
  "routing": {
    "plan": "premium",
    "review": "premium",
    "implement": "standard",
    "fix": "standard",
    "test": "standard",
    "chore": "economy",
    "report": "economy",
    "research": "economy",
    "summarise": "economy",
    "decide": "premium"
  },
  "concurrency": 1,
  "verify": {
    "runOnContinue": true,
    "failFast": true
  },
  "escalation": {
    "maxAttempts": 3,
    "attempt2": "supervisor-review",
    "attempt3": "blocked"
  }
}