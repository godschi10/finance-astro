---
// Shared calculator shell — faithful port of the live calculator page
// skeleton (finance.fitnesslova.qzz.io/tools/*, page-*.php templates).
// Anatomy copied from the live HTML on 2026-09-30 (King order: "import the
// money calculator /tools/ page … and the calculators themselves"):
//   1. .apps-hero dark trust hero (same layers as /apps/ + live tool pages):
//      dot-grid + gold-glow, 3-level breadcrumb (Home › Money Calculators ›
//      Tool), per-tool gold badge pill, h1 + lede, verbatim inline styles.
//   2. .con (margin-top:32; padding-bottom:48): slot (inputs → .fx-card,
//      receipt → .fx-result/.receipt, tables → .st-table-wrap), optional
//      .fx-disclaimer, .fx-copy art-body (Why + FAQ), FAQPage/WebApplication
//      JSON-LD (mirrors the live ld+json graph), .fx-aff CTA row, Related
//      guides (.g3 of .app-card, live anatomy: inline-styled title+excerpt).
// The theme class vocabulary (fx-card/fx-field/st-table/sr-chart/fx-rate…)
// is ported verbatim in styles/tools.css; pages slot real markup in.
import Layout from "../layouts/Layout.astro";
interface Faq { q: string; a: string; }
interface Related { href: string; title: string; excerpt: string; }
interface Cta { label: string; href: string; ghost?: boolean; }
interface Props {
  title: string;
  description: string;
  slug: string;
  tool: string;      // live hero H1 verbatim (some tools reword it, e.g. the
                     // converter's "Dollar to Naira & Every Currency")
  lede: string;      // hero sub-copy under the H1 (every tool page passes it)
  crumb?: string;    // breadcrumb current label (live: short tool name)
  verified: string;
  badge?: string;            // gold pill (live: "Live rates · updated …", "NTA 2025 · …")
  faqs?: Faq[];
  rawFaq?: boolean;
  copy?: [string, string][]; // [tag "h2"|"h3"|"p", text] — live .fx-copy art-body
  ctas?: Cta[];              // .fx-aff button row
  ctaNote?: string;          // paragraph above the .fx-aff buttons
  ctaTitle?: string;         // .shd stitle above .fx-aff (live: "Get the best dollar rate")
  related?: Related[];       // "Related guides" .g3 of .app-card
  relatedTitle?: string;     // live: "Related guides"
  disclaimer?: string;       // .fx-disclaimer (live: rate-source honesty note)
  ogImage?: { url: string; width: number; height: number; alt?: string } | null; // per-tool share card (passed straight to Layout)
}
const {
  title, description, slug, tool, lede, verified, badge = "Free · No sign-up · Always updated",
  crumb = tool,
  faqs = [], rawFaq = false, copy = [], ctas = [], ctaNote = "", ctaTitle = "Get the best rate",
  related = [], relatedTitle = "Related guides", disclaimer = "", ogImage = null,
} = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const ld = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");
const pageUrl = `${(Astro.site?.toString() ?? "https://godschi10.github.io").replace(/\/$/, "")}${base}money-tools/${slug}/`;
const graph: unknown[] = [{
  "@type": "WebApplication", "@id": pageUrl + "#webapp", name: tool, url: pageUrl,
  applicationCategory: "FinanceApplication", operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "NGN" }, description,
}];
if (faqs.length) graph.push({
  "@type": "FAQPage", "@id": pageUrl + "#faq",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
});
---
<Layout title={title} description={description} crumb={tool} ogImage={ogImage}>
<script type="application/ld+json" set:html={ld({ "@context": "https://schema.org", "@graph": graph })}></script>
<div class="apps-hero">
  <div style="position:absolute;top:0;right:0;bottom:0;left:0;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,0.025) 1px,transparent 1px);background-size:28px 28px;pointer-events:none"></div>
  <div style="position:absolute;top:-80px;right:-80px;width:360px;height:360px;background:radial-gradient(circle,rgba(217,119,6,0.08) 0%,transparent 65%);pointer-events:none"></div>
  <div style="position:relative;z-index:1;max-width:640px">
    <nav class="gwill-breadcrumbs" aria-label="Breadcrumb">
      <ol class="gwill-breadcrumbs__list">
        <li class="gwill-breadcrumbs__item"><a href={base}><span>Home</span></a></li>
        <li class="gwill-breadcrumbs__item"><a href={`${base}money-tools/`}><span>Money Calculators</span></a></li>
        <li class="gwill-breadcrumbs__item gwill-breadcrumbs__item--current"><span aria-current="page">{crumb}</span></li>
      </ol>
    </nav>
    <div style="display:inline-flex;align-items:center;gap:8px;font-size:9px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold-b);background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);padding:4px 12px;border-radius:var(--pill);margin-bottom:16px">{badge}</div>
    <h1 style="font-size:34px;font-weight:800;letter-spacing:-0.04em;color:#f0ede6;line-height:1.1;margin-bottom:10px">{tool}</h1>
    <p style="font-size:14px;font-weight:300;color:var(--dark-dim);line-height:1.75">{lede}</p>
  </div>
</div>
<div class="con" style="margin-top:32px;padding-bottom:48px">
  <div class="ad-bg"></div>
  <slot />
  <div style="margin-top:12px"><button class="btn b-ghost b-sm" type="button" onclick="location.reload()">Reset</button></div>
  {verified && <p class="fxap-conv-note" style="margin-top:14px"><span style="color:var(--gold-b)" aria-hidden="true">◆</span> {verified}</p>}
  {disclaimer && <p class="fx-disclaimer">{disclaimer}</p>}
  {copy.length > 0 && (
    <div class="fx-copy art-body" style="margin-top:28px">
      {copy.map(([tag, text]) => tag === "h2" ? <h2>{text}</h2> : tag === "h3" ? <h3>{text}</h3> : <p>{text}</p>)}
    </div>
  )}
  {faqs.length > 0 && (
    <div class="fx-copy art-body" aria-label="Frequently asked questions" style="margin-top:24px">
      <h2>Questions</h2>
      {faqs.map((f) => (<details class="faq"><summary>{f.q}</summary>{rawFaq ? <p set:html={f.a}></p> : <p>{f.a}</p>}</details>))}
    </div>
  )}
  {(ctas.length > 0 || ctaNote) && (
    <>
      <div class="shd" style="margin:28px 0 16px"><span class="stitle">{ctaTitle}</span></div>
      <div class="fx-aff">
        {ctaNote && <p style="font-size:13px;line-height:1.7;color:var(--text-dim);margin:0 0 12px">{ctaNote}</p>}
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          {ctas.map((c) => (<a class={`btn ${c.ghost ? "b-ghost" : "b-green"}`} style="flex:1;justify-content:center" href={c.href}>{c.label}</a>))}
        </div>
      </div>
    </>
  )}
  {related.length > 0 && (
    <>
      <div class="shd" style="margin:28px 0 16px"><span class="stitle">{relatedTitle}</span></div>
      <div class="g3">
        {related.map((r) => (
          <div class="app-card">
            <div style="padding:18px 20px">
              <div style="font-size:14px;font-weight:800;color:var(--text);letter-spacing:-0.02em;margin-bottom:8px"><a href={r.href}>{r.title}</a></div>
              <div style="font-size:13px;font-weight:300;line-height:1.6;color:var(--text-dim)">{r.excerpt}</div>
            </div>
          </div>
        ))}
      </div>
    </>
  )}
  <div class="ad-bg" style="margin-top:28px"></div>
  <p style="margin-top:22px"><a class="slink" href={`${base}money-tools/`}>← All money calculators</a></p>
</div>
<style is:global>
/* Port-local extension vocabulary (documented, never invents theme names):
   input grid + dark receipt rows + chart bars used by the calculator pages.
   The theme's own fx-card/fx-field/fx-input/fx-result/fx-big/st-table/sr-*
   rules come verbatim from styles/tools.css and are preferred inside .fx-card. */
.tgrid{display:grid;gap:14px;margin-top:18px}
@media(min-width:560px){.tgrid.c2{grid-template-columns:1fr 1fr}.tgrid.c3{grid-template-columns:1fr 1fr 1fr}}
.field label{display:block;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dim);margin-bottom:6px}
.field input,.field select{width:100%;min-height:48px;padding:12px 14px;font:inherit;font-size:1rem;background:var(--surface-2);color:var(--text);border:1px solid var(--border);border-radius:10px}
.field input:focus,.field select:focus{outline:2px solid var(--gold-b);outline-offset:1px;border-color:var(--gold-b)}
.field .hint{font-size:12px;color:var(--text-dim);margin-top:4px}
.receipt{background:#0d0b08;color:#f0ede6;border-radius:16px;padding:18px;margin-top:18px;box-shadow:var(--sh-md)}
.receipt-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#8f8575}
.receipt-fig{font-size:clamp(1.9rem,6vw,3rem);line-height:1.1;letter-spacing:-.03em;font-weight:800;color:var(--gold-b);margin-top:6px;overflow-wrap:anywhere}
.receipt-sub{font-size:.85rem;color:#c4b89a;margin-top:6px}
.receipt-div{border-top:1px dashed rgba(245,158,11,.35);margin:14px 0 10px}
.receipt-note{font-size:.8rem;color:#c4b89a}
.receipt-foot{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#8f8575;margin-top:10px}
.receipt-row{display:flex;justify-content:space-between;gap:12px;font-size:.85rem;padding:6px 0;color:#e8e4dc}
.receipt-row b{font-variant-numeric:tabular-nums;white-space:nowrap}
.hr{border-top:1px solid var(--border-dim);margin:26px 0 0}
/* v0.7.0: tool-body section heading ("Year by year", "Full table"). The class
   shipped in 8 calculator pages with NO rule anywhere — those h2s rendered as
   the browser default. Texture is the tool pages' OWN .fx-copy h2
   (styles/tools.css:60) verbatim, so one page never carries two heading
   scales (this and the FAQ "Questions" h2 sit on the same page). */
.tool-h2{font-size:22px;font-weight:800;letter-spacing:-.02em;color:var(--text);margin:28px 0 10px}
.st-wrap{overflow-x:auto;margin:18px calc(-1 * 16px) 0;padding:0 16px}
@media(min-width:768px){.st-wrap{margin-left:0;margin-right:0;padding:0}}
/* v0.6.8: table type + cells match the theme's OWN st-table anatomy
   (12px rows, 10px/14px cell padding) — the port had shrunk it to .75rem/10px. */
table.st{width:100%;min-width:560px;border-collapse:collapse;font-size:12px;font-variant-numeric:tabular-nums}
table.st th{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);text-align:left;padding:10px 14px;border-bottom:1px solid var(--border)}
table.st td{padding:12px 14px;border-bottom:1px solid var(--border-dim);color:var(--text-mid)}
table.st td.n,table.st th.n{text-align:right}
table.st tr.win td{background:var(--gold-muted);border-left:3px solid var(--gold-b)}
.btag{display:inline-block;font-size:9px;font-weight:800;letter-spacing:.12em;background:var(--gold-b);color:#0d0b08;border-radius:100px;padding:2px 8px;margin-left:8px;vertical-align:middle}
.bar-row{display:grid;grid-template-columns:1fr;gap:4px;padding:10px 0;border-bottom:1px solid var(--border-dim);font-size:.8rem}
.bar-top{display:flex;justify-content:space-between;gap:10px}
.bar-top b{font-variant-numeric:tabular-nums}
.bar{height:10px;border-radius:100px;background:var(--border-dim);overflow:hidden}
.bar i{display:block;height:100%;background:var(--gold-b);border-radius:100px}
.bar-note{font-size:.75rem;color:var(--text-dim)}
details.faq{border:1px solid var(--border);border-radius:10px;padding:14px 16px;margin-top:12px;background:var(--surface)}
details.faq summary{font-weight:700;cursor:pointer;min-height:44px}
/* v0.6.8 (King: cramp in conversions landing pages): answers read at FULL
   body size (1rem/1.8 — same texture as the article copy above) with a real
   12px seat under the question. .9rem + 8px was the visible jam. */
details.faq p{margin-top:12px;font-size:1rem;line-height:1.8;color:var(--text-mid)}
.swapbtn{width:44px;height:44px;border-radius:50%;border:1px solid var(--gold-b);background:var(--surface);color:var(--gold);font-size:18px;line-height:1}
.swapbtn:hover{transform:rotate(180deg);transition:transform var(--t-md)}
/* v0.7.0: .tgl — the calculators' gold switch. The native checkbox shipped
   with no class and no rule, so it painted the browser's blue box on a black
   card. The real <input> stays in the markup (page scripts read .checked) but
   is visually replaced by track + thumb; it stretches over the whole label so
   the touch target is the site's own 44px minimum — same rule as
   details.faq summary above. Off = border-tone track + mid ink; on = gold track
   + ink thumb (the .btag / .b-gold inverse already in the theme). --border (not
   --surface-2) is the off track: --surface-2 sat too close to the dark card. */
.tgl{position:relative;display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 2px;font-size:12px;color:var(--text-dim);cursor:pointer;user-select:none}
.tgl input{position:absolute;left:0;top:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
.tgl-track{position:relative;flex:0 0 auto;width:40px;height:22px;border-radius:var(--pill);background:var(--border);border:1px solid var(--border);transition:background var(--t-md),border-color var(--t-md)}
.tgl-thumb{position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:var(--text-mid);box-shadow:var(--sh-sm);transition:transform var(--t-md),background var(--t-md)}
.tgl-lbl{line-height:1.4}
.tgl input:checked+.tgl-track{background:var(--gold-b);border-color:var(--gold-b)}
.tgl input:checked+.tgl-track .tgl-thumb{transform:translateX(18px);background:#0d0b08}
.tgl input:checked~.tgl-lbl{color:var(--text)}
.tgl input:focus-visible+.tgl-track{outline:2px solid var(--gold-b);outline-offset:2px}
.crumbs{font-size:12px;color:var(--text-dim);margin-bottom:16px}
.crumbs a{color:var(--gold)}
.slink{color:var(--gold);font-weight:700}
.prog{height:10px;border-radius:100px;background:var(--border-dim);overflow:hidden;margin-top:8px}
.prog i{display:block;height:100%;background:var(--green-btn)}
</style>
</Layout>
