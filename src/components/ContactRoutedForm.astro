---
/**
 * Routed contact form — port of gwill-finance-theme
 * template-parts/forms/contact-routed.php (Pattern 3, one form, multiple
 * recipients via inquiry type). The live page posts to WP admin-ajax;
 * this static port posts to the same-shaped /forms endpoint on the
 * comments-api Worker (see src/scripts/gwill-forms.js), so the control is
 * REAL: honeypot, required fields, 5-min rate limit, nonce and the success
 * message all match the PHP handler's contract.
 * Field labels/copy are the partial's, byte-exact.
 */
interface Props { uid?: string; }
const { uid = "gwill-routed-1" } = Astro.props;
---
<form class="gwill-form gwill-form--routed" method="post" novalidate>
  <div class="gwill-honey" aria-hidden="true">
    <label for={`gwill_hp_${uid}`}>Leave this blank</label>
    <input type="text" name="gwill_hp" id={`gwill_hp_${uid}`} tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="gwill_form_id" value="routed" />

  <div class="gwill-form__field">
    <label for={`type_${uid}`}>
      What's this about?
      <span class="gwill-form__required" aria-hidden="true">*</span>
    </label>
    <select id={`type_${uid}`} name="gwill_inquiry_type" required>
      <option value="">Choose...</option>
      <option value="press">Press &amp; Media</option>
      <option value="partnership">Brand Partnerships</option>
      <option value="reader">Reader Question</option>
      <option value="support">Technical Support</option>
      <option value="general">General</option>
    </select>
  </div>

  <div class="gwill-form__row gwill-form__row--2col">
    <div class="gwill-form__field">
      <label for={`name_${uid}`}>
        Name
        <span class="gwill-form__required" aria-hidden="true">*</span>
      </label>
      <input type="text" id={`name_${uid}`} name="gwill_name" required autocomplete="name" />
    </div>
    <div class="gwill-form__field">
      <label for={`email_${uid}`}>
        Email
        <span class="gwill-form__required" aria-hidden="true">*</span>
      </label>
      <input type="email" id={`email_${uid}`} name="gwill_email" required autocomplete="email" />
    </div>
  </div>

  <div class="gwill-form__field">
    <label for={`message_${uid}`}>
      Message
      <span class="gwill-form__required" aria-hidden="true">*</span>
    </label>
    <textarea id={`message_${uid}`} name="gwill_message" rows="5" required></textarea>
    <p class="gwill-form__field-hint">No spam, no newsletters you didn't ask for, just a reply to your message.</p>
  </div>

  <div class="gwill-form__actions">
    <button type="submit" class="gwill-form__submit">
      <span class="gwill-form__submit-text">Send Message</span>
      <span class="gwill-form__submit-loading" aria-hidden="true">Sending...</span>
    </button>
  </div>

  <div class="gwill-form__status" role="alert" aria-live="polite"></div>
</form>
