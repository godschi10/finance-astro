---
import { catBySlug } from "../data/site";
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  date: string;
  readMins: number;
  author: string;
}
const { slug, title, excerpt, category, date, readMins, author } = Astro.props;
const c = catBySlug(category);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const url = `${base}articles/${slug}/`;
---
<article class="card" data-cat={category}>
  <div class="card-art" role="img" aria-label={`${c.name} article artwork`}>
    <span aria-hidden="true">{c.emoji}</span>
    <span class={`tile-wm ${c.badge}`} aria-hidden="true">{c.name}</span>
  </div>
  <div class="card-body">
    <span class={`badge ${c.badge}`}>{c.name}</span>
    <p class="card-t"><a href={url} style="text-decoration:none;color:inherit">{title}</a></p>
    <p class="card-ex">{excerpt}</p>
    <p class="card-meta">{date} · {readMins} min read · {author}</p>
  </div>
</article>
