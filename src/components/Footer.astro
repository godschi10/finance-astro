---
// Footer — faithful port of gwill-finance-theme 1.13.39 (footer.php sections 2–5).
//
// Two footers live in the DOM, exactly as in WP: `.footer` (desktop grid) and
// `.mfooter` (phone). CSS swaps them at 767/768px, the same contract the header
// uses for .sh / .mh. Markup order, class names and copy strings are copied from
// the live theme; the only deliberate deviations are noted inline:
//   1. hrefs point at this port's real routes (WP's /all-articles/ permalink is
//      not a route here — that would be a 404).
//   2. The push bell carries data-push-bell instead of the WP id="gwill-bell",
//      because both footers render one and duplicate ids are invalid HTML.
import { SITE, FOOTER_GROUPS, FOOTER_NETWORK } from "../data/site";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const year = new Date().getFullYear();
// WP: $gwill_copyright_host = home_url() — the theme deliberately prints the
// site's own host so a migrated site shows its new domain automatically.
const copyrightHost = SITE.origin;

// Icons copied verbatim from the theme's gwill_finance_social_svg() output and
// the footer's inline SVGs (extracted from the live render).
const ICON = {
  x: '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>',
  instagram:
    '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"></path></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452z"></path></svg>',
  youtube:
    '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg>',
  bell: '<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm6-6V11a6 6 0 0 0-4.5-5.8V4a1.5 1.5 0 0 0-3 0v1.2A6 6 0 0 0 6 11v5l-1.7 1.7a1 1 0 0 0 .7 1.7h14a1 1 0 0 0 .7-1.7L18 16Z"></path></svg>',
  install:
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 4v10.17l3.59-3.58L17 12l-5 5-5-5 1.41-1.41L11 14.17V4h2Zm-6 14h12v2H6v-2Z"></path></svg>',
  ios: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 3v10.55A4 4 0 1 0 14 17V7h3V3h-5Zm-1 13a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"></path></svg>',
};

const SOCIALS = [
  { key: "x", href: SITE.socials.x, label: "X (Twitter)" },
  { key: "instagram", href: SITE.socials.instagram, label: "Instagram" },
  { key: "linkedin", href: SITE.socials.linkedin, label: "LinkedIn" },
  { key: "youtube", href: SITE.socials.youtube, label: "YouTube" },
] as const;

const GUID =
  "Tap Share (⌫) then “Add to Home Screen”, then open the app from your Home Screen to enable notifications.";
const LINK_COLS_DESKTOP = [
  { title: "Articles", links: FOOTER_GROUPS.articles },
  { title: "Finance Apps", links: FOOTER_GROUPS.apps },
  { title: "Network", links: FOOTER_NETWORK.desktop },
];
const LINK_COLS_MOBILE = [
  { title: "Articles", links: FOOTER_GROUPS.articles },
  { title: "Finance Apps", links: FOOTER_GROUPS.apps },
  { title: "Site", links: FOOTER_GROUPS.site },
  { title: "Network", links: FOOTER_NETWORK.mobile },
];
const LEGAL = [
  { label: "Privacy", href: "privacy-policy/" },
  { label: "Disclaimer", href: "disclaimer/" },
  { label: "Affiliates", href: "affiliate-disclosure/" },
];
---

<!-- ══════ desktop footer (WP footer.php sections 2–4) ══════ -->
<footer class="footer">
  <div class="ftop">
    <div class="fcol fcol--brand">
      <div class="flogo"><span class="n">₦</span><span class="nm">gwillchijioke</span></div>
      <div class="ftag">{SITE.description}</div>
      <div class="fnet">Part of the gwillchijioke.com network</div>
      <div class="ffollow">
        <button
          type="button"
          class="fpush"
          data-push-bell
          aria-label="Notify me of new posts"><Fragment set:html={ICON.bell} /><span>Notify me of new posts</span></button
        >
        
        <button
          type="button"
          class="finstall"
          data-install-app
          hidden
          aria-label="Install app"
          data-label-alt="Install not available"
          data-label-done="App installed"><Fragment set:html={ICON.install} /><span>Install app</span></button
        >
        <button
          type="button"
          class="finstall finstall--ios"
          data-install-ios
          hidden
          aria-label="Add to Home Screen"
          data-guide={GUID}><Fragment set:html={ICON.ios} /><span>Add to Home Screen</span></button
        >
      </div>
      <nav class="fsoc" aria-label="Social media">
        {
          SOCIALS.map((s) => (
            <a class="soci" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <Fragment set:html={ICON[s.key]} />
            </a>
          ))
        }
      </nav>
    </div>
    {
      LINK_COLS_DESKTOP.map((col) => (
        <div>
          <div class="fct">{col.title}</div>
          {col.links.map((l) => (
            <a class="fl" href={l.external ? l.href : `${base}${l.href.replace(/^\//, "")}`} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener noreferrer" : undefined}>
              {l.label}
            </a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="ad-bg ad-bg--footer"></div>
  <div class="fbot">
    <span>&copy; {year} {copyrightHost}, Gwill Chijioke</span>
    <span class="fcredit">
      Designed &amp; built by <a class="fcredit-link" href="https://gwillchijioke.com" target="_blank" rel="noopener noreferrer">G-will Chijioke</a>
    </span>
    <span class="fbot-right">
      <span class="flegal">
        {
          LEGAL.map((l, i) => (
            <>
              {i > 0 && <span class="fdot">·</span>}
              <a href={`${base}${l.href}`}>{l.label}</a>
            </>
          ))
        }
      </span>
      <a class="ftoplink" href="#top">Back to top ↑</a>
    </span>
  </div>
</footer>

<!-- ══════ mobile footer (WP footer.php section 5) ══════ -->
<footer class="mfooter">
  <div class="flogo"><span class="n">₦</span><span class="nm">gwillchijioke</span></div>
  <p class="ftag" style="margin-top:4px;font-size:11px">{SITE.description}</p>
  <div class="mfgrid">
    {
      LINK_COLS_MOBILE.map((col) => (
        <div>
          <div class="fct">{col.title}</div>
          {col.links.map((l) => (
            <a class="fl" href={l.external ? l.href : `${base}${l.href.replace(/^\//, "")}`} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener noreferrer" : undefined}>
              {l.label}
            </a>
          ))}
        </div>
      ))
    }
  </div>
  <nav class="fsoc" style="margin:16px 0" aria-label="Social media">
    {
      SOCIALS.map((s) => (
        <a class="soci" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
          <Fragment set:html={ICON[s.key]} />
        </a>
      ))
    }
  </nav>
  <div class="ffollow">
    <button
      type="button"
      class="fpush"
      data-push-bell
      aria-label="Notify me of new posts"><Fragment set:html={ICON.bell} /><span>Notify me of new posts</span></button
    >
    
    <button
      type="button"
      class="finstall"
      data-install-app
      hidden
      aria-label="Install app"
      data-label-alt="Install not available"
      data-label-done="App installed"><Fragment set:html={ICON.install} /><span>Install app</span></button
    >
    <button
      type="button"
      class="finstall finstall--ios"
      data-install-ios
      hidden
      aria-label="Add to Home Screen"
      data-guide={GUID}><Fragment set:html={ICON.ios} /><span>Add to Home Screen</span></button
    >
  </div>
  <div class="mfbot">
    <span>&copy; {year} {copyrightHost}</span>
    <span class="mfcredit">
      Designed &amp; built by <a class="fcredit-link" href="https://gwillchijioke.com" target="_blank" rel="noopener noreferrer">G-will Chijioke</a>
    </span>
    <span class="flegal">
      {
        LEGAL.map((l, i) => (
          <>
            {i > 0 && <span class="fdot">·</span>}
            <a href={`${base}${l.href}`}>{l.label}</a>
          </>
        ))
      }
    </span>
    <a class="ftoplink" href="#top" style="color:var(--dark-dim)">Back to top ↑</a>
  </div>
</footer>

<script is:inline>
  /* Footer follow-CTAs — port of the theme's install/push behaviour.
     Native install (Chromium) reveals the button only when the browser says the
     app is installable; iOS gets the Home-Screen guide instead (no install API).
     Push needs a server, so the bell takes the theme's own "unsupported"
     treatment until a push service exists — see PUSH_ENDPOINT below. */
  (function () {
    "use strict";
    var appBtns = document.querySelectorAll("[data-install-app]");
    var iosBtns = document.querySelectorAll("[data-install-ios]");
    var deferred = null;

    window.addEventListener("beforeinstallprompt", function (e) {
      e.preventDefault();
      deferred = e;
      appBtns.forEach(function (b) {
        b.hidden = false;
      });
    });

    appBtns.forEach(function (b) {
      b.addEventListener("click", function () {
        if (!deferred) {
          b.disabled = true;
          if (b.dataset.labelAlt) b.textContent = b.dataset.labelAlt;
          return;
        }
        deferred.prompt();
        deferred.userChoice.then(function (choice) {
          if (choice && choice.outcome === "accepted" && b.dataset.labelDone) b.textContent = b.dataset.labelDone;
          deferred = null;
        });
      });
    });

    window.addEventListener("appinstalled", function () {
      appBtns.forEach(function (b) {
        b.disabled = true;
        if (b.dataset.labelDone) b.textContent = b.dataset.labelDone;
      });
    });

    var ua = navigator.userAgent;
    var isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    var isSafari = /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);
    if (isIOS && isSafari) {
      iosBtns.forEach(function (b) {
        b.hidden = false;
      });
    }
    iosBtns.forEach(function (b) {
      b.addEventListener("click", function () {
        var wrap = b.parentElement;
        if (!wrap || wrap.querySelector(".finstall-note")) return;
        var note = document.createElement("p");
        note.className = "finstall-note";
        note.textContent = b.dataset.guide || "";
        wrap.appendChild(note);
      });
    });

    /* The bell stays exactly as WP renders it, but the static build has no push
       service to subscribe to, so tapping it explains that instead of silently
       doing nothing. Set PUSH_ENDPOINT to a real endpoint to enable the flow. */
    var PUSH_ENDPOINT = "";
    var canPush = !!PUSH_ENDPOINT && "serviceWorker" in navigator && "PushManager" in window && "Notification" in window;
    var NOTE =
      "Push notifications need a push service, which this static build does not have yet. Nothing was subscribed.";
    document.querySelectorAll("[data-push-bell]").forEach(function (bell) {
      bell.addEventListener("click", function () {
        if (canPush) return;
        var wrap = bell.parentElement;
        if (!wrap || wrap.querySelector("[data-push-note]")) return;
        var note = document.createElement("p");
        note.className = "finstall-note";
        note.setAttribute("data-push-note", "");
        note.textContent = NOTE;
        wrap.appendChild(note);
      });
    });
  })();
</script>
