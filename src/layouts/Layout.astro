<script is:inline>
/* GWill Finance — mobile nav (main.js) + spotlight search (spotlight-search.js), ported. */
(function(){
'use strict';
/* ── 1. Mobile nav overlay: open/close + split-tap submenu accordion ──
   .mno-list li.menu-item-has-children: gold chevron toggles the sibling
   .sub-menu (preventDefault); tapping the row text navigates. Siblings
   close for a clean accordion. Caret buttons injected like WP main.js. */
var mnav = document.getElementById('mobile-nav');
var openers = document.querySelectorAll('.hbg');
var closers = document.querySelectorAll('.mno-close');
var lastFocused = null;

if (mnav) {
  var subSeq = 0;
  Array.prototype.forEach.call(mnav.querySelectorAll('.mno-list li.menu-item-has-children > a'), function (a) {
    if (a.querySelector('.nav-caret')) return;
    var caret = document.createElement('button');
    caret.type = 'button';
    caret.className = 'nav-caret';
    caret.setAttribute('aria-expanded', 'false');
    var sub = a.parentElement ? a.parentElement.querySelector('.sub-menu') : null;
    if (sub) {
      subSeq++;
      if (!sub.id) sub.id = 'mno-sub-' + subSeq;
      caret.setAttribute('aria-controls', sub.id);
    }
    caret.setAttribute('aria-label', 'Open ' + a.textContent.trim() + ' submenu');
    caret.textContent = '⌄';
    a.appendChild(caret);
  });
  document.addEventListener('click', function (e) {
    var caret = e.target.closest ? e.target.closest('.mno-list .nav-caret') : null;
    if (!caret) return;
    var li = caret.closest('li');
    if (!li) return;
    var wasOpen = li.classList.contains('open');
    if (li.parentElement) {
      Array.prototype.forEach.call(li.parentElement.children, function (s) {
        if (s !== li) s.classList.remove('open');
      });
    }
    li.classList.toggle('open', !wasOpen);
    caret.setAttribute('aria-expanded', !wasOpen ? 'true' : 'false');
    e.preventDefault();
    e.stopPropagation();
  });
}

/* ── 2. Desktop nav submenu chevron (server-rendered, guard for safety) ── */
Array.prototype.forEach.call(document.querySelectorAll('.snav-list li.menu-item-has-children > a'), function (a) {
  if (a.querySelector('.nav-caret-desktop')) return;
  var caret = document.createElement('span');
  caret.className = 'nav-caret-desktop';
  caret.setAttribute('aria-hidden', 'true');
  caret.textContent = '⌄';
  a.appendChild(caret);
});

var lockScroll = function (lock) {
  if (lock) {
    document.documentElement.dataset.scrollY = String(window.scrollY);
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
  } else {
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
    var restoreY = Number(document.documentElement.dataset.scrollY || 0);
    try {
      window.scrollTo({ top: restoreY, behavior: 'instant' });
    } catch (e) {
      var htmlEl = document.documentElement;
      var prevBehavior = htmlEl.style.scrollBehavior;
      htmlEl.style.scrollBehavior = 'auto';
      window.scrollTo(0, restoreY);
      htmlEl.style.scrollBehavior = prevBehavior;
    }
  }
};

var openNav = function () {
  if (!mnav) return;
  mnav.classList.add('open');
  mnav.removeAttribute('inert');
  mnav.setAttribute('aria-hidden', 'false');
  lockScroll(true);
  document.querySelectorAll('.hbg').forEach(function (b) { b.setAttribute('aria-expanded', 'true'); });
  var closeBtn = mnav.querySelector('.mno-close');
  if (closeBtn) {
    lastFocused = document.activeElement;
    closeBtn.focus({ preventScroll: true });
  }
};
var closeNav = function () {
  if (!mnav) return;
  mnav.classList.remove('open');
  mnav.setAttribute('inert', '');
  mnav.setAttribute('aria-hidden', 'true');
  lockScroll(false);
  document.querySelectorAll('.hbg').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
  if (lastFocused && lastFocused.focus) {
    lastFocused.focus({ preventScroll: true });
    lastFocused = null;
  }
};

openers.forEach(function (b) { b.addEventListener('click', openNav); });
closers.forEach(function (b) { b.addEventListener('click', closeNav); });
if (mnav) {
  mnav.querySelectorAll('a').forEach(function (a) {
    a.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('.nav-caret')) return;
      closeNav();
    });
  });
}
document.addEventListener('keydown', function (e) {
  if ('Escape' === e.key && mnav && mnav.classList.contains('open')) closeNav();
});
if (mnav) {
  mnav.addEventListener('keydown', function (e) {
    if ('Tab' !== e.key || !mnav.classList.contains('open')) return;
    var focusables = mnav.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])');
    if (!focusables.length) return;
    var first = focusables[0];
    var last = focusables[focusables.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
}
if (mnav && window.matchMedia) {
  var mqDesktop = window.matchMedia('(min-width: 768px)');
  var onDesktop = function (e) {
    if (e.matches && mnav.classList.contains('open')) closeNav();
  };
  if (mqDesktop.addEventListener) mqDesktop.addEventListener('change', onDesktop);
  else if (mqDesktop.addListener) mqDesktop.addListener(onDesktop);
}
/* Desktop dropdowns on touch tablets: first tap expands, not navigate. */
if (window.matchMedia && window.matchMedia('(hover: none)').matches) {
  var hasDesktopNav = document.querySelector('.snav-list');
  if (hasDesktopNav) {
    document.addEventListener('click', function (e) {
      var parent = e.target.closest ? e.target.closest('.snav-list li.menu-item-has-children') : null;
      Array.prototype.forEach.call(document.querySelectorAll('.snav-list li.open'), function (li) {
        if (!parent || !parent.contains(li)) li.classList.remove('open');
      });
      if (!parent) return;
      var link = parent.querySelector(':scope > a');
      if (link && (e.target === link || link.contains(e.target)) && !parent.classList.contains('open')) {
        e.preventDefault();
        parent.classList.add('open');
      }
    });
  }
}

/* ── 3. Spotlight search (spotlight-search.js) — client-side over POSTS ──
   The WP fetch path pulls a REST search index; a static Astro site has no
   endpoint, so the embedded POSTS index (title + excerpt + link + cat +
   date + mins) is searched locally. Same UI/UX contract: combobox input,
   .gs-row role=option, arrow-key nav with aria-activedescendant, view-all
   fallback, .gs-state row when nothing matches, close() keeps the text. */
(function () {
  var INDEX = [];
  try {
    var idxEl = document.getElementById('gwill-search-index');
    if (idxEl) INDEX = JSON.parse(idxEl.textContent || '[]');
  } catch (e) {}
  var INDEX_BASE = '';
  try {
    var form = document.querySelector('.gs-form');
    if (form) INDEX_BASE = form.getAttribute('action') || '';
    if (!INDEX_BASE) INDEX_BASE = window.location.origin + '/finance-astro/';
  } catch (e) { INDEX_BASE = window.location.origin + '/finance-astro/'; }
  if (!INDEX || !INDEX.length) return;

  var toggles = document.querySelectorAll('[data-gwill-search-toggle]');
  var panel = document.getElementById('gwill-search-panel');
  var input = document.getElementById('gwill-search-input');
  var results = document.getElementById('gwill-search-results');
  var clearBtn = document.getElementById('gwill-search-clear');
  var closeBtn = document.getElementById('gwill-search-close');
  if (!toggles.length || !panel || !input) return;

  var timer = null;
  var sel = -1;
  var data = [];
  var lastTrigger = null;
  var DEBOUNCE = 120;
  var MIN_CHARS = 2;
  var MAX_RESULTS = 8;

  function escHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function norm(s) {
    return String(s || '').toLowerCase().replace(/\s+/g, ' ').trim();
  }

  function search(query) {
    var q = norm(query);
    if (!q) return [];
    var words = q.split(' ');
    var out = [];
    for (var i = 0; i < INDEX.length; i++) {
      var p = INDEX[i];
      var hay = norm((p.title || '') + ' ' + (p.excerpt || '') + ' ' + (p.cat || ''));
      var score = 0;
      var all = true;
      for (var k = 0; k < words.length; k++) {
        if (hay.indexOf(words[k]) === -1) { all = false; break; }
        score += words[k].length;
      }
      if (all) {
        // Bing-y: title matches rank far above excerpt/category-only hits.
        if (norm(p.title || '').indexOf(q) !== -1) score += 40;
        out.push({ p: p, s: score });
      }
    }
    out.sort(function (a, b) { return b.s - a.s; });
    return out.slice(0, MAX_RESULTS);
  }

  function highlight(text, q) {
    var safe = escHtml(text);
    var qq = norm(q);
    if (!qq) return safe;
    try {
      var re = new RegExp('(' + qq.split(' ').sort(function (a, b) { return b.length - a.length; }).join('|') + ')', 'gi');
      return safe.replace(re, '<mark>$1</mark>');
    } catch (e) { return safe; }
  }

  function row(p, i, q) {
    var mins = p.mins || 1;
    var date = p.date ? p.date : '';
    var cat = p.cat ? p.cat : '';
    return '<a href="' + escHtml(p.url || '#') + '" class="gs-row" id="gwill-gs-' + i + '" role="option" aria-selected="false" data-i="' + i + '">'
      + '<span class="gs-arrow">→</span>'
      + '<span class="gs-main">'
      + '<span class="gs-title">' + highlight(p.title || '', q) + '</span>'
      + (p.excerpt ? '<span class="gs-excerpt">' + highlight(p.excerpt, q) + '</span>' : '')
      + '<span class="gs-meta">'
      + (date ? '<span class="gs-date">' + escHtml(date) + '</span><span class="gs-dot">·</span>' : '')
      + '<span>' + mins + ' min read</span></span>'
      + '</span>'
      + '<span class="gs-pill">' + escHtml(cat || 'article') + '</span>'
      + '</a>';
  }

  function renderResults(q) {
    data = search(q);
    sel = -1;
    var html = '';
    if (!data.length) {
      results.innerHTML = '<div class="gs-state" role="option" aria-disabled="true">No matches for "' + escHtml(q) + '". Try a different term.</div>';
      results.classList.add('has-results');
      return;
    }
    for (var i = 0; i < data.length; i++) html += row(data[i].p, i, q);
    html += '<a class="gs-viewall" role="option" href="' + escHtml(INDEX_BASE) + 'search/?q=' + encodeURIComponent(q) + '">View all results →</a>';
    results.innerHTML = html;
    results.classList.add('has-results');
  }

  function showState(msg) {
    results.innerHTML = '<div class="gs-state" role="option" aria-disabled="true">' + escHtml(msg) + '</div>';
    results.classList.add('has-results');
  }

  function items() {
    return Array.prototype.slice.call(results.querySelectorAll('.gs-row'));
  }
  function highlightActive() {
    var rows = items();
    rows.forEach(function (el, i) {
      el.classList.toggle('cur', i === sel);
      el.setAttribute('aria-selected', i === sel ? 'true' : 'false');
    });
    if (rows[sel]) {
      input.setAttribute('aria-activedescendant', 'gwill-gs-' + sel);
      rows[sel].scrollIntoView({ block: 'nearest' });
    } else {
      input.removeAttribute('aria-activedescendant');
    }
  }

  function syncClear() {
    if (clearBtn) clearBtn.hidden = !(input && input.value.length > 0);
  }

  function open(trigger) {
    lastTrigger = trigger || null;
    panel.hidden = false;
    toggles.forEach(function (t) { t.setAttribute('aria-expanded', 'true'); });
    input.setAttribute('aria-expanded', 'true');
    syncClear();
    setTimeout(function () { input.focus(); }, 80);
  }

  function close() {
    panel.hidden = true;
    toggles.forEach(function (t) { t.setAttribute('aria-expanded', 'false'); });
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
    results.innerHTML = '';
    results.classList.remove('has-results');
    data = [];
    sel = -1;
    syncClear();
    if (lastTrigger && lastTrigger.focus) {
      lastTrigger.focus({ preventScroll: true });
      lastTrigger = null;
    }
  }

  function clearOnly() {
    input.value = '';
    results.innerHTML = '';
    results.classList.remove('has-results');
    data = [];
    sel = -1;
    input.removeAttribute('aria-activedescendant');
    syncClear();
    input.focus();
  }

  if (clearBtn) clearBtn.addEventListener('click', clearOnly);
  if (closeBtn) closeBtn.addEventListener('click', function () { close(); syncClear(); });

  toggles.forEach(function (t) {
    t.addEventListener('click', function (e) {
      e.stopPropagation();
      if (panel.hidden) open(t); else close();
    });
  });

  input.addEventListener('keydown', function (e) {
    if ('Escape' === e.key) { e.preventDefault(); close(); }
    if ('ArrowDown' === e.key) { e.preventDefault(); sel = Math.min(sel + 1, data.length - 1); highlightActive(); }
    if ('ArrowUp' === e.key) { e.preventDefault(); sel = Math.max(sel - 1, 0); highlightActive(); }
    if ('Enter' === e.key && sel >= 0 && data[sel] && data[sel].p && data[sel].p.url) {
      e.preventDefault();
      window.location = data[sel].p.url;
    }
  });

  input.addEventListener('input', function () {
    clearTimeout(timer);
    syncClear();
    var v = this.value.trim();
    if (v.length < MIN_CHARS) {
      results.innerHTML = '';
      results.classList.remove('has-results');
      if (v.length) showState('Keep typing…');
      return;
    }
    timer = setTimeout(function () { renderResults(v); }, DEBOUNCE);
  });

  syncClear();
})();
})();
</script>
</body>
</html>
