---
import { SITE, NAV, TICKER_STATIC, POSTS, catBySlug, type NavItem } from "../data/site";
import "../styles/header.css";
// Shared chrome: head, self-hosted fonts, finance tokens (light + dark),
// skip-link, ticker, desktop nav + mobile drawer, footer. Staging-safe SEO:
// Pages origin + /finance-astro base everywhere, site-wide noindex on staging.
interface Props { title: string; description: string; noCanonical?: boolean; crumb?: string; }
const { title, description, noCanonical = false, crumb = "" } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const origin = (Astro.site?.toString() ?? "https://godschi10.github.io").replace(/\/$/, "");
const homeUrl = `${origin}${base}`;
const routePath = Astro.url.pathname.replace(/index\.html$/, "");
const pagePath = routePath.endsWith("/") ? routePath : `${routePath}/`;
const isHome = pagePath === base;
const canonical = `${origin}${pagePath}`;
const ogUrl = noCanonical ? homeUrl : canonical;
const ogImage = `${homeUrl}images/og-default.png`;
const siteName = "GWill Finance";
const sameAs = ["https://x.com/gwillchijioke", "https://github.com/gwillchijioke", "https://linkedin.com/in/gwillchijioke"];
const showBreadcrumbs = !noCanonical && !isHome && crumb !== "";
const ld = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");
const website = { "@context": "https://schema.org", "@type": "WebSite", name: siteName, url: homeUrl };
const organization = { "@context": "https://schema.org", "@type": "Organization", name: siteName, url: homeUrl, logo: `${homeUrl}icons/icon-512.png`, sameAs };
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: homeUrl }, { "@type": "ListItem", position: 2, name: crumb }] };
const fontFaces = [400, 700, 800].map((weight) =>
  `@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:${weight};font-display:swap;src:url("${base}fonts/jetbrains-mono-latin-${weight}-normal.woff2") format("woff2")}`
).join("\n");

// ── Faithful WP header port helpers ──────────────────────────────
// Prefix any site-root-relative nav href (e.g. "/all-articles/") with the
// ${base} (repo base "/finance-astro/") so every link targets this GitHub
// Pages subpath, exactly like the peer routes in the old header.
const linkFor = (href: string) => `${base}${href.replace(/^\//, "")}`;
const hasKids = (n: NavItem) => !!n.children && n.children.length > 0;

// Desktop .snav-list (top-level parent rows get menu-item-has-children +
// a server-rendered .nav-caret-desktop ⌄ like the WP nav; children render
// as .sub-menu dropdowns, nested one level deep exactly like the WP menu).
const desktopNavItem = (n: NavItem): string => {
  const kids = hasKids(n);
  const cls = `menu-item menu-item-type-custom menu-item-object-custom${kids ? " menu-item-has-children" : ""}`;
  const caret = kids ? `<span class="nav-caret-desktop" aria-hidden="true">⌄</span>` : "";
  const sub = kids
    ? `<ul class="sub-menu">${(n.children ?? []).map(desktopNavItem).join("")}</ul>`
    : "";
  return `<li class="${cls}"><a href="${linkFor(n.href)}">${n.label}${caret}</a>${sub}</li>`;
};
const desktopNavHtml = `<ul class="snav-list">${NAV.map(desktopNavItem).join("")}</ul>`;

// Mobile drawer .mno-list: same nested tree as an accordion. The gold
// .nav-caret handle buttons are injected by JS exactly like WP main.js
// (split-tap accordion: tap ⌄ toggles the sibling .sub-menu, tap the row
// text navigates). Sub-menu ul.sub-menu markup is server-rendered.
const mobileNavItem = (n: NavItem): string => {
  const kids = hasKids(n);
  const cls = `menu-item menu-item-type-custom menu-item-object-custom${kids ? " menu-item-has-children" : ""}`;
  const sub = kids
    ? `<ul class="sub-menu">${(n.children ?? []).map(mobileNavItem).join("")}</ul>`
    : "";
  return `<li class="${cls}"><a href="${linkFor(n.href)}">${n.label}</a>${sub}</li>`;
};
const mobileNavHtml = `<ul class="mno-list">${NAV.map(mobileNavItem).join("")}</ul>`;

const newsletterHref = `${base}#newsletter`;

// Spotlight search index: title + excerpt from the POSTS array, the same
// source the Astro pages render from. Kept tiny so the inline script can
// search fully client-side (no REST index on a static site).
const searchIndex = POSTS.map((p) => ({
  title: p.title,
  excerpt: p.excerpt,
  url: `${base}articles/${p.slug}/`,
  date: p.date,
  mins: p.readMins,
  cat: catBySlug(p.category).name,
}));
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, "\\u003c");
const searchBase = `${base}search/`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#0d0b08">
<link rel="preload" href={`${base}fonts/jetbrains-mono-latin-800-normal.woff2`} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={`${base}fonts/jetbrains-mono-latin-700-normal.woff2`} as="font" type="font/woff2" crossorigin>
<title>{title}</title>
<meta name="description" content={description}>
<meta name="deployment" content="GitHub Pages staging — not production">
{!noCanonical && <link rel="canonical" href={canonical}>}
<link rel="icon" type="image/svg+xml" href={`${base}icons/icon.svg`}>
<link rel="manifest" href={`${base}manifest.webmanifest`}>
<link rel="apple-touch-icon" sizes="180x180" href={`${base}icons/icon-180.png`}>
<meta property="og:type" content="website">
<meta property="og:url" content={ogUrl}>
<meta property="og:site_name" content={siteName}>
<meta property="og:locale" content="en_NG">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<script type="application/ld+json" set:html={ld(website)}></script>
{isHome && <script type="application/ld+json" set:html={ld(organization)}></script>}
{showBreadcrumbs && <script type="application/ld+json" set:html={ld(breadcrumb)}></script>}
<script is:inline>
/* GWill Finance — first-paint theme restore + tri-state pill (WP finance-home.html). */
(function(){
	// ── Part A: read persisted choice + paint before first paint ──
	var K = 'gwill-finance-theme-v3';
	var K2 = 'gwill-finance-theme-v2';
	var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
	var t = null;
	try { t = localStorage.getItem(K); } catch(e) {}

	// Migrate legacy v2 -> v3 once (v2 had no 'system' value; no-key = system).
	if (t === null) {
		var t2 = null;
		try { t2 = localStorage.getItem(K2); } catch(e) {}
		if (t2 === 'dark' || t2 === 'light') {
			t = t2;
			try { localStorage.setItem(K, t); } catch(e) {}
			try { localStorage.removeItem(K2); } catch(e) {}
		}
	}

	// Normalize: anything other than the three known values falls back to 'system'.
	if (t !== 'dark' && t !== 'light' && t !== 'system') t = 'system';

	var effective = t;
	if (effective === 'system') {
		effective = (mq && mq.matches) ? 'dark' : 'light';
	}
	if (effective === 'dark') document.documentElement.setAttribute('data-theme','dark');
	else document.documentElement.removeAttribute('data-theme');

	// ── Part B: wire the pill from the REAL stored state ──
	document.addEventListener('DOMContentLoaded', function(){
		var groups = document.querySelectorAll('[data-theme-group]');
		if (!groups.length) return;

		function paint(mode) {
			if (mode === 'dark') document.documentElement.setAttribute('data-theme','dark');
			else document.documentElement.removeAttribute('data-theme');
		}

		function persist(choice) {
			if (choice === 'system') {
				try { localStorage.removeItem(K); } catch(e) {}
			} else {
				try { localStorage.setItem(K, choice); } catch(e) {}
			}
		}

		function syncPressed(g, choice) {
			g.querySelectorAll('[data-theme-set]').forEach(function(btn){
				btn.setAttribute('aria-pressed', btn.getAttribute('data-theme-set') === choice ? 'true' : 'false');
			});
		}

		groups.forEach(function(g){
			g.setAttribute('data-current', t);
			syncPressed(g, t);
		});

		groups.forEach(function(g){
			g.querySelectorAll('[data-theme-set]').forEach(function(btn){
				if (!btn.getAttribute('aria-label')) { btn.setAttribute('aria-label','Theme'); }
				btn.addEventListener('click', function(){
					var pick = btn.getAttribute('data-theme-set');
					groups.forEach(function(g2){
						g2.setAttribute('data-current', pick);
						syncPressed(g2, pick);
					});
					persist(pick);
					paint(pick === 'system' ? ((mq && mq.matches) ? 'dark' : 'light') : pick);
				});
			});
			g.addEventListener('keydown', function(ev){
				var order = ['dark','system','light'];
				var segs = g.querySelectorAll('[data-theme-set]');
				var cur = g.getAttribute('data-current') || 'system';
				var i = order.indexOf(cur);
				if (ev.key === 'ArrowLeft' || ev.key === 'ArrowUp') {
					ev.preventDefault();
					segs[(i - 1 + order.length) % order.length].click();
					segs[(i - 1 + order.length) % order.length].focus();
				} else if (ev.key === 'ArrowRight' || ev.key === 'ArrowDown') {
					ev.preventDefault();
					segs[(i + 1) % order.length].click();
					segs[(i + 1) % order.length].focus();
				} else if (ev.key === 'Home') {
					ev.preventDefault(); segs[0].click(); segs[0].focus();
				} else if (ev.key === 'End') {
					ev.preventDefault(); segs[segs.length-1].click(); segs[segs.length-1].focus();
				}
			});
		});

		function onSys(e) {
			groups.forEach(function(g){
				if ((g.getAttribute('data-current') || 'system') === 'system') {
					paint(e.matches ? 'dark' : 'light');
				}
			});
		}
		if (mq) {
			if (mq.addEventListener) mq.addEventListener('change', onSys);
			else if (mq.addListener) mq.addListener(onSys);
		}
	});
})();
</script>
<style is:inline set:html={fontFaces}></style>
<style is:global>
:root{
  --font:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  --bg:#f7f6f2;--surface:#ffffff;--surface-2:#faf9f6;
  --border:#e4e2dc;--border-dim:#eeece7;
  --text:#0d0d0d;--text-mid:#3a3a3a;--text-dim:#6b6b6b;
  --art-copy:#262626;--art-dim:#3a3a3a;
  --gold:#b45309;--gold-b:#f59e0b;--gold-btn:#b45309;
  --gold-muted:#fef9ee;--gold-border:#fcd97a;--gold-glow:rgba(217,119,6,.22);
  --green:#15803d;--green-btn:#15803d;--green-muted:#f0fdf4;--green-border:#86efac;
  --purple:#7c3aed;--red:#b91c1c;--dark:#0d0b08;
  --dark-s:#131210;--dark-b:#211f1a;--dark-dim:#8f8575;
  --r-sm:6px;--r-md:10px;--r-lg:16px;--r-xl:24px;--pill:100px;
  --sh-sm:0 1px 3px rgba(0,0,0,.04),0 4px 12px rgba(0,0,0,.05);
  --sh-md:0 2px 8px rgba(0,0,0,.05),0 8px 28px rgba(0,0,0,.08);
  --sh-gold:0 4px 24px rgba(217,119,6,.14);
  --t:160ms ease;--t-md:240ms ease;
  --header-h:64px;--con-pad:48px;--wide:1200px;
}
@media(max-width:1023px){
  :root{--con-pad:28px;--header-h:56px}
}
[data-theme="dark"]{
  --bg:#0d0b08;--surface:#131210;--surface-2:#171512;
  --text:#f0ede6;--art-copy:#e8e4dc;--art-dim:#8a8070;
  --border:#211f1a;--border-dim:#1d1a16;
  --text-mid:#c4b89a;--text-dim:#8f8575;
  --gold:#f59e0b;--gold-btn:#b45309;
  --gold-muted:rgba(245,158,11,.08);--gold-border:rgba(245,158,11,.25);
  --gold-glow:rgba(245,158,11,.35);
  --green:#22c55e;--green-btn:#15803d;
  --green-muted:rgba(34,197,94,.08);--green-border:rgba(34,197,94,.25);
  --purple:#a78bfa;--red:#f87171;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{overflow-x:hidden;overflow-x:clip;scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 20px);background:var(--bg)}
body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:16px;line-height:1.6;-webkit-text-size-adjust:100%;overflow-x:hidden;overflow-x:clip;overflow-wrap:break-word}
img{max-width:100%;height:auto}
a{color:inherit}
button{font:inherit;cursor:pointer;touch-action:manipulation}
a:focus-visible,button:focus-visible{outline:3px solid var(--gold-b);outline-offset:3px}
::selection{background:var(--gold-b);color:#0d0b08}
[hidden]{display:none!important}
.wrap{width:calc(100% - 32px);max-width:var(--wide);margin-inline:auto}
.skip{position:fixed;top:8px;left:16px;transform:translateY(-200%);background:var(--surface);color:var(--text);z-index:1000;padding:12px 16px;min-height:48px;border:2px solid var(--gold);border-radius:var(--r-sm)}
.skip:focus{transform:none}
/* Header chrome lives in src/styles/header.css (WP port) — .sh/.mh/.mno/.gs/.ticker/.tp/.ncta/.nsearch. .brand + .wordmark remain here for the FOOTER brand only. */
.brand{display:inline-flex;align-items:center;gap:8px;margin-right:auto;min-height:48px;text-decoration:none;flex-shrink:0}
.brand-naira{color:var(--gold);font-weight:800;font-size:22px;line-height:1}
.wordmark{position:relative;font-weight:800;font-size:clamp(18px,2.6vw,22px);letter-spacing:-.03em;white-space:nowrap}
.wordmark::after{content:"";position:absolute;bottom:-6px;left:0;right:0;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--gold-b),var(--green));opacity:.8}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 24px;border-radius:var(--r-md);border:1px solid transparent;font-weight:700;font-size:15px;text-decoration:none;transition:background var(--t),transform var(--t)}
.btn:active{transform:translateY(1px)}
/* Hero */
/* Hero — dark ledger slab */
.hero{position:relative;overflow:hidden;text-align:left;background:var(--dark);color:#f0ede6;padding-block:56px 52px}
.hero::before{content:"";position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(rgba(255,255,255,.05) 1px,transparent 1.5px);background-size:28px 28px}
.hero::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(640px 320px at 85% -5%,rgba(245,158,11,.16),transparent 70%)}
.hero>.con{position:relative;z-index:1}
.hero-grain{position:absolute;inset:0;pointer-events:none;opacity:.5;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E")}
.hero-tag{display:inline-block;font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-b);border:1px solid rgba(245,158,11,.35);background:rgba(245,158,11,.1);border-radius:var(--pill);padding:6px 14px;margin-bottom:22px}
.hero-h{font-size:clamp(2.375rem,5.5vw,3.875rem);line-height:1;letter-spacing:-.045em;overflow-wrap:anywhere}
.hero-h .g{color:var(--gold-b)}
.hero-h .c{color:#f0ede6}
.hero-sub{margin-top:16px;font-size:.9375rem;line-height:1.75;color:#c4b89a;max-width:29rem}
.ledger{width:48px;height:3px;background:var(--gold-b);margin:24px 0 0}
.hero-acts{display:flex;flex-direction:column;gap:12px;margin-top:24px}
.hero .btn{width:100%;font-size:13px;font-weight:800;border-radius:6px}
.hero .b-gold{background:var(--gold-b);border-color:var(--gold-b);color:#0d0b08}
.hero .b-gold:hover{background:#fbbf24;border-color:#fbbf24;color:#0d0b08;transform:translateY(-1px)}
.hero .b-ghost{border-color:rgba(240,237,230,.35);color:#f0ede6;background:transparent}
.hero .b-ghost:hover{border-color:var(--gold-b);color:var(--gold-b);transform:translateY(-1px)}
.hero-cats{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:36px;border-top:1px solid rgba(245,158,11,.18);padding-top:20px}
.hero-cats-lbl{font-size:13px;color:#8f8575;font-weight:700;font-style:italic}
.chip{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;border:1px solid #2b2822;background:#171512;color:#f0ede6;border-radius:var(--pill);padding:15px 12px}
/* Stats — ledger odometer */
.stat-strip{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:32px}
.si{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:16px 12px;box-shadow:var(--sh-sm);min-width:0}
.si-n{font-size:1.5rem;font-weight:800;letter-spacing:-.04em;color:var(--gold);overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
.si:last-child .si-n{color:var(--green)}
.si-l{font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);margin-top:4px}
/* Sections / cards */
.con{width:calc(100% - 32px);max-width:var(--wide);margin-inline:auto}
.sg{padding-block:56px}
.shd{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap}
.stitle{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--text-dim)}
.slink{font-weight:700;color:var(--gold);min-height:48px;display:inline-flex;align-items:center}
.feat{display:grid;grid-template-columns:minmax(0,1fr);gap:0;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--sh-md)}
.feat-img{position:relative;min-height:200px;display:grid;place-items:center;background:var(--dark);border-bottom:1px solid var(--border)}
.feat-img>span:first-child{font-size:56px;line-height:1;color:#f0ede6}
.feat-body{padding:20px;min-width:0;border-left:3px solid var(--gold-b)}
.tile-wm{position:absolute;left:14px;bottom:12px;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.tile-wm.bgn{color:#4ade80}.tile-wm.bg{color:var(--gold-b)}.tile-wm.bpu{color:#a78bfa}.tile-wm.bsl{color:#c4b89a}.tile-wm.brd{color:#f87171}
.badge{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;border-radius:var(--r-sm);padding:4px 10px;text-decoration:none;margin-bottom:12px}
.bgn{background:var(--green-muted);color:var(--green);border:1px solid var(--green-border)}
.bg{background:var(--gold-muted);color:var(--gold);border:1px solid var(--gold-border)}
.bpu{background:rgba(124,58,237,.1);color:var(--purple);border:1px solid rgba(124,58,237,.3)}
.bsl{background:var(--surface-2);color:var(--text-mid);border:1px solid var(--border)}
.brd{background:rgba(248,113,113,.1);color:var(--red);border:1px solid rgba(248,113,113,.3)}
.feat-t{font-size:1.375rem;font-weight:800;line-height:1.2;letter-spacing:-.03em;overflow-wrap:anywhere}
.feat-t a{text-decoration:none}
.feat-ex{margin-top:8px;color:var(--text-mid);font-size:.8125rem;line-height:1.75}
.feat-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:16px;font-size:10px;color:var(--text-dim)}
.feat-dot{width:3px;height:3px;border-radius:50%;background:var(--text-dim);opacity:.6}
.cp-strip{display:flex;flex-wrap:wrap;gap:8px}
.cp{font-size:13px;font-weight:700;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--pill);padding:8px 16px;min-height:44px}
.cp.on,.cp[aria-pressed="true"]{background:var(--dark);color:#f0ede6;border-color:var(--dark)}
.g3{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--sh-sm);min-width:0;transition:transform var(--t),border-color var(--t)}
.card:hover{transform:translateY(-3px);border-color:var(--gold)}
.card:hover .card-t{color:var(--gold)}
.card-art{position:relative;min-height:120px;display:grid;place-items:center;background:var(--dark)}
.card-art>span:first-child{font-size:40px;line-height:1;color:#f0ede6}
.card-body{padding:16px 20px 20px;display:flex;flex-direction:column;gap:8px;flex:1;min-width:0}
.card-t{font-weight:800;font-size:.9375rem;line-height:1.35;letter-spacing:-.02em;overflow-wrap:anywhere}
.card-t a{text-decoration:none}
.card-ex{font-size:.75rem;line-height:1.65;color:var(--text-mid);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-meta{font-size:10px;color:var(--text-dim);margin-top:auto;padding-top:12px;border-top:1px solid var(--border-dim)}
/* Ad placeholder (honest empty slot) */
.ad-bg{border:1px dashed var(--border);border-radius:var(--r-md);background:var(--surface-2);color:var(--text-dim);font-size:12px;text-align:center;padding:20px;margin-block:24px;overflow-wrap:anywhere}
/* Newsletter hold band */
.nl-s{background:var(--dark);color:#f0ede6;border-radius:var(--r-xl);padding:28px 20px;display:grid;gap:16px}
.nl-h{font-size:1.25rem;font-weight:800;letter-spacing:-.03em}
.nl-s p{color:#c4b89a;font-size:15px}
.nl-meta{display:flex;flex-wrap:wrap;gap:8px;font-size:13px;color:#8f8575}
.nl-meta .dot{width:4px;height:4px;border-radius:50%;background:#8f8575;align-self:center}
/* Footer */
.footer{background:var(--dark);color:#f0ede6;margin-top:48px}
.footer-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:32px;padding-block:48px 32px}
.ftag{color:#c4b89a;font-size:14px;margin-top:12px;max-width:44ch}
.fct{font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#8f8575;margin-bottom:12px}
.flink-list{list-style:none;display:flex;flex-direction:column}
.flink-list a{display:inline-flex;align-items:center;min-height:44px;color:#c4b89a;text-decoration:none;font-size:13px}
.flink-list a:hover{color:#fff}
.socials{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
.socials a{display:inline-flex;align-items:center;justify-content:center;min-width:48px;min-height:48px;border:1px solid #2b2822;border-radius:var(--r-sm);color:#c4b89a;font-size:13px;font-weight:800;text-decoration:none;padding:0 10px}
.socials a:hover{color:var(--gold-b);border-color:var(--gold-b)}
.footer-bottom{border-top:1px solid #211f1a;padding-block:20px;display:flex;flex-wrap:wrap;gap:8px 24px;justify-content:space-between;font-size:11px;color:#8f8575}
.colophon{font-size:10px;letter-spacing:.06em;text-transform:uppercase}
/* Legal */
.legal-hero{background:var(--dark);color:#f0ede6;position:relative;overflow:hidden}
.legal-hero-inner{padding-block:40px}
.legal-hero-label{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-b)}
.legal-hero-title{font-size:clamp(1.75rem,4vw,2.5rem);font-weight:800;line-height:1.05;letter-spacing:-.035em;margin-top:8px;overflow-wrap:anywhere}
.legal-hero-title .g{color:var(--gold-b)}
.legal-seal{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-b);border:1px solid rgba(245,158,11,.4);border-radius:var(--pill);padding:6px 14px;margin-top:16px}
.crumbs{font-size:12px;color:#8f8575;margin-bottom:16px}
.crumbs a{color:#c4b89a}
.legal-section{padding-block:32px}
.legal-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:24px}
.legal-toc{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:20px;align-self:start}
.legal-toc-label{font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--text-dim);margin-bottom:12px}
.legal-toc-list{list-style:decimal inside;display:flex;flex-direction:column;gap:4px}
.legal-toc-list a{display:inline-flex;min-height:44px;align-items:center;color:var(--gold);font-size:13px;font-weight:700}
.legal-body{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:24px 20px;min-width:0;box-shadow:var(--sh-sm);max-width:720px}
.legal-block{scroll-margin-top:calc(var(--header-h) + 20px);padding-bottom:28px;margin-bottom:28px;border-bottom:1px solid var(--border-dim)}
.legal-block:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0}
.legal-block h2{display:block;font-size:1.125rem;font-weight:800;letter-spacing:-.02em;margin-bottom:8px;overflow-wrap:anywhere}
.legal-block h2::before{content:"";display:block;width:48px;height:3px;background:var(--gold);margin-bottom:12px}
.legal-block p,.legal-block li{font-size:1rem;line-height:1.8;color:var(--art-copy);overflow-wrap:anywhere}
.legal-block ul{padding-left:20px;display:flex;flex-direction:column;gap:6px;margin-top:8px}
/* Stub hold */
.hold{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:32px 24px;box-shadow:var(--sh-sm);min-width:0}
.hold h2{font-size:20px;margin-bottom:8px}
.hold-title{font-size:clamp(1.5rem,3.4vw,2rem);font-weight:800;letter-spacing:-.03em;line-height:1.1;overflow-wrap:anywhere}
.hold-title::before{content:"";display:block;width:48px;height:3px;background:var(--gold);margin-bottom:16px}
.hold p{color:var(--text-mid);font-size:15px;max-width:62ch}
.hold ul{margin-top:12px;padding-left:20px;color:var(--text-mid);font-size:15px;display:flex;flex-direction:column;gap:6px}
.phase-tag{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);background:var(--gold-muted);border:1px solid var(--gold-border);border-radius:var(--pill);padding:4px 12px;margin-bottom:12px}
.sg .crumbs a{color:var(--gold)}
/* Phase 3 — articles, search, forms */
/* Article single */
.art-h{font-size:clamp(1.75rem,3.8vw,2.5rem);font-weight:800;line-height:1.08;letter-spacing:-.035em;margin-top:12px;overflow-wrap:anywhere}
.art-lede{margin-top:12px;color:var(--text-mid);font-size:1rem;line-height:1.8;max-width:62ch}
.art-section{padding-block:8px 56px}
.art-main{min-width:0}
.disc-box{background:var(--gold-muted);border:1px solid var(--gold-border);border-left:3px solid var(--gold);border-radius:var(--r-md);padding:14px 18px;font-size:14px;line-height:1.7;color:var(--text-mid);margin-top:20px;overflow-wrap:anywhere}
.art-hero{border-radius:var(--r-md);overflow:hidden;margin-top:20px;min-height:180px}
.art-body{margin-top:20px;color:var(--art-copy);font-size:1rem;line-height:1.8;min-width:0;overflow-wrap:anywhere}
.art-body h2{font-size:1.125rem;font-weight:800;letter-spacing:-.02em;margin:28px 0 8px;overflow-wrap:anywhere}
.art-body h2::before{content:"";display:block;width:48px;height:3px;background:var(--gold);margin-bottom:12px}
.art-body p{margin-top:12px;max-width:72ch}
.art-body ul,.art-body ol{margin-top:12px;padding-left:20px;display:flex;flex-direction:column;gap:6px;max-width:72ch}
.art-body a{color:var(--gold)}
.art-body table{display:block;width:100%;overflow-x:auto;border:1px solid var(--border);border-radius:var(--r-md);margin-top:16px;font-size:.75rem;border-collapse:collapse}
.art-body th,.art-body td{padding:12px 14px;border-bottom:1px solid var(--border-dim);text-align:left;white-space:normal;min-width:120px}
.art-body thead th{background:var(--surface-2);font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);white-space:nowrap}
.art-body tbody tr:hover{background:var(--gold-muted)}
.art-body tbody tr:last-child th,.art-body tbody tr:last-child td{border-bottom:none}
.share-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:24px;padding-top:20px;border-top:1px solid var(--border-dim)}
.share-label{font-size:13px;font-weight:700;color:var(--text-dim)}
.author-bio{display:flex;gap:16px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:20px;margin-top:24px;min-width:0}
.author-bio>div{min-width:0}
.author-mark{flex-shrink:0;width:48px;height:48px;display:grid;place-items:center;background:var(--dark);color:var(--gold-b);font-weight:800;font-size:22px;border-radius:var(--r-md)}
.author-role{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-dim)}
.author-text{margin-top:8px;font-size:15px;line-height:1.7;color:var(--text-mid)}
.author-socials{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:8px}
.author-socials a{color:var(--gold);font-size:13px;font-weight:700;min-height:44px;display:inline-flex;align-items:center;text-transform:capitalize}
.comments-hold{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-lg);padding:20px;margin-top:24px}
.comments-hold p{font-size:14px;line-height:1.7;color:var(--text-mid);margin-top:8px;max-width:68ch}
.video-facade{position:relative;display:grid;place-items:center;gap:12px;text-align:center;background:var(--dark);color:#f0ede6;border-radius:var(--r-lg);margin-top:20px;padding:48px 20px;min-height:220px;overflow:hidden}
.video-facade p{font-size:14px;color:#c4b89a}
.video-emoji{font-size:40px;color:var(--gold-b);line-height:1}
.progress{position:fixed;top:0;left:0;right:0;z-index:600;height:3px;background:transparent;pointer-events:none}
.progress span{display:block;height:100%;width:0;background:var(--gold-b)}
/* Search + forms */
.search-form{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.search-form .form-input{flex:1 1 220px;min-width:0}
.form-input{width:100%;min-height:48px;padding:12px 14px;border-radius:var(--r-md);border:1px solid var(--border);background:var(--surface-2);color:var(--text);font:inherit;font-size:1rem}
.form-input:focus{outline:2px solid var(--gold);outline-offset:1px}
.form-input:disabled{opacity:.6;cursor:not-allowed}
.form-input::placeholder{color:var(--text-dim)}
.nl-form{display:grid;gap:8px;margin-top:16px;grid-template-columns:minmax(0,1fr)}
mark{background:var(--gold-border);color:inherit;border-radius:2px;padding:0 2px}
.result-count{margin-top:16px;font-size:13px;color:var(--text-dim)}
/* Apps */
.app-stats{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.app-stats span{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--pill);padding:4px 10px;color:var(--text-mid)}
.app-stats strong{color:var(--gold)}
.app-links{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.chip[aria-current="page"]{border-color:var(--gold);color:var(--gold-b)}
main{display:block;min-width:0}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(min-width:768px){
  .wrap{width:calc(100% - 64px)}
  .con{width:calc(100% - 64px)}
  .hero{padding-block:64px 60px}
  .hero-acts{flex-direction:row}.hero .btn{width:auto}
  .sg{padding-block:64px}
  .stat-strip{grid-template-columns:repeat(4,minmax(0,1fr))}
  .si{padding:20px 32px}
  .g3{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .feat{grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)}
  .feat-img{border-bottom:none;border-right:1px solid var(--border);min-height:240px}
  .footer-grid{grid-template-columns:2fr 1fr 1fr 1fr}
  .legal-hero-inner{padding:56px 48px}
  .legal-layout{grid-template-columns:280px minmax(0,1fr);align-items:start}
  .legal-toc{position:sticky;top:calc(var(--header-h) + 20px)}
  .nl-s{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:center;padding:36px 44px}
}
@media(min-width:1024px){
  /* WP desktop nav (.snav/.snav-list) styles live in header.css */
  .hero{padding-block:72px 68px}
  .sg{padding-block:72px}
  .g3{grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .card-ex{-webkit-line-clamp:3}
}
@media(max-width:359px){
  .brand{grid-column:1;grid-row:1;min-width:0}
  .wordmark{font-size:16px}
}
@media(forced-colors:active){.wordmark::after{background:LinkText}}
