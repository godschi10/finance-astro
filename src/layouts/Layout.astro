---
import { SITE, NAV, TICKER_STATIC, catBySlug, type NavItem } from "../data/site";
import { FX_SNAPSHOT_TS } from "../data/fx-snapshot";
import { TOOLS, allArticles as allPosts, fmtMonthYear } from "../data/content";
import "../styles/base.css"; // WP stylesheet section 2 (RESET/BASE) — the anchor reset
import "../styles/header.css";
import Footer from "../components/Footer.astro";
import "../styles/footer.css";
import "../styles/home.css"; // WP stylesheet sections the homepage renders
import "../styles/search404.css"; // WP slice — /search/ + /404/ vocabulary (.phd, .search-pill, .error-404, .es-*)
import "../styles/tools.css"; // verbatim theme calculator vocabulary (style.css 1244-1500, hx/fxap blocks) for /money-tools/ pages
import "../styles/article.css"; // category art gradients (.i-sav etc.) + card rules the search cards reuse
// ORDER IS THE CASCADE CONTRACT (v0.6.8): in WP's style.css .art-body is served
// AFTER .fx-copy — on <div class="fx-copy art-body"> the ART-BODY typography wins
// (live measures 16px/1.8 copy + 20px h2 at 390px). Importing article last
// reproduces that winner exactly; importing it first silently shrank every
// calculator's copy to 15px/27px (King: "not enough space between text or
// elements especially in all calculators"). Do not re-swap.
import "../styles/forms.css"; // WP stylesheet section 46 (FORMS) — control geometry
import "../styles/pages.css"; // §34/35/43/44/45 verbatim blocks: about cards, legal, newsletter pages
import "../styles/numbers.css"; // DESIGN-LANGUAGE §1 Number Law (R1) — ADDITIVE only: tabular-nums where money figures refresh/align. Never rewrites a verbatim rule; import last by design.
// Shared chrome: head, self-hosted fonts, finance tokens (light + dark),
// skip-link, ticker, desktop nav + mobile drawer, footer. Staging-safe SEO:
// Pages origin + /finance-astro base everywhere, site-wide noindex on staging.
interface Props {
  title: string;
  description: string;
  noCanonical?: boolean;
  crumb?: string;
  /** Featured image (single posts): absolute-under-base path + WP-side dims. */
  ogImage?: { url: string; width: number; height: number; alt?: string } | null;
  /** Single post: og:type=article + article:published/modified/author. */
  isArticle?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
}
const { title, description, noCanonical = false, crumb = "", ogImage = null, isArticle = false, publishedTime, modifiedTime, articleAuthor } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const origin = (Astro.site?.toString() ?? "https://godschi10.github.io").replace(/\/$/, "");
const homeUrl = `${origin}${base}`;
const routePath = Astro.url.pathname.replace(/index\.html$/, "");
const pagePath = routePath.endsWith("/") ? routePath : `${routePath}/`;
const isHome = pagePath === base;
const canonical = `${origin}${pagePath}`;
const ogUrl = noCanonical ? homeUrl : canonical;
// social-meta.php gwill_social_meta_image(): the post's featured image first,
// then the theme's branded 1200×675 share card (assets/brand/
// gwill-social-share.png — the wordmark logo on the finance palette) so every
// non-article page still shares as a rich card, never a bare-text one.
const BRAND_SHARE = { url: `${homeUrl}images/gwill-social-share.png`, width: 1200, height: 675 };
const og = ogImage ? { ...ogImage, url: ogImage.url.startsWith("http") ? ogImage.url : `${origin}${ogImage.url}` } : BRAND_SHARE;
const ogAbs = og.url;
const ogAlt = og.alt || title;
const siteName = "GWill Finance";
const sameAs = ["https://x.com/gwillchijioke", "https://github.com/gwillchijioke", "https://linkedin.com/in/gwillchijioke"];
const showBreadcrumbs = !noCanonical && !isHome && crumb !== "";
const ld = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");
const website = { "@context": "https://schema.org", "@type": "WebSite", name: siteName, url: homeUrl };
const organization = { "@context": "https://schema.org", "@type": "Organization", name: siteName, url: homeUrl, logo: `${homeUrl}icons/icon-512.png`, sameAs };
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: homeUrl }, { "@type": "ListItem", position: 2, name: crumb }] };
const fontFaces = [400, 700, 800].map((weight) =>
  `@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:${weight};font-display:swap;src:url("${base}fonts/jetbrains-mono-latin-${weight}-normal.woff2") format("woff2")}`
).join("\n");

// ── Faithful WP header port helpers ──────────────────────────────
// Prefix any site-root-relative nav href (e.g. "/all-articles/") with the
// ${base} (repo base "/finance-astro/") so every link targets this GitHub
// Pages subpath, exactly like the peer routes in the old header.
const linkFor = (href: string) => `${base}${href.replace(/^\//, "")}`;
const hasKids = (n: NavItem) => !!n.children && n.children.length > 0;

// Desktop .snav-list (top-level parent rows get menu-item-has-children +
// a server-rendered .nav-caret-desktop ⌄ like the WP nav; children render
// as .sub-menu dropdowns, nested one level deep exactly like the WP menu).
const desktopNavItem = (n: NavItem): string => {
  const kids = hasKids(n);
  const cls = `menu-item menu-item-type-custom menu-item-object-custom${kids ? " menu-item-has-children" : ""}`;
  const caret = kids ? `<span class="nav-caret-desktop" aria-hidden="true">⌄</span>` : "";
  const sub = kids
    ? `<ul class="sub-menu">${(n.children ?? []).map(desktopNavItem).join("")}</ul>`
    : "";
  return `<li class="${cls}"><a href="${linkFor(n.href)}">${n.label}${caret}</a>${sub}</li>`;
};
const desktopNavHtml = `<ul class="snav-list">${NAV.map(desktopNavItem).join("")}</ul>`;

// Mobile drawer .mno-list: same nested tree as an accordion. The gold
// .nav-caret handle buttons are injected by JS exactly like WP main.js
// (split-tap accordion: tap ⌄ toggles the sibling .sub-menu, tap the row
// text navigates). Sub-menu ul.sub-menu markup is server-rendered.
const mobileNavItem = (n: NavItem): string => {
  const kids = hasKids(n);
  const cls = `menu-item menu-item-type-custom menu-item-object-custom${kids ? " menu-item-has-children" : ""}`;
  const sub = kids
    ? `<ul class="sub-menu">${(n.children ?? []).map(mobileNavItem).join("")}</ul>`
    : "";
  return `<li class="${cls}"><a href="${linkFor(n.href)}">${n.label}</a>${sub}</li>`;
};
const mobileNavHtml = `<ul class="mno-list">${NAV.map(mobileNavItem).join("")}</ul>`;

const newsletterHref = `${base}#newsletter`;

// Spotlight search index: ONE corpus shared with the /search/ results page —
// every article (title/excerpt/category-name/date/read-mins, badge/art/emoji
// for the engine's map) AND every calculator. The old 7-item POSTS-only array
// left the calculators unsearchable in the spotlight (the /search/ page
// searched 31 items; the drop-down only 7 — found by probing the built page).
const posts = await allPosts(); // async getCollection — Layout renders after the await
const searchIndex = [
  ...posts.map((p) => {
    const c = catBySlug(p.data.category);
    return {
      title: p.data.title,
      excerpt: p.data.description,
      url: `${base}articles/${p.slug}/`,
      date: fmtMonthYear(p.data.pubDate),
      mins: p.data.readMins,
      cat: c?.name ?? "Finance",
      category: p.data.category,
      badge: c?.badge ?? "bsl",
      art: c?.art ?? "",
      emoji: c?.emoji ?? "",
      kind: "article",
    };
  }),
  ...TOOLS.map((t) => ({
    title: t.name,
    excerpt: t.desc,
    url: `${base}money-tools/${t.slug}/`,
    date: "",
    mins: 1,
    cat: "Calculator",
    category: "tools",
    badge: "bsl",
    art: "",
    emoji: "",
    kind: "tool",
  })),
];
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, "\\u003c");
const searchBase = `${base}search/`;
---
<!doctype html>
<html lang="en" data-forms-api="https://comments-api.gwill.workers.dev">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#0d0b08">
<link rel="preload" href={`${base}fonts/jetbrains-mono-latin-800-normal.woff2`} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={`${base}fonts/jetbrains-mono-latin-700-normal.woff2`} as="font" type="font/woff2" crossorigin>
<title>{title}</title>
<meta name="description" content={description}>
<meta name="deployment" content="GitHub Pages staging — not production">
{!noCanonical && <link rel="canonical" href={canonical}>}
<link rel="icon" type="image/svg+xml" href={`${base}icons/icon.svg`}>
<link rel="manifest" href={`${base}manifest.webmanifest`}>
<link rel="apple-touch-icon" sizes="180x180" href={`${base}icons/icon-180.png`}>
<meta property="og:type" content={isArticle ? "article" : "website"}>
<meta property="og:site_name" content={siteName}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={ogUrl}>
<meta property="og:image" content={ogAbs}>
<meta property="og:image:width" content={String(og.width)}>
<meta property="og:image:height" content={String(og.height)}>
<meta property="og:image:alt" content={ogAlt}>
{isArticle && publishedTime && <meta property="article:published_time" content={publishedTime}>}
{isArticle && modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
{isArticle && articleAuthor && <meta property="article:author" content={articleAuthor}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogAbs}>
<script type="application/ld+json" set:html={ld(website)}></script>
{isHome && <script type="application/ld+json" set:html={ld(organization)}></script>}
{showBreadcrumbs && <script type="application/ld+json" set:html={ld(breadcrumb)}></script>}
<script is:inline>
/* GWill Finance — first-paint theme restore + tri-state pill (WP finance-home.html). */
(function(){
	// ── Part A: read persisted choice + paint before first paint ──
	var K = 'gwill-finance-theme-v3';
	var K2 = 'gwill-finance-theme-v2';
	var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
	var t = null;
	try { t = localStorage.getItem(K); } catch(e) {}

	// Migrate legacy v2 -> v3 once (v2 had no 'system' value; no-key = system).
	if (t === null) {
		var t2 = null;
		try { t2 = localStorage.getItem(K2); } catch(e) {}
		if (t2 === 'dark' || t2 === 'light') {
			t = t2;
			try { localStorage.setItem(K, t); } catch(e) {}
			try { localStorage.removeItem(K2); } catch(e) {}
		}
	}

	// Normalize: anything other than the three known values falls back to 'system'.
	if (t !== 'dark' && t !== 'light' && t !== 'system') t = 'system';

	var effective = t;
	if (effective === 'system') {
		effective = (mq && mq.matches) ? 'dark' : 'light';
	}
	if (effective === 'dark') document.documentElement.setAttribute('data-theme','dark');
	else document.documentElement.removeAttribute('data-theme');

	// ── Part B: wire the pill from the REAL stored state ──
	document.addEventListener('DOMContentLoaded', function(){
		var groups = document.querySelectorAll('[data-theme-group]');
		if (!groups.length) return;

		function paint(mode) {
			if (mode === 'dark') document.documentElement.setAttribute('data-theme','dark');
			else document.documentElement.removeAttribute('data-theme');
		}

		function persist(choice) {
			if (choice === 'system') {
				try { localStorage.removeItem(K); } catch(e) {}
			} else {
				try { localStorage.setItem(K, choice); } catch(e) {}
			}
		}

		var LABEL = { system: 'System', light: 'Light', dark: 'Dark' };

		function syncPressed(g, choice) {
			g.querySelectorAll('[data-theme-set]').forEach(function(btn){
				btn.setAttribute('aria-pressed', btn.getAttribute('data-theme-set') === choice ? 'true' : 'false');
			});
		}

		// The trigger shows the CURRENT choice: icon via CSS on [data-current], text here.
		function syncLabel(g, choice) {
			var name = LABEL[choice] || LABEL.system;
			var lab = g.querySelector('.tp-lab');
			if (lab) lab.textContent = name;
			var trg = g.querySelector('[data-theme-trigger]');
			if (trg) trg.setAttribute('aria-label', 'Theme: ' + name);
		}

		function setOpen(g, on) {
			var menu = g.querySelector('[data-theme-menu]');
			var trg = g.querySelector('[data-theme-trigger]');
			if (!menu || !trg) return;
			menu.hidden = !on;
			g.setAttribute('data-open', on ? 'true' : 'false');
			trg.setAttribute('aria-expanded', on ? 'true' : 'false');
		}

		function closeMenus(except) {
			groups.forEach(function(g2){ if (g2 !== except) setOpen(g2, false); });
		}

		// Click to open · outside click / Escape to close · choice applies + closes.
		groups.forEach(function(g){
			var trigger = g.querySelector('[data-theme-trigger]');
			var menu = g.querySelector('[data-theme-menu]');
			if (!trigger || !menu) return;

			trigger.addEventListener('click', function(ev){
				ev.stopPropagation();
				var willOpen = g.getAttribute('data-open') !== 'true';
				closeMenus(g);
				setOpen(g, willOpen);
				if (willOpen) {
					var cur = g.getAttribute('data-current') || 'system';
					var sel = menu.querySelector('[data-theme-set="' + cur + '"]') || menu.querySelector('[data-theme-set]');
					// preventScroll, not a plain focus(): the pill lives in a sticky
					// header and the menu opens near the top of the viewport, so a
					// plain focus() scrolls the segment clear of the document's
					// `scroll-padding-top` (--header-h + 20px) — browser-measured as
					// a 19px upward jump at 390px, on every tap. The theme hit this
					// exact bug with its search trigger and fixed it the same way
					// (assets/js/spotlight-search.js: html { scroll-padding-top }
					// v1.0.199, "plain .focus() scrolls the sticky-header trigger
					// into its DOCUMENT position, on Android Chrome this drags the
					// whole page up — browser-verified 257px jump").
					if (sel) sel.focus({ preventScroll: true });
				}
			});

			menu.addEventListener('click', function(ev){
				setOpen(g, false);
				groups.forEach(function(g2){ syncLabel(g2, g2.getAttribute('data-current') || 'system'); });
				// same reason as above: returning focus to the sticky-header trigger
				// must not move the page (WCAG 2.4.3 focus return, no scroll)
				if (ev.isTrusted && trigger) trigger.focus({ preventScroll: true });
			});
		});

		document.addEventListener('click', function(ev){
			groups.forEach(function(g){
				if (!g.contains(ev.target)) setOpen(g, false);
			});
		});

		groups.forEach(function(g){
			g.setAttribute('data-current', t);
			syncPressed(g, t);
			syncLabel(g, t);
		});

		groups.forEach(function(g){
			g.querySelectorAll('[data-theme-set]').forEach(function(btn){
				if (!btn.getAttribute('aria-label')) { btn.setAttribute('aria-label','Theme'); }
				btn.addEventListener('click', function(){
					var pick = btn.getAttribute('data-theme-set');
					groups.forEach(function(g2){
						g2.setAttribute('data-current', pick);
						syncPressed(g2, pick);
					});
					persist(pick);
					paint(pick === 'system' ? ((mq && mq.matches) ? 'dark' : 'light') : pick);
				});
			});
			g.addEventListener('keydown', function(ev){
				var isOpen = g.getAttribute('data-open') === 'true';
				var order = ['system','light','dark'];
				var segs = g.querySelectorAll('[data-theme-set]');
				var cur = g.getAttribute('data-current') || 'system';
				var trigger = g.querySelector('[data-theme-trigger]');
				if (ev.key === 'Escape') {
					if (isOpen) {
						ev.preventDefault();
						setOpen(g, false);
						if (trigger) trigger.focus({ preventScroll: true });
					}
					return;
				}
				var back = (ev.key === 'ArrowLeft' || ev.key === 'ArrowUp');
				var fwd = (ev.key === 'ArrowRight' || ev.key === 'ArrowDown');
				if (!back && !fwd) return;
				ev.preventDefault();
				if (isOpen) {
					// Menu open: arrows move the focus ring only, never the theme.
					var idx = Array.prototype.indexOf.call(segs, document.activeElement);
					if (idx < 0) idx = order.indexOf(cur);
					var step = back ? -1 : 1;
					var next = segs[(idx + step + segs.length) % segs.length];
					if (next) next.focus();
				} else {
					// Menu closed: arrows still cycle the theme (legacy pill behaviour).
					var pick = order[(order.indexOf(cur) + (back ? -1 : 1) + order.length) % order.length];
					var target = g.querySelector('[data-theme-set="' + pick + '"]');
					if (target) target.click();
				}
			});
		});

		function onSys(e) {
			groups.forEach(function(g){
				if ((g.getAttribute('data-current') || 'system') === 'system') {
					paint(e.matches ? 'dark' : 'light');
				}
			});
		}
		if (mq) {
			if (mq.addEventListener) mq.addEventListener('change', onSys);
			else if (mq.addListener) mq.addListener(onSys);
		}
	});
})();
</script>
<style is:inline set:html={fontFaces}></style>
<style is:global>
:root{
  --font:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  --bg:#f7f6f2;--surface:#ffffff;--surface-2:#faf9f6;
  --border:#e4e2dc;--border-dim:#eeece7;
  --text:#0d0d0d;--text-mid:#3a3a3a;--text-dim:#6b6b6b;
  --art-copy:#262626;--art-dim:#3a3a3a;
  --gold:#b45309;--gold-b:#f59e0b;--gold-btn:#b45309;
  --gold-muted:#fef9ee;--gold-border:#fcd97a;--gold-glow:rgba(217,119,6,.22);
  --green:#15803d;--green-btn:#15803d;--green-muted:#f0fdf4;--green-border:#86efac;
  --purple:#7c3aed;--red:#b91c1c;--dark:#0d0b08;
  /* The theme's red badge tokens (style.css:124-125). article.css's verbatim
     .brd rule needs them; the port previously had only --red and its own
     literal-rgba .brd, which is gone now that the theme's rule owns it. */
  --red-muted:#fff1f2;--red-border:#fecdd3;
  --dark-s:#131210;--dark-b:#211f1a;--dark-dim:#8f8575;
  --r-sm:6px;--r-md:10px;--r-lg:16px;--r-xl:24px;--pill:100px;
  --sh-sm:0 1px 3px rgba(0,0,0,.04),0 4px 12px rgba(0,0,0,.05);
  --sh-md:0 2px 8px rgba(0,0,0,.05),0 8px 28px rgba(0,0,0,.08);
  --sh-gold:0 4px 24px rgba(217,119,6,.14);
  --t:160ms ease;--t-md:240ms ease;
  --header-h:64px;--con-pad:48px;--wide:1200px;
}
@media(max-width:1023px){
  :root{--con-pad:28px;--header-h:56px}
}
@media(max-width:767px){
  :root{--con-pad:20px}
}
[data-theme="dark"]{
  --bg:#0d0b08;--surface:#131210;--surface-2:#171512;--surface-3:#1c1a15; /* R1/Q5: 4th warm-black tier for floating panels (Linear surface-ladder doctrine) */
  --text:#f0ede6;--art-copy:#e8e4dc;--art-dim:#8a8070;
  --border:#211f1a;--border-dim:#1d1a16;
  --text-mid:#c4b89a;--text-dim:#8f8575;
  --gold:#f59e0b;--gold-btn:#b45309;
  --gold-muted:rgba(245,158,11,.08);--gold-border:rgba(245,158,11,.25);
  --gold-glow:rgba(245,158,11,.35);
  --green:#22c55e;--green-btn:#15803d;
  --green-muted:rgba(34,197,94,.08);--green-border:rgba(34,197,94,.25);
  --purple:#a78bfa;--red:#f87171;
  --red-muted:rgba(248,113,113,.1);--red-border:rgba(248,113,113,.3);
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{overflow-x:hidden;overflow-x:clip;scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 20px);background:var(--bg)}
body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:16px;line-height:1.6;-webkit-text-size-adjust:100%;overflow-x:hidden;overflow-x:clip;overflow-wrap:break-word}
img{max-width:100%;height:auto}
a{color:inherit}
button{font-family:inherit;font-size:inherit;cursor:pointer;touch-action:manipulation}
a:focus-visible,button:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--gold-btn);outline-offset:2px}
[data-theme="dark"] a:focus-visible,[data-theme="dark"] button:focus-visible,[data-theme="dark"] [tabindex]:focus-visible{outline-color:var(--gold-b)}
::selection{background:var(--gold-b);color:#0d0b08}
[hidden]{display:none!important}
.wrap{width:calc(100% - 32px);max-width:var(--wide);margin-inline:auto}
.skip{position:fixed;top:8px;left:16px;transform:translateY(-200%);background:var(--surface);color:var(--text);z-index:1000;padding:12px 16px;min-height:48px;border:2px solid var(--gold);border-radius:var(--r-sm)}
.skip:focus{transform:none}
.btn:active{transform:translateY(1px)}
.hero>.con{position:relative;z-index:1}
.hero-h .c{color:#f0ede6}
.ledger{width:48px;height:3px;background:var(--gold-b);margin:24px 0 0}
.hero .btn{width:100%;font-size:13px;font-weight:800;border-radius:6px}
.hero .b-gold{background:var(--gold-b);border-color:var(--gold-b);color:#0d0b08}
.hero .b-gold:hover{background:#fbbf24;border-color:#fbbf24;color:#0d0b08;transform:translateY(-1px)}
.hero .b-ghost{border-color:rgba(240,237,230,.35);color:#f0ede6;background:transparent}
.hero .b-ghost:hover{border-color:var(--gold-b);color:var(--gold-b);transform:translateY(-1px)}
.chip{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;border:1px solid #2b2822;background:#171512;color:#f0ede6;border-radius:var(--pill);padding:15px 12px}
.si:last-child .si-n{color:var(--green)}
.feat-img>span:first-child{font-size:56px;line-height:1;color:#f0ede6}
.tile-wm{position:absolute;left:14px;bottom:12px;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.tile-wm.bgn{color:#4ade80}.tile-wm.bg{color:var(--gold-b)}.tile-wm.bpu{color:#a78bfa}.tile-wm.bsl{color:#c4b89a}.tile-wm.brd{color:#f87171}
.bgn{background:var(--green-muted);color:var(--green);border:1px solid var(--green-border)}
.bg{background:var(--gold-muted);color:var(--gold);border:1px solid var(--gold-border)}
.bpu{background:rgba(124,58,237,.1);color:var(--purple);border:1px solid rgba(124,58,237,.3)}
.bsl{background:var(--surface-2);color:var(--text-mid);border:1px solid var(--border)}
/* .brd is the theme's own rule (article.css, style.css:676). The port's
   literal-rgba copy was removed so the verbatim rule, with its
   --red-muted/--red-border tokens, owns the badge. */
.feat-t a{text-decoration:none}

.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--sh-sm);min-width:0;transition:transform var(--t),border-color var(--t)}
.card:hover{transform:translateY(-3px);border-color:var(--gold)}
.card:hover .card-t{color:var(--gold)}
.card-art{position:relative;min-height:120px;display:grid;place-items:center;background:var(--dark)}
.card-art>span:first-child{font-size:40px;line-height:1;color:#f0ede6}
.card-body{padding:16px 20px 20px;display:flex;flex-direction:column;gap:8px;flex:1;min-width:0}
.card-t{font-weight:800;font-size:.9375rem;line-height:1.35;letter-spacing:-.02em;overflow-wrap:anywhere}
.card-t a{text-decoration:none}
.card-ex{font-size:.75rem;line-height:1.65;color:var(--text-mid);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-meta{font-size:10px;color:var(--text-dim);margin-top:auto;padding-top:12px;border-top:1px solid var(--border-dim)}
.nl-h{font-size:1.25rem;font-weight:800;letter-spacing:-.03em}
/* Stub hold */
.hold{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:32px 24px;box-shadow:var(--sh-sm);min-width:0}
.hold h2{font-size:20px;margin-bottom:8px}
.hold-title{font-size:clamp(1.5rem,3.4vw,2rem);font-weight:800;letter-spacing:-.03em;line-height:1.1;overflow-wrap:anywhere}
.hold-title::before{content:"";display:block;width:48px;height:3px;background:var(--gold);margin-bottom:16px}
.hold p{color:var(--text-mid);font-size:15px;max-width:62ch}
.hold ul{margin-top:12px;padding-left:20px;color:var(--text-mid);font-size:15px;display:flex;flex-direction:column;gap:6px}
.phase-tag{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);background:var(--gold-muted);border:1px solid var(--gold-border);border-radius:var(--pill);padding:4px 12px;margin-bottom:12px}
.sg .crumbs a{color:var(--gold)}
/* Phase 3 — articles, search, forms */
/* Article single — the article page's own rules now live in
   src/styles/article.css, copied verbatim from the theme (see
   docs/port/10-article-template.md). What remains here is either shared with
   other pages or port-only:
     .art-sub          — the post subtitle: no WordPress equivalent exists, so
                         it is designed in the theme's idiom (docs/port/08).
     .video-facade — used by the article + about pages. The invented
                         .author-bio/.author-mark/.author-role/.author-text/
                         .author-socials block was removed with the v0.6.2
                         author-archive fix: the real theme vocabulary
                         (.author-head/.author-av/.author-id/.abio-s) now
                         ships verbatim in article.css §30. */
.art-sub{margin-top:24px;margin-bottom:24px;color:var(--text-mid);font-size:1.0625rem;font-weight:300;line-height:1.6;max-width:62ch;border-left:3px solid var(--gold);padding-left:16px}
/* Port-invented prose.css was RETIRED on 2026-09-30: about/contact are now
   faithful live-template ports and need no port-authored prose layer; the
   ported article page gets the theme's .art-body rules from article.css*/
.video-facade{position:relative;display:grid;place-items:center;gap:12px;text-align:center;background:var(--dark);color:#f0ede6;border-radius:var(--r-lg);margin-top:20px;padding:48px 20px;min-height:220px;overflow:hidden}
.video-facade p{font-size:14px;color:#c4b89a}
.video-emoji{font-size:40px;color:var(--gold-b);line-height:1}
/* Search + forms — WP carries NO form margin; the old port's margin-top:20px
   leaked into the theme's .search-pill (rendered 74px vs WP's 54px, found by
   measuring). WP's flex-wrap:wrap is also wrong for the pill (the label +
   button row never wraps inside a 420px pill; it only squeezed the field). */
.search-form{display:flex;align-items:center;gap:8px}
.search-form .form-input{flex:1 1 220px;min-width:0}
.form-input{width:100%;min-height:48px;padding:12px 14px;border-radius:var(--r-md);border:1px solid var(--border);background:var(--surface-2);color:var(--text);font:inherit;font-size:1rem}
.form-input:focus{outline:2px solid var(--gold);outline-offset:1px}
.form-input:disabled{opacity:.6;cursor:not-allowed}
.form-input::placeholder{color:var(--text-dim)}
.nl-form{display:grid;gap:8px;margin-top:16px;grid-template-columns:minmax(0,1fr)}
mark{background:var(--gold-border);color:inherit;border-radius:2px;padding:0 2px}
.result-count{margin-top:16px;font-size:13px;color:var(--text-dim)}
/* Apps */
.app-stats{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.app-stats span{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--pill);padding:4px 10px;color:var(--text-mid)}
.app-stats strong{color:var(--gold)}
.app-links{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.chip[aria-current="page"]{border-color:var(--gold);color:var(--gold-b)}
main{display:block;min-width:0}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(min-width:768px){
  .wrap{width:calc(100% - 64px)}.hero .btn{width:auto}
  /* legal-hero/legal-layout/legal-toc overrides removed: the verbatim §43
     block in pages.css now owns them (196px TOC @ ≥900px, sticky +24px). */
}
@media(min-width:1024px){
  .card-ex{-webkit-line-clamp:3}
}
</style>
</head>
