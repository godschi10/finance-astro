---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { AUTHORS, authorBySlug, allArticles, fmtMonthYear } from "../../data/content";

export async function getStaticPaths() {
  const posts = await allArticles();
  return AUTHORS.map((a) => ({
    params: { slug: a.slug },
    props: {
      posts: posts
        .filter((p) => p.data.authorSlug === a.slug)
        .map((p) => ({
          slug: p.slug,
          title: p.data.title,
          excerpt: p.data.description,
          category: p.data.category,
          date: fmtMonthYear(p.data.pubDate),
          readMins: p.data.readMins,
          author: p.data.author,
        })),
    },
  }));
}

const { slug } = Astro.params;
const { posts } = Astro.props;
const author = authorBySlug(slug ?? "");
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<Layout title={`${author.name} - GWill Finance`} description={`Articles by ${author.name}: ${author.role}. Tested Nigerian finance guides, free to read.`} crumb={author.name}>
<section class="con sg" aria-labelledby="author-h">
  <p class="crumbs"><a href={base}>Home</a> › <a href={`${base}articles/`}>All Articles</a> › {author.name}</p>
  <div class="author-bio" style="margin-top:0">
    <div class="author-mark" aria-hidden="true">₦</div>
    <div>
      <h1 class="hold-title" id="author-h">{author.name}</h1>
      <p class="author-role">{author.role} · {posts.length} {posts.length === 1 ? "guide" : "guides"}</p>
      <p class="author-text">{author.bio}</p>
      <div class="author-socials">
        {Object.entries(author.socials).map(([label, href]) => (
          <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
        ))}
      </div>
    </div>
  </div>
  <div class="g3" style="margin-top:24px">
    {posts.map((p) => (
      <ArticleCard slug={p.slug} title={p.title} excerpt={p.excerpt} category={p.category} date={p.date} readMins={p.readMins} author={p.author} />
    ))}
  </div>
</section>
</Layout>
