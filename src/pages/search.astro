---
import Layout from "../layouts/Layout.astro";
import { CATEGORIES } from "../data/site";
import { TOOLS, allArticles, fmtMonthYear } from "../data/content";

// Faithful port of the theme's search results page (searchform.php +
// template-parts/content.php cards) + the upgraded smart engine
// (scripts/search-core.js — ONE engine shared with the spotlight overlay).
//
// WP's served page (captured 2026-09-27, finance-truth/wp-search-results.html):
//   .phd wrapper: breadcrumbs (Home › Search: {q}, aria-current) +
//     h1 "Search" + p "{n} results for <strong>{q}</strong>"
//   .con: .ad-bg (empty ad slot) + .search-pill.mb24 (max-width:420px)
//     + .g3 of .ac cards (ArticleCard = template-parts/content.php)
//   no-results: p "No results for <strong>{q}</strong>" + .es block
//     (padding:60px 20px): .es-glyph ₦ + h2.es-title "No results found" +
//     p.es-copy + .cp-strip category links + a.btn.b-gold "← Back to Home"
// WP pagination is absent at this corpus size (page-numbers: 0 in the
// capture) — the header count line is the WP contract.
const posts = await allArticles();
const index = {
  articles: posts.map((p) => {
    const c = CATEGORIES.find((x) => x.slug === p.data.category);
    return {
      kind: "article",
      slug: p.slug,
      title: p.data.title,
      desc: p.data.description,
      category: p.data.category,
      categoryName: c?.name ?? "Finance",
      badge: c?.badge ?? "bsl",
      art: c?.art ?? "",
      emoji: c?.emoji ?? "",
      date: fmtMonthYear(p.data.pubDate),
      readMins: p.data.readMins,
      author: p.data.author,
      body: p.body.slice(0, 2000),
    };
  }),
  tools: TOOLS.map((t) => ({ kind: "tool", slug: t.slug, title: t.name, desc: t.desc, category: "tools", categoryName: "Calculator", badge: "bsl", art: "", emoji: "" })),
};
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const initialQ = (Astro.url.searchParams.get("q") ?? "").slice(0, 80);
const catList = CATEGORIES.filter((c) => c.slug !== "uncategorized");
---
<Layout title={`Search${initialQ ? `: ${initialQ}` : ""} - GWill Finance`} description="Search every Nigerian money guide and calculator — instant, on your device, no tracking.">
<section class="phd" aria-labelledby="search-h">
  <nav class="bc" aria-label="Breadcrumb">
    <span class="bc-i"><a href={base}>Home</a></span>
    <span class="bc-s">›</span>
    <span class="bc-i" aria-current="page">{initialQ ? `Search: ${initialQ}` : "Search"}</span>
  </nav>
  <h1 id="search-h">Search</h1>
  <p id="search-count-p">{initialQ ? "Searching…" : "Every guide and calculator, searched on your device."}</p>
</section>
<section class="con" style="margin-top:28px;padding-bottom:48px">
  <div class="ad-bg"></div>
  <div class="search-pill mb24" style="max-width:420px">
    <form role="search" aria-label="Site search" method="get" class="search-form" action={`${base}search/`}>
      <label class="search-label">
        <span class="screen-reader-text">Search for:</span>
        <svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <input type="search" class="search-field" value={initialQ} name="s" id="search-input" placeholder="Search articles…">
      </label>
      <button type="submit" class="search-submit" aria-label="Submit search"><span>Search</span></button>
    </form>
  </div>
  <div class="cp-strip-wrap" style="margin-bottom:24px" role="group" aria-label="Filter by section">
    <div class="cp-strip">
      <button type="button" class="cp on" data-scat="" aria-pressed="true">Everything</button>
      {catList.map((c) => (<button type="button" class="cp" data-scat={c.slug} aria-pressed="false">{c.name}</button>))}
      <button type="button" class="cp" data-scat="tools" aria-pressed="false">Calculators</button>
    </div>
  </div>
  <div class="g3" id="search-results-grid"></div>
  <div id="search-empty" hidden>
    <div class="es" style="padding:60px 20px">
      <div class="es-glyph" aria-hidden="true">₦</div>
      <h2 class="es-title" style="margin-top:0">No results found</h2>
      <p class="es-copy">Nothing matched your search. Try a different keyword, or browse the categories below.</p>
      <div class="cp-strip">
        {catList.map((c) => (<a class="cp" href={`${base}category/${c.slug}/`}>{c.name}</a>))}
      </div>
      <a class="btn b-gold" href={base}>← Back to Home</a>
    </div>
  </div>
  <script type="application/json" id="search-index" set:html={JSON.stringify(index).replace(/</g, "\\u003c")}></script>
</section>
<script>
  import "../scripts/search-results.js";
</script>
</Layout>
