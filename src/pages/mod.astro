---
/**
 * /mod/ — the comments moderation desk (King's order, 2026-09-26).
 *
 * Talks directly to the comments-api Worker (Bearer ADMIN_TOKEN) via the
 * /api/moderation/* endpoints. Built on the AndroidScroll-proven desk laws:
 *   - one unlock gate, never a second token form inside an unlocked view
 *   - tabs Overview | Queue | All Comments; Overview is default
 *   - stat tiles that map to a section are BUTTONS (PENDING→Queue,
 *     APPROVED/SPAM/TRASH→All pre-filtered)
 *   - action buttons derive from row.status, never a fixed template
 *     (an APPROVED row shows no Approve)
 *   - reply-as-author auto-publishes (the desk is the author's own console)
 *   - rows labelled by POST NAME with a real link (+ #comment-<id>)
 *   - trash is terminal-capable ("Delete forever", two-tap inline confirm,
 *     never native confirm()); hard delete only from trash
 *   - token persisted in localStorage (sessionStorage fallback); empty
 *     unlock reuses the saved token, never wipes it; phone-restore re-reads
 *     the jar on pageshow + visibilitychange
 *   - version stamp on the lock form
 *   - 44px touch targets, text-cage laws, no horizontal scrollers
 */
import Layout from "../layouts/Layout.astro";

const DESK_VERSION = "desk v1 · 2026-09-26";
const COMMENTS_API = "https://comments-api.gwill.workers.dev";

/** slug -> post title (the site's own inventory, never invented). */
const POST_NAMES = {
  "grey-vs-geegpay-dollar-account": "Grey vs Geegpay: Which Dollar Account Should You Open?",
  "piggyvest-vs-cowrywise-2026": "PiggyVest vs Cowrywise in 2026: Which Saves You More?",
  "cheapest-way-receive-dollars-nigeria": "Cheapest Way to Receive Dollars in Nigeria (2026 Compared)",
  "ngn-dollar-cost-averaging-guide": "Dollar-Cost Averaging Into NGX Stocks on a ₦50k Salary",
  "kuda-vs-traditional-banks-charges": "Kuda vs Traditional Banks: The Real Cost of Free Transfers",
  "p2p-crypto-nigeria-safely": "How to Buy Crypto P2P in Nigeria Without Getting Scammed",
  "emergency-fund-naira-inflation": "How Much Emergency Fund Do You Need With Naira Inflation?",
  "gutenberg-elements-showcase": "Gutenberg Elements Showcase",
};
---

<Layout title="Comments desk — GWill Finance" description="Moderation desk." noCanonical={true}>
  <style>
    /* Desk styles — theme tokens only, so light/dark both work. */
    .mod-wrap { max-width: 860px; margin: 0 auto; padding: 32px var(--con-pad) 64px; }
    .mod-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .mod-head h1 { font-size: 1.25rem; letter-spacing: -0.02em; margin: 0; }
    .mod-stamp { color: var(--text-dim); font-size: 11px; }
    .mod-status { color: var(--text-mid); font-size: 12px; min-height: 18px; margin: 8px 0 0; overflow-wrap: anywhere; }
    .mod-status.err { color: var(--red, #b91c1c); }
    .mod-lock { max-width: 420px; margin: 48px auto 0; border: 1px solid var(--border); border-radius: var(--r-lg); padding: 28px; background: var(--surface); box-shadow: var(--sh-sm); }
    .mod-lock h2 { font-size: 1rem; margin: 0 0 6px; }
    .mod-lock p { color: var(--text-mid); font-size: 13px; margin: 0 0 16px; }
    .mod-lock input {
      width: 100%; box-sizing: border-box; font: inherit; font-size: 13px;
      padding: 12px 14px; border-radius: var(--r-md); border: 1px solid var(--border);
      background: var(--surface-2); color: var(--text);
    }
    .mod-lock .btn { width: 100%; justify-content: center; margin-top: 12px; padding: 12px 20px; }
    .mod-tabs { display: flex; gap: 8px; margin: 20px 0 16px; flex-wrap: wrap; }
    .mod-tab {
      font: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
      min-height: 44px; padding: 0 16px; display: inline-flex; align-items: center;
      border-radius: var(--pill); border: 1px solid var(--border);
      background: transparent; color: var(--text-mid);
    }
    .mod-tab[aria-selected="true"] { background: var(--gold-muted); border-color: var(--gold-border); color: var(--gold); }
    .mod-tab:hover { border-color: var(--gold); color: var(--gold); }
    .mod-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
    .mod-tile {
      text-align: left; cursor: pointer; border: 1px solid var(--border);
      border-radius: var(--r-md); padding: 14px 16px; background: var(--surface);
      display: flex; flex-direction: column; gap: 2px; min-height: 44px;
    }
    .mod-tile:hover { border-color: var(--gold); }
    .mod-tile .n { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; color: var(--gold); }
    .mod-tile .l { font-size: 11px; color: var(--text-mid); text-transform: uppercase; letter-spacing: 0.06em; }
    .mod-tile .go { font-size: 11px; color: var(--text-dim); margin-top: 4px; }
    .mod-sec { margin-top: 24px; }
    .mod-sec h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-mid); margin: 0 0 10px; }
    .mod-post { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--border-dim); }
    .mod-post a { color: var(--text); text-decoration: none; min-width: 0; overflow-wrap: anywhere; }
    .mod-post a:hover { color: var(--gold); }
    .mod-post .c { color: var(--text-dim); font-size: 12px; white-space: nowrap; }
    .mod-item { border: 1px solid var(--border); border-radius: var(--r-md); padding: 14px 16px; margin: 12px 0; background: var(--surface); }
    .mod-item-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .mod-item-head > * { min-width: 0; }
    .mod-item-head .who { font-weight: 700; }
    .mod-item-head .where { overflow-wrap: anywhere; }
    .mod-item-head .where a { color: var(--gold); text-decoration: none; }
    .mod-item-head .where a:hover { text-decoration: underline; }
    .mod-meta { color: var(--text-dim); font-size: 11px; white-space: normal; overflow-wrap: anywhere; }
    .mod-body { margin: 10px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; color: var(--text); }
    .mod-chip { display: inline-block; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: var(--pill); border: 1px solid var(--border); color: var(--text-mid); }
    .mod-chip.pending { border-color: var(--gold-border); color: var(--gold); background: var(--gold-muted); }
    .mod-chip.spam { border-color: var(--red-border, #fecdd3); color: var(--red, #b91c1c); background: var(--red-muted, #fff1f2); }
    .mod-chip.trash { border-color: var(--border); color: var(--text-dim); text-decoration: line-through; }
    .mod-chip.approved { border-color: var(--green-border, #86efac); color: var(--green, #15803d); background: var(--green-muted, #f0fdf4); }
    .mod-acts { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
    .mod-act {
      font: inherit; font-size: 12px; font-weight: 700; cursor: pointer;
      min-height: 44px; padding: 0 14px; display: inline-flex; align-items: center;
      border-radius: var(--pill); border: 1px solid var(--border); background: transparent; color: var(--text-mid);
    }
    .mod-act:hover { border-color: var(--text-dim); color: var(--text); }
    .mod-act.primary { background: var(--gold-btn); border-color: var(--gold-btn); color: #fff; }
    .mod-act.primary:hover { background: #92400e; color: #fff; }
    .mod-act.danger { border-color: var(--red-border, #fecdd3); color: var(--red, #b91c1c); }
    .mod-act.danger:hover { border-color: var(--red, #b91c1c); color: var(--red, #b91c1c); }
    .mod-act[disabled] { opacity: 0.5; cursor: default; }
    .mod-reply { margin-top: 12px; display: none; }
    .mod-reply textarea {
      width: 100%; box-sizing: border-box; font: inherit; font-size: 13px;
      min-height: 76px; padding: 10px 12px; border-radius: var(--r-md);
      border: 1px solid var(--border); background: var(--surface-2); color: var(--text); resize: vertical;
    }
    .mod-note { font-size: 12px; color: var(--green, #15803d); margin-top: 8px; }
    .mod-filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 4px; }
    .mod-filters input[type="search"] {
      -webkit-appearance: none; appearance: none; font: inherit; font-size: 13px;
      min-height: 44px; padding: 0 14px; border-radius: var(--pill);
      border: 1px solid var(--border); background: var(--surface-2); color: var(--text);
      flex: 1; min-width: 180px; max-width: 320px;
    }
    .mod-empty { color: var(--text-dim); font-size: 13px; padding: 24px 0; }
    .mod-pager { display: flex; gap: 8px; margin-top: 16px; }
    [hidden] { display: none !important; }
  </style>

  <div class="mod-wrap con">
    <header class="mod-head">
      <h1>Comments desk</h1>
      <span class="mod-stamp" id="mod-stamp">{DESK_VERSION}</span>
    </header>
    <p class="mod-status" id="mod-status"></p>

    <!-- ── the ONE gate ─────────────────────────────────────────────── -->
    <section class="mod-lock" id="mod-lock" hidden>
      <h2>Unlock the desk</h2>
      <p>Enter the moderation token. It is stored on this device only.</p>
      <form id="mod-unlock">
        <input type="password" id="mod-token" autocomplete="current-password"
               placeholder="Moderation token" aria-label="Moderation token" />
        <button class="btn b-gold" type="submit">Unlock</button>
      </form>
      <p class="mod-stamp" style="margin:14px 0 0">{DESK_VERSION}</p>
    </section>

    <!-- ── the desk (hidden until unlocked) ─────────────────────────── -->
    <section id="mod-desk" hidden>
      <div class="mod-tabs" role="tablist" aria-label="Desk sections">
        <button class="mod-tab" role="tab" id="tab-overview" aria-selected="true" data-tab="overview">Overview</button>
        <button class="mod-tab" role="tab" id="tab-queue" aria-selected="false" data-tab="queue">Queue</button>
        <button class="mod-tab" role="tab" id="tab-all" aria-selected="false" data-tab="all">All Comments</button>
      </div>

      <div id="mod-view-overview" class="mod-view" role="tabpanel" aria-labelledby="tab-overview">
        <div class="mod-tiles" id="mod-tiles"></div>
        <div class="mod-sec">
          <h3>Most commented</h3>
          <div id="mod-posts"></div>
        </div>
      </div>

      <div id="mod-view-queue" class="mod-view" role="tabpanel" aria-labelledby="tab-queue" hidden>
        <div id="mod-queue"></div>
      </div>

      <div id="mod-view-all" class="mod-view" role="tabpanel" aria-labelledby="tab-all" hidden>
        <div class="mod-filters">
          <button class="mod-tab" data-filter="pending">Pending</button>
          <button class="mod-tab" data-filter="approved">Approved</button>
          <button class="mod-tab" data-filter="spam">Spam</button>
          <button class="mod-tab" data-filter="trash">Trash</button>
          <button class="mod-tab" data-filter="all">All</button>
          <input type="search" id="mod-search" placeholder="Filter loaded page…" aria-label="Filter comments" />
        </div>
        <div id="mod-all"></div>
        <div class="mod-pager" id="mod-pager"></div>
      </div>

      <div class="mod-sec">
        <button class="mod-act" id="mod-signout">Sign out</button>
      </div>
    </section>
  </div>

  <script define:vars={{ COMMENTS_API, POST_NAMES, DESK_VERSION, base: import.meta.env.BASE_URL }}>
    (function () {
      "use strict";
      var JAR = "gwill-mod-token";
      var status = document.getElementById("mod-status");
      var lock = document.getElementById("mod-lock");
      var desk = document.getElementById("mod-desk");
      var token = null;

      function say(msg, err) {
        status.textContent = msg || "";
        status.className = "mod-status" + (err ? " err" : "");
      }

      function readJar() {
        try { return localStorage.getItem(JAR) || sessionStorage.getItem(JAR) || ""; }
        catch (e) { return ""; }
      }
      function writeJar(t) {
        try { localStorage.setItem(JAR, t); sessionStorage.setItem(JAR, t); } catch (e) {}
      }
      function clearJar() {
        try { localStorage.removeItem(JAR); sessionStorage.removeItem(JAR); } catch (e) {}
      }

      function api(path, opts) {
        opts = opts || {};
        opts.headers = Object.assign({ "Authorization": "Bearer " + token }, opts.headers || {});
        return fetch(COMMENTS_API + path, opts).then(function (r) {
          if (r.status === 401) { throw { unauthorized: true }; }
          return r.json();
        });
      }

      /* ── row rendering ───────────────────────────────────────────── */
      function postName(slug) {
        return POST_NAMES[slug] || slug;
      }
      function postUrl(slug, id) {
        return base + "articles/" + slug + "/" + (id ? "#comment-" + id : "");
      }
      function esc(s) {
        return String(s == null ? "" : s)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }
      function rowEl(c) {
        var el = document.createElement("article");
        el.className = "mod-item";
        el.setAttribute("data-id", c.id);
        var rx = c.reactions || {};
        var rxt = ["like", "heart", "fire", "laugh"]
          .filter(function (k) { return rx[k] > 0; })
          .map(function (k) { return rx[k] + " " + k; })
          .join(" · ");
        el.innerHTML =
          '<div class="mod-item-head">' +
            '<span class="who">' + esc(c.author) + "</span>" +
            '<span class="where"><a href="' + esc(postUrl(c.post_slug, c.id)) + '" target="_blank" rel="noopener">' +
              esc(postName(c.post_slug)) + "</a></span>" +
            '<span class="mod-chip ' + esc(c.status) + '">' + esc(c.status) + "</span>" +
          "</div>" +
          '<p class="mod-meta">' + esc(c.created) + " · spam " + c.spam_score + "%" + (rxt ? " · " + esc(rxt) : "") +
            (c.parent_id ? " · reply to #" + c.parent_id : "") + "</p>" +
          '<p class="mod-body">' + esc(c.content) + "</p>" +
          '<div class="mod-acts"></div>' +
          '<div class="mod-reply">' +
            '<textarea aria-label="Reply as G-will Chijioke" placeholder="Reply as G-will Chijioke…"></textarea>' +
            '<div class="mod-acts" style="margin-top:8px">' +
              '<button class="mod-act primary" data-act="post-reply">Post Reply</button>' +
              '<button class="mod-act" data-act="close-reply">Cancel</button>' +
            "</div>" +
            '<p class="mod-note" hidden></p>' +
          "</div>";
        buildActions(el, c);
        return el;
      }

      /* Action matrix — derived from row.status, never a fixed template. */
      function buildActions(el, c) {
        var acts = el.querySelector(".mod-acts");
        acts.innerHTML = "";
        function add(label, cls, act, onlick) {
          var b = document.createElement("button");
          b.className = "mod-act " + (cls || "");
          b.setAttribute("data-act", act);
          b.textContent = label;
          b.addEventListener("click", onlick);
          acts.appendChild(b);
          return b;
        }
        if (c.status === "pending") {
          add("Approve", "primary", "approve", function () { doAction(el, c, "approve"); });
          add("Spam", "", "spam", function () { doAction(el, c, "spam"); });
          add("Trash", "danger", "trash", function () { doAction(el, c, "trash"); });
        } else if (c.status === "approved") {
          add("Spam", "", "spam", function () { doAction(el, c, "spam"); });
          add("Trash", "danger", "trash", function () { doAction(el, c, "trash"); });
        } else if (c.status === "spam") {
          add("Approve", "primary", "approve", function () { doAction(el, c, "approve"); });
          add("Trash", "danger", "trash", function () { doAction(el, c, "trash"); });
        } else if (c.status === "trash") {
          add("Restore", "primary", "restore", function () { doAction(el, c, "restore"); });
          /* Two-tap inline confirm — never native confirm(). */
          var del = add("Delete forever", "danger", "delete", function () {
            if (del.dataset.armed !== "1") {
              del.dataset.armed = "1";
              del.textContent = "Tap again to delete forever";
              setTimeout(function () {
                del.dataset.armed = "";
                del.textContent = "Delete forever";
              }, 4000);
              return;
            }
            doAction(el, c, "delete");
          });
        }
        if (c.status === "pending" || c.status === "approved") {
          add("Reply", "", "reply", function () {
            var box = el.querySelector(".mod-reply");
            var open = box.style.display === "block";
            box.style.display = open ? "none" : "block";
            if (!open) box.querySelector("textarea").focus();
          });
        }
      }

      function doAction(el, c, action) {
        say((action === "delete" ? "Deleting" : action + "ing") + " #" + c.id + "…");
        el.querySelectorAll(".mod-act").forEach(function (b) { b.disabled = true; });
        api("/api/moderation/action", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: c.id, action: action }),
        }).then(function (res) {
          if (!res.success) throw new Error(res.data && res.data.error || "failed");
          say("Done: " + action + " #" + c.id + ".");
          if (action === "delete") { el.remove(); }
          else {
            var chip = el.querySelector(".mod-chip");
            var next = action === "approve" || action === "restore" ? "approved"
                     : action === "spam" ? "spam" : "trash";
            chip.className = "mod-chip " + next;
            chip.textContent = next;
            c.status = next;
            buildActions(el, c);
            el.querySelectorAll(".mod-act").forEach(function (b) { b.disabled = false; });
          }
          loadStats();
          refreshVisible();
        }).catch(function (e) {
          if (e && e.unauthorized) return bounced();
          el.querySelectorAll(".mod-act").forEach(function (b) { b.disabled = false; });
          say("Action failed: " + (e.message || "error"), true);
        });
      }

      /* Reply-as-author: desk Bearer → auto-approved. */
      document.addEventListener("click", function (ev) {
        var t = ev.target;
        if (!(t && t.getAttribute && t.getAttribute("data-act") === "post-reply")) return;
        var item = t.closest(".mod-item");
        var ta = item.querySelector(".mod-reply textarea");
        var note = item.querySelector(".mod-note");
        var id = parseInt(item.getAttribute("data-id"), 10);
        var content = (ta.value || "").trim();
        if (!content) { note.hidden = false; note.textContent = "Write something first."; note.style.color = "var(--red,#b91c1c)"; return; }
        t.disabled = true;
        api("/api/moderation/reply", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ parent_id: id, content: content }),
        }).then(function (res) {
          if (!res.success) throw new Error(res.data && res.data.error || "failed");
          note.hidden = false;
          note.style.color = "";
          note.textContent = "Posted as " + res.data.comment.author + " — approved and live.";
          ta.value = "";
          t.disabled = false;
          loadStats();
        }).catch(function (e) {
          if (e && e.unauthorized) return bounced();
          t.disabled = false;
          note.hidden = false;
          note.style.color = "var(--red,#b91c1c)";
          note.textContent = "Reply failed: " + (e.message || "error");
        });
      });
      document.addEventListener("click", function (ev) {
        var t = ev.target;
        if (t && t.getAttribute && t.getAttribute("data-act") === "close-reply") {
          var box = t.closest(".mod-reply");
          box.style.display = "none";
        }
      });

      /* ── data loading ────────────────────────────────────────────── */
      function loadStats() {
        return api("/api/moderation/stats").then(function (res) {
          if (!res.success) throw new Error("stats failed");
          var d = res.data;
          var tiles = document.getElementById("mod-tiles");
          tiles.innerHTML = "";
          [
            { n: d.stats.pending, l: "Pending", go: "Review the queue →", tab: "queue", filter: null },
            { n: d.stats.approved, l: "Approved", go: "Open all comments →", tab: "all", filter: "approved" },
            { n: d.stats.spam, l: "Spam", go: "Open all comments →", tab: "all", filter: "spam" },
            { n: d.stats.trash, l: "Trash", go: "Open all comments →", tab: "all", filter: "trash" },
            { n: d.reactions, l: "Reactions", go: null, tab: null, filter: null },
          ].forEach(function (t) {
            var b = document.createElement("button");
            b.className = "mod-tile";
            b.type = "button";
            b.innerHTML = '<span class="n">' + t.n + "</span>" +
              '<span class="l">' + esc(t.l) + "</span>" +
              (t.go ? '<span class="go">' + t.go + "</span>" : "");
            if (t.tab) b.addEventListener("click", function () {
              setTab(t.tab);
              if (t.filter) { allFilter = t.filter; syncFilterPills(); }
              refreshVisible();
            });
            tiles.appendChild(b);
          });
          var posts = document.getElementById("mod-posts");
          posts.innerHTML = d.posts.length ? "" : '<p class="mod-empty">No approved comments yet.</p>';
          d.posts.forEach(function (p) {
            var row = document.createElement("div");
            row.className = "mod-post";
            row.innerHTML = '<a href="' + esc(postUrl(p.slug)) + '" target="_blank" rel="noopener">' +
              esc(postName(p.slug)) + "</a>" +
              '<span class="c">' + p.comments + "</span>";
            posts.appendChild(row);
          });
        });
      }

      function loadList(kind, status, page, search) {
        var host = document.getElementById(kind === "queue" ? "mod-queue" : "mod-all");
        host.innerHTML = '<p class="mod-empty">Loading…</p>';
        var q = "?status=" + encodeURIComponent(status) + "&page=" + page + "&per_page=25";
        return api("/api/moderation/list" + q).then(function (res) {
          if (!res.success) throw new Error(res.data && res.data.error || "list failed");
          var rows = res.data.comments;
          if (search) {
            var s = search.toLowerCase();
            rows = rows.filter(function (c) {
              return (c.author + " " + c.content + " " + c.post_slug).toLowerCase().indexOf(s) !== -1;
            });
          }
          host.innerHTML = rows.length ? "" : '<p class="mod-empty">Nothing here.</p>';
          rows.forEach(function (c) { host.appendChild(rowEl(c)); });
          var pager = document.getElementById("mod-pager");
          if (kind === "all") {
            pager.innerHTML = "";
            if (page > 1) {
              var prev = document.createElement("button");
              prev.className = "mod-act"; prev.textContent = "← Previous";
              prev.addEventListener("click", function () { allPage = page - 1; refreshVisible(); });
              pager.appendChild(prev);
            }
            if (res.data.has_more) {
              var next = document.createElement("button");
              next.className = "mod-act"; next.textContent = "Next →";
              next.addEventListener("click", function () { allPage = page + 1; refreshVisible(); });
              pager.appendChild(next);
            }
          }
        });
      }

      /* ── tabs ────────────────────────────────────────────────────── */
      var TABS = ["overview", "queue", "all"];
      var current = "overview";
      var allFilter = "all";
      var allPage = 1;

      function setTab(name) {
        if (TABS.indexOf(name) === -1) name = "overview";
        current = name;
        TABS.forEach(function (t) {
          document.getElementById("tab-" + t).setAttribute("aria-selected", String(t === name));
          document.getElementById("mod-view-" + t).hidden = t !== name;
        });
        try { history.replaceState(null, "", "#/" + name); } catch (e) {}
      }
      function refreshVisible() {
        if (current === "overview") return loadStats();
        if (current === "queue") return loadList("queue", "pending", 1);
        return loadList("all", allFilter, allPage,
          (document.getElementById("mod-search").value || "").trim());
      }
      function syncFilterPills() {
        document.querySelectorAll("[data-filter]").forEach(function (b) {
          b.setAttribute("aria-selected", String(b.getAttribute("data-filter") === allFilter));
        });
      }

      TABS.forEach(function (t) {
        document.getElementById("tab-" + t).addEventListener("click", function () {
          setTab(t); refreshVisible();
        });
      });
      document.querySelectorAll("[data-filter]").forEach(function (b) {
        b.addEventListener("click", function () {
          allFilter = b.getAttribute("data-filter");
          allPage = 1;
          syncFilterPills();
          setTab("all");
          refreshVisible();
        });
      });
      var searchBox = document.getElementById("mod-search");
      var searchTimer = null;
      searchBox.addEventListener("input", function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () {
          if (current === "all") refreshVisible();
        }, 200);
      });

      /* ── the gate ────────────────────────────────────────────────── */
      var unlocked = false;
      function unlock(withToken) {
        token = withToken;
        say("Unlocking…");
        api("/api/moderation/stats").then(function (res) {
          if (!res.success) throw new Error("rejected");
          unlocked = true;
          writeJar(withToken);
          lock.hidden = true;
          desk.hidden = false;
          say("");
          var hash = (location.hash || "").replace(/^#\/?/, "");
          setTab(TABS.indexOf(hash) !== -1 ? hash : "overview");
          return refreshVisible();
        }).catch(function (e) {
          token = null;
          if (e && e.unauthorized) {
            say("That token was rejected. Sign out and in again with a valid token.", true);
          } else {
            say("Could not reach the comments API. Check your connection and retry.", true);
          }
          lock.hidden = false;
          desk.hidden = true;
        });
      }
      function bounced() {
        unlocked = false;
        token = null;
        clearJar();
        lock.hidden = false;
        desk.hidden = true;
        say("Session rejected — sign out and in again.", true);
      }

      document.getElementById("mod-unlock").addEventListener("submit", function (ev) {
        ev.preventDefault();
        /* Empty submit reuses the saved token — never wipes it. */
        var t = (document.getElementById("mod-token").value || "").trim() || readJar();
        if (!t) { say("Enter the moderation token.", true); return; }
        unlock(t);
      });
      document.getElementById("mod-signout").addEventListener("click", function () {
        clearJar();
        token = null;
        unlocked = false;
        desk.hidden = true;
        lock.hidden = false;
        document.getElementById("mod-token").value = "";
        say("Signed out.");
      });

      /* Phone-restore: the OS can kill the renderer and wake the page with
         dead sessionStorage but the DOM snapshot intact — re-read the
         persistent jar on pageshow + visibilitychange and walk straight in. */
      function maybeRestore() {
        if (unlocked) return;
        var saved = readJar();
        if (saved) unlock(saved);
      }
      window.addEventListener("pageshow", maybeRestore);
      document.addEventListener("visibilitychange", maybeRestore);

      /* Boot: saved token walks straight in; otherwise show the gate. */
      (function boot() {
        var saved = readJar();
        if (saved) { unlock(saved); return; }
        lock.hidden = false;
        say("");
      })();
    })();
  </script>
</Layout>
