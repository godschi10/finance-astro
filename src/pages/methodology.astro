<Layout title="Methodology - GWill Finance" description="How GWill Finance works: what the calculators are and are not, where the rates come from, how every number is verified, and how reviews and ratings are formed." crumb="Methodology">
<section class="legal-hero">
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="con legal-hero-inner">
    <nav class="gwill-breadcrumbs" aria-label="Breadcrumb">
      <ol class="gwill-breadcrumbs__list">
