---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Newsletter - GWill Finance" description="Nigerian money news, weekly. Email signup lands with Phase 2." crumb="Newsletter">
<section class="con sg" aria-labelledby="nlpage-h">
<p class="crumbs" style="color:var(--text-dim);font-size:12px;margin-bottom:16px"><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/`} style="color:var(--gold)">Home</a> › Newsletter</p>
<div class="hold">
<span class="phase-tag">Lands with Phase 2</span>
<h1 class="hold-title" id="nlpage-h">Nigerian money news, weekly.</h1>
<p style="margin-top:8px">Rate changes, app reviews, and the financial moves worth making. Free, no spam, unsubscribe anytime. The email capture form lands with Phase 2 together with the delivery endpoint — there is deliberately no email field on this page yet, because a form that cannot subscribe you would be a fake control.</p>
<p style="margin-top:12px"><a class="slink" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/`}>← Back to the homepage</a></p>
</div>
</section>
</Layout>
