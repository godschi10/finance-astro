---
import Layout from "../layouts/Layout.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<Layout title="Newsletter - GWill Finance" description="Nigerian money news, weekly. The list opens at launch — see what you will get." crumb="Newsletter">
<section class="con sg" aria-labelledby="nlpage-h">
  <p class="crumbs"><a href={base}>Home</a> › Newsletter</p>
  <div class="nl-s" style="margin-top:8px">
    <div class="nl-copy">
      <span class="phase-tag">Launching soon — no list yet</span>
      <h1 class="nl-h" id="nlpage-h">Nigerian money news, weekly.</h1>
      <p>Rate changes, app reviews, and the financial moves worth making. Free, no spam, unsubscribe anytime.</p>
      <div class="nl-meta"><span>✓ Free</span><span class="dot" aria-hidden="true"></span><span>✓ No spam</span><span class="dot" aria-hidden="true"></span><span>✓ Unsubscribe anytime</span></div>
    </div>
    <div aria-label="Newsletter signup (not yet open)">
      <p style="color:#c4b89a;font-size:15px">Delivery is being wired to a proper email service — there is deliberately no email field here yet, because a form that cannot subscribe you would be a fake control.</p>
      <form class="nl-form" aria-hidden="true" onsubmit="return false">
        <label class="sr-only" for="nl-email">Email address</label>
        <input class="form-input" id="nl-email" type="email" placeholder="you@example.com" disabled aria-disabled="true" tabindex="-1">
        <button class="btn b-gold b-sm" type="button" disabled aria-disabled="true" tabindex="-1">Notify me — soon</button>
      </form>
      <p style="margin-top:12px"><a class="slink" href={`${base}articles/`}>Read the guides meanwhile →</a></p>
    </div>
  </div>
</section>
</Layout>
