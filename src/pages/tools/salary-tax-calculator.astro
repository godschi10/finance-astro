---
import ToolShell from "../../components/ToolShell.astro";
import { payeCalculate, payeCompare, payeBandBreakdown, payeBands2026, MINIMUM_WAGE_MONTHLY } from "../../lib/salary-tax";
import { formatGrouped } from "../../lib/format";
const n = (v: number, d = 0) => formatGrouped(v, d);
const seed = payeCalculate(300000, 0.08, 0, 0, true);
const cmp = payeCompare(300000, 0.08, 0, 0);
const bands = payeBandBreakdown(seed.taxable, payeBands2026());
---
<ToolShell title="Salary Tax Calculator, NTA 2026 vs Old Bands - GWill Finance" description="Nigerian PAYE under the NTA 2026 bands vs the old Finance Act bands: rent relief, minimum-wage exemption, old-vs-new comparison." slug="salary-tax-calculator" tool="Salary-Tax Calculator" lede="2026 bands (0% under ₦800k, then 15–25%) against the old 7–24% — with 20% rent relief and the ₦70k minimum-wage exemption." verified="NTA 2026 bands · rent relief capped ₦500k · exemption ≤ ₦70,000/mo" faqs={[
  { q: "Who pays zero PAYE?", a: "Anyone earning at or below the ₦70,000 monthly minimum wage is exempt under the new bands, though pension still applies." },
  { q: "How does rent relief work?", a: "20% of annual rent reduces taxable income, capped at ₦500,000 a year. Keep rent receipts." },
  { q: "Old vs new — who wins?", a: "Almost everyone up to executive pay wins under 2026 bands. Enter your salary and the comparison card shows your exact saving." },
]}>
<div class="tgrid c3">
<div class="field"><label for="st-gross">Monthly gross ₦</label><input id="st-gross" type="number" min="0" step="any" value="300000" inputmode="decimal"></div>
<div class="field"><label for="st-pension">Pension %</label><input id="st-pension" type="number" min="0" max="100" step="any" value="8" inputmode="decimal"></div>
<div class="field"><label for="st-rent">Annual rent ₦</label><input id="st-rent" type="number" min="0" step="any" value="0" inputmode="decimal"></div>
<div class="field"><label for="st-nhf">NHF monthly ₦</label><input id="st-nhf" type="number" min="0" step="any" value="0" inputmode="decimal"></div>
<div class="field"><label for="st-nhis">NHIS monthly ₦</label><input id="st-nhis" type="number" min="0" step="any" value="0" inputmode="decimal"></div>
<div class="field"><label for="st-life">Life assurance monthly ₦</label><input id="st-life" type="number" min="0" step="any" value="0" inputmode="decimal"></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Take-home monthly</p>
<p class="receipt-fig" id="st-fig">₦{n(seed.net_monthly)}</p>
<p class="receipt-sub" id="st-sub">Tax ₦{n(seed.tax_monthly)}/mo · taxable ₦{n(seed.taxable)}/yr{seed.exempt ? " · EXEMPT (minimum wage)" : ""}</p>
<div class="receipt-div" aria-hidden="true"></div>
<div id="st-rows">
<div class="receipt-row"><span>Pension (annual)</span><b id="st-pen">₦{n(seed.pension_annual)}</b></div>
<div class="receipt-row"><span>Rent relief (annual)</span><b id="st-rel">₦{n(seed.relief_annual)}</b></div>
<div class="receipt-row"><span>PAYE tax (annual)</span><b id="st-tax">₦{n(seed.tax_annual)}</b></div>
</div>
<p class="receipt-foot">NTA 2026 bands · rent relief cap ₦500k</p>
</div>
<div class="hr"></div>
<h2 class="tool-h2">Old vs new bands</h2>
<div class="st-wrap"><table class="st" id="st-cmp">
<thead><tr><th>Regime</th><th class="n">Tax /yr</th><th class="n">Take-home /mo</th></tr></thead>
<tbody>
<tr class="win"><td>New (2026)<span class="btag">Best</span></td><td class="n" id="st-new-tax">₦{n(cmp.new.tax_annual)}</td><td class="n" id="st-new-net">₦{n(cmp.new.net_monthly)}</td></tr>
<tr><td>Old (Finance Act)</td><td class="n" id="st-old-tax">₦{n(cmp.old.tax_annual)}</td><td class="n" id="st-old-net">₦{n(cmp.old.net_monthly)}</td></tr>
</tbody>
</table></div>
<p class="bar-note" id="st-save">You keep ₦{n(cmp.save_monthly)}/mo more under the new bands.</p>
<div class="hr"></div>
<h2 class="tool-h2">2026 band breakdown</h2>
<div class="st-wrap"><table class="st" id="st-bands">
<thead><tr><th>Band</th><th class="n">Rate</th><th class="n">Slice ₦</th><th class="n">Tax ₦</th></tr></thead>
<tbody>
{bands.map((b) => (
<tr><td>₦{n(b.low)}{b.high === null ? "+" : ` – ₦${n(b.high)}`}</td><td class="n">{(b.rate * 100).toFixed(0)}%</td><td class="n">₦{n(b.slice)}</td><td class="n">₦{n(b.tax)}</td></tr>
))}
</tbody>
</table></div>
</ToolShell>
<script>
import { payeCalculate, payeCompare, payeBandBreakdown, payeBands2026 } from "../../lib/salary-tax";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => "₦" + formatGrouped(v, 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
function render() {
  const gross = Math.max(0, Number(g("st-gross").value) || 0);
  const pen = Math.min(100, Math.max(0, Number(g("st-pension").value) || 0)) / 100;
  const rent = Math.max(0, Number(g("st-rent").value) || 0);
  const nhf = Math.max(0, Number(g("st-nhf").value) || 0);
  const nhis = Math.max(0, Number(g("st-nhis").value) || 0);
  const life = Math.max(0, Number(g("st-life").value) || 0);
  const r = payeCalculate(gross, pen, nhf, rent, true, nhis, life, 0);
  t("st-fig").textContent = n(r.net_monthly);
  t("st-sub").textContent = `Tax ${n(r.tax_monthly)}/mo · taxable ${n(r.taxable)}/yr${r.exempt ? " · EXEMPT (minimum wage)" : ""}`;
  t("st-pen").textContent = n(r.pension_annual);
  t("st-rel").textContent = n(r.relief_annual);
  t("st-tax").textContent = n(r.tax_annual);
  const c = payeCompare(gross, pen, nhf, rent, nhis, life, 0);
  t("st-new-tax").textContent = n(c.new.tax_annual);
  t("st-new-net").textContent = n(c.new.net_monthly);
  t("st-old-tax").textContent = n(c.old.tax_annual);
  t("st-old-net").textContent = n(c.old.net_monthly);
  t("st-save").textContent = `You keep ${n(c.save_monthly)}/mo more under the new bands.`;
  const tb = document.querySelector("#st-bands tbody") as HTMLElement;
  tb.innerHTML = "";
  for (const b of payeBandBreakdown(r.taxable, payeBands2026())) {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td></td><td class="n"></td><td class="n"></td><td class="n"></td>`;
    (tr.children[0] as HTMLElement).textContent = "₦" + formatGrouped(b.low, 0) + (b.high === null ? "+" : ` – ₦${formatGrouped(b.high, 0)}`);
    (tr.children[1] as HTMLElement).textContent = (b.rate * 100).toFixed(0) + "%";
    (tr.children[2] as HTMLElement).textContent = n(b.slice);
    (tr.children[3] as HTMLElement).textContent = n(b.tax);
    tb.appendChild(tr);
  }
}
["st-gross", "st-pension", "st-rent", "st-nhf", "st-nhis", "st-life"].forEach((id) => g(id).addEventListener("input", render));
render();
</script>
