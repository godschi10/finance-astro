---
// Port of page-tools.php (gwill-finance-theme, "Finance Tools" template) —
// the Money Calculators hub, imported from the live
// https://finance.fitnesslova.qzz.io/tools/ capture 2026-09-30 (King order:
// "import the money calculator … maybe change the URL path to /money-tools/").
// Port URL: /money-tools/ (live path stays /tools/). Anatomy mirrored exactly:
//   2. .apps-hero: dot-grid + gold-glow layers, breadcrumb (Home › Money
//      Calculators), gold badge pill "Free · no sign-up · always updated" (sentence case since v0.7.14),
//      h1 "Money Calculators", lede — inline styles verbatim from the template.
//   3. .con > .ad-bg + .shd ("All tools" · "More added regularly") + .g3 of
//      16 .tool-card (per gwill_tools_card(): gradient icon tile
//      --tile/--tile-b, title, "Free · no sign-up" badge, desc, foot
//      "Open tool →" btn b-green b-sm)
//   + "Popular conversions" .shd + .fx-chips (the 8 amount landing pages)
//   + rect .ad-bg + 5. .fx-copy art-body hub intro ("Why use these
//     calculators?", 2 paras).
// Card copy (title/emoji/gradient/desc) is the live template's verbatim.
import Layout from "../../layouts/Layout.astro";
import { amountSlugs } from "../../lib/amount";
import { TOOL_MANIFEST } from "../../data/tool-manifest";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;

// page-tools.php gwill_tools_card() arguments, template order, verbatim — but no
// longer a SECOND hand-kept list of the sixteen tools (v0.7.21 leg D2). This
// page used to carry its own tools[] literal, which meant a slug lived in three
// places (here, data/content.ts TOOLS, data/tool-fields.ts TOOL_FIELDS) and a
// rename was three edits with nothing checking that the three agreed. It now
// reads the one manifest, in the same template order, with the same copy.
const tools = TOOL_MANIFEST;

// page-tools.php $amount_slugs — the live hub prints exactly these 8 chips
// (resolved against the port's own amount registry so links never 404).
const AMOUNT_CHIPS: [string, string][] = [
  ["100-dollars-to-naira", "100 Dollars to Naira"],
  ["1-million-naira-to-dollars", "1 Million Naira to Dollars"],
  ["50-dollars-to-naira", "50 Dollars to Naira"],
  ["500-dollars-to-naira", "500 Dollars to Naira"],
  ["1000-dollars-to-naira", "1000 Dollars to Naira"],
  ["5000-dollars-to-naira", "5000 Dollars to Naira"],
  ["10000-naira-to-dollars", "10000 Naira to Dollars"],
  ["100000-naira-to-dollars", "100000 Naira to Dollars"],
];
const have = new Set(amountSlugs());
const chips = AMOUNT_CHIPS.filter(([s]) => have.has(s));
const ld = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${import.meta.env.BASE_URL}` }, { "@type": "ListItem", position: 2, name: "Money Calculators" }] };
---
<Layout title="Money Calculators - GWill Finance" description="Free Nigerian money calculators, currency conversion at live rates, tax, savings goals, loans, budgets and more. No sign-up, works on any phone." crumb="Money Calculators" ogImage={{ url: `${base}images/og/tool-index.png`, width: 1200, height: 630, alt: "Money Calculators" }}>
<script type="application/ld+json" set:html={ld(breadcrumb)}></script>
<div class="apps-hero">
  <div style="position:absolute;top:0;right:0;bottom:0;left:0;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,0.025) 1px,transparent 1px);background-size:28px 28px;pointer-events:none"></div>
  <div style="position:absolute;top:-80px;right:-80px;width:360px;height:360px;background:radial-gradient(circle,rgba(217,119,6,0.08) 0%,transparent 65%);pointer-events:none"></div>
  <div style="position:relative;z-index:1;max-width:640px">
    <nav class="gwill-breadcrumbs" aria-label="Breadcrumb">
      <ol class="gwill-breadcrumbs__list">
        <li class="gwill-breadcrumbs__item"><a href={base}><span>Home</span></a></li>
        <li class="gwill-breadcrumbs__item gwill-breadcrumbs__item--current"><span aria-current="page">Money Calculators</span></li>
      </ol>
    </nav>
    <div style="display:inline-flex;align-items:center;gap:8px;font-size:9px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold-b);background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);padding:4px 12px;border-radius:var(--pill);margin-bottom:16px">Free · no sign-up · always updated</div>
    <h1 style="font-size:34px;font-weight:800;letter-spacing:-0.04em;color:#f0ede6;line-height:1.1;margin-bottom:10px">Money Calculators</h1>
    <p style="font-size:14px;font-weight:300;color:var(--dark-dim);line-height:1.75">Free tools to work out your money — live exchange rates, taxes, savings goals and more. Every one is built for Nigerians and updated automatically.</p>
  </div>
</div>
<div class="con" style="margin-top:32px;padding-bottom:48px">
  <div class="ad-bg"></div>
  <div class="shd" style="margin:20px 0 16px"><span class="stitle">All tools</span><span class="fz11 fw3 cd">More added regularly</span></div>
  <div class="g3">
    {tools.map((t) => {
      const [tileA, tileB] = t.grad.split(",");
      return (
      <div class="tool-card">
        <div class="tool-card__head">
          <div class="tool-card__top">
            <div class="tool-card__icon" style={`--tile:${tileA};--tile-b:${tileB}`}>{t.emoji}</div>
            <div>
              <div class="tool-card__title">{t.title}</div>
              <div class="tool-card__badge">Free · no sign-up</div>
            </div>
          </div>
          <p class="tool-card__desc">{t.desc}</p>
        </div>
        <div class="tool-card__foot">
          <a class="btn b-green b-sm" href={`${base}money-tools/${t.slug}/`}>Open tool →</a>
        </div>
      </div>
      );
    })}
  </div>
  {chips.length > 0 && (
    <>
      <div class="shd" style="margin:28px 0 16px"><span class="stitle">Popular conversions</span><span class="fz11 fw3 cd">Live-rate shortcuts</span></div>
      <div class="fx-chips" style="margin-top:0">
        {chips.map(([s, label]) => (<a class="fx-chip" href={`${base}money-tools/${s}/`}>{label}</a>))}
      </div>
    </>
  )}
  <div class="ad-bg" style="margin-top:28px"></div>
  <div class="fx-copy art-body" style="margin-top:28px">
    <h2>Why use these calculators?</h2>
    <p>Money decisions are hard when you’re guessing the numbers. These tools give you the real figure, the live exchange rate, your true take-home pay, the monthly amount you actually need to save, so you can plan with real numbers.</p>
    <p>Every tool is free, works on any phone, and is updated automatically so it never goes stale. New calculators are added as we build them.</p>
  </div>
</div>
</Layout>
