---
import ToolShell from "../../components/ToolShell.astro";
import { cryptoProfit, CRYPTO_SEED } from "../../lib/crypto";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
const seed = cryptoProfit(CRYPTO_SEED.invest, CRYPTO_SEED.buy_rate, CRYPTO_SEED.sell_rate, CRYPTO_SEED.buy_fee, CRYPTO_SEED.sell_fee, CRYPTO_SEED.flat_ngn);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Crypto Profit Calculator, P2P Spread - GWill Finance" description="P2P crypto profit in naira: buy/sell spread, platform fees, flat charges, break-even rate, and true ROI." slug="crypto-profit-calculator" tool="Crypto Profit Calculator" crumb="Crypto Profit Calculator (Naira, P2P-aware)" lede="The spread is the fee nobody quotes. Enter buy and sell rates plus every charge — profit, ROI, and break-even come out honest." verified="P2P-aware · fees modeled both sides" faqs={[
  { q: "Why model fees as explicit costs?", a: "Because a 1% fee on each side eats more than most spreads earn. Ignoring fees is how winning trades lose money." },
  { q: "What is the break-even rate?", a: "The sell rate at which this trade makes exactly zero. If your expected sell sits below it, do not enter." },
]}

  badge="Naira & P2P aware · not the USD tools",
  copy={[["p", "Say you put ₦200,000 into a coin quoted at ₦1,500 on the P2P buy side. After the 1% buy fee your money buys about 132 coins, not the 133 you might expect, the fee ate roughly ₦2,000 before you owned anything. When you sell at ₦1,800, the 1% sell fee and the network charge take another bite, and what lands as profit is not the headline ₦39,600 price move but the naira left after both legs of fees. That is the gap this calculator makes visible: the ₦39,600 in market movement is a gain only if you actually sold, and it is separate from the ₦4,376 you gave to fees."],["p", "The break-even line is the important one. It tells you the sell price at which your trade is exactly flat after fees. In the example above you need to sell at about ₦1,530 to just get your money back, meaning any sell price between ₦1,500 and ₦1,530 is a loss even though the coin moved up. That is the real cost of the spread plus fees, and it is why a fast in-and-out trade needs a bigger move than most people expect before it is actually worth doing."],["p", "Try it with your own numbers: change the buy and sell prices, or set the buy and sell rates to the same value to see the fee-only cost of a round-trip. The calculator re-derives everything instantly, and the same figures are what a reader without JavaScript sees in the static result and the FAQ."],["p", "On a P2P market the same coin trades at two prices: the rate you pay to buy and the rate you receive when you sell. That gap is not a fee but it costs you money all the same, often more than the explicit fee. If you buy USDT at ₦1,500 and the market only pays ₦1,450 when you sell, you have already lost 3.3% before a single naira of fees. This calculator breaks that out so you can see whether a quick trade is actually worth it, or whether the spread alone has eaten your margin."],["p", "A trade has more than one charge. Buying carries a percentage fee (and possibly a network or deposit charge), selling carries its own percentage, and moving the coin off a platform can carry a flat withdrawal fee. Stacking all of them against the gross gain is the only honest way to work out profit. This calculator takes every leg so the naira figure you see is what actually lands, not a headline number before costs."],["p", "Profit is the naira you made; ROI is the return relative to what you put in. A ₦35,000 profit on a ₦200,000 trade is a healthy 17%; the same profit on a ₦2,000,000 trade is under 2%. Always read both together, a big profit number can hide a thin return, and a high ROI on a tiny investment is still a small amount of money."],["p", "Global prices are quoted in USDT; Nigerian P2P quotes are in naira. The two only compare if you bridge them at the current rate. The converter in this tool does that with a live rate from our currency engine, so you can tell whether a P2P naira price is above or below the fair USDT-equivalent, the first step to spotting a bad quote."],["p", "Trading crypto in Nigeria is legal, but the market carries real risk, volatility, platform risk and the spread described above are all factors. Before you trade, understand the rules and the platforms that operate here. Our Crypto in Nigeria guide covers what is legal and the apps Nigerians actually use."],["p", "Once you have taken profit, the same compound math that made crypto attractive applies to your naira. See the growth with our compound interest calculator, set a real target with our savings goal calculator, and remember inflation quietly erodes any gain, our inflation-adjusted savings calculator shows the real target. To frame your money in today&#039;s buying power rather than a future number, our naira value calculator shows what a future amount is really worth."],["h2", "Crypto profit questions"],["h3", "How do I calculate crypto profit in naira?"],["p", "Work out how many coins your naira buys after the buy fee, multiply by the sell price, subtract the sell fee, then subtract your original investment. The remainder is your naira profit; divide by the investment for the ROI."],["h3", "Why does the P2P spread matter so much?"],["p", "On a P2P market the same coin quotes a lower buy rate than sell rate, that gap is a cost before you even pay a fee. For a quick round-trip the spread is often bigger than the fee, which is why this calculator shows it separately."],["h3", "What profit does a ₦200,000 trade make at these prices?"],["p", "Buying at ₦1,500 and selling at ₦1,800 with 1.0% fees on each leg gives about ₦35,224 profit, a 17.6% ROI."],["h3", "Does this include network or withdrawal fees?"],["p", "Yes, there is a flat naira fee field for network, withdrawal or transfer costs on top of the percentage buy and sell fees."]]},
  related={[{ href: `${base}articles/p2p-crypto-nigeria-safely/`, title: "How to Buy Crypto P2P in Nigeria Without Getting Scammed", excerpt: "Escrow rules, red flags, and the exact verification steps before you release a single naira." }, { href: `${base}articles/kuda-vs-traditional-banks-charges/`, title: "Kuda vs Traditional Banks: The Real Cost of Free Transfers", excerpt: "Card fees, failed-transfer reversals, and support tested — what digital banks actually save you." }, { href: `${base}articles/ngn-dollar-cost-averaging-guide/`, title: "Dollar-Cost Averaging Into NGX Stocks on a \u20a650k Salary", excerpt: "A step-by-step plan for buying Nigerian stocks every month without timing the market." }, { href: `${base}articles/piggyvest-vs-cowrywise-2026/`, title: "PiggyVest vs Cowrywise in 2026: Which Saves You More?", excerpt: "Interest rates, withdrawal rules, fees, and app experience compared side by side." }]},
  disclaimer="This calculator is for informational guidance only and is not financial advice. Crypto prices, fees and the P2P spread change constantly, and crypto is a volatile and risky asset, the figures shown are estimates based on what you enter. Confirm the exact quote and terms with the platform before you trade.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<div class="tgrid c3">

<div class="field"><label for="cp-inv">To invest ₦</label><input id="cp-inv" type="text" value={CRYPTO_SEED.invest} inputmode="decimal"></div>
<div class="field"><label for="cp-buy">Buy rate ₦</label><input id="cp-buy" type="text" value={CRYPTO_SEED.buy_rate} inputmode="decimal"></div>
<div class="field"><label for="cp-sell">Sell rate ₦</label><input id="cp-sell" type="text" value={CRYPTO_SEED.sell_rate} inputmode="decimal"></div>
<div class="field"><label for="cp-bf">Buy fee %</label><input id="cp-bf" type="text" value="1" inputmode="decimal"></div>
<div class="field"><label for="cp-sf">Sell fee %</label><input id="cp-sf" type="text" value="1" inputmode="decimal"></div>
<div class="field"><label for="cp-flat">Flat charges ₦</label><input id="cp-flat" type="text" value="0" inputmode="decimal"></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Profit</p>
<p class="receipt-fig" id="cp-fig">₦{n(seed.profit)}</p>
<p class="receipt-sub" id="cp-sub">ROI {(seed.roi * 100).toFixed(2)}% · {n(seed.coins, 4)} coins · sell nets ₦{n(seed.sell_net)}</p>
<p class="receipt-note" id="cp-warn" hidden></p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row"><span>Total fees</span><b id="cp-fees">₦{n(seed.fees_ngn)}</b></div>
<div class="receipt-row"><span>Break-even sell rate</span><b id="cp-be">₦{n(seed.break_even_rate, 2)}</b></div>
<div class="receipt-row"><span>Price gap value</span><b id="cp-gap">₦{n(seed.price_gap)}</b></div>
<p class="receipt-foot">P2P-aware · not financial advice</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
</div>
</ToolShell>
<script>
import { cryptoProfit } from "../../lib/crypto";
import { formatGrouped } from "../../lib/format";
import { pm } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig } from "../../data/tool-fields";
const nn = (v: number, d = 0) => "₦" + formatGrouped(v, d);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
/* THE ZERO LAW. cryptoProfit() short-circuits to an all-zero result when any of
   invest/buy/sell is missing, so without this the receipt printed a confident
   gold ₦0 profit, ₦0 fees and a ₦0 break-even for a visitor who entered nothing. */
const ALL = ["cp-inv", "cp-buy", "cp-sell", "cp-bf", "cp-sf", "cp-flat"];
function render() {
  /* F8 — every clamped negative says so: -x is priced as ₦0 in all six
     inputs (the engine clamps again inside, so the clamp cannot go — it is
     disclosed instead, in this rail which nothing else writes to). */
  const cpNeg = ["cp-inv", "cp-buy", "cp-sell", "cp-bf", "cp-sf", "cp-flat"].some((id) => pm(g(id).value) < 0);
  t("cp-warn").hidden = !cpNeg;
  t("cp-warn").textContent = cpNeg ? "Negative entries are treated as ₦0." : "";
  const r = cryptoProfit(
    Math.max(0, pm(g("cp-inv").value) || 0),
    Math.max(0, pm(g("cp-buy").value) || 0),
    Math.max(0, pm(g("cp-sell").value) || 0),
    Math.max(0, pm(g("cp-bf").value) || 0) / 100,
    Math.max(0, pm(g("cp-sf").value) || 0) / 100,
    Math.max(0, pm(g("cp-flat").value) || 0),
  );
  sfFig(t("cp-fig"), ALL, (r.profit < 0 ? "−" : "") + nn(Math.abs(r.profit)));
  sfFig(t("cp-sub"), ALL, `ROI ${(r.roi * 100).toFixed(2)}% · ${formatGrouped(r.coins, 4)} coins · sell nets ${nn(r.sell_net)}`);
  sfFig(t("cp-fees"), ALL, nn(r.fees_ngn));
  /* Break-even is invest ÷ (coins × (1 − sell fee)), so it needs the three
     numbers that make coins and sell net exist at all. */
  sfFig(t("cp-be"), ["cp-inv", "cp-buy", "cp-sell", "cp-sf"], nn(r.break_even_rate, 2));
  sfFig(t("cp-gap"), ALL, nn(r.price_gap));
}
  sfEmpty(sfIsEmpty("crypto-profit-calculator", gv));
["cp-inv", "cp-buy", "cp-sell", "cp-bf", "cp-sf", "cp-flat"].forEach((id) => g(id).addEventListener("input", render));
smartFields.register(TOOL_FIELDS["crypto-profit-calculator"]);
sfBind("crypto-profit-calculator", gv);
render();
</script>
