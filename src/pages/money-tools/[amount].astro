---
import ToolShell from "../../components/ToolShell.astro";
import {
  amountSlugs, amountPageData, amountTokens, amountRenderText,
  amountSiblings, amountOpposite, amountSeo, amountConfig, amountFmt, amountRate,
} from "../../lib/amount";
import { FX_SNAPSHOT, FX_SNAPSHOT_LABEL } from "../../data/fx-snapshot";
// Unit line via amountRate() — the converter's moneyTrim treatment (v0.7.53,
// F6 small-rate half) raised to lib level for this template: below 1 a rate
// prints 10 significant digits (1 NGN = $0.000751, the true value — the old
// 4dp mirror of page-amount-converter.php:118-125 printed $0.0008, and the
// {LIVE} token truncated to "$0.00"; fifth audit P1-4 #6/#7). Rates ≥ 1 keep
// the exact 6-decimal look.
const unitLineOf = (u: number, r: number, from: string, to: string) =>
  `1 ${from} = ${amountRate(u, to)} · 1 ${to} = ${amountRate(r, from)}`;
export function getStaticPaths() {
  return amountSlugs().map((slug) => ({ params: { amount: slug } }));
}
const slug = Astro.params.amount as string;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const fx = { rates: FX_SNAPSHOT.rates, as_of: FX_SNAPSHOT.as_of, cached: false, ok: true };
const d = amountPageData(slug, fx);
if (!d) throw new Error(`unknown amount slug: ${slug}`);
const pageUrl = (s: string) => `${base}money-tools/${s}/`;
const tokens = amountTokens(slug, d, pageUrl);
const lede = amountRenderText(d.cfg.content.lede, tokens);
const sections = d.cfg.content.sections.map((s) => ({ h2: s.h2, body: s.body.map((p) => amountRenderText(p, tokens)) }));
const faqs = d.cfg.content.faqs.map((f) => ({ q: f.q, a: amountRenderText(f.a, tokens) }));
const sibs = amountSiblings(slug).map((s) => ({ slug: s, h1: amountSeo(s, amountConfig(s)!).h1 }));
const opps = amountOpposite(slug).map((s) => ({ slug: s, h1: amountSeo(s, amountConfig(s)!).h1 }));
const equation = `${amountFmt(d.amount, d.from)} = ${amountFmt(d.converted, d.to)}`;
const unitLine = unitLineOf(d.unit_rate, d.rev_rate, d.from, d.to);
// Uniqueness pass (fifth audit P2-7 + Oct-8 audit P2): each page derives its
// own neighbouring-amount ladder from the snapshot rate it already renders —
// half, the page amount, double, five-fold, ten-fold. Pure arithmetic on the
// existing unit_rate (amt × unit_rate === fxConvert(amt, from, to)); no new
// fetches, no new engine calls, snapshot-stamped in the caption.
const ladder = [0.5, 1, 2, 5, 10].map((m) => {
  const amt = d.amount * m;
  return { amt, out: d.unit_rate * amt };
});
---
<ToolShell title={`${d.seo.title} - GWill Finance`} description={d.seo.meta_desc} slug={slug} tool={d.seo.h1} lede={lede} verified={`Mid-market ${FX_SNAPSHOT.as_of} (${FX_SNAPSHOT_LABEL}) · receipt refreshes live`} badge={`Live rate · updated ${FX_SNAPSHOT.as_of}`} faqs={faqs} rawFaq ogImage={{ url: `${base}images/og/tool-amount.png`, width: 1200, height: 630, alt: "Amount Converter" }}>
<div class="fx-card">
<div class="fxap-hero">
<p class="fxap-figure" id="am-fig"><span class="fxap-side">{amountFmt(d.amount, d.from)}</span><span class="fxap-eq">=</span><span class="fxap-side fxap-result" id="am-fig-r">{amountFmt(d.converted, d.to)}</span></p>
<p class="fx-result-note" id="am-unit">{unitLine} · {FX_SNAPSHOT.as_of} · mid-market, before provider fees</p>
<p class="fx-result-note" id="am-foot" style="opacity:.72">Snapshot · {FX_SNAPSHOT.as_of} · swaps to live timestamp when the feed answers</p>
</div>
</div>
<!-- v0.6.8 (King: cramp on the conversion landing pages): the LIVE amount
     template wraps this copy zone in `.fx-copy art-body` — h2 20px with 28/10
     margins, body 16px/1.8. The port had pulled it outside the wrapper with
     .95rem/10px inline overrides, so every section sat flush under the last.
     Restored to the live anatomy (the .hr divider stays — port section-break). -->
<div class="fx-copy art-body" style="margin-top:28px">
{sections.map((s) => (
<div><h2>{s.h2}</h2>{s.body.map((p) => (<p set:html={p}></p>))}</div>
))}
<div>
<h2>Nearby amounts at this snapshot rate</h2>
<p>The brackets around {amountFmt(d.amount, d.from)}, all converted at this page's own snapshot rate ({FX_SNAPSHOT.as_of}):</p>
<div class="st-table-wrap"><table class="st-table">
<thead><tr><th scope="col">Amount</th><th scope="col">You would get</th></tr></thead>
<tbody>
{ladder.map((r) => (r.amt === d.amount ? (
<tr><td><strong>{amountFmt(r.amt, d.from)}</strong></td><td><strong>{amountFmt(r.out, d.to)}</strong></td></tr>
) : (
<tr><td>{amountFmt(r.amt, d.from)}</td><td>{amountFmt(r.out, d.to)}</td></tr>
)))}
</tbody>
</table></div>
</div>
<div class="hr"></div>
{sibs.length > 0 && <h2>Neighbouring conversions</h2>}
{sibs.length > 0 && <p>{sibs.map((s, i) => (<span><a class="slink" href={pageUrl(s.slug)}>{s.h1}</a>{i < sibs.length - 1 ? " · " : ""}</span>))}</p>}
{opps.length > 0 && <h2>The other direction</h2>}
{opps.length > 0 && <p>{opps.map((s, i) => (<span><a class="slink" href={pageUrl(s.slug)}>{s.h1}</a>{i < opps.length - 1 ? " · " : ""}</span>))}</p>}
</div>
</ToolShell>
<div data-amount-slug={slug} hidden></div>
<script>
import { amountPageData, amountFmt, amountRate } from "../../lib/amount";
import { fxFetchLive } from "../../lib/fx";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS } from "../../data/tool-fields";
/* The amount family has no inputs of its own — the figure lives in the URL —
   so the table entry is deliberately empty. register() is still called so the
   fleet contract is uniform and auditable, and so the Clear-examples control
   (which lives in ToolShell) stays hidden on a tool that has no seed. */
smartFields.register(TOOL_FIELDS["amount"]);
const holder = document.querySelector("[data-amount-slug]");
const slug = holder && (holder as HTMLElement).dataset.amountSlug || "";
(async () => {
  try {
    if (!slug) return;
    const ctl = new AbortController();
    const t = setTimeout(() => ctl.abort(), 8000);
    const live = await fxFetchLive(ctl.signal);
    clearTimeout(t);
    if (!live.rates) return;
    const d = amountPageData(slug, { rates: live.rates, as_of: live.as_of || "just now", cached: false, ok: true });
    if (!d || d.unit_rate <= 0) return;
    const fig = document.getElementById("am-fig-r");
    const unit = document.getElementById("am-unit");
    const foot = document.getElementById("am-foot");
    if (fig) fig.textContent = amountFmt(d.converted, d.to);
    if (unit) unit.textContent = `1 ${d.from} = ${amountRate(d.unit_rate, d.to)} · 1 ${d.to} = ${amountRate(d.rev_rate, d.from)} · live · mid-market, before provider fees`;
    if (foot) foot.textContent = "Live · " + (live.as_of || "just now");
  } catch { /* snapshot stands, honestly labeled */ }
})();
</script>
