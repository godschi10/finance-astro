---
import ToolShell from "../../components/ToolShell.astro";
import { emergencyFund, EMERGENCY_SEED } from "../../lib/emergency";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
/* HN-2. The field opens at 24%, not 20%: NBS put Lagos at 23.68% headline in
   Aug 2026 — the highest of any state — while national headline was 15.39%. A
   20% default is 3.68 points UNDER what the largest readership pays, and
   calling that "cautious" was the dishonest part.

   WHY THE RATE IS PASSED IN RATHER THAN READ FROM EMERGENCY_SEED: the vectors
   gate (scripts/vectors-check.mjs, case "seeds") compares EMERGENCY_SEED
   against the PHP truth oracle gwill_emergency_fund_seed(). That oracle is the
   WP source of truth and this leg may not edit a gate or the oracle, so the
   seed constant cannot move. The PAGE's delivered default is a separate
   concern from the WP-parity seed, so it is stated here — which keeps the SSR
   receipt, the field and the client render all agreeing at 24%.
   Do not "tidy" this back to EMERGENCY_SEED.inflation. */
const INFL_PCT = 24;
const seed = emergencyFund(EMERGENCY_SEED.essentials, EMERGENCY_SEED.saved, EMERGENCY_SEED.monthly, EMERGENCY_SEED.cover, INFL_PCT / 100);
/* CALC-1 — the row below shows BOTH figures and says which is which, because
   the page's own copy promises to measure against the inflation-adjusted finish
   line and that finish line moves while you save. `months_to_reach` is now the
   moving-target answer (the audit's monthsToMovingTarget); the flat-price figure
   is gap ÷ monthly saving, kept on screen because hiding it would be its own
   dishonesty. ONE source for both wordings — the same two expressions the
   client render uses — so the server-rendered seed and the hydrated render
   cannot drift apart. */
const seedMoving = seed.months_to_reach;
const seedNominal = seed.gap / EMERGENCY_SEED.monthly;
const pct = Math.min(100, Math.round(seed.progress_pct));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Emergency Fund Calculator, Runway Months - GWill Finance" description="How many months could you survive job loss? Runway now, inflation-adjusted target, and the monthly saving that closes the gap." slug="emergency-fund-calculator" tool="Emergency Fund Calculator" crumb="Emergency Fund Calculator (Naira, Inflation-adjusted)" lede="A fund measured in months, not naira. See your runway today, the target that survives inflation, and exactly what closes the gap." verified="Inflation-adjusted target · 6-month default cover" faqs={[
  { q: "How many months should I cover?", a: "Six is the default for salaried earners; freelancers and single-income households should aim higher. Start with three and build." },
  { q: "Why is the real target bigger?", a: "Prices rise while you save. The real target prices your essentials at the inflation you set, so the fund still covers six months when you finish it." },
  { q: "Where should the fund sit?", a: "Liquid and boring: a high-yield savings pocket, not stocks or locked plans. Compare current rates on the savings-rate comparator." },
]}

  badge="The safety net · priced honestly",
  copy={[["p", "Most advice tells you to build 3-6 months of expenses, but the first useful number is the one you already have: how many months of essentials your current savings cover. That is your runway. If you save ₦450,000 and your essentials are ₦150,000, you have 3 months of cover today, a real, concrete position, not a vague sense of \"somewhere behind\". Knowing it is the starting point."],["p", "The target is your monthly essentials times the months you want covered. If your essentials are ₦150,000 and you want six months, that is ₦900,000. The exact figure depends on your own spending, not a generic table, which is why this calculator asks for your essentials rather than assuming. Three months is the minimum; six is the comfortable default; more if your income is irregular."],["p", "Your essentials do not stay the same. If you are saving toward a target you will reach in about a year, that year of inflation has raised the monthly figure you are aiming at. In Nigeria inflation has run high, so the gap is real, the naira target you set today is worth less by the time you hit it. This calculator projects the inflation-adjusted target so you are not surprised a year later by how much more you need."],["p", "Divide the target by what you add to the fund each month. But do not use the raw figure as your finish line, the inflation-adjusted target is the one to measure against, and as you progress the runway number tells you whether you are genuinely safer. Building an emergency fund is a marathon, not a sprint; the progress bar makes each month visible."],["p", "The 3-6 month rule is a starting point, not a law. The right size for your fund depends on how stable your income is. If you are a salaried worker with one employer, three months may be enough. If you freelance, run a business, or are the sole earner in a large household, your risk is higher and six months or more is safer, because a job loss or a slow month hits harder and can last longer than a standard notice period. The calculator lets you set the cover you want so the target reflects your actual situation, not a generic table."],["p", "The biggest one is using the fund for non-emergencies, a holiday, a new phone, a wedding. The second is investing it somewhere risky for a slightly higher return and then needing it the day the market is down. The third is setting the target once and never raising it as your cost of living grows. Revisit it every few months, bump the essentials figure if your rent or food bill has gone up, and the progress bar will tell you honestly whether you are keeping pace."],["p", "An emergency fund must be safe and immediately accessible, not tied up in something that drops in value or takes weeks to reach. A high-yield savings account or a fixed-deposit ladder is the usual Nigerian home for it. Compare the best rates with our savings rate comparator, and see how the balance grows with our compound interest calculator."],["p", "An emergency fund is one part of a complete money plan. To know how much to set aside each month toward a specific goal, use our savings goal calculator. To understand how high inflation erodes your target, our inflation-adjusted savings calculator and naira value calculator show the real, inflation-adjusted figure. And to divide your take-home into needs, wants and savings, our 50/30/20 budget calculator tells you how much you can safely put toward the fund each month."],["h2", "Emergency fund questions"],["h3", "How much emergency fund should I have in naira?"],["p", "Three to six months of essential expenses. Multiply your monthly essentials by the cover you want, on ₦150,000 a month, six months is about ₦900,000."],["h3", "What counts as an essential expense?"],["p", "Everything you cannot cut in a crisis: rent or mortgage, food, transport, utilities, insurance, and the minimum payments on debt. Leave out dining out, subscriptions and shopping."],["h3", "Why adjust the target for inflation?"],["p", "Because your essentials rise with inflation, the naira target you set today is worth less by the time you reach it. Adjusting shows the honest number to aim for."],["h3", "Where should I keep my emergency fund?"],["p", "Safe and instantly accessible, a high-yield savings account or a fixed-deposit ladder. Keep it separate from your spending account and only touch it for genuine emergencies."]]},
  related={[{ href: `${base}articles/piggyvest-vs-cowrywise-2026/`, title: "PiggyVest vs Cowrywise in 2026: Which Saves You More?", excerpt: "Interest rates, withdrawal rules, fees, and app experience compared side by side." }, { href: `${base}articles/grey-vs-geegpay-dollar-account/`, title: "Grey vs Geegpay: Which Dollar Account Should You Open?", excerpt: "Account opening, conversion spreads, card support, and payout speed — tested with real transfers." }, { href: `${base}articles/ngn-dollar-cost-averaging-guide/`, title: "Dollar-Cost Averaging Into NGX Stocks on a \u20a650k Salary", excerpt: "A step-by-step plan for buying Nigerian stocks every month without timing the market." }, { href: `${base}articles/kuda-vs-traditional-banks-charges/`, title: "Kuda vs Traditional Banks: The Real Cost of Free Transfers", excerpt: "Card fees, failed-transfer reversals, and support tested — what digital banks actually save you." }]},
  disclaimer="This calculator is for informational guidance only and is not financial advice. The 3-6 month rule is a guideline, and the inflation-adjusted projection is an estimate based on the rate you enter. Adjust to your circumstances and confirm significant decisions with a licensed adviser.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<div class="tgrid c3">

<div class="field" data-cur="NGN"><label for="em-ess">Monthly essentials ₦</label><input id="em-ess" type="text" value={EMERGENCY_SEED.essentials} inputmode="decimal"></div>
<div class="field" data-cur="NGN"><label for="em-saved">Saved so far ₦</label><input id="em-saved" type="text" value={EMERGENCY_SEED.saved} inputmode="decimal"></div>
<div class="field" data-cur="NGN"><label for="em-mo">Monthly saving ₦</label><input id="em-mo" type="text" max="100000000" value={EMERGENCY_SEED.monthly} inputmode="decimal"></div>
<div class="field"><label for="em-cover">Cover (months)</label><input id="em-cover" type="text" max="60" value={EMERGENCY_SEED.cover} inputmode="decimal"></div>
<div class="field"><label for="em-infl">Inflation %/yr</label><input id="em-infl" type="text" max="100" value={INFL_PCT} inputmode="decimal"></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Your runway today</p>
<p class="receipt-fig" id="em-fig">{seed.runway_now.toFixed(1)} months</p>
<p class="receipt-sub" id="em-sub">Target ₦{n(seed.target)} · gap ₦{n(seed.gap)} · real (inflated) target ₦{n(seed.real_target)}</p>
<div class="prog" aria-hidden="true"><i id="em-bar" style={`width:${pct}%`}></i></div>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row"><span>Months to finish</span><b id="em-mtr">about {seedMoving.toFixed(1)}</b></div>
<!-- CALC-1. What the row answers, and the flat-price figure beside it. The
     `<b>` above is the real answer (the inflation-adjusted finish line, which
     moves while you save); this line names the rate it assumes and keeps the
     "if prices stood still" number visible, so nobody can read the nominal
     figure and believe the work finishes sooner than it does. -->
<p class="receipt-sub" id="em-mtr-note">at {INFL_PCT}% inflation · {seedNominal.toFixed(1)} months if prices stood still</p>
<!-- The SSR fallback above only ever sees the seed, where the gap is open
     (about 7.2 months), so the closed-gap wording cannot be reached before
     hydration. C1's zero cases are all named in the client render below. -->
<div class="receipt-row"><span>Progress</span><b id="em-pct">{pct}%</b></div>
<p class="bar-note" id="em-warn" hidden></p>
<p class="receipt-foot">6-month default · inflation-adjusted</p>
<p class="receipt-foot">Gap + progress vs today's naira target — the real target is the inflated finish line</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
</div>
</ToolShell>
<script>
import { emergencyFund } from "../../lib/emergency";
import { formatGrouped } from "../../lib/format";
import { pm, pmBlank } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig } from "../../data/tool-fields";
const nn = (v: number) => "₦" + formatGrouped(v, 0);
/* The rate the visitor typed, as they typed it — rounded for display, never
   rounded to zero (a 0.004% entry would otherwise read "at 0% inflation"). */
const fmtPct = (v: number) => {
  const r = Math.round(v * 100) / 100;
  if (r !== 0) return String(r);
  return v > 0 ? "<0.01" : "0";
};
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
/* THE ZERO LAW. Months-to-finish answers for the inflation-ADJUSTED finish line
   (CALC-1: the page's own copy promises that is the one to measure against, and
   that line moves while you save), so it waits on essentials, cover, the monthly
   saving AND inflation. The flat-price figure — gap ÷ monthly saving — is still
   shown beside it, named for what it is. A cleared field withholds its figure
   rather than printing the ₦0 that a 0% assumption would produce. */
const FIVE = ["em-ess", "em-saved", "em-mo", "em-cover", "em-infl"];
const REACH = ["em-ess", "em-mo", "em-cover"];
/* M2 — THE ZERO LAW, THE OTHER HALF. `pm("0") || 6` is a real 0 short-circuited
   to the seed, so a visitor who deliberately typed 0 months of cover was shown
   the seed's SIX-month plan with no warning, while the EMPTY case was handled
   with care. The two cases disagreed; now they agree.

   WHAT A GENUINE 0 MEANS HERE: a cover of 0 asks for no emergency fund at all —
   target ₦0, gap ₦0, 0 months to finish. That is a real answer to a real
   question and it is the visitor's own number, so it is printed as one, with the
   page naming what it means rather than inventing a fund nobody asked for. The
   engine keeps its monthsCover >= 1 clamp (it is a faithful PHP port and the
   vectors gate verifies it), so the page renders the 0-cover case from its own
   inputs instead of re-calling the engine with a value it would refuse. */
function render() {
  const essRaw = pm(g("em-ess").value);
  const savedRaw = pm(g("em-saved").value);
  const moRaw = pm(g("em-mo").value);
  const coverRaw = g("em-cover").value;
  const inflRaw = pm(g("em-infl").value);
  /* Blank keeps the seed AND keeps saying so (the note below). A typed 0 is not
     blank and must not borrow the seed. */
  /* B4-FIX2 — entered means honest: garbage cover ("abc12") borrows the 6-month
     seed exactly like a cleared field, never prices 12 (or 0) months. */
  const cover = !pmBlank(coverRaw) ? Math.max(0, pm(coverRaw)) : 6;
  const r = emergencyFund(
    Math.max(0, essRaw || 0),
    Math.max(0, savedRaw || 0),
    Math.max(0, moRaw || 0),
    cover === 0 ? 1 : cover,
    Math.max(0, inflRaw || 0) / 100,
  );
  /* Cover 0 => the honest target is ₦0, not the engine's clamped 1-month one. */
  const target = cover === 0 ? 0 : r.target;
  const gap = cover === 0 ? 0 : r.gap;
  const realTarget = cover === 0 ? 0 : r.real_target;
  const monthsToFinish = cover === 0 ? 0 : r.months_to_reach;
  /* CALC-1, the flat-price figure: gap ÷ monthly saving. Informative, and no
     longer what `months_to_reach` means — the row shows both, each named. */
  const nominal = moRaw > 0 ? gap / moRaw : 0;
  const progress = cover === 0 ? 0 : r.progress_pct;
  // Finite-result guard: absurd cover/inflation/saving used to compound into
  // ₦Infinity. Never print it — say the plan is out of range instead.
  const fz = (v: number) => Number.isFinite(v) ? nn(v) : "out of range";
  const mtrBad = !Number.isFinite(monthsToFinish) || monthsToFinish > 12000;
  const tgtBad = !Number.isFinite(target) || !Number.isFinite(gap) || !Number.isFinite(realTarget) || realTarget > 1e15;
  const p = Math.min(100, Math.round(progress));
  sfFig(t("em-fig"), ["em-ess", "em-saved"], r.runway_now.toFixed(1) + " months");
  sfFig(t("em-sub"), FIVE, `Target ${fz(target)} · gap ${fz(gap)} · real (inflated) target ${fz(realTarget)}`);
  /* A typed 0 cover is an honest ZERO months and must not borrow the "save
     something monthly" dash — that dash means monthlySave is 0, a different
     failure entirely.

     C1 made the THIRD case reachable, and this is where it had to be handled:
     a CLOSED gap (saved >= target) is 0 months not because anything is broken
     but because the goal is already met. Printing the monthlySave dash there
     told a fully-funded user to "save something monthly" when their fund is
     already complete — a false alarm on the one input they had nothing wrong
     with. The zero cases are named separately, because they are different
     facts and only one of them is a problem:
       · gap closed          → "done — target reached"
       · no cover asked for  → "0.0 (no cover asked for)"
       · no monthly saving   → the dash (the only case that is advice)

     CALC-1 (2026-10-09) adds the fourth, and it is the one this page used to
     break its own promise on: the fund can NEVER reach the inflated finish
     line, because inflation takes more each month than the visitor puts in.
     That is a fact about their numbers, not an error, and it gets real words —
     never "Infinity", never a blank, never the nominal figure dressed up as an
     answer. */
  const gapClosed = essRaw > 0 && savedRaw >= essRaw * Math.max(0, cover) && cover > 0;
  let mtrText: string;
  let mtrNote = "";
  if (!Number.isFinite(monthsToFinish) || monthsToFinish > 12000) {
    mtrText = "out of range";
    mtrNote = "lower the target, the inflation rate, or raise the monthly saving";
  } else if (moRaw <= 0) {
    mtrText = "— (save something monthly)";
  } else if (r.never && cover > 0) {
    mtrText = "never";
    mtrNote = "your saving doesn't catch up with inflation at this rate";
  } else if (monthsToFinish > 0) {
    /* The real answer is an estimate — it is a projection over the inflation
       you typed — so it says "about". The flat-price figure is exact division
       and does not. */
    mtrText = inflRaw > 0 ? `about ${monthsToFinish.toFixed(1)}` : monthsToFinish.toFixed(1);
    mtrNote = inflRaw > 0
      ? `at ${fmtPct(inflRaw)}% inflation · ${nominal.toFixed(1)} months if prices stood still`
      : "prices held flat — no inflation entered";
  } else {
    mtrText = cover === 0 ? "0.0 (no cover asked for)"
      : gapClosed ? "done — target reached"
      : "0.0 (already there)";
  }
  sfFig(t("em-mtr"), REACH, mtrText);
  sfFig(t("em-mtr-note"), REACH, mtrNote);
  sfFig(t("em-pct"), ["em-ess", "em-saved", "em-cover"], p + "%");
  (document.getElementById("em-bar") as HTMLElement).style.width = p + "%";
  const notes: string[] = [];
  if (!(essRaw > 0) && !(savedRaw > 0) && !(moRaw > 0)) notes.push("Enter your monthly essentials and saving to see the plan.");
  if (cover === 0) notes.push("Cover of 0 months means no target to save toward — your runway above is the figure that still applies.");
  else if (mtrBad || tgtBad) notes.push("Out of range — lower the target: fewer months' cover, lower inflation, or a larger monthly saving.");
  else if (pmBlank(coverRaw)) notes.push("Cover defaults to 6 months — set your own if needed.");
  if (essRaw < 0 || savedRaw < 0 || moRaw < 0 || inflRaw < 0) notes.push("Negative entries are treated as ₦0.");
  const w = t("em-warn");
  w.hidden = notes.length === 0;
  w.textContent = notes.join(" ");
}
  sfEmpty(sfIsEmpty("emergency-fund-calculator", gv));
["em-ess", "em-saved", "em-mo", "em-cover", "em-infl"].forEach((id) => g(id).addEventListener("input", render));
smartFields.register(TOOL_FIELDS["emergency-fund-calculator"]);
sfBind("emergency-fund-calculator", gv);
render();
</script>
