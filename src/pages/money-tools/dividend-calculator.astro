---
import ToolShell from "../../components/ToolShell.astro";
import { dividendProject, ngxDividendStocks, dividendVerified, DIVIDEND_SEED } from "../../lib/dividend";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
const seed = dividendProject(DIVIDEND_SEED.investment, DIVIDEND_SEED.price, DIVIDEND_SEED.dps, DIVIDEND_SEED.price_growth, DIVIDEND_SEED.div_growth, DIVIDEND_SEED.years, DIVIDEND_SEED.drip);
const stocks = ngxDividendStocks();
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Dividend Estimator, NGX DRIP Projection - GWill Finance" description="Project NGX dividend shares year by year: DRIP vs cash, price and dividend growth, yield, gain, and CAGR." slug="dividend-calculator" tool="Dividend & ROI Estimator" crumb="Dividend & ROI Estimator (Nigerian Stocks)" lede="Pick an NGX payer, set growth, choose DRIP or cash — the projection shows every year's shares, dividends, and portfolio value." verified={`NGX table verified ${dividendVerified()} · indicative prices, not live quotes`} faqs={[
  { q: "DRIP or cash — which wins?", a: "DRIP almost always, over years. Toggle above on the same inputs and compare the end values — compounding shares beats pocketing dividends." },
  { q: "Are these live NGX prices?", a: "No. The stock table is a maintained snapshot for estimation. Check your broker for tradable prices before buying." },
  { q: "What does CAGR tell me?", a: "Your true annual return with everything reinvested — the one number that lets you compare this stock against a savings plan." },
]}

  badge="NGX stocks · forward total return",
  copy={[["p", "The dividend yield on the stock exchange tells you what a company pays out each year relative to its price. It is a snapshot. Total return is the full picture: the share-price change, plus every dividend you collect, plus the compounding if you reinvest those dividends. Two stocks can have the same headline yield and wildly different outcomes over five years, which is exactly why projecting matters."],["p", "A dividend stock&#039;s future value rests on two numbers you choose: how fast the share price grows and how fast the dividend grows. Both are assumptions, not facts. A bank that grows its dividend at 8% a year and a bank that keeps it flat will look completely different in a five-year projection. This estimator makes those two inputs explicit, so you can see how much of the result is real math and how much is your guess. Drop dividend growth to zero and watch the compounding story change, that is the honest way to use a projection."],["p", "A high yield can be a red flag. If a share price falls sharply, the headline yield on the historic dividend jumps up, a distressed stock can look like a great income pick when it is really a falling knife. Always read the yield against the payout ratio and the company&#039;s track record, not as a standalone number. The estimator shows the yield on what you enter, and the projection lets you stress-test whether that yield is sustainable under a realistic dividend-growth assumption."],["p", "A DRIP reinvests your dividend into more shares at the current price. Those extra shares pay more dividends next time, which buy even more shares, the snowball. Over a long horizon that compounding is usually worth more than the dividend cash itself. This estimator runs both cases side by side so you can see the gap grow each year, instead of taking a reinvestment claim on faith."],["p", "The NGX is a dividend market. Nigerian blue chips, banks like GTCO, Zenith and Stanbic, and industrials like Dangote Cement and BUA, pay out meaningful portions of earnings, and yields that would look enormous by global standards are normal here. That means dividend-driven total return matters far more in naira than it does in the dollar market, and no global calculator prices it that way."],["p", "A projection is only as good as what you assume. Price growth and dividend growth are not guaranteed, they move with inflation, interest rates, company earnings and the economy. This calculator takes your inputs, does the math cleanly, and makes no promise about the future. Use the numbers to understand the shape of a return, then stress-test the outcome with a lower growth assumption to see how resilient your plan is."],["p", "Dividend income is only one way a naira grows. To see the effect of reinvested returns on a single lump sum, our compound interest calculator shows the same snowball. To plan how much you need to save toward a target, use our savings goal calculator. To see how inflation quietly erodes a naira return over the same horizon, our inflation-adjusted savings calculator and naira value calculator frame the real, inflation-adjusted target."],["p", "You buy NGX stocks through a licensed stockbroker or a modern investing app. Our best investment apps for Nigerian beginners guide and the Risevest vs Trove comparison cover the practical options for getting started."],["h2", "Dividend & ROI questions"],["h3", "What is dividend yield for a Nigerian stock?"],["p", "The annual dividend per share divided by the share price. A stock at ₦128 paying ₦12 a year yields about 9.19%. It is a snapshot, not a forecast."],["h3", "Should I reinvest dividends or take cash?"],["p", "Reinvesting (DRIP) buys more shares, so your holding compounds and usually produces a larger total value over time. Taking cash gives you income now but keeps your share count fixed. The right choice depends on whether you want growth or income."],["h3", "Are these projections guaranteed?"],["p", "No. They use the growth assumptions you enter. Share prices and dividends change with the economy and the company, the estimator shows the math, not a promise."],["h3", "Are the stock prices and dividends live?"],["p", "The stock list is a maintained, clearly-labelled table of indicative figures last verified in September 2026, so you have a realistic starting point. Enter fresh figures from your broker for the exact current value."]]},
  related={[{ href: `${base}articles/ngn-dollar-cost-averaging-guide/`, title: "Dollar-Cost Averaging Into NGX Stocks on a \u20a650k Salary", excerpt: "A step-by-step plan for buying Nigerian stocks every month without timing the market." }, { href: `${base}articles/piggyvest-vs-cowrywise-2026/`, title: "PiggyVest vs Cowrywise in 2026: Which Saves You More?", excerpt: "Interest rates, withdrawal rules, fees, and app experience compared side by side." }]},
  disclaimer="This estimator is for informational guidance only and is not financial advice. Dividend and price figures are indicative or based on inputs you provide, and Nigerian stocks carry real risk, capital can fall as well as rise. Confirm major decisions with a licensed investment adviser.", ogImage={{ url: `${base}images/og/tool-dividend-calculator.png`, width: 1200, height: 630, alt: "Dividend & ROI Estimator" }}>
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<div class="tgrid c3">

<div class="field"><label for="dv-stock">NGX stock</label><select id="dv-stock">{stocks.map((s, i) => (<option value={i} selected={s.ticker === "GTCO"}>{s.name} ({s.ticker})</option>))}</select></div>
<div class="field"><label for="dv-inv">Investment ₦</label><input id="dv-inv" type="text" value={DIVIDEND_SEED.investment} inputmode="decimal"></div>
<div class="field"><label for="dv-pg">Price growth %/yr</label><input id="dv-pg" type="text" max="100" value="10" inputmode="decimal"></div>
<div class="field"><label for="dv-dg">Dividend growth %/yr</label><input id="dv-dg" type="text" max="100" value="8" inputmode="decimal"></div>
<div class="field"><label for="dv-yrs">Years</label><input id="dv-yrs" type="number" min="1" max="40" step="1" value={DIVIDEND_SEED.years} inputmode="numeric"></div>
<div class="field"><label for="dv-drip">Dividends</label><select id="dv-drip"><option value="1" selected>Reinvest (DRIP)</option><option value="0">Take cash</option></select></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl" id="dv-lbl">Portfolio end value</p>
<p class="receipt-fig" id="dv-fig">₦{n(seed.end_value)}</p>
<p class="receipt-sub" id="dv-sub">Cash dividends ₦{n(seed.cash_total)} · gain ₦{n(seed.gain)} · CAGR {(seed.cagr * 100).toFixed(1)}%</p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row"><span>Shares held</span><b id="dv-sh">{n(seed.shares, 2)}</b></div>
<div class="receipt-row"><span>Starting yield</span><b id="dv-yld">{(seed.yield * 100).toFixed(2)}%</b></div>
<div class="receipt-row"><span>Cash dividends total</span><b id="dv-cash">₦{n(seed.cash_total)}</b></div>
<p class="receipt-note" id="dv-warn" hidden></p>
<p class="receipt-foot">Indicative projection · not investment advice</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
</div>
<div class="hr"></div>
<h2 class="tool-h2">Year by year</h2>
<div class="st-table-wrap"><table class="st-table" id="dv-table">
<thead><tr><th>Year</th><th class="n">Price ₦</th><th class="n">Shares</th><th class="n">Dividend ₦</th><th class="n">Value ₦</th></tr></thead>
<tbody>
{seed.yearly.map((y) => (<tr><td>{y.year}</td><td class="n">₦{n(y.price, 2)}</td><td class="n">{n(y.shares, 2)}</td><td class="n">₦{n(y.dividend)}</td><td class="n">₦{n(y.value)}</td></tr>))}
</tbody>
</table></div>
</ToolShell>
<script>
import { dividendProject, ngxDividendStocks } from "../../lib/dividend";
import { formatGrouped } from "../../lib/format";
import { pm } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind } from "../../data/tool-fields";
const nn = (v: number, d = 0) => "₦" + formatGrouped(v, d);
const stocks = ngxDividendStocks();
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
function render() {
  const s = stocks[Number((document.getElementById("dv-stock") as HTMLSelectElement).value) || 0] ?? stocks[0];
  const drip = (document.getElementById("dv-drip") as HTMLSelectElement).value === "1";
  const r = dividendProject(
    Math.max(0, pm(g("dv-inv").value) || 0),
    s.price, s.dps,
    Math.max(0, pm(g("dv-pg").value) || 0) / 100,
    Math.max(0, pm(g("dv-dg").value) || 0) / 100,
    Math.max(1, Math.trunc(pm(g("dv-yrs").value) || 5)),
    drip,
  );
  const warn = t("dv-warn");
  const tb = document.querySelector("#dv-table tbody") as HTMLElement;
  if (!Number.isFinite(r.end_value) || !Number.isFinite(r.cash_total) || !Number.isFinite(r.gain)) {
    warn.hidden = false;
    warn.textContent = "Out of range — that growth is beyond what this projection can price. Try 100% or less.";
    t("dv-lbl").textContent = "Portfolio end value";
    t("dv-fig").textContent = "Out of range";
    t("dv-sub").textContent = "No confident total at this input — lower the growth rates.";
    t("dv-sh").textContent = "—";
    t("dv-yld").textContent = "—";
    t("dv-cash").textContent = "—";
    tb.innerHTML = "";
    return;
  }
  warn.hidden = true;
  warn.textContent = "";
  t("dv-lbl").textContent = drip ? "Portfolio end value" : "Total value incl. cash dividends";
  t("dv-fig").textContent = drip ? nn(r.end_value) : nn(r.end_value + r.cash_total);
  t("dv-sub").textContent = `Cash dividends ${nn(r.cash_total)} · gain ${nn(r.gain)} · CAGR ${(r.cagr * 100).toFixed(1)}%`;
  t("dv-sh").textContent = formatGrouped(r.shares, 2);
  t("dv-yld").textContent = (r.yield * 100).toFixed(2) + "%";
  t("dv-cash").textContent = nn(r.cash_total);
  tb.innerHTML = "";
  for (const y of r.yearly) {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td></td><td class="n"></td><td class="n"></td><td class="n"></td><td class="n"></td>`;
    (tr.children[0] as HTMLElement).textContent = String(y.year);
    (tr.children[1] as HTMLElement).textContent = nn(y.price, 2);
    (tr.children[2] as HTMLElement).textContent = formatGrouped(y.shares, 2);
    (tr.children[3] as HTMLElement).textContent = nn(y.dividend);
    (tr.children[4] as HTMLElement).textContent = nn(y.value);
    tb.appendChild(tr);
  }
}
  sfEmpty(sfIsEmpty("dividend-calculator", gv));
["dv-inv", "dv-pg", "dv-dg", "dv-yrs"].forEach((id) => g(id).addEventListener("input", render));
["dv-stock", "dv-drip"].forEach((id) => (document.getElementById(id) as HTMLSelectElement).addEventListener("change", render));
smartFields.register(TOOL_FIELDS["dividend-calculator"]);
sfBind("dividend-calculator", gv);
render();
</script>
