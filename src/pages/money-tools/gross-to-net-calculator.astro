---
import ToolShell from "../../components/ToolShell.astro";
import { reverseGross } from "../../lib/gross-to-net";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
const seed = reverseGross(250000, 0.08);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Net to Gross Salary Calculator (Take-Home to Salary), Nigeria - GWill Finance" description="What gross salary do you need for your target take-home? Reverse-solved through NTA 2025 PAYE with pension and reliefs." slug="gross-to-net-calculator" tool="Net to Gross (Take-Home to Salary)" lede="Start from the take-home you want, work backwards to the gross you must negotiate — pension, NHF, and rent relief accounted for." verified="Reverse-solved over NTA 2025 PAYE · 8% pension default" faqs={[
  { q: "Why is the gross so much higher than my target?", a: "Pension (8%) comes off even in the minimum-wage exempt zone, then PAYE stacks on top. The gap is real — negotiate to the gross, not the net." },
  { q: "Does rent lower the gross I need?", a: "Yes — 20% of annual rent (capped ₦500k) cuts taxable income, so slightly less gross reaches the same net." },
]}

  badge="Reverse PAYE · NTA 2025",
  copy={[["p", "Most salary discussions start from gross, the figure on your offer letter, and work forward to the net that arrives in your account. But when you are negotiating, planning a budget or comparing two offers, it is often more useful to start from the take-home you need and ask: what gross produces that? Because PAYE rises with gross, there is exactly one gross for any given net, and this calculator finds it precisely."],["p", "The calculator applies the current NTA 2025 schedule: a 0% band on the first ₦800,000 of annual taxable income, progressive 15% to 25% bands above that, a rent relief of 20% of annual rent (capped ₦500,000), and a complete minimum-wage exemption for those earning ₦70,000 a month or less. Because the first slice is tax-free, the relationship between gross and net is not linear, which is exactly why a simple multiplier fails and a proper solver is needed."],["p", "If an employer quotes a net figure (\"you will take home ₦X\"), this tells you what the actual gross is, and whether that is competitive. If you want a specific take-home, say, ₦300,000, this shows the gross offer you should ask for, and the tax gap between gross and net that your employer will deduct."],["p", "The gap between your gross and net is more than just PAYE. The breakdown table shows each piece: the pension contribution (8% by default), the National Housing Fund, NHIS, any life assurance and other reliefs you claim, and the rent relief that lowers your taxable income. Each deduction and relief moves the gross you need in a different direction, more deductions mean you need a higher gross for the same take-home, while more reliefs mean you need a lower one."],["p", "Under the Nigeria Tax Act 2025, you pay no income tax on an employment if your gross income from that employment is at or below the national minimum wage (NTA 2025, s.163(1)(t)). This is a different thing from the ₦800,000 zero-rate band, which applies to your chargeable income once you are taxable. Last verified 11 Oct 2026 · NTA s.163(1)(t) (nta2025.txt:4407-4408) · s.58(1) (nta2025.txt:1877-1880). Pension still comes off first, so the gross you need sits about 8.7% above the net at the default 8% pension (a ₦60,000 target needs about ₦65,217 gross) — with no PAYE on top."],["p", "This calculator works backward, net to gross. To go the other way, from a salary you have been offered to the take-home you will actually receive, use our Nigeria Tax Calculator. It also compares the old and new tax bands and shows how much the Nigeria Tax Act 2025 saves you."],["h2", "Net to gross questions"],["h3", "How do I find gross salary from net pay?"],["p", "Because PAYE rises with gross salary, the calculator binary-searches the gross that produces your target take-home under the current Nigeria Tax Act 2025 bands, so the two always agree exactly."],["h3", "What gross salary gives me ₦250,000 take home per month?"],["p", "About ₦308,192 a month before tax, assuming the default 8% pension, no NHF and no rent relief. The calculator shows the PAYE and deductions too."],["h3", "How is this different from the salary tax calculator?"],["p", "The salary tax calculator goes forward, gross in, net out. This one reverses it: you tell it the net you want, it returns the gross you must earn."],["h3", "Does rent relief change the gross I need?"],["p", "Yes. Rent relief lowers your taxable income, so with rent relief you need a slightly lower gross to hit the same take-home. Enter your annual rent to see the effect."]]},
  disclaimer="This calculator is for informational guidance only and is not tax, payroll or financial advice. Figures follow the Nigeria Tax Act 2025 with assumed deductions, confirm your exact salary and tax with your employer or a licensed adviser.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<div class="tgrid c3">

<div class="field" data-cur="NGN"><label for="gn-net">Target take-home ₦/mo</label><input id="gn-net" type="text" value="250000" inputmode="decimal"></div>
<div class="field"><label for="gn-pen">Pension %</label><input id="gn-pen" type="text" max="100" value="8" inputmode="decimal"></div>
<div class="field" data-cur="NGN"><label for="gn-rent">Annual rent ₦</label><input id="gn-rent" type="text" value="0" inputmode="decimal"></div>
<div class="field" data-cur="NGN"><label for="gn-nhf">NHF monthly ₦</label><input id="gn-nhf" type="text" value="0" inputmode="decimal"></div>
<div class="field" data-cur="NGN"><label for="gn-nhis">NHIS monthly ₦</label><input id="gn-nhis" type="text" value="0" inputmode="decimal"></div>
<div class="field" data-cur="NGN"><label for="gn-life">Life assurance monthly ₦</label><input id="gn-life" type="text" value="0" inputmode="decimal"></div>
<div class="field" data-cur="NGN"><label for="gn-other">Other reliefs monthly ₦</label><input id="gn-other" type="text" value="0" inputmode="decimal"></div>
</div>
<p class="hint" id="gn-dedwarn" hidden></p>
<div class="receipt">
<p class="receipt-lbl">Gross to negotiate</p>
<p class="receipt-fig" id="gn-fig" aria-live="polite">₦{n(seed.gross_monthly)}</p>
<p class="receipt-sub" id="gn-sub">Nets ₦{n(seed.net_monthly)}/mo after ₦{n(seed.tax_monthly)} tax{seed.exempt ? " · EXEMPT (minimum wage)" : ""}</p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row"><span>Pension /mo</span><b id="gn-pen2">₦{n(seed.pension_monthly)}</b></div>
<div class="receipt-row"><span>NHF /mo</span><b id="gn-nhf2">₦{n(seed.nhf_monthly)}</b></div>
<div class="receipt-row"><span>NHIS /mo</span><b id="gn-nhis2">₦{n(seed.nhis_monthly)}</b></div>
<div class="receipt-row"><span>Life assurance /mo</span><b id="gn-life2">₦{n(seed.life_monthly)}</b></div>
<div class="receipt-row"><span>Other reliefs /mo</span><b id="gn-other2">₦{n(seed.other_monthly)}</b></div>
<div class="receipt-row"><span>Rent relief /mo</span><b id="gn-rel">₦{n(seed.relief_monthly)}</b></div>
<div class="receipt-row"><span>Deductions /mo</span><b id="gn-ded">₦{n(seed.deductions_monthly)}</b></div>
<p class="bar-note" id="gn-warn" hidden></p>
<p class="receipt-foot">NTA 2025 bands · binary-solved · pension figured on gross as basic</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
</div>
</ToolShell>
<script>
import { reverseGross } from "../../lib/gross-to-net";
import { formatGrouped } from "../../lib/format";
import { pm, pmBlank } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig } from "../../data/tool-fields";
const n = (v: number) => "₦" + formatGrouped(v, 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
/* THE ZERO LAW. The gross is SOLVED from the target take-home, so every row on
   this page hangs off gn-net: an uncleared target must not print a gold ₦0
   "gross to negotiate", and each relief row additionally waits on its own
   field, because gross × 0% relief is a deduction the visitor never claimed. */
const ALL = ["gn-net", "gn-pen", "gn-rent", "gn-nhf", "gn-nhis", "gn-life", "gn-other"];
function render() {
  const netRaw = pm(g("gn-net").value);
  const penRaw = pm(g("gn-pen").value);
  const rentRaw = pm(g("gn-rent").value);
  const net = Math.max(0, netRaw || 0);
  const pen = Math.min(100, Math.max(0, penRaw || 0)) / 100;
  const rent = Math.max(0, rentRaw || 0);
  const nhf = Math.max(0, pm(g("gn-nhf").value) || 0);
  const nhis = Math.max(0, pm(g("gn-nhis").value) || 0);
  const life = Math.max(0, pm(g("gn-life").value) || 0);
  const other = Math.max(0, pm(g("gn-other").value) || 0);
  const r = reverseGross(net, pen, nhf, rent, nhis, life, other);
  sfFig(t("gn-fig"), ALL, n(r.gross_monthly));
  sfFig(t("gn-sub"), ALL, `Nets ${n(r.net_monthly)}/mo after ${n(r.tax_monthly)} tax${r.exempt ? " · EXEMPT (minimum wage)" : ""}`);
  sfFig(t("gn-pen2"), ["gn-net", "gn-pen"], n(r.pension_monthly));
  sfFig(t("gn-nhf2"), ["gn-net", "gn-nhf"], n(r.nhf_monthly));
  sfFig(t("gn-nhis2"), ["gn-net", "gn-nhis"], n(r.nhis_monthly));
  sfFig(t("gn-life2"), ["gn-net", "gn-life"], n(r.life_monthly));
  sfFig(t("gn-other2"), ["gn-net", "gn-other"], n(r.other_monthly));
  sfFig(t("gn-rel"), ["gn-net", "gn-rent"], n(r.relief_monthly));
  sfFig(t("gn-ded"), ALL, n(r.deductions_monthly));
  const notes: string[] = [];
  if (!(netRaw > 0)) notes.push("Enter a target take-home above ₦0 — the gross waits until you do.");
  if (netRaw < 0 || penRaw < 0 || rentRaw < 0) notes.push("Negative entries are treated as ₦0.");
  if (penRaw > 100) notes.push("Pension capped at 100%.");
  // Solver ceiling, B3 (v0.7.55): the engine now REPORTS saturation itself —
  // `unreachable` is true when the capped search's net at the ₦100M/mo ceiling
  // still sits below the target — so the page prints the honest message off the
  // engine's word instead of re-deriving it from the returned figures.
  if (r.unreachable) notes.push("Out of range — that take-home is beyond this solver's ₦100M/month ceiling. Lower the target.");
  else if (netRaw > 100000000) notes.push("That target looks unusually large — double-check the figure.");
  /* #5 hard caps (v0.7.55) — the input-side inline nudge: on this page the
     visitor types the fixed deductions directly, so the nudge fires when NHF +
     NHIS + life + other already exceed the take-home being targeted — the
     solver will price a much higher gross to carry them. */
  const netKnown = !pmBlank(g("gn-net").value);
  const dedFixed = nhf + nhis + life + other;
  const dedWarn = t("gn-dedwarn");
  if (netKnown && dedFixed > net) {
    dedWarn.hidden = false;
    dedWarn.textContent = `Heads-up — NHF + NHIS + life assurance + other reliefs add up to ${n(dedFixed)}/mo, above the ${n(net)}/mo take-home you're targeting. The solver will price a much higher gross to carry them; check the deduction fields.`;
  } else {
    dedWarn.hidden = true;
    dedWarn.textContent = "";
  }
  const w = t("gn-warn");
  w.hidden = notes.length === 0;
  w.textContent = notes.join(" ");
}
  sfEmpty(sfIsEmpty("gross-to-net-calculator", gv));
["gn-net", "gn-pen", "gn-rent", "gn-nhf", "gn-nhis", "gn-life", "gn-other"].forEach((id) => g(id).addEventListener("input", render));
smartFields.register(TOOL_FIELDS["gross-to-net-calculator"]);
sfBind("gross-to-net-calculator", gv);
render();
</script>
