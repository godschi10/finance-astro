---
import ToolShell from "../../components/ToolShell.astro";
import { loanRepayment, LOAN_SEED } from "../../lib/loan";
import { formatGrouped } from "../../lib/format";
const n = (v: number, d = 0) => formatGrouped(v, d);
const seed = loanRepayment(LOAN_SEED.amount, LOAN_SEED.tenor, LOAN_SEED.tenor_unit, LOAN_SEED.rate, LOAN_SEED.mode);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Loan Repayment Calculator, True APR - GWill Finance" description="Loan-app quote in, real cost out: installment, total interest, and the true effective APR behind flat, daily, and reducing-balance loans." slug="loan-repayment-calculator" tool="Loan Repayment Calculator" lede="Lenders quote rates that flatter themselves. Enter the quote exactly as advertised and see the installment, the total, and the real APR." verified="True APR solved from the repayment stream · lender quotes vary, confirm terms" faqs={[
  { q: "Why is the APR higher than the quoted rate?", a: "Flat-rate loans charge interest on the original balance all through, even as you repay. The APR reflects what you actually pay on money you actually still hold." },
  { q: "Daily vs monthly — which is worse?", a: "A small daily rate compounds brutally: 1% a day is thousands of percent APR. The receipt shows the annualized truth." },
]}

  badge="Loan cost · True APR",
  copy={[["p", "The single most misleading number in Nigerian lending is the quoted rate. Banks use a reducing (amortizing) annual rate, which is honest, the interest is recalculated each month on the balance you still owe. But most loan apps do not. They quote a \"flat\" rate: interest charged on the ORIGINAL amount every single month, even as you pay the balance down. A 1.5% flat monthly rate is not 18% a year; because you are paying interest on money you have already repaid, it works out closer to 35% a year. Some apps skip the pretense and quote a daily rate, 0.5% per day sounds small but annualizes to over 400%."],["p", "Take the default: ₦100,000 borrowed for 30 days at 1% per day. The interest is 1% of the original amount for each of 30 days, ₦1,000 a day, ₦30,000 in total. So you repay ₦130,000 on a ₦100,000 loan, a 30% interest charge in a single month. To compare that with a bank quote, the calculator converts it to an effective APR of well over 2,000%, that is not the rate a bank would quote you, but it is the honest annualized cost of what you just agreed to. That is precisely the gap this tool exists to expose."],["p", "Every lender can phrase its rate differently: \"1.5% flat\", \"0.5% per day\", \"30% per annum reducing\". These three can look similar on paper yet cost wildly different amounts. The effective APR strips away the phrasing by solving for the single annual rate at which the present value of your repayments exactly equals the loan. That one figure lets you line up a bank, a loan app and a POS advance side by side. If a lender will not tell you the effective APR, that is usually a sign the real cost is higher than the headline suggests."],["p", "Interest is only part of the cost. Many Nigerian lenders also deduct an upfront processing fee, a mandatory insurance or technology charge, or a \"commitment\" fee, often 3-5% of the amount, taken before you even receive the money. Those are additional cost on top of the rates this calculator models, and a true all-in APR should include them. When a lender quotes you a figure, always ask for the full schedule: amount you receive, every charge, and the total you repay."],["p", "Before you sign, get three things in writing. First, the effective APR, the single number this tool computes, and the one that lets you compare a bank to an app to a POS advance fairly. Second, the full repayment schedule: the exact installment, when it is due, and the total you will pay back including every charge. Third, what happens if you are late or fail to pay, the penalty rate, whether the lender reports to a credit bureau, and whether they can seize collateral or deduct directly from your account. A lender that is vague about any of these is usually the one to walk away from. A loan that looks cheap because of a small daily rate can be the most expensive money you ever borrow."],["p", "A loan is one side of your balance sheet. To build the emergency fund that keeps you from borrowing in the first place, use our emergency fund calculator. To see how much of your take-home a repayment really eats, our 50/30/20 budget calculator and budget allocator show where the money goes. And to plan how fast you can free up cash to clear the debt, our savings goal calculator charts the monthly amount you need."],["h2", "Loan repayment questions"],["h3", "What is a flat interest rate on a Nigerian loan?"],["p", "A flat rate charges interest on the original loan amount every month, even as you repay the balance. So \"1.5% flat per month\" costs far more than 18% a year, the effective APR is usually close to double the simple rate-times-twelve figure."],["h3", "Is a 5% monthly loan app rate expensive?"],["p", "Yes. A 5% flat monthly rate on a short tenor typically annualizes to well over 100%. Even at a longer tenor it is far above the 25-35% a formal bank loan costs. Use the effective APR on this calculator to judge it honestly."],["h3", "Does this calculator include loan fees?"],["p", "It models the interest in the rate you enter. Upfront processing, insurance or commitment fees are separate and add to the true cost, include them when comparing a total."],["h3", "How is the effective APR calculated?"],["p", "The calculator finds the interest rate at which the present value of your repayments exactly equals the amount borrowed, then annualizes it. For example, ₦100,000 borrowed for 30 days at 1% per day costs about ₦130,000 to repay, an effective APR of about 2,333.9%. That is the honest way to compare loans with different quoted rates and terms."]]},
  related={[{ href: `${base}articles/cheapest-way-receive-dollars-nigeria/`, title: "Cheapest Way to Receive Dollars in Nigeria (2026 Compared)", excerpt: "Wise, Grey, Geegpay, and domiciliary accounts compared on fees, speed, and exchange margins." }, { href: `${base}articles/grey-vs-geegpay-dollar-account/`, title: "Grey vs Geegpay: Which Dollar Account Should You Open?", excerpt: "Account opening, conversion spreads, card support, and payout speed — tested with real transfers." }, { href: `${base}articles/piggyvest-vs-cowrywise-2026/`, title: "PiggyVest vs Cowrywise in 2026: Which Saves You More?", excerpt: "Interest rates, withdrawal rules, fees, and app experience compared side by side." }, { href: `${base}articles/ngn-dollar-cost-averaging-guide/`, title: "Dollar-Cost Averaging Into NGX Stocks on a \u20a650k Salary", excerpt: "A step-by-step plan for buying Nigerian stocks every month without timing the market." }]},
  disclaimer="This calculator is for informational guidance only and is not financial or lending advice. Figures reflect the interest rate you enter; lenders may add fees, and actual terms vary. Confirm the full repayment schedule with your lender before signing.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<div class="tgrid c3">

<div class="field"><label for="ln-amt">Loan amount ₦</label><input id="ln-amt" type="text" max="1000000000000" value={LOAN_SEED.amount} inputmode="decimal"></div>
<div class="field"><label for="ln-tenor">Tenor</label><input id="ln-tenor" type="number" min="1" max="600" step="1" value={LOAN_SEED.tenor} inputmode="numeric"></div>
<div class="field"><label for="ln-unit">Tenor unit</label><select id="ln-unit"><option value="days" selected>Days</option><option value="months">Months</option></select></div>
<div class="field"><label for="ln-rate">Quoted rate %</label><input id="ln-rate" type="text" value={LOAN_SEED.rate} inputmode="decimal"></div>
<div class="field"><label for="ln-mode">Rate type</label><select id="ln-mode"><option value="daily" selected>Per day (loan apps)</option><option value="flat">Flat per month</option><option value="reducing">Reducing balance</option></select></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">You repay <span id="ln-period">{seed.period}</span></p>
<p class="receipt-fig" id="ln-fig">₦{n(seed.installment)}</p>
<p class="receipt-sub" id="ln-sub">Total ₦{n(seed.total)} · interest ₦{n(seed.interest)} · true APR {(seed.apr * 100).toFixed(1)}%</p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row"><span>Total repaid</span><b id="ln-tot">₦{n(seed.total)}</b></div>
<div class="receipt-row"><span>Interest</span><b id="ln-int">₦{n(seed.interest)}</b></div>
<div class="receipt-row"><span>True APR</span><b id="ln-apr">{(seed.apr * 100).toFixed(1)}%</b></div>
<p class="receipt-foot">APR solved from the repayment stream · day tenors round up to whole months · lender fees excluded</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
</div>
</ToolShell>
<script>
import { loanRepayment } from "../../lib/loan";
import { formatGrouped } from "../../lib/format";
import { pm } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind } from "../../data/tool-fields";
const nn = (v: number) => "₦" + formatGrouped(v, 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
function render() {
  const r = loanRepayment(
    Math.max(0, pm(g("ln-amt").value) || 0),
    Math.max(1, Math.trunc(pm(g("ln-tenor").value) || 1)),
    (document.getElementById("ln-unit") as HTMLSelectElement).value,
    Math.max(0, pm(g("ln-rate").value) || 0),
    (document.getElementById("ln-mode") as HTMLSelectElement).value,
  );
  t("ln-period").textContent = r.period;
  if (!Number.isFinite(r.installment) || !Number.isFinite(r.total) || !Number.isFinite(r.interest) || !Number.isFinite(r.apr)) {
    t("ln-fig").textContent = "Out of range";
    t("ln-sub").textContent = "No confident total at this input — lower the amount, tenor, or rate.";
    t("ln-tot").textContent = "—";
    t("ln-int").textContent = "—";
    t("ln-apr").textContent = "—";
    return;
  }
  t("ln-fig").textContent = nn(r.installment);
  t("ln-sub").textContent = `Total ${nn(r.total)} · interest ${nn(r.interest)} · true APR ${(r.apr * 100).toFixed(1)}%`;
  t("ln-tot").textContent = nn(r.total);
  t("ln-int").textContent = nn(r.interest);
  t("ln-apr").textContent = (r.apr * 100).toFixed(1) + "%";
}
  sfEmpty(sfIsEmpty("loan-repayment-calculator", gv));
["ln-amt", "ln-tenor", "ln-rate"].forEach((id) => g(id).addEventListener("input", render));
(document.getElementById("ln-unit") as HTMLSelectElement).addEventListener("change", render);
(document.getElementById("ln-mode") as HTMLSelectElement).addEventListener("change", render);
smartFields.register(TOOL_FIELDS["loan-repayment-calculator"]);
sfBind("loan-repayment-calculator", gv);
render();
</script>
