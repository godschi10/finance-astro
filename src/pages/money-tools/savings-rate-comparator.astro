---
import ToolShell from "../../components/ToolShell.astro";
import { savingsRateData, savingsRateVerified } from "../../lib/savings-rate";
const rows = [...savingsRateData()].sort((a, b) => b.rate - a.rate);
const max = Math.max(...rows.map((r) => r.rate));
const verified = `Rates verified ${savingsRateVerified()} · indicative, not live quotes`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Best Savings Rates in Nigeria Compared - GWill Finance" description="Who pays the most on your savings right now: PiggyVest, Cowrywise, Kuda, FairMoney, Carbon, Renmoney and bank benchmarks, compared." slug="savings-rate-comparator" tool="Best Savings Rate in Nigeria" crumb="Savings Rate Comparator" lede="Headline annual rates, best first. These are marketing figures that move monthly — indicative, never live quotes." verified={verified} faqs={[
  { q: "Is the highest rate automatically best?", a: "No. Locked plans pay more but trap your money; flexible plans pay less but let you withdraw. Match the plan to when you need the cash." },
  { q: "How fresh are these rates?", a: "The table is a maintained snapshot, verified September 2026. Confirm the current figure with the provider before locking funds." },
]}

  badge="Rate tracker · updated September 2026",
  copy={[["p", "Right now the highest advertised headline rate is Renmoney at about 28.0% per annum. But that number comes with a big asterisk, it is almost always a LOCKED product. The trade-off is simple: the more you let a provider lock your money, the more it usually pays. A flexible account you can withdraw from any time pays a fraction of that. So the honest question is not just \"who pays the most\" but \"what am I willing to lock for how long?\""],["p", "Look at the gap in the chart. PiggyVest SafeLock pays up to ~18.5% but locks your money for 10-1000 days; PiggyVest Flex Naira, which you can withdraw from any time, pays ~12%. That ~6-point gap is the price of liquidity. Bank fixed deposits follow the same logic, higher than a regular savings account because your money is locked for a term. If you might need the cash next week, a locked plan hurts even at a higher headline rate. If the money is genuinely earmarked for next year, lock it and take the better rate."],["p", "A high rate means nothing if your money is not safe. Banks and CBN-licensed digital banks are covered by NDIC deposit insurance (up to ₦5 million per depositor per bank). Pure fintech savings platforms, and money market funds, are generally NOT deposit-insured the same way, your money sits in designated instruments, not an insured deposit. Ask two questions before chasing a rate: is the provider licensed, and is my deposit insured? The highest advertised number is often attached to the least-insured product."],["p", "Savings platform rates track the broader money market. When the CBN raises its monetary policy rate, yields across savings, fixed deposits and money market funds rise; when it cuts, they fall. That is why this comparison is a maintained snapshot, last verified on September 2026, and why a \"best rate today\" should always be rechecked: the number that was best last month may not be best next month. Use this tool to see today's rates, then confirm the live figure with the provider."],["p", "Two providers can advertise the same headline rate but feel completely different to save with, because of the starting bar. The money market fund in the chart wants a ₦100,000 minimum, fine if you are moving a lump sum, impossible if you are saving your first ₦5,000. The fintech products mostly start from ₦0, which is why a newer saver may actually get further with a slightly lower flexible rate they can build from nothing. Compare the minimum against your monthly savings ability before you let the headline number make the decision for you."],["p", "A headline rate is only half the story, the other half is what that rate actually grows into and whether it beats inflation. To work out what a platform&#039;s rate really earns you over time, use the compound interest calculator and the savings goal calculator to set an actual target. To see whether that rate keeps your money truly safe from rising prices, the inflation-adjusted savings calculator shows the real value, and the emergency fund calculator covers the liquid buffer you should hold before chasing yield."],["p", "When you compare a locked plan against a flexible one, stop staring at the headline and ask: (1) will I need this money within the lock period? If yes, pay the liquidity price and keep it flexible, the higher rate is not worth an emergency you cannot fund. (2) Is the extra yield worth the product&#039;s risk? A pure fintech platform paying 28% may not be NDIC-insured, while a bank FD at a lower rate keeps your deposit covered. The best rate is the one you can actually leave alone, so pick the term and the insurer before you pick the number."],["h2", "Savings rate questions"],["h3", "Which platform pays the highest savings interest in Nigeria?"],["p", "As of the latest update, Renmoney advertises the highest headline rate at about 28.0% per annum. Rates move, so treat this as an indicative snapshot, confirm with the provider. The locked-vs-flexible trade-off matters more than the headline."],["h3", "Is the highest rate always the best?"],["p", "No. A locked product paying more may not suit you if you need the money soon. Also check NDIC coverage, minimum deposits, and exit penalties. Match the product to your horizon, not just the number."],["h3", "Are these live rates?"],["p", "No, they are a maintained snapshot, last verified in September 2026, from providers&#039; advertised rates. Always confirm the current figure with the provider before committing."],["h3", "Should I save with a fintech or a bank?"],["p", "Fintech platforms often pay more, but check licensing and deposit insurance. CBN-licensed digital banks and commercial banks are NDIC-insured; many standalone savings apps are not. For large sums, the insurance coverage matters as much as the rate."]]},
  related={[{ href: `${base}articles/piggyvest-vs-cowrywise-2026/`, title: "PiggyVest vs Cowrywise in 2026: Which Saves You More?", excerpt: "Interest rates, withdrawal rules, fees, and app experience compared side by side." }, { href: `${base}articles/ngn-dollar-cost-averaging-guide/`, title: "Dollar-Cost Averaging Into NGX Stocks on a \u20a650k Salary", excerpt: "A step-by-step plan for buying Nigerian stocks every month without timing the market." }, { href: `${base}articles/kuda-vs-traditional-banks-charges/`, title: "Kuda vs Traditional Banks: The Real Cost of Free Transfers", excerpt: "Card fees, failed-transfer reversals, and support tested — what digital banks actually save you." }]},
  disclaimer="This comparator is for informational guidance only and is not financial advice. Rates are indicative maintained figures that change; verify with each provider before committing. Nothing here is a guarantee of returns or deposit insurance.">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<div class="field" style="max-width:320px;margin-top:18px"><label for="sr-amt">Test an amount (₦)</label><input id="sr-amt" type="text" value="500000" inputmode="decimal"><p class="hint">Yearly interest each plan would pay on it.</p></div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Top payer · <span id="sr-top">{rows[0].provider} {rows[0].product}</span></p>
<p class="receipt-fig" id="sr-fig">{rows[0].rate.toFixed(1)}%</p>
<p class="receipt-sub" id="sr-sub">on ₦500,000 ≈ ₦{(500000 * rows[0].rate / 100).toLocaleString("en-US", { maximumFractionDigits: 0 })} a year</p>
<div class="receipt-div" aria-hidden="true"></div>
<p class="receipt-note">Indicative marketing rates — confirm before you lock funds.</p>
<p class="receipt-note" id="sr-warn" hidden></p>
<p class="receipt-foot">{verified}</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
<div class="hr"></div>
<h2 class="tool-h2">Every plan, best first</h2>
<div id="sr-bars">
{rows.map((r) => (
<div class="bar-row" data-sr-rate={r.rate}>
<div class="bar-top"><span><b>{r.provider}</b> · {r.product} <span class="bar-note">({r.type})</span></span><b data-sr-out>{r.rate.toFixed(1)}%</b></div>
<div class="bar" aria-hidden="true"><i style={`width:${(r.rate / max * 100).toFixed(1)}%`}></i></div>
<p class="bar-note" data-sr-note>{r.note}</p>
</div>
))}
</div>
<div class="hr"></div>
<h2 class="tool-h2">Full table</h2>
<div class="st-wrap"><table class="st">
<thead><tr><th>Provider</th><th>Product</th><th class="n">Rate %/yr</th><th class="n">Min ₦</th></tr></thead>
<tbody>
{rows.map((r, i) => (
<tr class={i === 0 ? "win" : ""}><td>{r.provider}{i === 0 && <span class="btag">Best</span>}</td><td>{r.product}</td><td class="n">{r.rate.toFixed(1)}%</td><td class="n">{r.min.toLocaleString("en-US")}</td></tr>
))}
</tbody>
</table></div>
</ToolShell>
<script>
import { savingsRateData } from "../../lib/savings-rate";
import { pm } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig } from "../../data/tool-fields";
const rows = [...savingsRateData()].sort((a, b) => b.rate - a.rate);
const max = Math.max(...rows.map((r) => r.rate));
const amt = document.getElementById("sr-amt") as HTMLInputElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
function render() {
  /* F8 — a typed negative is clamped to a 0 test amount above; say so in this
     rail (which nothing else writes to) instead of pricing -x as ₦0 silently. */
  const srNeg = pm(amt.value) < 0;
  (document.getElementById("sr-warn") as HTMLElement).hidden = !srNeg;
  (document.getElementById("sr-warn") as HTMLElement).textContent = srNeg ? "Negative entries are treated as ₦0." : "";
  const a = Math.max(0, pm(amt.value) || 0);
  const fmt = (n: number) => "₦" + Math.round(n).toLocaleString("en-US");
  const top = rows[0];
  /* THE ZERO LAW. sr-fig is the plan's own rate — it reads nothing the visitor
     can clear, so it always prints. Everything that multiplies THAT RATE by the
     test amount waits on the amount. */
  (document.getElementById("sr-fig") as HTMLElement).textContent = top.rate.toFixed(1) + "%";
  sfFig(document.getElementById("sr-sub") as HTMLElement, ["sr-amt"], `on ${fmt(a)} ≈ ${fmt(a * top.rate / 100)} a year` + (a < top.min ? ` · below the ${fmt(top.min)} minimum — not eligible at this amount` : ""));
  document.querySelectorAll("#sr-bars .bar-row").forEach((el, i) => {
    const r = rows[i];
    sfFig(el.querySelector("[data-sr-out]") as HTMLElement, ["sr-amt"], `${r.rate.toFixed(1)}% · ${fmt(a * r.rate / 100)}/yr` + (a < r.min ? ` · needs min ${fmt(r.min)}` : ""));
    ((el.querySelector(".bar i") as HTMLElement).style.width = (r.rate / max * 100).toFixed(1) + "%");
  });
}
  sfEmpty(sfIsEmpty("savings-rate-comparator", gv));
amt.addEventListener("input", render);
smartFields.register(TOOL_FIELDS["savings-rate-comparator"]);
sfBind("savings-rate-comparator", gv);
render();
</script>
