---
import ToolShell from "../../components/ToolShell.astro";
import { fxHistorySummary } from "../../lib/fx-history";
import { fxNumber } from "../../lib/fx";
import { FX_SNAPSHOT } from "../../data/fx-snapshot";
// SSG: honest snapshot anchor only — the trend paints client-side from the
// live feed plus points your device has collected (never invented history).
const anchor = FX_SNAPSHOT.rates.NGN;
const seed = fxHistorySummary([{ date: "2026-09-01", ngn: anchor }], anchor);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Dollar to Naira Trend, 30/90-Day & 1-Year History - GWill Finance" description="USD to NGN trend over 30 days, 90 days or 12 months. The chart builds from live feed points your device collects — no invented history." slug="exchange-rate-history" tool="$ USD to Naira Rate History" crumb="Rate History Chart" lede="The dollar-naira rate steps, it does not drift. Watch the window below — every point is a real fetched rate, timestamped." verified={`Snapshot anchor ₦${anchor.toLocaleString("en-US", { maximumFractionDigits: 0 })} · ${FX_SNAPSHOT.as_of} — live points added on each visit`} faqs={[
  { q: "Where does the history come from?", a: "Your browser fetches the current rate on each visit and keeps dated points on this device. No backfilled or invented points — the chart starts empty and earns its shape." },
  { q: "Which windows can I view?", a: "30 days, 90 days, or 12 months — the windows that matter for sending, pricing, and holding decisions. Older points age out automatically." },
]}

  badge="Live trend · US Dollar to Naira · updated daily",
  copy={[["h2", "How to read the USD to naira trend"],["p", "The line above plots the number of naira one $ buys on each recorded day. When the line rises, the naira is weakening (your naira buys fewer USD); when it falls, the naira is strengthening. The stat strip summarises the change: the 30-day figure tells you whether the last month has moved in your favour or against it."],["p", "A falling USD-to-naira line is good news if you buy foreign currency for tuition, travel or imports, you need fewer naira. It is bad news if you earn naira and hold foreign savings, or if you run a business that imports. The converse is true when the line climbs. The trend is how you size the risk before you move money."],["h2", "Why the naira moves in steps, not smoothly"],["p", "The official USD/NGN rate does not drift continuously, it adjusts in steps around FX-policy decisions, currency-supply changes and market demand. That is why the chart shows distinct points joined by straight lines rather than a smoothed curve: each point is a real recorded rate for that date, and the gaps between them are exactly where the market held steady before stepping again."],["p", "This is why the daily movement can look small while a month or a quarter shows a meaningful shift. A 30-day view smooths out the daily noise; a 90-day or 1-year view reveals the underlying direction. For someone planning a large transfer or a dollar-denominated purchase, the longer window is the one that matters, the daily spread is noise, but the trend decides your cost."],["h2", "Official rate vs the street rate in the trend"],["p", "This chart tracks the official mid-market rate. When USD is the base, the parallel (street) rate trades at a spread above it, use the converter's \"Parallel market\" toggle to see that estimate alongside. Tracking both over time is how experienced Nigerians read where the real cost of foreign exchange is heading."],["p", "The gap between the official and parallel rate is the practical cost of limited dollar supply. A widening gap usually signals tighter supply or higher demand; a narrowing gap suggests the market is easing. If you plan to convert naira in the near term, checking both the trend and the current spread tells you whether to move now or wait."],["h2", "How to use the history chart to time a transfer"],["p", "Read the 30-day change first: is the naira gaining or losing ground against this currency? Then switch to the 6-month or 1-year view to confirm the trend is real and not a short-term wobble. Finally, compare against the parallel rate in the converter. Nobody can call the exact bottom, but the combination of a real trend and a realistic spread tells you whether converting today is a fair deal or an expensive one."],["h2", "Rate history questions"],["h3", "When does the chart update?"],["p", "Daily, matching the source&#039;s daily snapshots. The current point always reflects the latest published rate."],["h3", "Are these real rates or estimates?"],["p", "Real recorded rates from an openly-licensed currency dataset, cached briefly on our server. We never fabricate a trend, the line connects genuine data points."],["h3", "Is this the rate my bank will give me?"],["p", "No, this is the official mid-market rate. Banks, bureaux and platforms add a margin on top, and the parallel market trades higher. Use the main converter to get the live figure."]]},
  disclaimer="Rates are indicative and sourced from openly-licensed daily data. They are not a quote and do not constitute financial advice. Confirm the live rate before any transaction.", ogImage={{ url: `${base}images/og/tool-exchange-rate-history.png`, width: 1200, height: 630, alt: "$ USD to Naira Rate History" }}>
<div class="fx-card">
<div class="tgrid c2">
<div class="field"><label for="xh-days">Window</label><select id="xh-days"><option value="30" selected>Last 30 days</option><option value="90">Last 90 days</option><option value="365">Last 12 months</option></select></div>
<div class="field"><label for="xh-base">Base</label><select id="xh-base" disabled><option>USD → NGN (more coming)</option></select></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">USD → NGN · <span id="xh-n">0 points on this device</span></p>
<p class="receipt-fig" id="xh-fig">₦{fxNumber(seed.current, 0)}</p>
<p class="receipt-sub" id="xh-sub">Snapshot — the live rate loads on each visit</p>
<div class="receipt-div" aria-hidden="true"></div>
<div id="xh-chart" role="img" aria-label="Dollar to naira trend chart"></div>
<p class="receipt-foot" id="xh-foot">Snapshot · {FX_SNAPSHOT.as_of}</p>
</div>
</div>
</ToolShell>
<script>
import { fxHistoryRange, fxHistorySummary } from "../../lib/fx-history";
import { fxNumber, fxFetchLive } from "../../lib/fx";
import { FX_SNAPSHOT } from "../../data/fx-snapshot";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS } from "../../data/tool-fields";
const KEY = "gwill-fx-pts";
type Pt = { date: string; ngn: number };
function load(): Pt[] {
  try {
    const raw = localStorage.getItem(KEY);
    if (!raw) return [];
    const arr = JSON.parse(raw);
    return Array.isArray(arr) ? arr.filter((p) => p && p.date && p.ngn > 0).slice(-365) : [];
  } catch { return []; }
}
function save(pts: Pt[]) { try { localStorage.setItem(KEY, JSON.stringify(pts.slice(-365))); } catch {} }
function draw(pts: Pt[]) {
  const box = document.getElementById("xh-chart") as HTMLElement;
  if (pts.length < 2) {
    box.innerHTML = `<p class="receipt-note">Not enough history points yet — visit again and the trend starts here.</p>`;
    return;
  }
  const w = 640, h = 220, pt = 24, pb = 28, pl = 52, pr = 16;
  const vals = pts.map((p) => p.ngn);
  const min = Math.min(...vals), max = Math.max(...vals);
  const span = Math.max(1e-9, max - min);
  const lo = min - span * 0.1, hi = max + span * 0.1, rg = hi - lo;
  const X = (i: number) => pl + (i / (pts.length - 1)) * (w - pl - pr);
  const Y = (v: number) => pt + (1 - (v - lo) / rg) * (h - pt - pb);
  const line = pts.map((p, i) => `${X(i).toFixed(1)},${Y(p.ngn).toFixed(1)}`).join(" ");
  box.innerHTML = `<svg viewBox="0 0 ${w} ${h}" style="width:100%;height:auto;display:block" role="img" aria-label="US dollar to naira trend">` +
    `<polyline points="${line}" fill="none" stroke="var(--gold-b)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/></svg>`;
}
async function render() {
  const days = Number((document.getElementById("xh-days") as HTMLSelectElement).value) || 30;
  let pts = load();
  try {
    const ctl = new AbortController();
    const t = setTimeout(() => ctl.abort(), 8000);
    const live = await fxFetchLive(ctl.signal);
    clearTimeout(t);
    if (live.rates?.["NGN"] > 0) {
      const today = new Date().toISOString().slice(0, 10);
      if (!pts.length || pts[pts.length - 1].date !== today) {
        pts = [...pts, { date: today, ngn: Number(live.rates["NGN"]) }];
        save(pts);
      }
    }
  } catch { /* stored points stand */ }
  const win = fxHistoryRange(pts, days);
  const s = fxHistorySummary(win.length ? win : [{ date: "2026-09-01", ngn: FX_SNAPSHOT.rates.NGN }], FX_SNAPSHOT.rates.NGN);
  (document.getElementById("xh-n") as HTMLElement).textContent = `${win.length} point${win.length === 1 ? "" : "s"} on this device`;
  (document.getElementById("xh-fig") as HTMLElement).textContent = "₦" + fxNumber(s.current, 0);
  const arrow = s.change === 0 ? "–" : s.direction === "up" ? "▲" : "▼";
  (document.getElementById("xh-sub") as HTMLElement).textContent = win.length > 1
    ? s.change === 0
      ? `– No movement across the window · holding ₦${fxNumber(s.current, 0)}`
      : `${arrow} ₦${fxNumber(Math.abs(s.change), 0)} (${s.change_pct.toFixed(1)}%) across the window · low ₦${fxNumber(s.min, 0)} · high ₦${fxNumber(s.max, 0)}`
    : "Snapshot — the live rate loads on each visit";
  (document.getElementById("xh-foot") as HTMLElement).textContent = win.length > 1 ? `${win.length} device-collected points` : "Snapshot · Sep 2026";
  draw(win);
}
document.getElementById("xh-days")?.addEventListener("change", render);
/* Design spec §5 row 15: NO CHANGE to this tool's behaviour. It already owns the
   repo's only tool-scoped localStorage key and its only control is an integer
   day-window select, not a money input — so the table entry is empty and
   register() seeds nothing, remembers nothing and leaves Clear examples hidden. */
smartFields.register(TOOL_FIELDS["exchange-rate-history"]);
render();
</script>
