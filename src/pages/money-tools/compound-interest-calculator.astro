---
import ToolShell from "../../components/ToolShell.astro";
import { compoundGrowth, compoundSchedule } from "../../lib/savings";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
const seed = compoundGrowth(100000, 50000, 0.10, 60, "monthly", "monthly");
const rows = compoundSchedule(100000, 50000, 0.10, 60, "monthly", "monthly");
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Compound Interest Calculator, Nigeria - GWill Finance" description="Project compound growth with flexible deposits: principal, monthly top-ups, rate, and year-by-year balance schedule." slug="compound-interest-calculator" tool="Compound Interest Calculator" lede="Small deposits, boring consistency, absurd endings. Set your principal and top-up, then watch each year's balance in the schedule." verified="Monthly compounding default · deposit frequency aware" faqs={[
  { q: "Why does the schedule matter more than the final number?", a: "Because year three is where most people quit. Seeing the curve bend upward is what keeps the deposits going." },
  { q: "What rate should I assume?", a: "Use a rate you can actually get — check the savings-rate comparator — not the 30% a friend's plug promised." },
]}

  badge="Compound interest · Monthly compounding",
  copy={[["p", "Compound interest is interest earned on interest. Each month, your balance earns interest, and because that interest stays in the account, next month you earn interest on the original amount plus the interest from the month before. Over years, this compounding makes your balance accelerate: the growth is not a straight line but a curve that steepens with time."],["p", "The savings-goal calculator answers \"how much do I need to save each month to reach a target?\" This calculator answers the opposite question: \"if I put in this much, what will I end up with?\" Use both together, set a target, then see how different monthly contributions change your final balance."],["p", "Nigerian savings accounts, fixed deposits and money-market funds typically pay a few percent to low double-digits. Use a rate close to what your money will actually earn, a sky-high assumption looks impressive on screen but will not hold in reality, and a conservative one keeps your plan honest."],["p", "The more often interest is compounded, the faster your balance grows, daily compounding beats annual. And contributing more frequently (weekly vs monthly) makes a big difference, because more of your money starts earning interest sooner. Try the two frequency selectors above to see the swing."],["p", "This calculator projects how much you will HAVE. If you want to know how much to save to reach a specific target, use our savings goal calculator. And since inflation quietly shrinks any future goal, our inflation-adjusted calculator shows what you truly need. If you want to see how much your naira will buy in the future, the naira value calculator shows how inflation erodes purchasing power. If you hold dividend stocks instead, our dividend & ROI estimator projects the total return with reinvested (DRIP) versus cash dividends."],["p", "Take the default: ₦500,000 to start, ₦50,000 added each month, at 12% a year for 10 years. Over that decade you deposit ₦6,500,000 of your own money. Compound interest turns it into roughly ₦13.1 million, about ₦6.6 million of that is pure growth, more than double what you put in. That is the effect of leaving your money to compound instead of withdrawing the interest every month."],["p", "Notice how the year-by-year table accelerates: the first year adds a modest amount, but by the later years the interest each year is far larger. The earlier you start, and the longer you leave it, the more of the final balance is earned interest rather than your own deposits. This is why time in the market matters more than timing the market when it comes to savings."],["h2", "Compound interest questions"],["h3", "How is compound interest calculated?"],["p", "Each month, your balance earns interest, and that interest is added back into the balance, so next month you earn interest on the original amount plus last month's interest. Over time that compounding makes growth accelerate."],["h3", "How does the compound frequency change the result?"],["p", "The selector defaults to monthly compounding, but you can switch to quarterly, daily or annually. Daily compounding means interest is added more often, so it grows slightly faster than monthly; annual compounds once a year and grows slightly slower. The difference matters most over long horizons."],["h3", "How much will ₦500,000 grow to in 10 years at 12%?"],["p", "With ₦50,000 added each month, about ₦13,152,128, of which roughly ₦6,652,128 is interest earned on top of what you deposited."],["h3", "What does \"interest earned\" mean in the table?"],["p", "It is the difference between your final balance and the total you actually deposited, the pure growth that compounding produced on top of your own money."],["h3", "Why does the balance grow faster in later years?"],["p", "Because interest is earned on a larger base each month. Early on, growth is mostly your deposits; later, the accumulated interest starts earning its own interest, that is the compounding effect."],["h3", "What interest rate should I assume?"],["p", "Use a realistic rate for where your money sits, Nigerian savings accounts, fixed deposits or money-market funds. Higher assumed rates are not guaranteed."]]},
  disclaimer="This calculator is for informational guidance only and is not financial or investment advice. Rates are not guaranteed, confirm your plan with a licensed financial adviser.",>
<div class="fx-card">
<div class="tgrid c3">
<div class="field"><label for="ci-prin">Starting principal ₦</label><input id="ci-prin" type="number" min="0" step="any" value="100000" inputmode="decimal"></div>
<div class="field"><label for="ci-dep">Deposit per period ₦</label><input id="ci-dep" type="number" min="0" step="any" value="50000" inputmode="decimal"></div>
<div class="field"><label for="ci-freq">Deposit frequency</label><select id="ci-freq"><option value="monthly" selected>Monthly</option><option value="weekly">Weekly</option><option value="biweekly">Bi-weekly</option><option value="quarterly">Quarterly</option><option value="annual">Annual</option></select></div>
<div class="field"><label for="ci-rate">Annual rate %</label><input id="ci-rate" type="number" min="0" step="any" value="10" inputmode="decimal"></div>
<div class="field"><label for="ci-yrs">Years</label><input id="ci-yrs" type="number" min="1" step="1" value="5" inputmode="numeric"></div>
<div class="field"><label for="ci-cmp">Compounding</label><select id="ci-cmp"><option value="monthly" selected>Monthly</option><option value="quarterly">Quarterly</option><option value="daily">Daily</option><option value="annual">Annual</option></select></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Future value</p>
<p class="receipt-fig" id="ci-fig">₦{n(seed.future)}</p>
<p class="receipt-sub" id="ci-sub">You put in ₦{n(seed.deposited)} · interest earned ₦{n(seed.interest)}</p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row"><span>Deposited</span><b id="ci-dep2">₦{n(seed.deposited)}</b></div>
<div class="receipt-row"><span>Interest</span><b id="ci-int">₦{n(seed.interest)}</b></div>
<p class="receipt-foot">Compounding does the heavy lifting</p>
</div>
</div>
<div class="hr"></div>
<h2 class="tool-h2">Year by year</h2>
<div class="st-table-wrap"><table class="st-table" id="ci-table">
<thead><tr><th>Year</th><th class="n">Balance</th><th class="n">Deposited</th><th class="n">Interest</th></tr></thead>
<tbody>
{rows.map((r) => (<tr><td>{r.year}</td><td class="n">₦{n(r.balance)}</td><td class="n">₦{n(r.deposited)}</td><td class="n">₦{n(r.interest)}</td></tr>))}
</tbody>
</table></div>
</ToolShell>
<script>
import { compoundGrowth, compoundSchedule } from "../../lib/savings";
import { formatGrouped } from "../../lib/format";
const nn = (v: number) => "₦" + formatGrouped(v, 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const sel = (id: string) => (document.getElementById(id) as HTMLSelectElement).value;
function render() {
  const p = Math.max(0, Number(g("ci-prin").value) || 0);
  const d = Math.max(0, Number(g("ci-dep").value) || 0);
  const rate = Math.max(0, Number(g("ci-rate").value) || 0) / 100;
  const yrs = Math.max(1, Math.trunc(Number(g("ci-yrs").value) || 5));
  const r = compoundGrowth(p, d, rate, yrs * 12, sel("ci-cmp"), sel("ci-freq"));
  t("ci-fig").textContent = nn(r.future);
  t("ci-sub").textContent = `You put in ${nn(r.deposited)} · interest earned ${nn(r.interest)}`;
  t("ci-dep2").textContent = nn(r.deposited);
  t("ci-int").textContent = nn(r.interest);
  const tb = document.querySelector("#ci-table tbody") as HTMLElement;
  tb.innerHTML = "";
  for (const row of compoundSchedule(p, d, rate, yrs * 12, sel("ci-cmp"), sel("ci-freq"))) {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td></td><td class="n"></td><td class="n"></td><td class="n"></td>`;
    (tr.children[0] as HTMLElement).textContent = String(row.year);
    (tr.children[1] as HTMLElement).textContent = nn(row.balance);
    (tr.children[2] as HTMLElement).textContent = nn(row.deposited);
    (tr.children[3] as HTMLElement).textContent = nn(row.interest);
    tb.appendChild(tr);
  }
}
["ci-prin", "ci-dep", "ci-rate", "ci-yrs"].forEach((id) => g(id).addEventListener("input", render));
["ci-freq", "ci-cmp"].forEach((id) => (document.getElementById(id) as HTMLSelectElement).addEventListener("change", render));
render();
</script>
