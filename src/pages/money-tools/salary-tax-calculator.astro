<script>
import { payeCalculate, payeCompare, payeBandBreakdown, payeBands2026, payeBonusTax } from "../../lib/salary-tax";
import { formatGrouped } from "../../lib/format";
import { pm, pmBlank } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig, sfNegative, labelOf } from "../../data/tool-fields";
const n = (v: number) => "₦" + formatGrouped(v, 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
/* E10 M1 ; the "last change" teaching line. It stays silent on cold load,
   on Clear and on Reset, and prints only after a field is really edited.
   Every figure comes from THIS render's own engine result (stSnapshot), so
   nothing is read from a cached or stale value. The spine's bulk Clear/Reset
   passes are suppressed by a capture-phase click flag: their synthetic
   input burst must not claim a change the visitor never made. */
type LcSnap = {
  r: ReturnType<typeof payeCalculate>;
  gross: number; pen: number; rent: number; nhf: number;
  nhis: number; life: number; other: number; bonus: number; bad: boolean;
};
let lcBlocked = false;
let stSnapshot: LcSnap | null = null;
const lcBox = t("st-last-change");
function hideLastChange(): void {
  if (!lcBox) return;
  lcBox.hidden = true;
  lcBox.textContent = "";
}
function lcDelta(v: number): string {
  if (Math.abs(v) < 0.5) return "take-home unchanged";
  return `take-home ${v > 0 ? "+" : "-"}₦${formatGrouped(Math.abs(v), 0)}/mo`;
}
function paintLastChange(id: string): void {
  const s = stSnapshot;
  if (!s || !lcBox || s.bad) { hideLastChange(); return; }
  const { r, gross, pen, rent, nhf, nhis, life, other, bonus } = s;
  /* The comparison engine run holds every OTHER field at its current value
     and puts only the edited field back to the seed, so the line states the
     marginal effect the engine actually made, never a remembered figure. */
  const base = () => payeCalculate(
    id === "st-gross" ? 300000 : gross,
    id === "st-pension" ? 0.08 : pen,
    id === "st-nhf" ? 0 : nhf,
    id === "st-rent" ? 0 : rent,
    true,
    id === "st-nhis" ? 0 : nhis,
    id === "st-life" ? 0 : life,
    id === "st-other" ? 0 : other);
  const eff = () => lcDelta(r.net_monthly - base().net_monthly);
  let line = "";
  if (id === "st-bonus") {
    /* A bonus is a separate one-off: it does not move regular take-home, so
       the line reports its own PAYE and net rather than inventing a delta. */
    const bt = payeBonusTax(gross, bonus, pen, nhf, rent, nhis, life, other);
    line = `Bonus ${n(bonus)}: bonus PAYE ${n(bt.tax)}, bonus take-home ${n(bt.net)} (taxed separately at your marginal band).`;
  } else if (id === "st-rent") {
    line = `Annual rent ${n(rent)}: rent relief ${n(r.relief_annual - base().relief_annual)}, ${eff()}.`;
  } else if (id === "st-nhf") {
    line = `NHF monthly ${n(nhf)}: ${eff()}.`;
  } else if (id === "st-nhis") {
    line = `NHIS monthly ${n(nhis)}: ${eff()}.`;
  } else if (id === "st-life") {
    line = `Life assurance monthly ${n(life)}: ${eff()}.`;
  } else if (id === "st-other") {
    line = `Other reliefs monthly ${n(other)}: ${eff()}.`;
  } else if (id === "st-pension") {
    line = `Pension ${g("st-pension").value}%: ${eff()}.`;
  } else if (id === "st-gross") {
    line = `Monthly gross ${n(gross)}: ${eff()}.`;
  }
  if (!line) { hideLastChange(); return; }
  lcBox.textContent = line;
  lcBox.hidden = false;
}
/* Capture runs before the spine's own button handlers, so lcBlocked is up
   before clearExamples()/reset() dispatch their synthetic input events. */
document.addEventListener("click", (e) => {
  const el = e.target as HTMLElement | null;
  if (!el || !el.closest || !el.closest("[data-sf-clear], [data-sf-reset]")) return;
  lcBlocked = true;
  hideLastChange();
  /* The clear hook also fires one delayed input event; keep the block up
     through that burst, then release it for the visitor's next real edit. */
  setTimeout(() => { lcBlocked = false; }, 50);
}, true);
/* E4 M1 ; #st-fig stays the ONE polite live region. Its visible amount lives
   in an aria-hidden span, so AX exposes one named paragraph carrying the
   figure ("Take-home: ₦… a month") instead of a bare StaticText that reads
   the same number twice. The span is rebuilt if the empty-state painter ever
   replaces the paragraph's text. */
const figBox = t("st-fig");
function figValue(): HTMLElement {
  let v = document.getElementById("st-fig-v") as HTMLElement | null;
  if (!v) {
    figBox.textContent = "";
    v = document.createElement("span");
    v.id = "st-fig-v";
    v.setAttribute("aria-hidden", "true");
    figBox.appendChild(v);
  }
  return v;
}
/* E4 H1 ; "ours" means the figures still come from our delivered worked
   example. Every marker stands down the moment any seed field holds a value
   other than the server seed, so no marker claims our example over a figure
   the visitor typed. Value-based, so badge paint order cannot make it stale. */
const OWN = "Ours, not yours: our worked example, not your salary.";
const OWN_SHORT = "Ours, not yours.";
const SEED_VALUES: Record<string, string> = {
  "st-gross": "300000", "st-pension": "8", "st-rent": "0", "st-nhf": "0",
  "st-nhis": "0", "st-life": "0", "st-other": "0", "st-bonus": "0",
};
function ownershipIsOurs(): boolean {
  /* A19 H1/M1 ; the badge is the truth, not the string. A visitor who types
     the same number as the seed has replaced our example, even though the
     value is byte-identical; all eight field badges still present is the ONLY
     all-ours state. */
  const fields = [...document.querySelectorAll(".tgrid .field")];
  return fields.length === 8 && fields.every((f) => f.hasAttribute("data-sd"));
}
function paintOwnership(ours: boolean, partial: boolean, sampleCount: number): void {
  const rec = document.getElementById("st-own-rec") as HTMLElement | null;
  const cmp = document.getElementById("st-own-cmp") as HTMLElement | null;
  const userCount = 8 - sampleCount;
  const partialTxt = `Partly yours: ${userCount} field${userCount === 1 ? "" : "s"} yours; ${sampleCount} still hold our worked example.`;
  if (rec) {
    rec.textContent = ours ? OWN : partial ? partialTxt : "Your figures, estimate only.";
    rec.hidden = false;
    if (ours || partial) rec.setAttribute("data-own", "");
    else rec.removeAttribute("data-own");
  }
  if (cmp) {
    cmp.textContent = ours ? OWN_SHORT : partial ? "Partly yours." : "";
    cmp.hidden = !(ours || partial);
  }
}
/* A19 H1/M1 ; ownership is read AFTER smart-fields has updated the field
   badges for this input. The badge is the truth: all eight = ours, some = a
   hybrid, none = the visitor's. Withheld figures show no ownership marker. */
function syncOwnership(): void {
  const fields = [...document.querySelectorAll(".tgrid .field")];
  const sampleCount = fields.filter((f) => f.hasAttribute("data-sd")).length;
  const ours = ownershipIsOurs();
  const partial = sampleCount > 0 && sampleCount < 8;
  const figTxt = (document.getElementById("st-fig")?.textContent || "").trim();
  const withheld = figTxt === "–" || figTxt === "No salary" || figTxt === "Out of range";
  const seedTeach = document.getElementById("st-seed-teach") as HTMLElement | null;
  const gapNote = document.getElementById("st-gap-note") as HTMLElement | null;
  if (seedTeach) seedTeach.hidden = !ours || withheld;
  if (gapNote) gapNote.hidden = !ours || withheld;
  const rec = document.getElementById("st-own-rec") as HTMLElement | null;
  const cmp = document.getElementById("st-own-cmp") as HTMLElement | null;
  if (withheld) {
    if (rec) rec.hidden = true;
    if (cmp) cmp.hidden = true;
    return;
  }
  const mixedBox = document.getElementById("st-mixed");
  if (mixedBox && !mixedBox.hidden) {
    if (rec) rec.hidden = true;
    if (cmp) cmp.hidden = true;
    const oldMixedSave = document.getElementById("st-own-save");
    if (oldMixedSave) oldMixedSave.remove();
    return;
  }
  paintOwnership(ours, partial, sampleCount);
  const save = t("st-save");
  const old = document.getElementById("st-own-save");
  if (old) old.remove();
  if (ours || partial) {
    const sm = document.createElement("span");
    sm.id = "st-own-save";
    sm.className = "st-own";
    sm.setAttribute("data-own", "");
    const userCount = 8 - sampleCount;
    sm.textContent = ours
      ? " Ours, not yours: our worked example, not your figures."
      : ` Partly yours: ${userCount} field${userCount === 1 ? "" : "s"} yours; ${sampleCount} still hold our worked example.`;
    save.appendChild(sm);
  }
}
/* THE ZERO LAW: every figure below declares the ids it is derived from, so a
   relief the visitor never entered cannot print itself as a gold ₦0 deduction. */
const ALL = ["st-gross", "st-pension", "st-rent", "st-nhf", "st-nhis", "st-life", "st-other"];
/* E5 H1–H4 ; the seven detail inputs get the gross grammar too. Three shapes
   are withheld: digits that are not a readable number (12.5.5, 1.2.3), any
   minus (a negative deduction is never ₦0 and is never priced), and an absurd
   one-off bonus. A value with no honest digits ("abc", ".", "") is parser-blank
   and goes through sfFig's own blank path plus a field-named demand line. The
   raw text is NEVER rewritten : only derived cells and notices react. */
const DETAIL = ["st-pension", "st-rent", "st-nhf", "st-nhis", "st-life", "st-other", "st-bonus"];
const BONUS_CEIL = 100000000;
interface DetailState { id: string; malformed: boolean; minus: boolean; blank: boolean; absurd: boolean; overCap: boolean; }
const detailClean = (txt: string): string => String(txt).replace(/[\u200B-\u200F\uFEFF]/g, "").replace(/[^\d.eE-]/g, "");
function detailStateOf(id: string): DetailState {
  const txt = g(id).value;
  const blank = pmBlank(txt);
  const clean = detailClean(txt);
  const malformed = !blank && /\d/.test(txt) && !Number.isFinite(Number(clean));
  const minus = !blank && /-/.test(clean);
  const absurd = id === "st-bonus" && !blank && !malformed && !minus && pm(txt) > BONUS_CEIL;
  const overCap = id === "st-pension" && !blank && !malformed && !minus && pm(txt) > 100;
  return { id, malformed, minus, blank, absurd, overCap };
}
/* One line per offending field : the label the visitor reads, and the concrete
   fix. No internal selector, no ₦ verdict. */
function detailFix(s: DetailState): string {
  const who = labelOf(s.id);
  if (s.overCap) return `${who} is above 100%. Enter 100 or less.`;
  if (s.minus) return `${who} has a minus sign: digits only, no minus. Enter a positive number.`;
  if (s.malformed) return `${who} is not a figure we can read. Enter a plain number with at most one decimal point.`;
  if (s.absurd) return `${who} looks unusually large for a one-off amount. Enter a plausible bonus (digits only).`;
  return `${who}: enter a plain number.`;
}
/* E5 M1–M3 ; #st-warn is the ONE named live notice. While an error is up it is
   moved into the offending field's own wrapper, so its message and its fix
   control sit where the visitor is typing instead of thousands of pixels
   below ; it moves back when the input is corrected. The fix control focuses
   and selects the offender (M2). Typing focus is never stolen. */
const warnBox = t("st-warn");
const warnText = t("st-warn-text");
const fixBtn = t("st-fix-btn") as HTMLButtonElement;
const warnHomeParent = warnBox.parentNode as Node;
const warnHomeNext = warnBox.nextElementSibling;
let stOffender: string | null = null;
function placeWarn(id: string | null): void {
  const field = id ? g(id).closest(".field") : null;
  const parent = field || warnHomeParent;
  const before = field ? field.querySelector(".hint") : warnHomeNext;
  if (parent) parent.insertBefore(warnBox, before || null);
}
fixBtn.addEventListener("click", () => {
  if (!stOffender) return;
  const el = g(stOffender);
  el.focus();
  if (typeof el.select === "function") el.select();
});
/* E7 F5, A18 H4 ; the browser scrolls only the focused field into view, so a
   recovery notice inserted below it can sit entirely under the fold. Re-scroll
   to the notice when it is not fully visible (keyboard shrink or not). The
   field sits directly above it, so both stay in view. No second live region,
   no state change, no focus steal. */
function keepRecoveryInView(): void {
  if (warnBox.hidden || !stOffender) return;
  const field = g(stOffender);
  if (document.activeElement !== field) return;
  const vh = window.visualViewport?.height ?? window.innerHeight;
  const box = warnBox.getBoundingClientRect();
  if (box.top >= 0 && box.bottom <= vh - 8) return;
  requestAnimationFrame(() => {
    warnBox.scrollIntoView({ block: "nearest", behavior: "instant" });
    /* nearest leaves sub-pixel rounding at the fold; give the last row 8px. */
    const over = warnBox.getBoundingClientRect().bottom - (vh - 8);
    if (over > 0) window.scrollBy({ top: over, behavior: "instant" });
  });
}
for (const id of ["st-gross", ...DETAIL]) g(id).addEventListener("focus", keepRecoveryInView);
window.addEventListener("resize", keepRecoveryInView);
if (window.visualViewport) window.visualViewport.addEventListener("resize", keepRecoveryInView);
/* S5 item 5 ; the period state. "monthly" is the shipped calculator (every
   input and the engine's core output); "annual" is a DISPLAY view that reads
   the engine's OWN annual fields (net_annual, tax_annual, save_annual ; the
   engine returns all three), so no figure here is a multiplied guess.
   Declared module-scope because render() reads it; the toggle buttons below
   own every write. */
let stPeriod: "monthly" | "annual" = "monthly";
const perNet = (v: { net_annual: number; net_monthly: number }) => (stPeriod === "annual" ? v.net_annual : v.net_monthly);
function paintPeriod(): void {
  t("st-lbl").textContent = stPeriod === "annual" ? "Take-home per year" : "Take-home monthly";
  t("st-cmp-net-h").textContent = stPeriod === "annual" ? "Take-home /yr" : "Take-home /mo";
}
/* A28 ; "Plan this take-home" must actually carry it. Every salary -> budget
   link gets a validated monthly income query; a blocked/withheld figure removes
   the parameter so the budget never opens on a stale handoff. */
function syncNextLinks(): void {
  const fig = (document.getElementById("st-fig")?.textContent || "").trim();
  const m = fig.match(/₦\s*([\d,]+)/);
  const amount = m ? Number(m[1].replace(/,/g, "")) : 0;
  const monthly = stPeriod === "annual" ? amount / 12 : amount;
  document.querySelectorAll('a[href*="50-30-20-budget-calculator"],a[href*="gross-to-net-calculator"]').forEach((a) => {
    const href = (a as HTMLAnchorElement).href;
    const url = new URL(href, location.href);
    const key = href.indexOf("50-30-20-budget-calculator") >= 0 ? "income" : "gross";
    if (monthly > 0 && Number.isFinite(monthly)) url.searchParams.set(key, String(Math.round(monthly)));
    else url.searchParams.delete(key);
    (a as HTMLAnchorElement).href = url.toString();
  });
}

function render() {
  paintPeriod();
