---
import ToolShell from "../../components/ToolShell.astro";
import { payeCalculate, payeCompare, payeBandBreakdown, payeBands2026 } from "../../lib/salary-tax";
import { formatGrouped } from "../../lib/format";
import { articleTitleOf } from "../../data/content";
const n = (v: number, d = 0) => formatGrouped(v, d);
const seed = payeCalculate(300000, 0.08, 0, 0, true);
const cmp = payeCompare(300000, 0.08, 0, 0);
const bands = payeBandBreakdown(seed.taxable, payeBands2026());
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
// Related-guide card titles derive from the article records (SITE-3) ;  an
// unknown slug throws at build rather than shipping a stale card.
const artTitle = await articleTitleOf();
// Crossover-aware winner: the old bands beat the new ones well below executive
// pay (at ₦500k/mo, no rent, old wins ₦2,800/yr). Sub-naira gaps count as ties.
const saveA = cmp.save_annual;
const newWins = saveA > 0.5;
const oldWins = saveA < -0.5;
const tie = !newWins && !oldWins;
const saveTxt = tie
  ? "Both regimes leave you with the same take-home."
  : newWins
    ? `You keep ₦${n(cmp.save_monthly)}/mo more under the new bands.`
    : `The old bands save you ₦${n(-cmp.save_monthly)}/mo vs the new bands.`;
/* S5 item 2 ; the quick-check worked answers. Same engine, same 8%-pension /
   no-rent basis as the copy prose below (and as WP's server-computed answers
   at page-salary-tax-calculator.php:245-268), but computed HERE from the
   port's own payeCalculate() so the figures can never drift from the maths:
   nothing is hand-typed. These are labelled reference answers, not the
   visitor's receipt ; the receipt above still waits on his own numbers. */
const wk = [300000, 500000, 1000000].map((gross) => ({ gross, r: payeCalculate(gross, 0.08, 0, 0, true) }));
/* Chip labels: ₦300k / ₦500k / ₦1m ; the same shorthand the copy prose and
   WP's chips use. */
const wkLabel = (gross: number) => (gross >= 1000000 ? `₦${gross / 1000000}m` : `₦${gross / 1000}k`);
---
<ToolShell title="Nigeria Tax Calculator 2026, NTA 2025 vs Old Bands - GWill Finance" description="Nigerian PAYE under the NTA 2025 bands (in force 1 Jan 2026) vs the old PITA bands, for comparison only (repealed 1 Jan 2026): rent relief, minimum-wage exemption, old-vs-new comparison." slug="salary-tax-calculator" tool="Nigeria Tax Calculator 2026" crumb="Nigeria Tax Calculator" lede="2026 bands (0% under ₦800k, then 15–25%) against the repealed 7–24% PITA (Personal Income Tax Act 2004) bands, for comparison, with 20% rent relief and the ₦70k minimum-wage exemption (no tax on pay at or below the minimum wage)." verified="NTA 2025 bands · rent relief capped ₦500k · exemption ≤ ₦70,000/mo (national minimum wage, source fmino.gov.ng) · last checked 25 Nov 2026" faqs={[
  { q: "Who pays zero PAYE?", a: "You pay no income tax on an employment if your gross income from that employment is at or below the national minimum wage (Nigeria Tax Act 2025, s.162(1)(t)). This is a different thing from the ₦800,000 zero-rate band, which applies to your taxable income once you are taxable. Last checked 25 Nov 2026 · <a href=\"https://nass.gov.ng/documents/download/11249\">Nigeria Tax Act 2025 gazette</a>: s.162(1)(t) and s.58 and Fourth Schedule" },
  { q: "How does rent relief work?", a: "20% of annual rent reduces taxable income, capped at ₦500,000 a year. Keep rent receipts. Last checked 25 Nov 2026 · <a href=\"https://repo.podus.ai/laws/nigeria-tax-act/section/30/\">Nigeria Tax Act 2025 s.30(2)(a)(vi)</a>" },
  { q: "How is a bonus taxed?", a: "A bonus is employment income, taxed on the day it is paid (NTA 2025 ss.4(2)(a), 26(2)). Enter it in the bonus field and we add it to your regular taxable income and charge only the extra tax, so a bonus pays at your marginal band rate rather than the top one. If the bonus lifts your gross above the national minimum wage, the minimum-wage exemption falls away (s.162(1)(t)): the first ₦800,000 of taxable income is still taxed at 0%. Last checked 25 Nov 2026 · <a href=\"https://nass.gov.ng/documents/download/11249\">Nigeria Tax Act 2025 gazette</a>: ss.4(2)(a), 26(2), 162(1)(t)" },
  { q: "Old vs new: who wins?", a: "The new bands win for most salaries, especially with rent relief. Without rent, the old bands come out slightly ahead for gross pay of roughly ₦325k–₦535k a month (by at most about ₦1,000 a month), and again for very high earners. Note the old row is for comparison only: the Personal Income Tax Act it came from was repealed on 1 Jan 2026 (NTA 2025 s.195(g)), so no one is actually paid on it. Enter your salary and the comparison card shows your actual winner. Last checked 25 Nov 2026 · <a href=\"https://nass.gov.ng/documents/download/11249\">Nigeria Tax Act 2025 gazette</a>: s.195(g); old bands: <a href=\"https://fctirs.gov.ng/wp-content/uploads/2023/07/Personal-Income-Tax-Act.pdf\">PITA Cap. P8 LFN 2004</a>" },
]}
  rawFaq
  badge="NTA 2025 · In force since 1 Jan 2026",
  ctaTitle="What next",
  ctaNote="If you rent, your annual rent reduces taxable income: 20% of it is deducted, capped at ₦500,000 a year. Then confirm the pension basis and rent relief with payroll or HR: this is guidance, not tax advice.",
  ctas={[{ label: "Work backwards from take-home", href: `${base}money-tools/gross-to-net-calculator/` }, { label: "Plan this take-home 50-30-20", href: `${base}money-tools/50-30-20-budget-calculator/`, ghost: true }]},
  copy={[["p", "₦243,820 a month, that is the new take-home under the Nigeria Tax Act 2025 for a ₦300,000 gross salary at the minimum 8% pension. Use the calculator with your own numbers and rent to get an estimate."],["p", "₦394,700 a month on a ₦500,000 gross at the minimum pension. Add your annual rent above to see how rent relief reduces your taxable income further."],["p", "₦771,900 a month on a ₦1,000,000 gross at the minimum pension. The old-vs-new comparison card above shows your exact savings under the new law."],["p", "Your annual gross is reduced by pension, NHF, NHIS, life assurance and rent relief (20% of annual rent, capped at ₦500,000). What remains is your taxable income, which is taxed on graduated bands, 0% on the first ₦800,000, then 15% up to ₦3,000,000, 18% up to ₦12,000,000, 21% up to ₦25,000,000, 23% up to ₦50,000,000 and 25% above that."],["p", "The Nigeria Tax Act 2025 replaces the old Consolidated Relief Allowance (₦200,000 + 20% of gross) with a rent relief of 20% of your annual rent, capped at ₦500,000. If you pay ₦2,400,000 a year in rent, you get ₦480,000 off your taxable income. Enter your annual rent above to see the effect."],["p", "The Nigeria Tax Act 2025 (NTA 2025), in force since 1 January 2026, is the biggest change to personal income tax in Nigeria in decades. It was designed to leave the lowest earners completely untaxed, widen the tax-free threshold for everyone, and simplify how allowances work, and for most workers it results in more take-home pay."],["h3", "The new 0% band, most people now start at zero"],["p", "Under the old law, tax started from the first naira of taxable income at 7%. NTA 2025 sets a 0% band on the first ₦800,000 of annual taxable income, so a big slice of every salary is now completely tax-free before any higher bands apply. You pay no income tax on an employment if your gross income from that employment is at or below the national minimum wage (Nigeria Tax Act 2025, s.162(1)(t)). This is a different thing from the ₦800,000 zero-rate band, which applies to your taxable income once you are taxable. Last checked 25 Nov 2026 · Nigeria Tax Act 2025 s.162(1)(t), s.58 and Fourth Schedule"],["h3", "Rent relief replaces the old allowance"],["p", "The old Consolidated Relief Allowance, the flat ₦200,000 plus 20% of gross income that everyone claimed, is gone. In its place is a rent relief worth 20% of your annual rent, capped at ₦500,000. That is a real shift: someone who pays no rent (living rent-free or in staff quarters) no longer gets an automatic allowance, while tenants get a deduction that scales with what they actually pay. This is one of the biggest reasons your take-home under the new law can differ from the old figures."],["h3", "Wider bands, higher top rate"],["p", "The tax bands are now far wider, 15% on income up to ₦3,000,000, 18% up to ₦12,000,000, 21% up to ₦25,000,000, 23% up to ₦50,000,000 and 25% above that, so your effective rate stays lower for longer. Only the very highest earners reach the new 25% top rate (up from 24% before)."],["p", "Type your salary and rent into the calculator above and compare the old and new rows to see exactly what the law change means for your personal take-home, every figure is computed live from the official bands."],["h3", "Nigerian tax calculator questions"],["h3", "What changed in the Nigeria Tax Act 2025?"],["p", "The first ₦800,000 of annual income is now tax-free (0% band). The old Consolidated Relief Allowance (CRA) is replaced by a rent relief of 20% of annual rent, capped at ₦500,000. Employees earning ₦70,000 a month or less pay zero PAYE (the national minimum wage figure, per the Federal Ministry of Information). The top rate is now 25% instead of 24%."],["h3", "How do I claim rent relief?"],["p", "Enter your annual rent in the calculator. The relief is automatically applied, 20% of your annual rent, up to ₦500,000. Your employer would normally adjust your PAYE for this in the official filing."],["h3", "Did the NRS replace the FIRS, and when do the new tax rules start?"],["p", "The Nigeria Revenue Service (NRS) replaced the Federal Inland Revenue Service under an Act that took effect on 26 June 2025. The new tax rules themselves (the Nigeria Tax Act 2025) take effect from 1 January 2026. Last checked 25 Nov 2026 · NRS (Establishment) Act 2025 gazette (Official Gazette No. 117, 26 Jun 2025), covering commencement on 1 January 2026 · Aluko & Oyebode transition overview (further reading only, not authority for a section number)"],["h3", "What pension rate should I use?"],["p", "Your pension contribution is a minimum of 8% of your monthly emoluments (that is your basic salary plus your housing and transport allowances), while your employer adds a minimum of 10%, under the Pension Reform Act 2014. Deductions you claim must be made in writing to your tax authority. Last checked 25 Nov 2026 · PenCom FAQ (pencom.gov.ng/wp-content/uploads/2018/04/FAQ-CPS-reviewed.-17-Apr.-2018.pdf) · NTA s.31 on written claims"],["h3", "What is the NHF limit?"],["p", "The National Housing Fund contribution is 2.5% of your basic monthly salary, uncapped: the NHF Act sets no ceiling on the amount (confirm the figure your payroll applies). Last checked 25 Nov 2026 · NHF Act ss.4(a), 9(1) (Federal Mortgage Bank of Nigeria) · NTA s.30(2)(a)(i)"]]},
  related={[{ href: `${base}articles/kuda-vs-traditional-banks-charges/`, title: artTitle("kuda-vs-traditional-banks-charges"), excerpt: "Card fees, failed-transfer reversals, and support tested: what digital banks actually save you." }]},
  disclaimer="This calculator is for informational guidance only and is not tax, financial or investment advice. Tax rules and personal circumstances vary, confirm your figures with a licensed tax professional.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers and the receipt waits.</p>
<!-- PERIOD TOGGLE (S5 item 5) ; the WP tax tools' Monthly/Annual switch
     (page-salary-tax-calculator.php:68-71, with the label-flip JS at
     assets/js/salary-tax.js:331-345), in the port's own segmented grammar
     (.fx-stepper/.fx-step, the control the savings-goal mode switch uses).
     DISPLAY-ONLY: the engine and every input stay monthly, and the per-year
     view reads the engine's OWN annual fields where they exist (net_annual,
     tax_annual, save_annual ; they do on this page), so no figure is a
     multiplied guess. -->
<div class="fx-stepper" role="group" aria-label="Receipt period">
  <button type="button" class="fx-step active" data-st-period="monthly" aria-pressed="true">Monthly</button>
  <button type="button" class="fx-step" data-st-period="annual" aria-pressed="false">Annual</button>
</div>
<!-- E7 F6 ; compact in-card jump row. Four 44px targets in the lower third of
     the viewport at scroll 0, so a one-handed edit no longer starts with a
     long hunt. Each button scrolls its own control into view; none writes a
     figure, changes state, or steals focus except Gross, which focuses the
     field a thumb just chose. Gaps are wider than the 8px touch-slop floor. -->
<div class="st-jump" role="group" aria-label="Jump to calculator controls">
  <button type="button" class="st-jump-btn" data-st-jump="gross">Gross</button>
  <button type="button" class="st-jump-btn" data-st-jump="period">Period</button>
  <button type="button" class="st-jump-btn" data-st-jump="result">Result</button>
  <button type="button" class="st-jump-btn" data-st-jump="clear">Clear</button>
</div>
<p class="hint">Only the take-home figure and its label, the tax line under it, the verdict and the comparison table's take-home column follow this period. The four annual rows in the receipt are pension, other reliefs, rent relief and PAYE (pay-as-you-earn tax); they stay annual in both views. The calculator itself works in months; the per-year view reads the engine's own annual figures.</p>
<p class="hint" id="st-legend">Marked <strong>Sample</strong> means the figure is our worked example, not your own: type over any field and its Sample marker disappears. Clear examples removes only what is still ours; numbers you typed stay.</p>
<p class="hint" id="st-rule">Fill all eight fields - type 0 for anything you do not have.</p>
<div class="tgrid c3">

<div class="field" data-cur="NGN"><label for="st-gross">Monthly gross ₦</label><span class="fi"><span class="fi-sym" aria-hidden="true">₦</span><input id="st-gross" type="text" value="300000" inputmode="decimal"></span><p class="hint">Enter the monthly gross pay from your payslip (basic salary plus housing and transport allowances), before pension and tax come off. The 2026 bands are worked out from this figure.</p></div>
<div class="field"><label for="st-pension">Pension %</label><input id="st-pension" type="text" max="100" value="8" inputmode="decimal"><p class="hint">Pension contributions are calculated on your <strong>monthly emoluments</strong> (your basic salary plus your housing and transport allowances) per the Pension Reform Act 2014: a minimum of 8% by you and 10% by your employer. Only the portion you actually contribute is deductible under the Nigeria Tax Act 2025.<br><em>Last checked 25 Nov 2026 · NTA <a href="https://repo.podus.ai/laws/nigeria-tax-act/section/30/">s.30(2)(a)(iii)</a> · <a href="https://www.pencom.gov.ng/wp-content/uploads/2018/04/FAQ-CPS-reviewed.-17-Apr.-2018.pdf">PenCom FAQ on the CPS</a> (8% employee, 10% employer minimum)</em></p></div>
<div class="field" data-cur="NGN"><label for="st-rent">Annual rent ₦</label><span class="fi"><span class="fi-sym" aria-hidden="true">₦</span><input id="st-rent" type="text" value="0" inputmode="decimal"></span><p class="hint">Per year, not per month: enter the total rent you pay in a year. 20% of it comes off your taxable income (what is left after these deductions), capped at ₦500,000 a year.<br><em>Last checked 25 Nov 2026 · NTA <a href="https://repo.podus.ai/laws/nigeria-tax-act/section/30/">s.30(2)(a)(vi)</a></em></p></div>
<div class="field" data-cur="NGN"><label for="st-nhf">NHF monthly ₦</label><span class="fi"><span class="fi-sym" aria-hidden="true">₦</span><input id="st-nhf" type="text" value="0" inputmode="decimal"></span><p class="hint">National Housing Fund (NHF): a long-term housing savings deduction from your salary, usually 2.5% of basic monthly pay. It comes off your taxable income. Enter the monthly amount your payslip shows.<br><em>Last checked 25 Nov 2026 · <a href="https://fmbn.gov.ng/backend/storage/uploads/37UNgpzsyASabzhQCnHuyzFtIpnsfmW2ODvAmQSG.pdf">NHF Act s.4</a> (2.5% of basic monthly salary) · NTA <a href="https://repo.podus.ai/laws/nigeria-tax-act/section/30/">s.30(2)(a)(i)</a></em></p></div>
<div class="field" data-cur="NGN"><label for="st-nhis">NHIS monthly ₦</label><span class="fi"><span class="fi-sym" aria-hidden="true">₦</span><input id="st-nhis" type="text" value="0" inputmode="decimal"></span><p class="hint">National Health Insurance Scheme (NHIS): a health insurance deduction that comes off your taxable income. Enter the monthly amount your payslip shows; leave at ₦0 if your payslip does not show it.<br><em>Last checked 25 Nov 2026 · NTA <a href="https://repo.podus.ai/laws/nigeria-tax-act/section/30/">s.30(2)(a)(ii)</a></em></p></div>
<div class="field" data-cur="NGN"><label for="st-life">Life assurance monthly ₦</label><span class="fi"><span class="fi-sym" aria-hidden="true">₦</span><input id="st-life" type="text" value="0" inputmode="decimal"></span><p class="hint">Leave at ₦0 if your payslip doesn't show it: when filled, it comes off taxable income.<br><em>Last checked 25 Nov 2026 · NTA <a href="https://repo.podus.ai/laws/nigeria-tax-act/section/30/">s.30(2)(a)(v)</a></em></p></div>
<div class="field" data-cur="NGN"><label for="st-other">Other reliefs monthly ₦</label><span class="fi"><span class="fi-sym" aria-hidden="true">₦</span><input id="st-other" type="text" value="0" inputmode="decimal"></span><p class="hint">Anything else your payroll deducts that reduces taxable income under the Nigeria Tax Act 2025. Same field as our Net to Gross calculator, so both tools answer identically. Leave at ₦0 if none.<br><em>Last checked 25 Nov 2026 · NTA <a href="https://repo.podus.ai/laws/nigeria-tax-act/section/30/">s.30(2)(a)</a></em></p></div>
<div class="field" data-cur="NGN"><label for="st-bonus">Bonus / 13th month (an extra month's pay) ₦</label><span class="fi"><span class="fi-sym" aria-hidden="true">₦</span><input id="st-bonus" type="text" value="0" inputmode="decimal"></span><p class="hint">A one-off bonus or 13th-month payment, taxed on the day it is paid. It is added on top of your regular taxable income and only the extra tax is charged, so it is taxed at your marginal band rate (the rate on the last naira you earn, not your average rate), not at the top rate.<br><em>Last checked 25 Nov 2026 · NTA ss.4(2)(a), 26(2), 162(1)(t) in the <a href="https://nass.gov.ng/documents/download/11249">Nigeria Tax Act 2025 gazette</a></em></p></div>
</div>
<p class="hint" id="st-dedwarn" hidden></p>
<div class="receipt">
<p class="receipt-lbl" id="st-lbl">Take-home monthly</p>
<p class="receipt-fig" id="st-fig" aria-live="polite" aria-label={`Take-home: ₦${n(seed.net_monthly)} a month`}><span id="st-fig-v" aria-hidden="true">₦{n(seed.net_monthly)}</span></p>
<p class="receipt-sub" id="st-sub">Tax ₦{n(seed.tax_monthly)}/mo · taxable income (after deductions) ₦{n(seed.taxable)}/yr{seed.exempt ? " · EXEMPT (minimum wage)" : ""}</p>
<!-- E8b M1-M4 / L1-L3 ; the legal basis and the limits sit BESIDE the figure.
     These are the public documents verified in the E8a source map. Section
     numbers stay as text and follow the printed gazette numbering. -->
<div class="st-trust" id="st-trust">
<p class="st-trust-line st-seed-teach" id="st-seed-teach"><strong>What this example includes:</strong> gross ₦300,000 a month, pension at 8% (the statutory minimum), and ₦0 in every other field: rent, NHF, NHIS, life assurance, other reliefs and bonus. Add your annual rent to see rent relief cut your taxable income and move your take-home, or fill NHF, NHIS or life assurance to see a deduction move it. The bonus is left at ₦0 here, so no separate bonus tax shows; enter a bonus and it is taxed on its own at your marginal band.</p>
<p class="st-trust-line st-last-change" id="st-last-change" hidden></p>
<p class="st-trust-line"><strong>Sources:</strong> <a href="https://nass.gov.ng/documents/download/11249">Nigeria Tax Act 2025 gazette</a> (ss.4(2)(a), 26(2), 162(1)(t), 195(g)) and the <a href="https://nipc.gov.ng/assets/resources/nigeria-tax-act-2025/nigeria-tax-act-2025-gazette.pdf">gazette copy with the band table</a> (s.58 and Fourth Schedule); <a href="https://repo.podus.ai/laws/nigeria-tax-act/section/30/">s.30(2)(a)</a> (rent (vi), pension (iii), NHF (i), NHIS (ii), life (v)) and <a href="https://repo.podus.ai/laws/nigeria-tax-act/section/31/">s.31</a> (reliefs claimed in writing); <a href="https://nipc.gov.ng/assets/resources/nigeria-revenue-service-establishment-act-2025/nigeria-revenue-service-establishment-act-2025-gazette.pdf">NRS (Establishment) Act 2025</a>; <a href="https://fmbn.gov.ng/backend/storage/uploads/37UNgpzsyASabzhQCnHuyzFtIpnsfmW2ODvAmQSG.pdf">NHF Act</a>; <a href="https://www.pencom.gov.ng/wp-content/uploads/2018/04/FAQ-CPS-reviewed.-17-Apr.-2018.pdf">PenCom FAQ</a>; <a href="https://fctirs.gov.ng/wp-content/uploads/2023/07/Personal-Income-Tax-Act.pdf">PITA, old bands only</a>. <a href="https://aluko-oyebode.com/wp-content/uploads/2026/07/OVERVIEW-OF-THE-GENERAL-TRANSITION-GUIDELINES-FOR-THE-NEW-TAX-ACTS-2025.pdf">Aluko &amp; Oyebode</a> is further reading, not authority for a section number.</p>
<p class="st-trust-line"><strong>Minimum wage:</strong> no PAYE on an employment at or below the national minimum wage, currently ₦70,000 a month, per the <a href="https://fmino.gov.ng/federal-government-inaugurates-committee-on-consequential-salaries-adjustments/">Federal Ministry of Information and National Orientation</a>; the exemption itself is s.162(1)(t) of the gazette.</p>
<p class="st-trust-line"><strong>Method and disclaimer:</strong> an estimate for guidance, not tax advice. We apply the 2026 bands to the annual gross you enter, subtract the deductions you enter, and show annual figures in the receipt. The full disclaimer and article follow below.</p>
<p class="st-trust-line"><strong>Why ₦300,000:</strong> it is our worked example because it clears the ₦800,000 zero-rate band and reaches the 15% band, so the receipt shows a non-zero tax line without any deduction we invented. The 8% pension is the statutory minimum employee contribution. The ₦0 in every other field is a placeholder, not a claim about your payslip. Type over it with your own pay.</p>
<p class="st-trust-line"><strong>Estimate, not your payslip:</strong> PAYE is withheld when income is paid, so a one-off bonus is taxed on its payment day; allowances and bonuses change which bands apply; NHF, NHIS, life assurance and other reliefs are written up by your payroll; and a second employer is assessed separately, so this one-employer estimate will not match a two-job payslip.</p>
<p class="st-trust-line st-trust-checked"><strong>Last checked 25 Nov 2026</strong> against the public sources linked above.</p>
</div>
<p class="receipt-foot st-own" id="st-own-rec" data-own>Ours, not yours: our worked example, not your salary.</p>
<p class="hint" id="st-next">Next: <a href={`${base}money-tools/50-30-20-budget-calculator/`}>plan this take-home with the 50-30-20 budget</a>, or <a href={`${base}money-tools/gross-to-net-calculator/`}>work back from take-home</a>.</p>
<div class="receipt-div" aria-hidden="true"></div>
<div id="st-rows">
<div class="receipt-row"><span>Pension (annual)</span><b id="st-pen">₦{n(seed.pension_annual)}</b></div>
<!-- E8b H1 ; the three deductions the engine subtracted but the receipt never
     printed. Hidden while zero so the seeded example stays clean; sfFig still
     withholds them as a dash when a field is blank or malformed. -->
<div class="receipt-row st-ded-row" id="st-nhf-row" hidden><span>NHF (annual)</span><b id="st-nhf2">₦{n(seed.nhf_annual)}</b></div>
<div class="receipt-row st-ded-row" id="st-nhis-row" hidden><span>NHIS (annual)</span><b id="st-nhis2">₦{n(seed.nhis_annual)}</b></div>
<div class="receipt-row st-ded-row" id="st-life-row" hidden><span>Life assurance (annual)</span><b id="st-life2">₦{n(seed.life_annual)}</b></div>
<div class="receipt-row"><span>Other reliefs (deductions that lower taxable income, annual)</span><b id="st-other2">₦{n(seed.other_annual)}</b></div>
<div class="receipt-row"><span>Rent relief (rent deduction, annual)</span><b id="st-rel">₦{n(seed.relief_annual)}</b></div>
<div class="receipt-row"><span>PAYE tax (Pay As You Earn income tax, annual)</span><b id="st-tax">₦{n(seed.tax_annual)}</b></div>
</div>
<p class="receipt-foot">NTA 2025 bands · rent relief cap ₦500k · pension on the emoluments you enter</p>
<p class="receipt-foot">A bonus counts as employment income and is taxed on the day it is paid. <strong>If a bonus takes your gross pay above the national minimum wage, the minimum-wage exemption falls away</strong> and the bonus runs through the normal band table: the first ₦800,000 of taxable income is still taxed at 0%. <em>Last checked 25 Nov 2026 · NTA ss.4(2)(a), 26(2), 162(1)(t) in the <a href="https://nass.gov.ng/documents/download/11249">Nigeria Tax Act 2025 gazette</a></em></p>
<div class="receipt-foot" id="st-bonus-block">
<p class="receipt-row"><span>Bonus PAYE (Pay As You Earn, one-off)</span><b id="st-bonus-tax">–</b></p>
<p class="receipt-row"><span>Bonus take-home</span><b id="st-bonus-net">–</b></p>
<p class="receipt-row"><span>Effective rate on the bonus (bonus tax ÷ bonus)</span><b id="st-bonus-rate">–</b></p>
