<script>
import { payeCalculate, payeCompare, payeBandBreakdown, payeBands2026, payeBonusTax } from "../../lib/salary-tax";
import { formatGrouped } from "../../lib/format";
import { pm, pmBlank } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig, sfNegative, labelOf } from "../../data/tool-fields";
const n = (v: number) => "₦" + formatGrouped(v, 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
/* E10 M1 ; the "last change" teaching line. It stays silent on cold load,
   on Clear and on Reset, and prints only after a field is really edited.
   Every figure comes from THIS render's own engine result (stSnapshot), so
   nothing is read from a cached or stale value. The spine's bulk Clear/Reset
   passes are suppressed by a capture-phase click flag: their synthetic
   input burst must not claim a change the visitor never made. */
type LcSnap = {
  r: ReturnType<typeof payeCalculate>;
  gross: number; pen: number; rent: number; nhf: number;
  nhis: number; life: number; other: number; bonus: number; bad: boolean;
};
let lcBlocked = false;
let stSnapshot: LcSnap | null = null;
const lcBox = t("st-last-change");
function hideLastChange(): void {
  if (!lcBox) return;
  lcBox.hidden = true;
  lcBox.textContent = "";
}
function lcDelta(v: number): string {
  if (Math.abs(v) < 0.5) return "take-home unchanged";
  return `take-home ${v > 0 ? "+" : "-"}₦${formatGrouped(Math.abs(v), 0)}/mo`;
}
function paintLastChange(id: string): void {
  const s = stSnapshot;
  if (!s || !lcBox || s.bad) { hideLastChange(); return; }
  const { r, gross, pen, rent, nhf, nhis, life, other, bonus } = s;
  /* The comparison engine run holds every OTHER field at its current value
     and puts only the edited field back to the seed, so the line states the
     marginal effect the engine actually made, never a remembered figure. */
  const base = () => payeCalculate(
    id === "st-gross" ? 300000 : gross,
    id === "st-pension" ? 0.08 : pen,
    id === "st-nhf" ? 0 : nhf,
    id === "st-rent" ? 0 : rent,
    true,
    id === "st-nhis" ? 0 : nhis,
    id === "st-life" ? 0 : life,
    id === "st-other" ? 0 : other);
  const eff = () => lcDelta(r.net_monthly - base().net_monthly);
  let line = "";
  if (id === "st-bonus") {
    /* A bonus is a separate one-off: it does not move regular take-home, so
       the line reports its own PAYE and net rather than inventing a delta. */
    const bt = payeBonusTax(gross, bonus, pen, nhf, rent, nhis, life, other);
    line = `Bonus ${n(bonus)}: bonus PAYE ${n(bt.tax)}, bonus take-home ${n(bt.net)} (taxed separately at your marginal band).`;
  } else if (id === "st-rent") {
    line = `Annual rent ${n(rent)}: rent relief ${n(r.relief_annual - base().relief_annual)}, ${eff()}.`;
  } else if (id === "st-nhf") {
    line = `NHF monthly ${n(nhf)}: ${eff()}.`;
  } else if (id === "st-nhis") {
    line = `NHIS monthly ${n(nhis)}: ${eff()}.`;
  } else if (id === "st-life") {
    line = `Life assurance monthly ${n(life)}: ${eff()}.`;
  } else if (id === "st-other") {
    line = `Other reliefs monthly ${n(other)}: ${eff()}.`;
  } else if (id === "st-pension") {
    line = `Pension ${g("st-pension").value}%: ${eff()}.`;
  } else if (id === "st-gross") {
    line = `Monthly gross ${n(gross)}: ${eff()}.`;
  }
  if (!line) { hideLastChange(); return; }
  lcBox.textContent = line;
  lcBox.hidden = false;
}
/* Capture runs before the spine's own button handlers, so lcBlocked is up
   before clearExamples()/reset() dispatch their synthetic input events. */
document.addEventListener("click", (e) => {
  const el = e.target as HTMLElement | null;
  if (!el || !el.closest || !el.closest("[data-sf-clear], [data-sf-reset]")) return;
  lcBlocked = true;
  hideLastChange();
  /* The clear hook also fires one delayed input event; keep the block up
     through that burst, then release it for the visitor's next real edit. */
  setTimeout(() => { lcBlocked = false; }, 50);
}, true);
/* E4 M1 ; #st-fig stays the ONE polite live region. Its visible amount lives
   in an aria-hidden span, so AX exposes one named paragraph carrying the
   figure ("Take-home: ₦… a month") instead of a bare StaticText that reads
   the same number twice. The span is rebuilt if the empty-state painter ever
   replaces the paragraph's text. */
const figBox = t("st-fig");
function figValue(): HTMLElement {
  let v = document.getElementById("st-fig-v") as HTMLElement | null;
  if (!v) {
    figBox.textContent = "";
    v = document.createElement("span");
    v.id = "st-fig-v";
    v.setAttribute("aria-hidden", "true");
    figBox.appendChild(v);
  }
  return v;
}
/* E4 H1 ; "ours" means the figures still come from our delivered worked
   example. Every marker stands down the moment any seed field holds a value
   other than the server seed, so no marker claims our example over a figure
   the visitor typed. Value-based, so badge paint order cannot make it stale. */
const OWN = "Ours, not yours: our worked example, not your salary.";
const OWN_SHORT = "Ours, not yours.";
const SEED_VALUES: Record<string, string> = {
  "st-gross": "300000", "st-pension": "8", "st-rent": "0", "st-nhf": "0",
  "st-nhis": "0", "st-life": "0", "st-other": "0", "st-bonus": "0",
};
function ownershipIsOurs(): boolean {
  /* E5 M4 : exact seed strings, not parsed numbers. Any typed-but-unreadable
     value stands all three markers down (regression against E4 H1). */
  return Object.keys(SEED_VALUES).every((id) => g(id).value === SEED_VALUES[id]);
}
function paintOwnership(ours: boolean): void {
  const rec = document.getElementById("st-own-rec") as HTMLElement | null;
  const cmp = document.getElementById("st-own-cmp") as HTMLElement | null;
  if (rec) { rec.textContent = ours ? OWN : ""; rec.hidden = !ours; }
  if (cmp) { cmp.textContent = ours ? OWN_SHORT : ""; cmp.hidden = !ours; }
}
/* THE ZERO LAW: every figure below declares the ids it is derived from, so a
   relief the visitor never entered cannot print itself as a gold ₦0 deduction. */
const ALL = ["st-gross", "st-pension", "st-rent", "st-nhf", "st-nhis", "st-life", "st-other"];
/* E5 H1–H4 ; the seven detail inputs get the gross grammar too. Three shapes
   are withheld: digits that are not a readable number (12.5.5, 1.2.3), any
   minus (a negative deduction is never ₦0 and is never priced), and an absurd
   one-off bonus. A value with no honest digits ("abc", ".", "") is parser-blank
   and goes through sfFig's own blank path plus a field-named demand line. The
   raw text is NEVER rewritten : only derived cells and notices react. */
const DETAIL = ["st-pension", "st-rent", "st-nhf", "st-nhis", "st-life", "st-other", "st-bonus"];
const BONUS_CEIL = 100000000;
interface DetailState { id: string; malformed: boolean; minus: boolean; blank: boolean; absurd: boolean; }
const detailClean = (txt: string): string => String(txt).replace(/[\u200B-\u200F\uFEFF]/g, "").replace(/[^\d.eE-]/g, "");
function detailStateOf(id: string): DetailState {
  const txt = g(id).value;
  const blank = pmBlank(txt);
  const clean = detailClean(txt);
  const malformed = !blank && /\d/.test(txt) && !Number.isFinite(Number(clean));
  const minus = !blank && /-/.test(clean);
  const absurd = id === "st-bonus" && !blank && !malformed && !minus && pm(txt) > BONUS_CEIL;
  return { id, malformed, minus, blank, absurd };
}
/* One line per offending field : the literal field id, the label the visitor
   reads, and the concrete fix. No ₦ verdict rides in it. */
function detailFix(s: DetailState): string {
  const who = `#${s.id} (${labelOf(s.id)})`;
  if (s.minus) return `${who} has a minus sign: digits only, no minus. Enter a positive number.`;
  if (s.malformed) return `${who} is not a figure we can read. Enter a plain number with at most one decimal point.`;
  if (s.absurd) return `${who} looks unusually large for a one-off amount. Enter a plausible bonus (digits only).`;
  return `${who}: enter a plain number.`;
}
/* E5 M1–M3 ; #st-warn is the ONE named live notice. While an error is up it is
   moved into the offending field's own wrapper, so its message and its fix
   control sit where the visitor is typing instead of thousands of pixels
   below ; it moves back when the input is corrected. The fix control focuses
   and selects the offender (M2). Typing focus is never stolen. */
const warnBox = t("st-warn");
const warnText = t("st-warn-text");
const fixBtn = t("st-fix-btn") as HTMLButtonElement;
const warnHomeParent = warnBox.parentNode as Node;
const warnHomeNext = warnBox.nextElementSibling;
let stOffender: string | null = null;
function placeWarn(id: string | null): void {
  const field = id ? g(id).closest(".field") : null;
  const parent = field || warnHomeParent;
  const before = field ? field.querySelector(".hint") : warnHomeNext;
  if (parent) parent.insertBefore(warnBox, before || null);
}
fixBtn.addEventListener("click", () => {
  if (!stOffender) return;
  const el = g(stOffender);
  el.focus();
  if (typeof el.select === "function") el.select();
});
/* E7 F5 ; on a shortened visual viewport the browser scrolls only the focused
   field into view, leaving the recovery notice and its Go-to button below the
   fold. Re-scroll to the notice (the field sits directly above it, so both stay
   in view) when a keyboard-like shrink happens or an offender is focused in a
   short viewport. No second live region, no state change, no focus steal. The
   emulation limit stands: a real OS keyboard was never raised. */
function keepRecoveryInView(): void {
  const vv = window.visualViewport;
  if (!vv || vv.height >= 600) return;
  if (warnBox.hidden || !stOffender) return;
  const field = g(stOffender);
  if (document.activeElement !== field) return;
  requestAnimationFrame(() => {
    warnBox.scrollIntoView({ block: "nearest", behavior: "instant" });
    /* nearest leaves sub-pixel rounding at the fold; give the last row 8px. */
    const over = warnBox.getBoundingClientRect().bottom - (vv.height - 8);
    if (over > 0) window.scrollBy({ top: over, behavior: "instant" });
  });
}
for (const id of ["st-gross", ...DETAIL]) g(id).addEventListener("focus", keepRecoveryInView);
window.addEventListener("resize", keepRecoveryInView);
if (window.visualViewport) window.visualViewport.addEventListener("resize", keepRecoveryInView);
/* S5 item 5 ; the period state. "monthly" is the shipped calculator (every
   input and the engine's core output); "annual" is a DISPLAY view that reads
   the engine's OWN annual fields (net_annual, tax_annual, save_annual ; the
   engine returns all three), so no figure here is a multiplied guess.
   Declared module-scope because render() reads it; the toggle buttons below
   own every write. */
let stPeriod: "monthly" | "annual" = "monthly";
const perNet = (v: { net_annual: number; net_monthly: number }) => (stPeriod === "annual" ? v.net_annual : v.net_monthly);
function paintPeriod(): void {
  t("st-lbl").textContent = stPeriod === "annual" ? "Take-home per year" : "Take-home monthly";
  t("st-cmp-net-h").textContent = stPeriod === "annual" ? "Take-home /yr" : "Take-home /mo";
}
function render() {
  paintPeriod();
  syncQcChips();
  const grossTxt = g("st-gross").value;
  const grossRaw = pm(grossTxt);
  /* E2 H1/H3 ; an ENTERED gross that is not a usable number must withhold every
     derived figure and never print a conclusion. Three shapes reach here:
       "12.5.5"   -> honest alphabet, but Number() is NaN, so pm() reads 0 ;
       "-5000"    -> negative, clamped away by Math.max below ;
       "999999999"-> past the tool's own ₦100m deep-link ceiling.
     A genuine "0" is entered and stays honest: no bad state, no withheld figure. */
  const grossEntered = !pmBlank(grossTxt);
  const grossClean = String(grossTxt).replace(/[\u200B-\u200F\uFEFF]/g, "").replace(/[^\d.eE-]/g, "");
  const grossMalformed = grossEntered && /\d/.test(grossTxt) && !Number.isFinite(Number(grossClean));
  const grossNegative = grossEntered && grossRaw < 0;
  const grossAbsurd = grossEntered && grossRaw > 100000000;
  const grossBad = grossMalformed || grossNegative || grossAbsurd;
  /* E5 H1/H2/H4 ; detail errors join the same withheld state as a bad gross.
     Parser-blank details already dash through sfFig's blank deps, and the
     sentinel makes the hold uniform for digit-bearing garbage and minus signs. */
  const dStates = DETAIL.map(detailStateOf);
  const dBad = dStates.filter((s) => s.malformed || s.minus || s.absurd);
  const dBlank = dStates.filter((s) => s.blank);
  /* An absurd bonus gates only its own three cells ; it does not move the
     regular take-home, which is not derived from the bonus. Malformed and
     minus values withhold the whole receipt. */
  const dHold = dStates.filter((s) => s.malformed || s.minus);
  /* One withheld dep id: every sfFig below dashes while any input is bad. */
  const HOLD = grossBad || dHold.length > 0 || dBlank.length > 0 ? ["__st_hold__"] : [];
  const penRaw = pm(g("st-pension").value);
  const rentRaw = pm(g("st-rent").value);
  const nhfRaw = pm(g("st-nhf").value);
  const gross = Math.max(0, grossRaw || 0);
  const pen = Math.min(100, Math.max(0, penRaw || 0)) / 100;
  const rent = Math.max(0, rentRaw || 0);
  const nhf = Math.max(0, nhfRaw || 0);
  const nhis = Math.max(0, pm(g("st-nhis").value) || 0);
  const life = Math.max(0, pm(g("st-life").value) || 0);
  const other = Math.max(0, pm(g("st-other").value) || 0);
  /* THE BONUS IS NOT IN `ALL` ON PURPOSE. A bonus is a separate one-off payment,
     not part of the monthly salary: it does not change the regular take-home, the
     taxable figure or the band breakdown, so adding st-bonus to ALL would make a
     bonus redraw figures it cannot move. Its block gates on its OWN field (the
     ZERO LAW), so an uncleared bonus prints no bonus figures at all. */
  const bonus = Math.max(0, pm(g("st-bonus").value) || 0);
  const r = payeCalculate(gross, pen, nhf, rent, true, nhis, life, other);
  /* MINOR-5 ; the engine's net is deliberately unfloored and the NHF field has
     no max: ₦500k gross + ₦500k NHF used to print a −₦40,000/mo take-home, a
     number no payslip can show. Mirrors the emergency-fund guard (v0.7.16):
     the take-home figures answer "Out of range" rather than a negative, and
     the rail below names the fields to check ; never a silent clamp. */
  const netBad = (v: number) => !Number.isFinite(v) || v < 0;
  const netTxt = (v: number) => netBad(v) ? "Out of range" : n(v);
  const fv = figValue();
  sfFig(fv, [...ALL, ...HOLD], netTxt(perNet(r)));
  figBox.setAttribute("aria-label", `Take-home: ${(fv.textContent || "").trim()} ${stPeriod === "annual" ? "a year" : "a month"}`);
  sfFig(t("st-sub"), [...ALL, ...HOLD], `Tax ${n(stPeriod === "annual" ? r.tax_annual : r.tax_monthly)}/${stPeriod === "annual" ? "yr" : "mo"} · taxable income (after deductions) ${n(r.taxable)}/yr${r.exempt && !grossBad ? " · EXEMPT (minimum wage)" : ""}`);
  sfFig(t("st-pen"), ["st-gross", "st-pension", ...HOLD], n(r.pension_annual));
  /* E8b H1 ; the three deductions the engine subtracts but the receipt used to
     omit. They print only when the visitor entered a non-zero amount, so the
     seeded zero case stays clean. sfFig still dashes each one on a blank or
     malformed field, and the row hides when the value is genuinely zero. */
  sfFig(t("st-nhf2"), ["st-gross", "st-nhf", ...HOLD], n(r.nhf_annual));
  sfFig(t("st-nhis2"), ["st-gross", "st-nhis", ...HOLD], n(r.nhis_annual));
  sfFig(t("st-life2"), ["st-gross", "st-life", ...HOLD], n(r.life_annual));
  const dedRows: [string, number][] = [["st-nhf-row", nhf], ["st-nhis-row", nhis], ["st-life-row", life]];
  for (const [rowId, amount] of dedRows) {
    const row = document.getElementById(rowId);
    if (row) row.hidden = !(amount > 0);
  }
  /* Other-reliefs receipt row (P1-6 parity tail): mirrors the Net to Gross
     page's gn-other2 row ; the row rides its own field, annualised the same
     way the engine annualises it (otherMonthly × 12). */
  /* E4 L2 ; both relief rows read the gross-dependent withheld path too. A
     gross the parser cannot read ("abc", "12,") makes the headline dash, and
     these two used to keep printing ₦0 because their own fields held "0".
     Adding st-gross dashes them with the headline; the typed value stays. */
  sfFig(t("st-other2"), ["st-gross", "st-other", ...HOLD], n(r.other_annual));
  sfFig(t("st-rel"), ["st-gross", "st-rent", ...HOLD], n(r.relief_annual));
  sfFig(t("st-tax"), [...ALL, ...HOLD], n(r.tax_annual));
  /* BONUS BLOCK (P1-6 tail). The engine is payeBonusTax(gross, bonus, pen, nhf,
     rent, nhis, life, other) ; the same marginal-band machinery the vector gate
     already asserts (paye_bonus, paye_bonus_exempt_base). Nothing here restates a
     rate: the effective rate is READ BACK off the engine's own tax/bonus, never
     computed from a band I typed. A ₦0 bonus hides the whole block rather than
     printing three gold zeros (THE ZERO LAW), and the gross is required because a
     bonus's tax is a function of the pay it stacks on. */
  /* The gross test reads the FIELD directly rather than the `grossKnown`
     const below: `grossKnown` is declared later in this function, so touching
     it here is a temporal-dead-zone ReferenceError that aborts render() and
     leaves every figure below it stale. (The behavioural suite caught exactly
     that on the first run of this block ; rails + console, both salary-tax.)

     These cells WITHHOLD as "; " via sfFig instead of hiding a wrapper: an
     `hidden` ancestor does not stop a `.receipt-row b` from carrying text, and
     the behavioural suite scrapes exactly those (the first run shipped a stale
     "0.0%" through a hidden div and failed reset + clear). The house ZERO LAW
     is "; ", not "hidden" ; the row is always there, the figure is not. */
  const BONUS_DEPS = ["st-gross", "st-bonus", "st-pension", "st-nhf", "st-rent", "st-nhis", "st-life", "st-other", ...HOLD];
  /* E5 H3 ; the bonus gets its own plausibility gate. An absurd one-off never
     prints a precise PAYE, net or rate, even when the rest of the receipt is
     otherwise usable ; detailFix names #st-bonus and asks for a real amount. */
  const bonusAbsurd = dStates.some((s) => s.id === "st-bonus" && s.absurd);
  const bonusOn = bonus > 0 && !pmBlank(g("st-gross").value) && !grossBad && !bonusAbsurd;
  if (bonusOn) {
    const bt = payeBonusTax(gross, bonus, pen, nhf, rent, nhis, life, other);
    sfFig(t("st-bonus-tax"), BONUS_DEPS, n(bt.tax));
    sfFig(t("st-bonus-net"), BONUS_DEPS, n(bt.net));
    sfFig(t("st-bonus-rate"), BONUS_DEPS, (bt.rate * 100).toFixed(1) + "%");
  } else {
    sfFig(t("st-bonus-tax"), BONUS_DEPS, "–");
    sfFig(t("st-bonus-net"), BONUS_DEPS, "–");
    sfFig(t("st-bonus-rate"), BONUS_DEPS, "–");
  }
  /* E4 L1 ; the waiting sentence belongs to the empty state only. Once the
     bonus has a usable value the three cells carry real figures and the line
     that says they wait would be a stale lie; the explanation above stays. */
  const waitLine = document.getElementById("st-bonus-wait") as HTMLElement | null;
  if (waitLine) waitLine.hidden = bonusOn;
  const c = payeCompare(gross, pen, nhf, rent, nhis, life, other);
  sfFig(t("st-new-tax"), [...ALL, ...HOLD], n(c.new.tax_annual));
  sfFig(t("st-new-net"), [...ALL, ...HOLD], netTxt(perNet(c.new)));
  sfFig(t("st-old-tax"), [...ALL, ...HOLD], n(c.old.tax_annual));
  sfFig(t("st-old-net"), [...ALL, ...HOLD], netTxt(perNet(c.old)));
  const nw = !grossBad && c.save_annual > 0.5, ow = !grossBad && c.save_annual < -0.5;
  (document.getElementById("st-row-new") as HTMLElement).className = nw ? "win" : "";
  (document.getElementById("st-row-old") as HTMLElement).className = ow ? "win" : "";
  (document.getElementById("st-tag-new") as HTMLElement).style.display = nw ? "" : "none";
  (document.getElementById("st-tag-old") as HTMLElement).style.display = ow ? "" : "none";
  /* BREAK-4. This rail used to assert "Both regimes leave you with the same
     take-home" whenever the two comparisons tied ; INCLUDING while gross was
     blank, because gross=0 makes them tie at ₦0. That is a conclusion about a
     comparison the visitor never made, with no user data behind it: the exact
     HN-3 class this whole leg exists to prevent, sitting in a prose rail the
     honesty pass deliberately did not touch. It is now honestly conditional:
     with no gross entered it withholds the claim and says what is missing, and
     the tie sentence only ever prints on a gross the visitor actually typed. */
  /* B4-FIX2 ; entered means honest, not merely digit-bearing: "abc123" in
     gross must read as un-entered (the demand line below), never as ₦123 of
     comparison prose. pmBlank() is the fleet's one entered-test (pm.js). */
  const grossKnown = !pmBlank(g("st-gross").value);
  /* MINOR-5 ; with deductions above gross there is no take-home for either
     regime, so the tie/winner prose withholds rather than concluding over
     the "Out of range" cells beside it. */
  const cmpBad = netBad(c.new.net_monthly) || netBad(c.old.net_monthly);
  /* E5 M5 ; an "Out of range" verdict refuses a take-home, so the relief row
     may not print a precise naira amount beside that refusal. */
  if (cmpBad) sfFig(t("st-other2"), ["st-gross", "st-other", "__st_range__"], n(r.other_annual));
  /* S5 item 5 ; the winner sentence follows the chosen period off the
     engine's own save figures (save_annual in the per-year view,
     save_monthly in the per-month view; the engine returns both). */
  const saveFig = stPeriod === "annual" ? c.save_annual : c.save_monthly;
  const saveUnit = stPeriod === "annual" ? "yr" : "mo";
  /* E4 H1 ; the three ours-not-yours markers are a view of the delivered
     example, not a permanent caption. Once any seed field is the visitor's,
     paintOwnership clears the receipt and comparison markers and no marker is
     appended to the verdict. */
  const ours = ownershipIsOurs();
  paintOwnership(ours);
  /* E5 H1/H2/H3 ; a bad or unreadable detail withholds the verdict too. A
     CANNOT SCORE sentence carries the fix but no ₦ conclusion ; a parser-blank
     detail dashes the line beside the other withheld cells. Gross keeps its
     shipped grammar verbatim. */
  const detailBad = dBad.length > 0;
  const detailBlankOnly = !detailBad && grossKnown && dBlank.length > 0;
  const detailVerdict = detailBad
    ? `CANNOT SCORE. ${detailFix(dBad[0])} No verdict is shown until you do.`
    : detailBlankOnly
    ? "–"
    : "";
  t("st-save").textContent = grossBad
    ? "CANNOT SCORE. Monthly gross ₦: enter a plain number above ₦0. No verdict is shown until you do."
    : detailVerdict
    ? detailVerdict
    : !grossKnown
    ? "Old vs new bands compared on your gross: enter it above."
    : cmpBad
      ? "Out of range: deductions exceed the gross you entered, so neither regime has a take-home to compare."
      : (!nw && !ow)
      ? "Both regimes leave you with the same take-home."
      : nw
        ? `You keep ${n(saveFig)}/${saveUnit} more under the new bands.`
        : `The old bands save you ${n(-saveFig)}/${saveUnit} vs the new bands.`;
  if (ours) {
    const sm = document.createElement("span");
    sm.id = "st-own-save";
    sm.className = "st-own";
    sm.setAttribute("data-own", "");
    sm.textContent = " Ours, not yours: our worked example, not your figures.";
    t("st-save").appendChild(sm);
  }
  const notes: string[] = [];
  if (grossBad) {
    /* E2 H1/H3 ; one rail, the field named and the fix concrete. The absurd
       case keeps its existing "double-check" warn verbatim above this line. */
    if (grossAbsurd) notes.push("That gross looks unusually large: double-check the figure.");
    const why = grossNegative ? "a negative entry has no take-home to price."
      : grossMalformed ? "that is not a figure we can read has no take-home to price."
      : "a figure this large has no take-home we will price.";
    notes.push(`Monthly gross ₦ ${why} Enter a plain number above ₦0 at a realistic monthly salary. No figures or verdict are shown until you do.`);
  } else if (detailBad || detailBlankOnly) {
    /* E5 H1/H2/H4 ; name each offending field with its concrete fix. The
       gross demand line is held back here so Clear cannot blame gross for a
       detail value that is still bad (M6). Cap rails stay on the normal path. */
    const offenders = detailBad ? dBad : dBlank;
    for (const s of offenders.slice(0, 3)) {
      notes.push(detailFix(s) + (s.blank ? " No verdict is shown until you do." : " No figures or verdict are shown until you do."));
    }
    /* E6 F1 ; the notice may never hide the rest of the scope. Three named
       fields keep the E5 grammar byte-stable; every remaining empty/offending
       field is counted AND named here, so "4 more fields" is never a mystery. */
    const more = offenders.length - Math.min(3, offenders.length);
    if (more > 0) notes.push(`${more} more field${more > 1 ? "s" : ""} to fill: ${offenders.slice(3).map((s) => labelOf(s.id)).join(", ")}. Type 0 for any you do not have.`);
  } else {
    if (!(grossRaw > 0)) notes.push("Enter a monthly gross above ₦0: take-home waits until you do.");
    /* E6 F1 ; a truly blank page must show the whole scope, not just gross.
       The demand above stays byte-stable; this names every other empty field
       and counts them, so seven hidden blanks can never read as one missing
       number. */
    if (dBlank.length) notes.push(`${dBlank.length} more field${dBlank.length > 1 ? "s" : ""} to fill: ${dBlank.map((s) => labelOf(s.id)).join(", ")}. Type 0 for any you do not have.`);
    /* A34: the negative line names the field(s) (sfNegative) instead of a
       bare fleet line; the too-large and cap lines keep their own voice.
       E5 H4: the three detail negatives now have their own withhold-and-fix
       rail above, so only gross is named here. */
    const stNeg = sfNegative(["st-gross"]);
    if (stNeg) notes.push(stNeg);
    /* E5 L1 ; the cap rail now carries the fix, not just the fact. */
    if (penRaw > 100) notes.push("Pension capped at 100%: at 100% there is no take-home. Enter 100 or less.");
    if (grossRaw > 100000000) notes.push("That gross looks unusually large: double-check the figure.");
    /* E5 L2 ; the refusal leads, the Act citation follows it. */
    if (netBad(r.net_monthly)) notes.push("Out of range: pension, NHF, NHIS, life assurance and other reliefs add up to more than your gross, so no take-home can print. Check #st-nhf and the monthly deduction fields against your payslip.");
    if (nhfRaw > 15000) notes.push("The National Housing Fund contribution is 2.5% of your basic monthly salary, uncapped: the NHF Act sets no ceiling on the amount (confirm the figure your payroll applies). Last checked 25 Nov 2026 · NHF Act ss.4(a), 9(1) (Federal Mortgage Bank of Nigeria) · NTA s.30(2)(a)(i)");
    if (rentRaw * 0.2 > 500000) notes.push("Rent relief capped at ₦500,000/yr: the excess changes nothing. Enter your annual rent; capped relief is ₦500,000.");
  }
  /* E5 M1/M2/M3 ; one named live notice, moved to the offending field. The
     aria-invalid flag and the focus control follow that same field. */
  const invalidIds = grossBad ? ["st-gross"]
    : detailBad ? dBad.map((s) => s.id)
    : detailBlankOnly ? dBlank.map((s) => s.id)
    : [];
  /* M3 also covers the impossible-combo rail: a valid but absurd deduction is
     not an aria-invalid syntax error, yet its notice must still sit at the
     field that caused it. Pick the largest deduction contributor ; the rail
     itself still names #st-nhf as L2 requires. */
  const rangeNow = netBad(r.net_monthly) || cmpBad;
  const rangeOffender = rangeNow
    ? ([{ id: "st-pension", v: gross * pen }, { id: "st-nhf", v: nhf }, { id: "st-nhis", v: nhis },
       { id: "st-life", v: life }, { id: "st-other", v: other }, { id: "st-rent", v: rent * 0.2 }]
        .sort((a, b) => b.v - a.v)[0] || { id: "" }).id
    : "";
  for (const id of [...DETAIL, "st-gross"]) g(id).removeAttribute("aria-invalid");
  for (const id of invalidIds) g(id).setAttribute("aria-invalid", "true");
  /* E6 F3 ; in the pure waiting state the ONE named notice moves to the first
     field instead of sitting thousands of pixels below it on a phone. No second
     live region: the same #st-warn moves with its Go-to control to #st-gross. */
  const blankDemand = notes.length > 0 && notes[0].indexOf("Enter a monthly gross above ₦0") === 0 && !invalidIds.length && !rangeNow;
  stOffender = notes.length ? (invalidIds[0] || rangeOffender || (blankDemand ? "st-gross" : null)) : null;
  fixBtn.hidden = !stOffender;
  fixBtn.textContent = stOffender ? `Go to ${labelOf(stOffender)}` : "";
  placeWarn(stOffender);
  warnBox.hidden = notes.length === 0;
  warnText.textContent = notes.join(" ");
  /* #5 hard caps (v0.7.55) ; the INPUT-side inline nudge the fresh audit asked
     for, sitting with the fields it talks about. The v0.7.52 Out-of-range guard
     above stays untouched on the receipt rail; this fires earlier, at the
     moment pension + NHF + NHIS + life assurance outrun the gross they come
     off, so the visitor fixes the inputs instead of reading a broken receipt. */
  const dedTotal = gross * pen + nhf + nhis + life + other;
  const dedWarn = t("st-dedwarn");
  if (grossKnown && !grossBad && dedTotal > gross) {
    dedWarn.hidden = false;
    dedWarn.textContent = `Heads-up: pension + NHF + NHIS + life assurance + other reliefs add up to ${n(dedTotal)}/mo, above the ${n(gross)}/mo gross you entered. At this level there is no take-home; check the deduction fields.`;
  } else {
    dedWarn.hidden = true;
    dedWarn.textContent = "";
  }
  const tb = document.querySelector("#st-bands tbody") as HTMLElement;
  tb.innerHTML = "";
  /* B4-FIX3 ; the breakdown is exemption-blind: at gross ≤ ₦70,000/mo PAYE is
     ₦0 EXEMPT while the rows printed real ₦6,000-class charges. Every number
     stays true (slices are the correct bands maths); the TAX column withholds
     as "; " under exemption and the line below names why, so the column sums
     to the PAYE above it instead of to a tax nobody pays. */
  const bandsNote = t("st-bands-note");
  for (const b of payeBandBreakdown(r.taxable, payeBands2026())) {
    const tr = document.createElement("tr");
    tr.innerHTML = `<td></td><td class="n"></td><td class="n"></td><td class="n"></td>`;
    (tr.children[0] as HTMLElement).textContent = "₦" + formatGrouped(b.low, 0) + (b.high === null ? "+" : ` – ₦${formatGrouped(b.high, 0)}`);
    (tr.children[1] as HTMLElement).textContent = (b.rate * 100).toFixed(0) + "%";
    (tr.children[2] as HTMLElement).textContent = grossBad ? "–" : n(b.slice);
    (tr.children[3] as HTMLElement).textContent = (grossBad || r.exempt) ? "–" : n(b.tax);
    tb.appendChild(tr);
  }
  bandsNote.hidden = grossBad || !r.exempt;
  bandsNote.textContent = r.exempt && !grossBad ? "EXEMPT (minimum wage): no PAYE is due, so band taxes are withheld. Slices show the pre-exemption bands maths." : "";
  /* E10 M1 ; the fresh snapshot the on-edit line reads. `bad` carries every
     withheld state, so an invalid or blank field can never produce a claim. */
  stSnapshot = { r, gross, pen, rent, nhf, nhis, life, other, bonus,
    bad: grossBad || dBad.length > 0 || dBlank.length > 0 || netBad(r.net_monthly) };
}
  sfEmpty(sfIsEmpty("salary-tax-calculator", gv));
["st-gross", "st-pension", "st-rent", "st-nhf", "st-nhis", "st-life", "st-other", "st-bonus"].forEach((id) => g(id).addEventListener("input", render));
/* ── S5 item 2 ; QUICK-CHECK CHIPS ──────────────────────────────────────────
   WP's chips (page-salary-tax-calculator.php:217-224) jump to pre-computed
   worked answers. Here each chip does both halves through the form's OWN
   path: it writes the gross field ; the receipt re-renders exactly as a
   keystroke would, SAMPLE badge clearing included ; then scrolls to the
   matching worked row below. The worked figures themselves are rendered
   server-side from the engine (see the frontmatter `wk`), never hand-typed.
   aria-pressed tracks the TYPED gross, so the chip releases the moment the
   field holds anything else. */
const QC_CHIPS = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-qc-gross]"));
function syncQcChips(): void {
  const typed = pm(g("st-gross").value);
  for (const b of QC_CHIPS) b.setAttribute("aria-pressed", Math.abs(typed - Number(b.dataset.qcGross)) < 1e-9 ? "true" : "false");
}
for (const b of QC_CHIPS) {
  b.addEventListener("click", () => {
    g("st-gross").value = b.dataset.qcGross as string;
    g("st-gross").dispatchEvent(new Event("input", { bubbles: true }));
    const target = document.getElementById(b.dataset.qcGoto as string);
    if (target) target.scrollIntoView({ behavior: "smooth", block: "center" });
  });
}
/* ── S5 item 5 ; THE PERIOD TOGGLE ──────────────────────────────────────────
   The savings-goal mode switch's grammar (buttons, not radios): the period is
   a VIEW of the same receipt, not a number. Reset restores the seeded numbers
   and leaves the chosen period standing. */
const ST_PERIOD_BTNS = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-st-period]"));
function setStPeriod(p: "monthly" | "annual"): void {
  if (p === stPeriod) return;
  stPeriod = p;
  ST_PERIOD_BTNS.forEach((b) => {
    const on = b.dataset.stPeriod === p;
    b.classList.toggle("active", on);
    b.setAttribute("aria-pressed", on ? "true" : "false");
  });
  render();
}
ST_PERIOD_BTNS.forEach((b) => b.addEventListener("click", () => setStPeriod(b.dataset.stPeriod as "monthly" | "annual")));
/* E7 F6 ; the in-card jump row. These buttons only move the viewport. Gross
   also focuses the field it names, so a thumb that chose Gross can type at
   once; the other three leave focus alone. Instant, so no smooth-scroll race
   with the next tap. */
const JUMP_TARGETS: Record<string, string> = {
  gross: "#st-gross", period: ".fx-stepper", result: "#st-fig", clear: ".sf-ctrls",
};
document.querySelectorAll<HTMLButtonElement>("[data-st-jump]").forEach((b) => {
  b.addEventListener("click", () => {
    const key = b.dataset.stJump || "";
    const el = document.querySelector(JUMP_TARGETS[key]) as HTMLElement | null;
    if (!el) return;
    el.scrollIntoView({ block: "center", behavior: "instant" });
    if (key === "gross") {
      const input = el as HTMLInputElement;
      input.focus();
      input.select();
    }
  });
});
/* ── S5 item 4 ; DEEP-LINK PREFILL ?gross= ──────────────────────────────────
   WP reads ?gross= on this very page (page-salary-tax-calculator.php:32-42):
   strip non-numeric, clamp 0–₦100M/month, silent fallback to the seed on
   garbage. The law is ported with the port's own reader (pm/pmBlank ; the
   same honest-money alphabet every field uses) and the converter's F6 URL
   mechanics (currency-converter.astro:191-237): read on load AFTER the seed
   paint, canonicalise debounced on change, pure garbage strips the query
   entirely ; no warning, no invented figure, the share link rides the state. */
const urlGross = (raw: string): string | null => {
  const s = raw.trim().slice(0, 40);
  if (s === "" || pmBlank(s)) return null;
  const v = pm(s);
  if (!Number.isFinite(v) || v <= 0 || v > 100000000) return null;
  return String(v);
};
let urlTimer: ReturnType<typeof setTimeout> | undefined;
function syncUrlNow(): void {
  const q = new URLSearchParams();
  q.set("gross", g("st-gross").value.trim().slice(0, 40));
  history.replaceState(null, "", `${location.pathname}?${q.toString()}`);
}
function syncUrl(): void {
  clearTimeout(urlTimer);
  urlTimer = setTimeout(syncUrlNow, 600);
}
(function applyUrlState(): void {
  if (!location.search) return;
  const u = new URLSearchParams(location.search);
  const a = urlGross(u.get("gross") || "");
  if (a !== null) {
    g("st-gross").value = a;
    g("st-gross").dispatchEvent(new Event("input", { bubbles: true }));
    syncUrlNow();
  } else {
    history.replaceState(null, "", location.pathname);
  }
})();
g("st-gross").addEventListener("input", syncUrl);
smartFields.register(TOOL_FIELDS["salary-tax-calculator"]);
sfBind("salary-tax-calculator", gv);
/* E10 M1 ; attached AFTER register so the cold-load restore() burst cannot
   print a change nobody made. Registered after the page's own render listener,
   so stSnapshot is already fresh when this one paints. */
["st-gross", "st-pension", "st-rent", "st-nhf", "st-nhis", "st-life", "st-other", "st-bonus"].forEach((id) =>
  g(id).addEventListener("input", () => {
    if (lcBlocked) { hideLastChange(); return; }
    paintLastChange(id);
  }));
render();
</script>
