    /* E5 L2 ; the refusal leads, the Act citation follows it. */
    if (netBad(r.net_monthly)) notes.push("Out of range: pension, NHF, NHIS, life assurance and other reliefs add up to more than your gross, so no take-home can print. Check the NHF monthly field and the monthly deduction fields against your payslip.");
