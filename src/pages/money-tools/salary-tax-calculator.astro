/* ── S5 item 4 ; DEEP-LINK PREFILL ?gross= ──────────────────────────────────
   WP reads ?gross= on this very page (page-salary-tax-calculator.php:32-42):
   strip non-numeric, clamp 0–₦100M/month, silent fallback to the seed on
   garbage. The law is ported with the port's own reader (pm/pmBlank ; the
   same honest-money alphabet every field uses) and the converter's F6 URL
   mechanics (currency-converter.astro:191-237): read on load AFTER the seed
   paint, canonicalise debounced on change, pure garbage strips the query
   entirely ; no warning, no invented figure, the share link rides the state. */
const urlGross = (raw: string): string | null => {
  const s = raw.trim().slice(0, 40);
  if (s === "" || pmBlank(s)) return null;
  const v = pm(s);
  if (!Number.isFinite(v) || v <= 0 || v > 100000000) return null;
  return String(v);
};
const URL_FIELDS: Array<[string, string]> = [
  ["gross", "st-gross"], ["pension", "st-pension"], ["rent", "st-rent"], ["nhf", "st-nhf"],
  ["nhis", "st-nhis"], ["life", "st-life"], ["other", "st-other"], ["bonus", "st-bonus"],
];
let urlTimer: ReturnType<typeof setTimeout> | undefined;
function syncUrlNow(): void {
  const q = new URLSearchParams();
  URL_FIELDS.forEach(([k, id]) => q.set(k, g(id).value.trim().slice(0, 40)));
  history.replaceState(null, "", `${location.pathname}?${q.toString()}`);
}
function syncUrl(): void {
  clearTimeout(urlTimer);
  urlTimer = setTimeout(syncUrlNow, 600);
}
/* E14 H2 ; copy/share must never read a URL the debounce has not caught up
   with. Capture phase runs before the share handler's own click listener. */
document.addEventListener("click", (e) => {
  const el = e.target as Element | null;
  if (el && el.closest(".sf-share")) syncUrlNow();
}, true);
smartFields.register(TOOL_FIELDS["salary-tax-calculator"]);
(function applyUrlState(): void {
  if (!location.search) return;
  const u = new URLSearchParams(location.search);
  let applied = false;
  URL_FIELDS.forEach(([k, id]) => {
    const raw = u.get(k);
    if (raw === null) return;
    const s = raw.trim().slice(0, 40);
    if (k === "gross") {
      const a = urlGross(s);
      if (a === null) return;
      g(id).value = a;
    } else {
      if (s === "" || pmBlank(s)) return;
      g(id).value = s;
    }
    g(id).dispatchEvent(new Event("input", { bubbles: true }));
    applied = true;
  });
  if (applied) syncUrlNow();
  else history.replaceState(null, "", location.pathname);
})();
URL_FIELDS.forEach(([, id]) => g(id).addEventListener("input", syncUrl));
/* A20 R1 ; register must run BEFORE applyUrlState. The seed badges are painted
   first, then the URL values replace them and their input events clear the
   badges, so a shared link is not labelled as our worked example. */
/* E13 H2 ; a restored pension rate on our example gross is a HYBRID, not the
   visitor's full answer. Say so beside the figure whenever a field was
   restored; cold load stays silent. */
const mixedBox = t("st-mixed");
if (mixedBox) {
  const restored = document.querySelector('.field[data-r]');
  if (restored) {
    mixedBox.hidden = false;
    mixedBox.setAttribute("data-own", "");
    mixedBox.innerHTML = "<strong>Partly yours:</strong> only your pension rate was restored. Gross, rent and the deduction fields are not remembered, so check them before trusting this figure.";
  }
}
sfBind("salary-tax-calculator", gv);
/* E10 M1 ; attached AFTER register so the cold-load restore() burst cannot
   print a change nobody made. Registered after the page's own render listener,
   so stSnapshot is already fresh when this one paints. */
["st-gross", "st-pension", "st-rent", "st-nhf", "st-nhis", "st-life", "st-other", "st-bonus"].forEach((id) =>
  g(id).addEventListener("input", () => {
    if (lcBlocked) { hideLastChange(); return; }
    paintLastChange(id);
  }));
render();
</script>
