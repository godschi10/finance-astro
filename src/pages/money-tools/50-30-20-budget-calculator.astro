});
document.addEventListener("keydown", (e) => {
  const row = (e.target as HTMLElement).closest?.(".actuals-row[data-goto]");
  if (!row) return;
  if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
    e.preventDefault();
    const target = document.getElementById((row as HTMLElement).dataset.goto as string) as HTMLInputElement | null;
    if (!target) return;
    target.scrollIntoView({ behavior: "smooth", block: "center" });
    target.focus({ preventScroll: true });
  }
});
/* E12-3/E12-2 — every "go there" CTA (bg-next, al-next, the reconcile
   fix, saved-splits links) scrolls AND focuses, never just jumps. Native
   anchor hrefs stay as the no-JS fallback. */
document.addEventListener("click", (e) => {
  const a = (e.target as HTMLElement).closest?.("a[data-goto]");
  if (!a) return;
  e.preventDefault();
  const target = document.getElementById((a as HTMLElement).dataset.goto as string) as HTMLInputElement | null;
  if (!target) return;
  target.scrollIntoView({ behavior: "smooth", block: "center" });
  target.focus({ preventScroll: true });
});
/* MF-5 — plan save: copy the live plan as one line. The "copied" word hides
   on the next render (the figures it copied are stale by then).
   T2 — "My plan" is TRUE only when all seven step-1 fields are the
   visitor's own (no SAMPLE badge, real digits entered): cold it would
   export our example as theirs, empty it would export a ₦0 plan. So
   all-typed copies "My plan"; a touched-but-partial page copies the same
   figures labelled as our example; an empty (or plan-incomplete) page
   refuses with the waiting line and copies nothing — never ₦0. */
const copyBtn = document.getElementById("bg-copy");
if (copyBtn) copyBtn.addEventListener("click", async () => {
  const done = t("bg-copied");
  const planIds = PLAN_IDS;
  const typed = (id: string) => !hasBadge(id, "data-sd") && !pmBlank(g(id).value);
  /* Refuse only when the figures would be invented: a blank plan input prices
     as ₦0, and ₦0 is never copied. Cold (all SAMPLE, all valued) is NOT a
     refusal — it copies the example, honestly labelled. */
  /* E14 — and refuse when the plan on screen is not the plan the reader took.
     With "250," in income the page will not print ₦125/₦75/₦50 anywhere (the
     verdict is CANNOT SCORE), so the clipboard must not be the one place those
     exact figures still travel. Same refusal voice, same reason: nothing to
     copy yet. */
  if (sfIsEmpty("50-30-20-budget-calculator", gv) || planIds.some((id) => pmBlank(g(id).value)) || junkIn(planIds)) {
    done.textContent = " — nothing to copy yet — enter your numbers above.";
    done.hidden = false;
    return;
  }
  const allTyped = ["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].every(typed);
  const i2 = Math.max(0, pm(g("bg-inc").value) || 0);
  const p2 = budget503020(i2,
    Math.max(0, pm(g("bg-needs").value) || 0) / 100,
    Math.max(0, pm(g("bg-wants").value) || 0) / 100,
    Math.max(0, pm(g("bg-save").value) || 0) / 100);
  const summary = allTyped
    ? `My 50/30/20 plan (income ${nn(i2)}): needs ${nn(p2.needs)}, wants ${nn(p2.wants)}, savings ${nn(p2.savings)}.`
    : `EXAMPLE: Our 50/30/20 example (income ${nn(i2)}): needs ${nn(p2.needs)}, wants ${nn(p2.wants)}, savings ${nn(p2.savings)}. Type your own numbers to make it yours.`;
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(summary);
    else throw new Error("no clipboard");
    done.textContent = " — copied.";
  } catch { done.textContent = " — copy failed here; long-press the plan line above."; }
  done.hidden = false;
});

  // E7: Quick-fill handlers
  document.querySelectorAll('[data-fill]').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = document.getElementById(btn.dataset.fill);
      if (target) {
        target.value = btn.dataset.value;
        target.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
  });
  document.querySelectorAll('[data-preset]').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.dataset.preset;
      if (preset === '50,30,20') { g('bg-needs').value='50'; g('bg-wants').value='30'; g('bg-save').value='20'; }
      else if (preset === '60,20,20') { g('bg-needs').value='60'; g('bg-wants').value='20'; g('bg-save').value='20'; }
      else if (preset === '70,15,15') { g('bg-needs').value='70'; g('bg-wants').value='15'; g('bg-save').value='15'; }
      ['bg-needs','bg-wants','bg-save'].forEach(id => g(id).dispatchEvent(new Event('input', { bubbles: true })));
    });
  });
  /* E11-1 — the OTHER half of the A11 CRITICAL. These three chips write a PLAN
     figure into a SPEND field, exactly like the `.offer [data-use]` rail, and
     they were doing it with no disclosure at all. They now call the same
     disclosePlanWrite() the rail calls, so there is one voice for one fact. */
  document.querySelectorAll('[data-fill-from-plan]').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = document.getElementById(btn.dataset.fillFromPlan);
      if (!target) return;
      const plan = budget503020(
        Math.max(0, pm(g('bg-inc').value) || 0),
        Math.max(0, pm(g('bg-needs').value) || 0) / 100,
        Math.max(0, pm(g('bg-wants').value) || 0) / 100,
        Math.max(0, pm(g('bg-save').value) || 0) / 100
      );
      if (target.id === 'bg-spn') target.value = String(Math.round(plan.needs));
      else if (target.id === 'bg-spw') target.value = String(Math.round(plan.wants));
      else if (target.id === 'bg-sps') target.value = String(Math.round(plan.savings));
      target.dispatchEvent(new Event('input', { bubbles: true }));
      /* AFTER the dispatch, deliberately. dispatchEvent('input') is synchronous,
         and the bg-spn input listener above lifts this note the moment the field
         changes — so disclosing first would be undone in the same tick and the
         note would never be seen. Order is load-bearing; do not swap. */
      disclosePlanWrite();
    });
  });
  document.querySelectorAll('[data-fill-actual]').forEach(btn => {
    btn.addEventListener('click', () => {
      const b = btn.dataset.fillActual;
      /* Same inputs render() reads, same engine — never a second maths source. */
      const inc = Math.max(0, pm(g('bg-inc').value) || 0);
      const shares3: Record<string, number> = {};
      document.querySelectorAll('[data-al-bucket]').forEach((el) => {
        const inp = el as HTMLInputElement;
        shares3[inp.dataset.alBucket as string] = Math.max(0, pm(inp.value) || 0) / 100;
      });
      const r = budgetAllocator(inc,
        Math.max(0, pm(g('bg-needs').value) || 0) / 100,
        Math.max(0, pm(g('bg-wants').value) || 0) / 100,
        Math.max(0, pm(g('bg-save').value) || 0) / 100,
        shares3);
      const amt = r.buckets.find((x) => x.id === b)?.amount ?? 0;
      const el = document.getElementById(ACT_ID[b]) as HTMLInputElement;
      if (!el) return;
      el.value = String(Math.round(amt));
      el.dispatchEvent(new Event('input', { bubbles: true }));
      /* A plan figure scored as an actual is "on plan" by construction — the
         visitor must hear that, same disclosure as every other plan-write. */
      disclosePlanWrite();
    });
  });
  document.querySelectorAll('[data-apply-defaults]').forEach(btn => {
    btn.addEventListener('click', () => {
      const defaults = { rent: 40, food: 25, transport: 15, data: 10, utilities: 7 };
      Object.entries(defaults).forEach(([id, val]) => {
        const el = document.getElementById('al-' + id);
        if (el) { el.value = String(val); el.dispatchEvent(new Event('input', { bubbles: true })); }
      });
    });
  });

render();
</script>
