---
import ToolShell from "../../components/ToolShell.astro";
import { budget503020, budget503020Compare, BUDGET_SEED_INCOME } from "../../lib/budget";
import { budgetAllocator } from "../../lib/allocator";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
const income = BUDGET_SEED_INCOME;
const seed = budget503020(income);
/* The seed month must be INTERNALLY CONSISTENT, because this is the first
   thing every visitor sees. It was not: income 250,000 at 50/30/20 puts needs
   at 125,000, while "Spent on needs" shipped 140,000 — so the flagship tool
   opened on ₦-15,000 of needs remaining, i.e. on a negative number, on a page
   whose entire argument is that its figures are honest. Wants had the same
   fault (-15,000). Income and the 50/30/20 split are untouched (BUDGET_SEED_INCOME
   is asserted by the vectors gate and named in the page's own sourced context
   line), so only the three ACTUAL-spend seeds move, and they now describe one
   real month: 120,000 spent on needs (5,000 under plan), 65,000 on wants
   (10,000 under), 40,000 put to savings (10,000 SHORT of the 20% the plan asks
   for). 225,000 spent of 250,000 earned. Every "left" figure is non-negative,
   and the one gap the example still shows — savings 10,000 light — is the
   honest, instructive one for a budget tool to show. */
const seedActuals = { needs: 120000, wants: 65000, savings: 40000 };
const chk = budget503020Compare(income, 0.5, 0.3, 0.2, seedActuals.needs, seedActuals.wants, seedActuals.savings);
/* Step 2 seed: the needs half of the SAME income, itemised with the allocator
   engine's own defaults (rent 40 / food 25 / transport 15 / data 10 / bills 7).
   One income in, both steps out — the page opens on one continuous journey. */
const al = budgetAllocator(income);
const seedRent = al.buckets.find((b) => b.id === "rent")?.amount ?? 0;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="50/30/20 Budget Calculator, Nigeria - GWill Finance" description="Split any income into needs, wants and savings, check real spending against the plan — then break the needs half into rent, food, transport, data and bills, all on one page." slug="50-30-20-budget-calculator" tool="50/30/20 Budget Calculator" lede="Half for needs, 30% for wants, a fifth for future-you. Set the income, check your actual spending, then itemise the needs half — two steps, one page." verified="Two steps, one page · plan vs actual checker · needs-half buckets" faqs={[
  { q: "Is 50/30/20 realistic on a Nigerian salary?", a: "As a direction, yes; as law, adjust. High rent cities may need 60/20/20 for a season — the tool accepts custom splits." },
  { q: "What counts as savings?", a: "Anything future-you keeps: emergency fund, investments, debt repayment. Not the money sitting in your spending account." },
  { q: "Where exactly does the needs half go?", a: "Step 2 on this same page breaks your plan's needs figure into rent, food, transport, data and bills, with every share tunable. One tool, one journey — no second page." },
]}

  badge="The 50/30/20 rule · Simple budgeting",
  copy={[["p", "The 50/30/20 rule is the most popular budgeting method for a reason: it is simple enough to remember and flexible enough to stick to. You divide your take-home pay into three buckets, 50% to needs, 30% to wants, 20% to savings and debt repayment. No complicated categories, no spreadsheet required. It is a starting point you can adjust as your life changes."],["p", "Needs are the things you cannot function without: rent or mortgage, food, transport to work, utility bills, and the minimum payments on your debt. Wants are everything else, the takeaways, the subscriptions you barely use, the upgrade you do not need. The rule&#039;s real value is forcing you to draw that line honestly. Most budgets that fail do so because wants quietly sneak into the needs column."],["p", "In Nigeria, high inflation and rising costs make strict needs-heavy budgets common, housing and food can easily consume well over 50%. That is fine. Treat 50/30/20 as a target to move toward, not a rule to feel guilty about. Start by tracking what your needs actually cost, then push the savings slice up over time. Even starting at 10% savings and inching toward 20% beats saving nothing at all. Use your take-home (net) pay, the money that actually lands in your account, not your gross."],["p", "The 20% savings-and-debt bucket is the seed that grows your future. Once you are saving, put it to work, see it compound with our compound interest calculator, or set a specific target with our savings goal calculator. And remember inflation erodes any goal, our inflation-adjusted calculator shows what you truly need to save."],["p", "Strict 50/30/20 assumes your big needs cost about half your take-home. In high-cost Nigerian cities, rent and food alone can push well past that, which is not a failure of the rule, just a reality to plan around. The important part is to keep the savings slice conscious and growing, even if the mix leans heavier on needs. Adjust the three percentage fields above to whatever split your numbers actually support, rather than forcing a 50/30/20 square peg."],["p", "50/30/20 gives you the three big numbers. To turn them into a budget you can actually spend against, break the needs bucket into real Nigerian categories, rent, food, transport, data, utilities. Step 2 of this same calculator, below the receipt, takes this same split and digs into the needs half, showing exactly how many naira go to rent, food, transport, data and bills, with every share editable so the plan always adds up."],["p", "Start from your take-home pay, never your gross. Whatever your income, the goal is the same: give every naira a job, so nothing leaks away unnoticed."],["p", "The rule fails when people treat it as a rigid law instead of a compass. One classic mistake is budgeting on gross pay, which inflates every bucket and leaves you chasing money that never landed. Another is stuffing the wants bucket with expenses that are really needs in disguise, the \"basic\" phone plan you upgraded twice, the meal delivery that quietly became dinner. And the third is ignoring the leftover entirely: if your three percentages do not sum to 100, the leftover has no job, so it disappears into the void of everyday spending."],["p", "The fix for all three is honest categorising. Budget on what hits your account. When something feels like a want, ask whether you would genuinely afford to drop it this month, if it is a bill you must pay, it belongs in needs. And make sure your split adds up. The calculator above flags any unallocated remainder so you can add it to savings rather than let it vanish."],["p", "Freelancers, commission earners and seasonal workers face a question the 50/30/20 rule glosses over: what is your \"take-home\" when every month is different? The workable answer is to base the budget on your average of the last three months, not your best month. Budget on the average, and when a good month arrives, sweep the surplus past the 20% savings slice rather than inflating your wants."],["p", "Because the rule is percentage-based, it scales with whatever number you enter, that is precisely why this tool takes a single income figure and lets you adjust the three splits. Set the income to your moving average and the buckets adjust automatically, so a lean month is no longer a mystery and a strong month becomes a chance to save more."],["h2", "Budgeting questions"],["h3", "What is the 50/30/20 rule?"],["p", "A simple budget that puts 50% of your take-home pay toward needs, 30% toward wants, and 20% toward savings and paying down debt."],["h3", "How much should I allocate from a ₦250,000 salary?"],["p", "About ₦125,000 for needs, ₦75,000 for wants, and ₦50,000 for savings/debt each month."],["h3", "Should I use gross or net income?"],["p", "Use your take-home (net) pay, the amount that actually reaches your account after tax, because that is what you can genuinely spend and save."],["h3", "What counts as a need versus a want?"],["p", "Needs are what you cannot do without: housing, food, transport, utilities, minimum debt payments. Wants are the rest, dining out, entertainment, upgrading your phone. If in doubt, it is a want."]]},
  related={[
    { href: `${base}money-tools/compound-interest-calculator/`, title: "Compound Interest Calculator", excerpt: "Put the 20% to work — project your savings year by year." },
    { href: `${base}money-tools/savings-goal-calculator/`, title: "Savings Goal Calculator", excerpt: "Name the target and deadline — get the exact monthly price." },
    { href: `${base}money-tools/inflation-savings-calculator/`, title: "Inflation Savings Calculator", excerpt: "Inflate the goal first, then price what you truly need to save." },
  ]}
  disclaimer="This calculator is for informational guidance only and is not financial advice. The 50/30/20 rule is a budgeting framework, not a guarantee of outcomes, adjust it to your circumstances and confirm major decisions with a licensed adviser.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<p class="receipt-note" id="bg-memdate" hidden></p>
<p class="receipt-note" id="bg-live" hidden></p>
<!-- Visual stepper -->
<div class="fx-stepper" id="bg-stepper" aria-label="Budget steps">
  <button type="button" class="fx-step active" data-step="1" aria-current="step">1. Plan</button>
  <button type="button" class="fx-step" data-step="2" aria-disabled="true">2. Itemise</button>
</div>
<!-- E10 (A10-C7) — the seed exit, INSIDE the card and inside the first screen.
     The shell's own "Clear examples" / "Reset" pair is shared with every other
     calculator: it lives in a footer strip 4.9 viewport-heights down a 390px
     phone, outside .fx-card, at 31px. Both of those are untouched and keep
     working; these two are ADDITIVE and simply press the very same buttons, so
     the page still has exactly one clear() and one reset(). 44px minimum, the
     site's own tap floor. -->
<div class="fx-chips" style="margin-top:0" id="bg-examplectl" aria-label="Leave the worked example">
  <button type="button" class="btn b-ghost b-sm" id="bg-clear-example" style="min-height:44px" hidden>Clear the example</button>
  <button type="button" class="btn b-ghost b-sm" id="bg-reset-example" style="min-height:44px">Reset to the example</button>
</div>
<div class="tgrid c3" id="bg-top">
<div class="field"><label for="bg-inc">Monthly income ₦</label><input id="bg-inc" type="text" value={income} inputmode="decimal" autocomplete="section-income"></div>
<div class="field"><label for="bg-needs">Needs %</label><input id="bg-needs" type="text" max="100" value="50" inputmode="decimal" placeholder="50" autocomplete="section-budget-splits"></div>
<div class="field"><label for="bg-wants">Wants %</label><input id="bg-wants" type="text" max="100" value="30" inputmode="decimal" placeholder="30" autocomplete="section-budget-splits"></div>
<div class="field"><label for="bg-save">Savings %</label><input id="bg-save" type="text" max="100" value="20" inputmode="decimal" placeholder="20" autocomplete="section-budget-splits"></div>
<div class="field"><label for="bg-spn">Spent on needs ₦</label><input id="bg-spn" type="text" value={String(seedActuals.needs)} inputmode="decimal" autocomplete="off"></div>
<div class="field"><label for="bg-spw">Spent on wants ₦</label><input id="bg-spw" type="text" value={String(seedActuals.wants)} inputmode="decimal" autocomplete="off"></div>
<div class="field"><label for="bg-sps">Put to savings ₦</label><input id="bg-sps" type="text" value={String(seedActuals.savings)} inputmode="decimal" autocomplete="off"></div>
</div>
<!-- E13 — the input-health rails. pm() is deliberately tolerant: it reads
     "12.5.5" as 0, "abc" as never-entered and "1e9" as a billion naira, so
     the field and the maths could disagree and the visitor was never told
     (A13 proved it live: "12.5.5" in the income box still printed "AHEAD —
     Our example puts ₦40,000 extra to savings"). Each of these owns ONE
     question, names the fields at fault in the labels' own words, and routes
     to the first offender. They sit directly under the grid they police, so
     nobody has to hunt for the box, and they are emptied as well as hidden
     when they have nothing to say — a hidden rail must never carry stale
     prose. .receipt-note is carried for the fleet's rail vocabulary; the
     inline colour is --text-mid because these three sit on --surface, not on
     the dark receipt slip, where #c4b89a would be unreadable in light. -->
<p class="receipt-note" id="bg-junk" hidden style="color:var(--text-mid);border-left:2px solid var(--red);padding-left:10px;margin:12px 0 0"></p>
<p class="receipt-note" id="bg-range" hidden style="color:var(--text-mid);border-left:2px solid var(--red);padding-left:10px;margin:12px 0 0"></p>
<p class="receipt-note" id="bg-big" hidden style="color:var(--text-mid);border-left:2px solid var(--red);padding-left:10px;margin:12px 0 0"></p>
<!-- Income quick-fill chips -->
<div class="fx-chips" style="margin-top:10px" id="income-chips" aria-label="Quick-fill income">
<button type="button" class="fx-chip" data-fill="bg-inc" data-value="70000" aria-label="Fill ₦70,000">₦70k</button>
<button type="button" class="fx-chip" data-fill="bg-inc" data-value="100000" aria-label="Fill ₦100,000">₦100k</button>
<button type="button" class="fx-chip" data-fill="bg-inc" data-value="150000" aria-label="Fill ₦150,000">₦150k</button>
<button type="button" class="fx-chip" data-fill="bg-inc" data-value="250000" aria-label="Fill ₦250,000">₦250k</button>
<button type="button" class="fx-chip" data-fill="bg-inc" data-value="500000" aria-label="Fill ₦500,000">₦500k</button>
</div>
<!-- Split preset chips -->
<div class="fx-chips" style="margin-top:10px" id="split-chips" aria-label="Quick-fill split percentages">
<button type="button" class="fx-chip" data-preset="50,30,20" aria-label="Fill 50/30/20 split">50/30/20</button>
<button type="button" class="fx-chip" data-preset="60,20,20" aria-label="Fill 60/20/20 split">60/20/20</button>
<button type="button" class="fx-chip" data-preset="70,15,15" aria-label="Fill 70/15/15 split">70/15/15</button>
</div>
<!-- E10 (A10-C5) — the plain words live on the LABEL, not on a hover title.
     E9 rewrote only the hover `title`, and only on two of these three (the
     savings button's title reads "Fill savings from plan", so the single-match
     replace skipped it). A 390px phone has no hover path at all, so the gloss
     was dead where it matters. All three now say it, visibly, on every device. -->
<div class="quick-fills" id="bg-actuals-fills" style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">
  <button type="button" class="btn b-ghost b-xs" data-fill-from-plan="bg-spn" title="Use my targets — put what you spent on needs straight from the plan's needs target">Use my targets — needs</button>
  <button type="button" class="btn b-ghost b-xs" data-fill-from-plan="bg-spw" title="Use my targets — put what you spent on wants straight from the plan's wants target">Use my targets — wants</button>
  <button type="button" class="btn b-ghost b-xs" data-fill-from-plan="bg-sps" title="Use my targets — put what you saved straight from the plan's savings target">Use my targets — savings</button>
</div>
<p class="receipt-note" id="bg-seedwarn" hidden></p>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Plan buckets</p>
<p class="receipt-fig" id="bg-fig">₦{n(seed.needs)} · ₦{n(seed.wants)} · ₦{n(seed.savings)}</p>
<p class="receipt-sub" id="bg-sub">Needs · wants · savings — leftover <span id="bg-else">₦{n(seed.else)}</span></p>
<p class="receipt-sub" id="bg-sumnote"></p>
<p class="receipt-note" id="bg-warn" hidden></p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row" data-goto="bg-spn" tabindex="0" role="button" style="cursor:pointer;min-height:44px;display:flex;align-items:center" title="See the field behind this figure"><span>Needs left <span aria-hidden="true">›</span></span><b id="bg-rn">₦{n(chk.needs_remaining)}</b></div>
<div class="receipt-row" data-goto="bg-spw" tabindex="0" role="button" style="cursor:pointer;min-height:44px;display:flex;align-items:center" title="See the field behind this figure"><span>Wants left <span aria-hidden="true">›</span></span><b id="bg-rw">₦{n(chk.wants_remaining)}</b></div>
<div class="receipt-row" data-goto="bg-sps" tabindex="0" role="button" style="cursor:pointer;min-height:44px;display:flex;align-items:center" title="See the field behind this figure"><span>Savings left to save <span aria-hidden="true">›</span></span><b id="bg-rs">₦{n(chk.savings_remaining)}</b></div>
<p class="receipt-note" id="bg-pasted" hidden></p>
<p class="receipt-note" id="bg-whatnow" hidden></p>
<p class="receipt-foot hint">Plan vs actual: leftover = income your splits didn't assign</p>
<p class="receipt-foot hint">Wants left = plan wants minus spent on wants</p>
<p class="receipt-foot hint">Savings left to save = plan savings minus put to savings</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
<!-- Next-action CTAs after Step 1 -->
<div class="next-actions" id="bg-next" hidden></div>
<p class="receipt-note"><a href="#step2">See where the needs money goes ↓</a> · <button type="button" class="btn b-ghost b-lg" id="bg-copy" style="min-height:44px">Copy example plan</button><span id="bg-copywhy" data-trust="example"> — cold, this copies our example.</span><span id="bg-copied" hidden> — copied.</span></p>
<div class="receipt-div" aria-hidden="true"></div>
<h3 id="step2" style="position:sticky;top:0;background:var(--surface);z-index:10;padding-top:12px">Step 2 — where the needs money goes</h3>
<p>One tool, one journey. This is the plan's needs figure from step 1 — the same income, the same split — itemised into real Nigerian lines: rent, food, transport, data, bills. Knowing you should spend <span id="bg-step2-needs">₦{n(seed.needs)}</span> on needs is useful; knowing rent takes about <span id="bg-step2-rent">₦{n(seedRent)}</span> of it is actionable. The shares below are indicative starting points, not laws — tune any bucket and the naira follows instantly, always reconciling back to your income.</p>
<p class="receipt-note"><a href="#bg-top">↑ Adjust income &amp; split</a></p>
<p class="receipt-note" id="bg-mini" hidden></p>
<div class="tgrid c3" style="margin-top:14px">
{al.buckets.filter((b) => b.id !== "other").map((b) => (
<div class="field"><label for={`al-${b.id}`}>{b.label} % of needs</label><input id={`al-${b.id}`} type="text" max="100" value={(b.share * 100).toFixed(0)} inputmode="decimal" data-al-bucket={b.id}></div>
))}
</div>
<!-- Apply defaults button -->
<div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
  <button type="button" class="btn b-ghost b-sm" data-apply-defaults aria-label="Apply default needs shares (rent 40%, food 25%, transport 15%, data 10%, bills 7%)">Apply defaults</button>
</div>
<!-- E10 (A10-C1/C3) — the mirror's own inputs. The old panel had no
     per-bucket actual field anywhere: it MANUFACTURED one by rescaling the
     single "Spent on needs" figure, so all five variance badges always agreed
     and the panel could never say the only thing worth saying ("rent over,
     food under"). These five are the fix. They ship EMPTY — no invented
     naira is typed in for anyone — and each is optional: a blank bucket is
     UNKNOWN, and an unknown bucket prints no amount and no badge at all. -->
<div class="tgrid c3" id="al-actual-fields" style="margin-top:14px">
{al.buckets.filter((b) => b.id !== "other").map((b) => (
<div class="field"><label for={`al-act-${b.id}`}>{b.label} — you actually spent ₦</label><input id={`al-act-${b.id}`} type="text" inputmode="decimal" placeholder="—" autocomplete="off" data-al-actual={b.id}></div>
))}
</div>
<!-- E13 — step 2's own malformed rail. The five shares decide what "Other
     needs" IS and the five actuals are scored into badges, so one junk box
     here prices a bucket at ₦0 and then prints a confident "UNDER ₦48,000"
     for it — the exact lie step 1 was caught telling, five fields further
     down the same page. -->
<p class="receipt-note" id="al-junk" hidden style="color:var(--text-mid);border-left:2px solid var(--red);padding-left:10px;margin:12px 0 0"></p>
<p class="receipt-note" id="al-actual-hint">Optional — score just the buckets you know. A bucket you leave blank still shows that bucket's plan amount, but no "you spent" figure and no badge, because we have nothing real to score it against. Nothing is filled in for you here.</p>
<!-- E12-10 — the five actuals faced a blank naira grid with no affordance.
     Same vocabulary as the income chips above: one tap writes THAT bucket's
     plan amount, clearly labelled, and routes through the same disclosure
     the step-1 "Use my targets" chips use. -->
<div class="quick-fills" id="al-actual-fills" style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">
  <button type="button" class="btn b-ghost b-xs" data-fill-actual="rent">Use plan — rent</button>
  <button type="button" class="btn b-ghost b-xs" data-fill-actual="food">Use plan — food</button>
  <button type="button" class="btn b-ghost b-xs" data-fill-actual="transport">Use plan — transport</button>
  <button type="button" class="btn b-ghost b-xs" data-fill-actual="data">Use plan — data</button>
  <button type="button" class="btn b-ghost b-xs" data-fill-actual="utilities">Use plan — bills</button>
</div>
<!-- Verdict banner (plain-language) -->
<div class="verdict-banner" id="al-verdict" aria-live="polite"></div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Needs budget (<span data-sf-fig id="al-pct">50%</span> of income): <span data-sf-fig id="al-needs">₦{n(al.needs)}</span></p>
<div id="al-rows">
{al.buckets.map((b) => (
<div class="receipt-row"><span>{b.label}</span><b data-al-amt={b.id}>₦{n(b.amount)}</b></div>
))}
</div>
<p class="receipt-note" id="al-warn" hidden></p>
<p class="receipt-note" id="al-sharesum" hidden></p>
<!-- The aggregate needs-vs-plan line keeps MF-4's own element (id al-needsline).
     It was merged into al-actuals in E9 and destroyed by the same innerHTML
     overwrite; its own node is the fix. -->
<p class="receipt-note" id="al-needsline" hidden></p>
<div class="receipt-div" aria-hidden="true"></div>
<!-- E10 (A10-C1/C8) — the mirror panel gets its own heading (five unlabelled
     rows told a first-time visitor nothing) and its OWN disclosure element.
     E9 wrote the ownership sentence into this panel's note and then, 100 lines
     later, overwrote the same node with innerHTML — the page deleted its own
     safety disclosure at render time. The disclosure now lives in #al-mirror-own
     and NOTHING else writes it; the rows write #al-actuals only. The Example
     badge rides inside the panel, so ownership travels with the numbers instead
     of decaying at the section boundary. -->
<p class="receipt-lbl" id="al-mirror-h" hidden>Plan vs what you actually spent, bucket by bucket <span class="trust-badge" data-trust="example" id="al-mirror-badge" hidden>Example</span></p>
<p class="receipt-note" id="al-mirror-own" hidden></p>
<div class="actuals-rows" id="al-actuals" hidden></div>
<p class="receipt-note" id="al-onplan" hidden></p>
<!-- E11-8: the aggregate-vs-buckets reconciliation line. Hidden until the
     visitor has scored at least one bucket AND entered a needs total. -->
<p class="receipt-note" id="al-reconcile" hidden></p>
<p class="receipt-note" id="al-reconcile-fix" hidden><a class="btn b-ghost b-xs" id="al-reconcile-go" href="#bg-spn" data-goto="bg-spn">Correct the needs total</a></p>
<p class="receipt-foot hint">Variance = what you entered, minus that bucket's plan</p>
<p class="receipt-foot">Shares of needs — naira follows instantly</p>
<p class="receipt-foot hint">Other needs is whatever is left after the named shares</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
<!-- Next-action CTAs after Step 2 -->
<div class="next-actions" id="al-next" hidden></div>
<p class="receipt-note" id="bg-resetnote">Reset wipes what you typed and restores our example — it cannot be undone.</p>
</div>
</ToolShell>
<script>
import { budget503020, budget503020Compare } from "../../lib/budget";
import { budgetAllocator } from "../../lib/allocator";
import { formatGrouped } from "../../lib/format";
import { pm, pmBlank, pmHonest } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig, SF_DASH } from "../../data/tool-fields";
/* F1 — fleet-wide negative shape (the crypto tool's winner): a negative prints
   −₦X (U+2212 minus before the symbol), never ₦-X. format.ts stays
   PHP-parity-pinned (it mirrors gwill_paye_number), so this is fixed per page
   on the two pages whose figures can actually go negative. */
const nn = (v: number) => (v < 0 ? "−" : "") + "₦" + formatGrouped(Math.abs(v), 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
/* Badge reads, module scope: render() uses them for the seedwarn gate and the
   copy handler below uses the same badges, so one definition serves both. */
const hasBadge = (id: string, attr: string) => {
  const fi = document.getElementById(id);
  const f = fi && (fi as HTMLElement).closest ? (fi as HTMLElement).closest(".field") : null;
  return !!(f && (f as Element).hasAttribute(attr));
};
/* E10 — the five needs buckets, and the OPTIONAL actual-spend field that goes
   with each. Module scope because render()'s negative-rail check needs the ids
   too. The engine's own bucket list is never re-typed here: AL_BUCKETS is the
   five NAMED buckets only, in the allocator's order. */
const AL_BUCKETS = ["rent", "food", "transport", "data", "utilities"];
const ACT_ID: Record<string, string> = {
  rent: "al-act-rent", food: "al-act-food", transport: "al-act-transport",
  data: "al-act-data", utilities: "al-act-utilities",
};
const ACT_IDS = AL_BUCKETS.map((b) => ACT_ID[b]);
/* ── E13 — INPUT HEALTH ───────────────────────────────────────────────────
   A13 found the CRITICAL on this page and the Manager re-proved it on live
   bytes: the income box accepted "12.5.5" and the page still printed "AHEAD
   — Our example puts ₦40,000 extra to savings", a verdict computed from a
   figure nobody entered. "abc" emptied the verdict with no explanation, and
   "1e9" moved a billion naira through the plan unchallenged. The cause is
   that pm() is deliberately TOLERANT — that tolerance is what keeps a
   grouped "₦1,234.50" live-accurate — so the field showed one thing while the
   maths used another and nothing on the page said so.

   These predicates are the only NEW truth source here, and they are built
   FROM pm/pmBlank/pmHonest rather than beside them, so they can never
   disagree with the reader the maths actually uses. */
/* pm()'s own strip expression (pm.js) — but WITHOUT pm()'s final NaN→0
   swallow, which is the one thing this test has to see through. pm() returns
   0 for both "" and "12.5.5"; the only way to tell a real figure from junk is
   to run its strip yourself and look at the Number it fed to that swallow.
   Returning NaN is deliberate and safe here: nothing downstream ever uses
   this as a value, only Number.isFinite() on it. */
const pmRaw = (v: string): number => Number(String(v).replace(/[\u200B-\u200F\uFEFF]/g, "").replace(/[^\d.eE-]/g, ""));
/* The field names exactly as the visitor reads them. TEXT NODES ONLY, never
   textContent: the spine appends its SAMPLE / LAST USED pill INSIDE the
   label (mark(), smart-fields.js), so textContent is "Needs %Last used" and
   every sentence below would ship garbled — the BREAK-1 lesson, applied to
   the new rails rather than rediscovered by them. */
const fieldName = (id: string): string => {
  const l = document.querySelector(`label[for="${id}"]`);
  if (!l) return id;
  let s = "";
  l.childNodes.forEach((n) => { if (n.nodeType === 3) s += n.textContent || ""; });
  return s.trim() || id;
};
/* Every one of these rails is innerHTML (it ends on an anchor), and one of
   them echoes what the visitor typed back at them — so the echo is escaped. */
const esc = (s: string): string => s.replace(/[&<>"']/g, (c) => (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" } as Record<string, string>)[c]));
/* The seven step-1 inputs this page's maths reads, and the three of them
   that are SHARES of one income rather than amounts. */
const STEP1_IDS = ["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"];
const SPLIT_IDS = ["bg-needs", "bg-wants", "bg-save"];
/* The four ids a PLAN figure is read from: income and the three splits. Step 1's
   receipt, step 2's buckets, the live line, the mini line and the whole mirror
   panel are that one figure itemised, so a junk box among the four means no
   plan figure anywhere on the page is true — not "priced from a number nobody
   entered". */
const PLAN_IDS = ["bg-inc", "bg-needs", "bg-wants", "bg-save"];
/* What the reader took from a malformed box, in the field's own unit, so the
   rail can say it instead of leaving the visitor to guess. The three step-1
   splits and the five step-2 shares are percentages; everything else here is
   naira. Never re-typed: AL_BUCKETS is the engine's own list (above). */
const PCT_IDS = SPLIT_IDS.concat(AL_BUCKETS.map((b) => "al-" + b));
const MONEY_IDS = ["bg-inc", "bg-spn", "bg-spw", "bg-sps"];
const unitOf = (id: string): string => (PCT_IDS.indexOf(id) >= 0 ? "0%" : "₦0");
/* What the reader ACTUALLY took from a box, in the field's own unit — so a rail
   can quote the figure instead of leaving the visitor to work out that "250,"
   was priced as ₦250. */
const readAs = (id: string): string => (PCT_IDS.indexOf(id) >= 0 ? `${pm(g(id).value)}%` : nn(pm(g(id).value)));
/* ── THE COMMA THAT IS NOT A THOUSANDS COMMA ────────────────────────────────
   pm() is provenance-blind about separators: it strips "," before it reads, so
   "₦1,500,000" lands on 1500000 — the grouped naira a blurred money field
   legitimately holds. The SAME strip is why "250," reads 250 and "," reads 0,
   and both are alphabet-legal, so every predicate built from pmHonest() waves
   them through as well-formed: malformedOf() said not-malformed, pmBlank() said
   entered, the reader took 250, and the page priced an entire plan off a
   near-miss keystroke — ₦125 of needs with the verdict confidently AHEAD, on
   income that is either ₦250,000 or a typo. The Manager re-proved it on live
   bytes.

   pm() is off-limits (the fleet's reader, 63 call sites, and its tolerance is
   what keeps a grouped figure live-accurate), so the page answers the one
   question the reader cannot. A thousands comma has digits on its left,
   exactly three digits on its right, and a group boundary after them. Anything
   else is a separator the visitor reached for while typing a naira amount, and
   it goes through the same junk rail as "12.5.5" — with the figure the reader
   took said out loud, never silently repaired to 250000. */
const misplacedComma = (v: string): boolean => {
  const s = String(v).trim();
  for (let i = 0; i < s.length; i++) {
    if (s[i] !== ",") continue;
    /* Nothing before it ⇒ a leading comma. Fewer than three digits after it,
       or digits with no group boundary after them ⇒ trailing, doubled or
       simply in the wrong place. "1,234.50" keeps its comma: three digits then
       the decimal point, which is a group boundary. */
    const before = s[i - 1];
    if (!(before >= "0" && before <= "9")) return true;
    if (!/^\d{3}([.,]|$)/.test(s.slice(i + 1))) return true;
  }
  return false;
};
/* MALFORMED — visible text that is not a figure, in the three shapes this page
   actually produces, because it does three different things with them:
     "unparseable"  every character is in the honest-money alphabet but the
                    text is still not a number ("12.5.5"). pm() discards the
                    whole thing to 0, so the receipt prints a confident ₦0
                    nobody typed.
     "unreadable"   characters outside that alphabet ("abc"). pmBlank reads
                    these as never-entered, so every dependent figure is
                    held back as "—" and the verdict goes quiet with no
                    explanation at all.
     "separator"    the honest-money alphabet with a comma in it that is not a
                    grouping comma ("250," / ","). pm() drops it and reads the
                    rest, so the field shows one figure while the maths uses
                    another — the near-miss CRITICAL. It is not blank (there
                    are digits) and it is not NaN (the rest is a real number),
                    so this test is the only thing on the page that can see it.
   A genuinely EMPTY field is NOT malformed: the offer rail already names it
   and says "empty, not zero", which is the honest answer. Neither is a value
   pm() reads exactly as written — "₦1,234.50", "1 234 500", "8.5%", "007",
   "1e5", "+500" all parse and are left strictly alone. */
const malformedOf = (id: string): "" | "unreadable" | "unparseable" | "separator" => {
  const v = g(id).value;
  if (v.trim() === "") return "";
  if (!pmHonest(v)) return "unreadable";
  if (misplacedComma(v)) return "separator";
  return Number.isFinite(pmRaw(v)) ? "" : "unparseable";
};
/* Name up to three offending fields in the labels' own words — "A", "B and C"
   — then count the rest, so seventeen junk boxes cannot become a
   seventeen-field sentence. */
const nameList = (ids: readonly string[]): string => {
  const named = ids.slice(0, 3).map((id) => `"${esc(fieldName(id))}"`);
  const more = ids.length - named.length;
  let s = named.length > 1 ? `${named.slice(0, -1).join(", ")} and ${named[named.length - 1]}` : named[0];
  if (more) s += ` and ${more} more field${more > 1 ? "s" : ""}`;
  return s;
};
/* The tail every input-health rail ends on: the FIRST offender, named, on the
   same data-goto CTA grammar the reconcile fix already uses — a tap scrolls
   AND focuses the box instead of only jumping to it. */
const goTo = (id: string): string => ` <a class="btn b-ghost b-xs" href="#${id}" data-goto="${id}">Go to "${esc(fieldName(id))}"</a>`;
/* The junk predicate, per FIGURE: the ids this figure is read from, judged the
   way the rails above judge them. A figure whose inputs include a malformed
   field would print the reader's number while the field shows another, so it
   withholds — the rule sfFig() already applies to a BLANK dep, extended to a
   junk one. One helper, so no call site can invent its own narrower test. */
const junkIn = (ids: readonly string[]): boolean => ids.some((id) => !!malformedOf(id));
/* The same withhold grammar tool-fields.ts uses for a blank dep: the same dim
   dash, and the same data-sf-no marker. The marker is load-bearing — without
   it sfEmpty()'s kept-map restore mistakes this deliberate dash for the empty
   state's and writes a stale figure straight back over it. */
const NO_FIG = "data-sf-no";
const sfFigJ = (el: HTMLElement | null, deps: readonly string[], real: string): void => {
  if (!el) return;
  if (junkIn(deps)) { sfFig(el, deps, SF_DASH); el.setAttribute(NO_FIG, ""); return; }
  sfFig(el, deps, real);
};
/* One rail, one voice, shared by the step-1 and step-2 rails so the two can
   never drift into two sentences for one fact. Per-field clauses, because
   the two malformed kinds need two DIFFERENT truths: an unparseable box was
   priced from ₦0, an unreadable one was priced from nothing, and saying "we
   ignored your input" for both would be false about one of them. */
const junkRail = (el: HTMLElement | null, ids: readonly string[]): void => {
  if (!el) return;
  const bad = ids.filter((id) => malformedOf(id));
  if (!bad.length) { el.hidden = true; el.innerHTML = ""; return; }
  const named = bad.slice(0, 3);
  const more = bad.length - named.length;
  const clauses = named.map((id) => {
    const nm = `"${esc(fieldName(id))}"`;
    const kind = malformedOf(id);
    if (kind === "separator")
      return `${nm} reads "${esc(g(id).value)}" — the comma in there is not a thousands separator (one sits between three-digit groups), so it was dropped and the box was read as ${readAs(id)}.`;
    return kind === "unparseable"
      ? `${nm} reads "${esc(g(id).value)}", which is not a figure we can use — so the plan was priced as if it read ${unitOf(id)}, not as what you typed.`
      : `${nm} reads "${esc(g(id).value)}", and we could not get a figure out of it at all — so every number that depends on it is held back as "—" instead of guessed.`;
  });
  el.hidden = false;
  el.innerHTML = clauses.join(" ")
    + (more ? ` ${more} more field${more > 1 ? "s" : ""} ${more > 1 ? "are" : "is"} in the same state.` : "")
    + ` Retype ${bad.length > 1 ? "them" : "it"} as a plain number.`
    + goTo(bad[0]);
};
/* SPLITS OUT OF RANGE. A share is a slice of ONE income, so it runs 0 to 100
   — the range is the whole fact and no benchmark is invented to support it.
   The engine prices the value as typed and clamps only the NEGATIVE to 0, so
   150 really does move 150% of income into needs and −10 really is priced as
   0%; the rail says which happened rather than letting the figure speak for
   itself. The generic negative line in #bg-warn still fires as well, because
   "we priced −10 as ₦0" and "−10 is outside 0–100" are two different
   statements and a visitor needs both. */
const rangeRail = (el: HTMLElement | null, ids: readonly string[]): void => {
  if (!el) return;
  const bad = ids.filter((id) => { const v = pm(g(id).value); return v < 0 || v > 100; });
  if (!bad.length) { el.hidden = true; el.innerHTML = ""; return; }
  el.hidden = false;
  el.innerHTML = `${nameList(bad)} reads ${bad.map((id) => `${pm(g(id).value)}%`).slice(0, 3).join(", ")}.`
    + ` A share is a slice of one income, so it runs 0 to 100 — a share above 100 is priced exactly as you typed it, and a share below 0 is priced as 0%.`
    + goTo(bad[0]);
};
/* MAGNITUDE. The page already had ONE too-large convention — the same ₦100M
   threshold and the same "That looks unusually large — double-check the
   figure" voice the salary-tax page uses — but it covered the income box only
   and never said WHICH box. The threshold and the voice now cover the income
   and the three step-1 actual spends, each named and routed, so a stray
   keystroke cannot become the confident "₦95,000,000,000 over" the step-2
   reconcile rail already refuses to print. No average salary is claimed
   anywhere in it: the honest signal is the size of the number itself. */
const HUGE_MONEY = 100000000;
const bigRail = (el: HTMLElement | null, ids: readonly string[]): void => {
  if (!el) return;
  const bad = ids.filter((id) => pm(g(id).value) > HUGE_MONEY);
  if (!bad.length) { el.hidden = true; el.innerHTML = ""; return; }
  const named = bad.slice(0, 3);
  const more = bad.length - named.length;
  el.hidden = false;
  el.innerHTML = `${named.map((id) => `"${esc(fieldName(id))}" reads ${esc(nn(pm(g(id).value)))}`).join(", ")}.`
    + ` That looks unusually large — double-check the figure before reading anything into the plan.`
    + (more ? ` ${more} more figure${more > 1 ? "s" : ""} ${more > 1 ? "are" : "is"} past the same line.` : "")
    + goTo(bad[0]);
};
/* E10 — a bucket the visitor has NOT entered is UNKNOWN, and unknown never
   prices as ₦0. pmBlank (no digit / not the honest-money alphabet) is the same
   predicate the copy handler and the ZERO LAW already use, so "abc" and "" read
   alike and neither becomes a scored bucket. Returns null, never a number. */
const actualOf = (bucket: string): number | null => {
  const el = document.getElementById(ACT_ID[bucket]) as HTMLInputElement | null;
  /* E13 — junk is UNKNOWN, never ₦0. pmBlank already returns null for "abc",
     but "1.2.3" has digits inside the honest-money alphabet, so it slipped
     through and was scored as a real ₦0 — printing "you entered ₦0 UNDER
     ₦50,000", a fabricated verdict about a bucket nobody scored. A malformed
     bucket now reads exactly like a blank one: no figure, no badge, and the
     new #al-junk rail names the box instead. */
  /* E14 — a NEGATIVE actual is unknown for the same reason. -1 used to be
     clamped to ₦0 here and the mirror then asserted "you entered ₦0 UNDER
     ₦67,500" while the field visibly held -1: a figure nobody entered, scored
     with total confidence. A spend cannot be negative, so nothing is scored
     and the rail above names the box. */
  if (!el || pmBlank(el.value) || malformedOf(ACT_ID[bucket])) return null;
  if (pm(el.value) < 0) return null;
  return Math.max(0, pm(el.value) || 0);
};
/* E10 — the ONE ownership predicate, reusing the page's existing sd()/badge
   truth (never a new truth source): an id still wearing SAMPLE is ours, a
   blanked id is nobody's, anything else is the visitor's. Used by seedwarn,
   the mirror, the verdict banner and the new sum line alike. */
const isOurs = (id: string) => hasBadge(id, "data-sd");
function render() {
  /* F8 — every clamped negative says so: -x is priced as ₦0 in all seven
     inputs, so the rail names the rewrite instead of staying silent. */
  const bgNeg = ["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].some((id) => pm(g(id).value) < 0);
  /* Recovery soft spot 1 (A4): 999999999 income printed ₦500,000,000 plan
     figures with no line saying the number is absurd — figures were the only
     signal. The honest line reuses the fleet's own too-large vocabulary
     verbatim (salary-tax "That gross looks unusually large — double-check
     the figure", same ₦100M threshold), so no new clause family is invented. */
  const bgHuge = pm(g("bg-inc").value) > 100000000;
  t("bg-warn").hidden = !(bgNeg || bgHuge);
  t("bg-warn").textContent = (bgNeg ? "Negative entries are treated as ₦0." : "")
    + ((bgNeg && bgHuge) ? " " : "")
    + (bgHuge ? "That income looks unusually large — double-check the figure." : "");
  /* ── E13 — the three input-health rails, in the order the orders that asked
     for them came in. The malformed line is the confirmed CRITICAL: without
     it a verdict was computed from "12.5.5". Computed once here and then read
     by the rail, the verdict banner and the step-1 CTAs below, so none of the
     three can disagree about which field is at fault. */
  const junkStep1 = STEP1_IDS.filter((id) => malformedOf(id));
  junkRail(t("bg-junk"), STEP1_IDS);
  rangeRail(t("bg-range"), SPLIT_IDS);
  bigRail(t("bg-big"), MONEY_IDS);
  /* ONE junk in the four plan ids and there is no plan to itemise. Step 2's
     buckets, the live line, the mini line and the mirror panel are all this
     same figure, so they read the same predicate rather than each deciding for
     itself what counts as readable. */
  const planJunked = junkIn(PLAN_IDS);
  const inc = Math.max(0, pm(g("bg-inc").value) || 0);
  const np = Math.max(0, pm(g("bg-needs").value) || 0) / 100;
  const wp = Math.max(0, pm(g("bg-wants").value) || 0) / 100;
  const svp = Math.max(0, pm(g("bg-save").value) || 0) / 100;
  const plan = budget503020(inc, np, wp, svp);
  /* THE ZERO LAW: every figure declares the ids it is derived from. A split the
     visitor never entered cannot print a gold ₦0 bucket. A split the reader
     mis-read ("250," priced as 250) cannot print a plan at all — that is what
     sfFigJ adds on top of the blank test. */
  sfFigJ(t("bg-fig"), PLAN_IDS, `${nn(plan.needs)} · ${nn(plan.wants)} · ${nn(plan.savings)}`);
  sfFigJ(t("bg-else"), PLAN_IDS, nn(plan.else));
  /* B4-FIX2 — a split the visitor never entered cannot print a gold bucket:
     garbage ("abc" in a split) reads as un-entered, exactly like a cleared
     field, so the demand line below matches the blank state. */
  const total = Math.round((np + wp + svp) * 100);
  /* FATIGUE CUT — the old sentence lived here ("Set all three splits — an
     empty split is not a zero"), a second teacher for the one "empty ≠ zero"
     rule. It now speaks in the Nothing-to-compute rail's own voice
     (guardOffer, tool-fields.ts: "Nothing to compute yet — X is empty, not
     zero"), naming the exact missing split(s) in the fields' own words
     (text-nodes-only labels, so SAMPLE/LAST USED badges can never garble it
     — the BREAK-1 lesson). One voice for the rule instead of two; the error
     path below is untouched. */
  const splitLabel = (id: string) => {
    const l = document.querySelector(`label[for="${id}"]`);
    if (!l) return id;
    let s = "";
    l.childNodes.forEach((n) => { if (n.nodeType === 3) s += n.textContent || ""; });
    return s.trim() || id;
  };
  const missingSplits = ["bg-needs", "bg-wants", "bg-save"].filter((id) => pmBlank(g(id).value));
  /* E4 census gate: `empty` is needed above (F-P2) as well as below. It reads
     VALUES only (sfIsEmpty), never badge state, so judging it here instead of
     at the foot of render() changes nothing — first paint included. */
  const empty = sfIsEmpty("50-30-20-budget-calculator", gv);
  /* F-P2 — the empty/partial state fired TWO rail-voice lines at once: this
     sumnote ("Needs % and Wants % … are empty, not zero") AND the offer rail
     ~40px below ("Monthly income ₦ and Needs % …"). The offer now carries the
     ONE union sentence (its `needs` in tool-fields.ts names income + all three
     splits, so guardOffer's single clause already says every missing id), so
     this line stands down whenever the offer rail is active. Same information,
     one line fewer. F-P3 — a shown-but-empty sumnote is a visible nothing
     (cold + every 100%-split state painted a blank <p>), so the element hides
     with its empty text instead of holding whitespace. */
  const offerRail = !empty && PLAN_IDS.some((id) => pmBlank(g(id).value));
  const sumnote = t("bg-sumnote");
  if (offerRail) { sumnote.textContent = ""; sumnote.hidden = true; }
  else if (missingSplits.length) {
    sumnote.hidden = false;
    sumnote.textContent = `Nothing to compute yet — ${missingSplits.map(splitLabel).join(" and ")} ${missingSplits.length > 1 ? "are" : "is"} empty, not zero.`;
  }
  /* E14 — a junk split is priced from the reader's number, so "Splits add to
     300%" would be a percentage nobody typed. The junk rail already owns that
     field's voice; this line stands down rather than second-guessing it. */
  else if (junkIn(SPLIT_IDS)) { sumnote.textContent = ""; sumnote.hidden = true; }
  else if (total === 100) { sumnote.textContent = ""; sumnote.hidden = true; }
  else {
    /* Recovery soft spot 2 (A4): the old line stated the FACT ("Splits add to
       250%") and prescribed nothing — the fix is named in the SAME line, no
       new line, no new clause family. */
    sumnote.hidden = false;
    sumnote.textContent = `Splits add to ${total}% — buckets use your exact percentages, so bring them back to 100%.`;
  }
  const c = budget503020Compare(inc, np, wp, svp,
    Math.max(0, pm(g("bg-spn").value) || 0),
    Math.max(0, pm(g("bg-spw").value) || 0),
    Math.max(0, pm(g("bg-sps").value) || 0));
  /* E13 manager follow-up — the SAME dishonesty, one surface up. When income is
   malformed ("12.5.5"), pm() reads ₦0 but the field still shows "12.5.5", and
   these three receipt rows printed "Needs left › −₦120,000" — a confident
   number about the visitor's month, derived from a figure that does not exist.
   The verdict banner and the what-now line already withhold on this predicate;
   the rows were the last surface that did not. They show the spine's withheld
   "—" instead, which is what the page prints for "we cannot price this". */
  const rowDash = junkStep1.length > 0 ? "—" : null;
  sfFig(t("bg-rn"), ["bg-inc", "bg-needs", "bg-spn"], rowDash ?? nn(c.needs_remaining));
  sfFig(t("bg-rw"), ["bg-inc", "bg-wants", "bg-spw"], rowDash ?? nn(c.wants_remaining));
  sfFig(t("bg-rs"), ["bg-inc", "bg-save", "bg-sps"], rowDash ?? nn(c.savings_remaining));
  /* STEP 2 — the needs half, itemised. Same income, same split: the needs
     figure feeding these buckets IS plan.needs, so step 1 → step 2 is one
     continuous journey — change income or split and both steps move. */
  const shares: Record<string, number> = {};
  const shareIds: string[] = [];
  document.querySelectorAll("[data-al-bucket]").forEach((el) => {
    const inp = el as HTMLInputElement;
    shares[inp.dataset.alBucket as string] = Math.max(0, pm(inp.value) || 0) / 100;
    shareIds.push(inp.id);
  });
  /* E13 — step 2's own malformed rail. The five shares decide what "Other
     needs" IS and the five actuals are scored straight into badges, so one
     junk box here prices a bucket at ₦0 and then prints a confident
     "UNDER ₦48,000" for it — the same lie step 1 was caught telling, five
     fields further down the page. */
  junkRail(t("al-junk"), shareIds.concat(ACT_IDS));
  const r2 = budgetAllocator(inc, np, wp, svp, shares);
  /* E14 — every one of these is plan.needs itemised, so a junk income or split
     leaves the whole itemised step reading from the reader's number instead of
     the one on screen. They read planJunked through sfFigJ, the same predicate
     the receipt above does. */
  sfFigJ(t("al-needs"), ["bg-inc", "bg-needs"], nn(r2.needs));
  /* T3 — the step-2 label names the LIVE split, never a fixed "half": at a
     60/20/20 split "Needs half: ₦150,000" was a live lie. Same live-span
     pattern E2 used for the intro (sfFig withholds as "—" while blank). */
  sfFigJ(t("al-pct"), ["bg-inc", "bg-needs"], `${Math.round(np * 100)}%`);
  /* F-A2-1 — the step-2 intro names live figures, never the seed's. sfFig
     withholds them as "—" while the inputs are blank, exactly like the
     receipt, so no ₦0 is ever printed in prose. */
  sfFigJ(t("bg-step2-needs"), ["bg-inc", "bg-needs"], nn(r2.needs));
  const rentAmt = r2.buckets.find((b) => b.id === "rent")?.amount ?? 0;
  sfFigJ(t("bg-step2-rent"), ["bg-inc", "bg-needs", "al-rent"], nn(rentAmt));
  const shareSum = Object.values(shares).reduce((a, b) => a + b, 0);
  const planned = r2.needs * shareSum;
  /* A junk share is priced from the reader's number too, so "buckets add to
     345% of needs" would be a percentage nobody typed — the same standing rule
     for the overage line as for the sum line above. */
  const shareJunked = junkIn(shareIds);
  /* Every clamped negative says so: -x is priced as ₦0 in income, splits and
     every share, so the rail names the rewrite instead of staying silent.
     #bg-warn already owns the seven step-1 boxes, so this clause names only the
     five shares it alone covers. */
  /* E14 — but a negative SPEND is not a spend that was clamped: it is a spend
     that cannot exist. The old treatment clamped it to ₦0 and the mirror then
     printed "you entered ₦0 UNDER ₦67,500" over a field visibly holding -1 —
     an entry nobody made, in the panel whose whole job is to score what was
     really spent. So the two families get two different truths, each naming its
     own fields in the labels' own words. */
  const negClampIds = shareIds.filter((id) => pm((document.getElementById(id) as HTMLInputElement).value) < 0);
  const negActIds = ACT_IDS.filter((id) => pm(g(id).value) < 0);
  const negClampClause = negClampIds.length
    ? ` ${nameList(negClampIds)} ${negClampIds.length > 1 ? "read" : "reads"} ${negClampIds.map((id) => nn(pm(g(id).value))).slice(0, 3).join(", ")} — ${negClampIds.length > 1 ? "a figure there cannot be negative, so they are" : "a figure there cannot be negative, so it is"} treated as ₦0.`
    : "";
  const negActClause = negActIds.length
    ? ` ${nameList(negActIds)} ${negActIds.length > 1 ? "read" : "reads"} ${negActIds.map((id) => nn(pm(g(id).value))).slice(0, 3).join(", ")} — ${negActIds.length > 1 ? "a spend cannot be negative, so those buckets are" : "a spend cannot be negative, so that bucket is"} left unscored rather than read as ₦0.`
    : "";
  const alNegSfx = negClampClause + negActClause;
  /* A field still wearing SAMPLE has not been touched; one wearing LAST USED
     holds the visitor's own remembered number. Both are the spine's own
     badges, read off the DOM — no new state kept here (hasBadge, module scope). */
  if (r2.needs > 0 && planned > r2.needs && !shareJunked) {
    t("al-warn").hidden = false;
    /* F-A2-7 — a remembered tune must not read as a scold: when the overage
       rides on LAST USED shares, the warn says so instead of greeting the
       returner with a warning new visitors never see. The maths never moves. */
    const memSfx = shareIds.some((id) => hasBadge(id, "data-r")) ? " Includes shares from your last visit — trim any bucket to fit." : "";
    t("al-warn").textContent = `Over by ${nn(planned - r2.needs)} — buckets add to ${(shareSum * 100).toFixed(0)}% of needs. Trim shares to 100% or less.` + memSfx + alNegSfx;
  } else if (negClampIds.length || negActIds.length) {
    t("al-warn").hidden = false;
    t("al-warn").textContent = (negClampClause + negActClause).trim();
  } else {
    t("al-warn").hidden = true;
    t("al-warn").textContent = "";
  }
  const box = t("al-rows");
  box.innerHTML = "";
  for (const b of r2.buckets) {
    const div = document.createElement("div");
    div.className = "receipt-row";
    const lab = document.createElement("span"); lab.textContent = b.label;
    const amt = document.createElement("b");
    amt.setAttribute("data-al-amt", b.id);
    /* The residual "Other needs" row is what is left of needs after every
       named share, so it waits on ALL of them, not on one. */
    sfFigJ(amt, b.id === "other" ? ["bg-inc", "bg-needs"].concat(shareIds) : ["bg-inc", "bg-needs", "al-" + b.id], nn(b.amount));
    div.appendChild(lab); div.appendChild(amt); box.appendChild(div);
  }
  /* E10 — the five needs-share fields decide what "Other needs" IS, so they
     gate every figure derived from them. The receipt above already withholds a
     blanked share's own row through sfFig; sharesSet keeps the mirror and the
     sum line on the SAME rule, so a half-cleared set of shares never prints a
     sum that quietly counts a blank as 0%. */
  const sharesSet = shareIds.length > 0 && shareIds.every((id) => !pmBlank(g(id).value));
  /* F-A2-6 — over-100% must not swallow the residual: the engine (rightly,
     untouched — it lives outside this file) omits "Other needs" at zero, so
     the page re-states it here as the honest negative step 1 already prints.
     Exactly-100% stays omitted: ₦0 of other is nothing to show. */
  if (r2.needs > 0 && planned > r2.needs && !r2.buckets.some((b) => b.id === "other")) {
    const div = document.createElement("div");
    div.className = "receipt-row";
    const lab = document.createElement("span"); lab.textContent = "Other needs";
    const amt = document.createElement("b");
    amt.setAttribute("data-al-amt", "other");
    sfFigJ(amt, ["bg-inc", "bg-needs"].concat(shareIds), nn(r2.needs - planned));
    div.appendChild(lab); div.appendChild(amt); box.appendChild(div);
  }
  sfEmpty(empty);
  /* F2 — the receipt sits below the fold at 390px, so a split change used to
     recompute figures the visitor could not see. This one line lives beside
     the fields and mirrors the plan, so every edit is visibly answered. */
  const splitsSet = PLAN_IDS.every((id) => !pmBlank(g(id).value));
  const live = t("bg-live");
  /* A hidden line carries no text: the rails contract reads note prose
    verbatim, so a stale "Plan now: ₦…" must not sit in the DOM behind hidden. */
  /* E14 — the same for a junk plan id. "250," priced the whole line at ₦125
     somewhere a visitor could see it and the page never said a word; the what-
     now, the verdict and the three receipt rows already stood down on this
     predicate, and this was the last one that did not. */
  if (empty || !splitsSet || planJunked) { live.hidden = true; live.textContent = ""; }
  else {
    live.hidden = false;
    live.textContent = `Plan now: ${nn(plan.needs)} needs · ${nn(plan.wants)} wants · ${nn(plan.savings)} savings`;
  }
  /* F-A2-3 — the seed-actuals ambush: income or split typed, but the spends
     still wear SAMPLE (ours, never entered). Name them before they paint the
     first triple negative as the visitor's month. */
  const sd = (id: string) => hasBadge(id, "data-sd");
  const seedWarn = t("bg-seedwarn");
  const planTouched = ["bg-inc", "bg-needs", "bg-wants", "bg-save"].some((id) => !sd(id));
  /* Name exactly which spends are still ours: after the visitor types one real
     figure, "the spends below" would smear their number with our example. */
  const seedIds = ["bg-spn", "bg-spw", "bg-sps"].filter(sd);
  if (!empty && planTouched && seedIds.length) {
    seedWarn.hidden = false;
    const nm = seedIds.map((id) => id === "bg-spn" ? "needs" : id === "bg-spw" ? "wants" : "savings").join(" and ");
    seedWarn.textContent = seedIds.length === 3
      ? "Heads up: the spends below are still our example, not yours — type what you really spent."
      : `Heads up: the ${nm} ${seedIds.length > 1 ? "spends are" : "spend is"} still our example — type what you really spent.`;
  } else { seedWarn.hidden = true; seedWarn.textContent = ""; }
  /* F-A2-4 + MF-1 — a negative must say what now: name the overage and the
     one honest action (trim the spend, or move the split). Step 2 plans from
     the plan figure either way, so say that too. */
  const wn = t("bg-whatnow");
  const overNW: Array<{ name: string; over: number }> = [];
  if (c.needs_remaining < 0) overNW.push({ name: "needs", over: -c.needs_remaining });
  if (c.wants_remaining < 0) overNW.push({ name: "wants", over: -c.wants_remaining });
  /* Savings reads opposite: remaining>0 is "still to save" (self-explanatory,
     the seed's own story), remaining<0 is OVER-put — ahead of plan, not short
     of it. Only the confusing sign gets the gloss, never a scold for saving. */
  const savOver = c.savings_remaining < 0 ? -c.savings_remaining : 0;
  /* E13 manager follow-up — the boundary the leg logged instead of hiding.
     With "12.5.5" typed into income, pm() reads ₦0 while the FIELD still shows
     "12.5.5". The verdict banner was gated on that and prints CANNOT SCORE, but
     this line was NOT: it still said "needs and wants ₦185,000 over — spend
     less there", computed from a figure that does not exist and phrased in the
     visitor's voice. That is the same shape as the mirror E10 removed — a
     confident number about your month, derived from nothing.
     So the advice line withholds exactly where the verdict does: no verdict
     means no advice ABOUT the verdict. The rail above already names the field
     and how to fix it; this line would only have repeated it in a voice the
     numbers cannot support. */
  const step1Junked = junkStep1.length > 0;
  if (!empty && !step1Junked && (overNW.length || savOver > 0)) {
    const bits: string[] = [];
    if (overNW.length) {
      const nm = overNW.map((o) => o.name).join(" and ");
      const tot = overNW.reduce((a, o) => a + o.over, 0);
      bits.push(`${nm} ${nn(tot)} over — spend less there or raise the ${nm} split % above`);
    }
    if (savOver > 0) bits.push(`savings ${nn(savOver)} over plan — ahead of it; leave it banked or move the split if needs run tight`);
    wn.hidden = false;
    wn.textContent = bits.join("; ") + ". Step 2 still itemises the plan figure, not the overspend.";
  } else { wn.hidden = true; wn.textContent = ""; }
  /* MF-6 — the both-steps mini plan: FATIGUE CUT keeps only the pair the
     tuner cannot see from step 2 (needs + rent). Wants/savings restated the
     live line two screens up; rent is the actionable one here. Same guard as
     the live line: no figures on an empty page. */
  const mini = t("bg-mini");
  if (empty || !splitsSet || planJunked) { mini.hidden = true; mini.textContent = ""; }
  else {
    mini.hidden = false;
    /* E14: a junk share is priced from the reader's number, so "rent of needs"
       here would come from a share nobody typed. Same predicate the bucket rows
       below use, so the two cannot disagree about one share. */
    const rentTxt = pmBlank(g("al-rent").value) || malformedOf("al-rent") ? "—" : nn(rentAmt);
    mini.textContent = `Mini plan — needs ${nn(plan.needs)} · rent ${rentTxt} of needs`;
  }
  /* Discovery (A4 bottom-3): the copy button's cold honesty must be visible
     PRE-tap, not just in the clipboard payload. The static span beside the
     button says it copies our example; the moment every field is the
     visitor's own (the same all-typed predicate the copy handler uses) the
     span stands down, so it never mislabels a "My plan" copy. Empty pages
     refuse copies, so the span waits there too. */
  const cwhy = document.getElementById("bg-copywhy");
  const copyBtn = document.getElementById("bg-copy");
  if (cwhy && copyBtn) {
    const typedFld = (id: string) => !hasBadge(id, "data-sd") && !pmBlank(g(id).value);
    const allTyped = ["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].every(typedFld);
    const planTyped = ["bg-inc", "bg-needs", "bg-wants", "bg-save"].every(typedFld);
    if (empty) {
      cwhy.hidden = false;
      cwhy.textContent = " — cold, this copies our example.";
      cwhy.setAttribute("data-trust", "example");
      copyBtn.textContent = "Copy example plan";
    } else if (allTyped) {
      cwhy.hidden = true;
      copyBtn.textContent = "Copy my plan";
    } else if (planTyped) {
      cwhy.hidden = false;
      cwhy.textContent = " — copies the example plan (your splits, our spends).";
      cwhy.setAttribute("data-trust", "computed");
      copyBtn.textContent = "Copy plan summary";
    } else {
      cwhy.hidden = false;
      cwhy.textContent = " — cold, this copies our example.";
      cwhy.setAttribute("data-trust", "example");
      copyBtn.textContent = "Copy example plan";
    }
  }
  /* MF-4 — the whole-needs line, kept and given its OWN element. It compares
     the aggregate needs spend against the plan, which is a DIFFERENT question
     from the per-bucket mirror below; it no longer shares an id with anything
     the mirror writes, because E9's collision (this sentence and five
     fabricated rows in ONE node, the second overwrite deleting the first) is
     exactly what this split removes.
     T1 — the same plan-touched gate as seedwarn, in seedwarn's own words:
     until the visitor touches a plan input AND the spend itself, the figures
     are our example, so the line reads as example, never "You spent".
     F-P1 — cold painted the plan THREE times (live + mini + mirror) before a
     keystroke. While step-1 is untouched the seed keeps this line waiting; a
     spend typed alone still raises the Example voice (the history-trap path),
     so the gate is "nobody touched anything", not "plan untouched".
     F-P5 — a ₦0 plan is a plan that doesn't exist: the line withholds exactly
     where copy refuses (the same plan-complete guard as the copy handler
     below), so a kept spend + cleared plan never scolds "₦95,000 over" against
     a plan nobody entered. */
  const am = t("al-needsline");
  /* F-P1/F-P5 gates, verbatim as before — the plan is what both halves read. */
  const planComplete = PLAN_IDS.every((id) => !pmBlank(g(id).value));
  const step1Touched = planTouched || !sd("bg-spn");
  /* E14 — "12.5.5" in "Spent on needs" read as ₦0 and the line printed "You
     spent ₦0 vs ₦150,000 plan on needs — within plan" while the verdict above
     said CANNOT SCORE for the very same field. One screen, two owners. */
  const spendJunked = junkIn(["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn"]);
  if (!empty && planComplete && !pmBlank(g("bg-spn").value) && !spendJunked && step1Touched) {
    const spent = Math.max(0, pm(g("bg-spn").value) || 0);
    const mineSpent = planTouched && !sd("bg-spn");
    am.hidden = false;
    if (spent > plan.needs) {
      am.textContent = mineSpent
        ? `You spent ${nn(spent)} vs ${nn(plan.needs)} plan on needs — ${nn(spent - plan.needs)} over. Tune the buckets below against the plan, then trim the spend above.`
        : `Example: ${nn(spent)} vs ${nn(plan.needs)} plan on needs — ${nn(spent - plan.needs)} over. Our example, not yours — type what you really spent to score your month.`;
    } else {
      am.textContent = mineSpent
        ? `You spent ${nn(spent)} vs ${nn(plan.needs)} plan on needs — within plan. The buckets below share out the plan figure.`
        : `Example: ${nn(spent)} vs ${nn(plan.needs)} plan on needs — within plan. Our example, not yours — the buckets below share out the plan figure.`;
    }
  } else { am.hidden = true; am.textContent = ""; }
  /* MF-5 + F9 — the memory date, visible: the spine dates LAST USED only in a
     hover title (no touch path), so the page reads the spine's own key and
     prints the day. A copied plan goes stale on the next keystroke, so the
     confirmation hides here too. */
  t("bg-copied").hidden = true;
  const md = t("bg-memdate");
  let memTxt = "";
  try {
    const raw = localStorage.getItem("gwill-sf-50-30-20");
    if (raw) {
      const s = JSON.parse(raw);
      if (s && s.t) {
        const days = Math.floor((Date.now() - s.t) / 864e5);
        const rel = days <= 0 ? "today" : days === 1 ? "yesterday" : days + " days ago";
        const dst = new Date(s.t).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
        memTxt = `Last saved ${rel} (${dst}) — only LAST USED pills are yours.`;
      }
    }
  } catch {}
  if (memTxt && !empty) { md.hidden = false; md.textContent = memTxt; }
  else { md.hidden = true; md.textContent = ""; }

  /* Visual stepper: update active state based on user interaction with step 2 */
  const step1 = document.querySelector('.fx-step[data-step="1"]');
  const step2 = document.querySelector('.fx-step[data-step="2"]');
  if (step1 && step2) {
    /* Step 2 is "active" only when user has typed in any bucket (lost SAMPLE badge) */
    const step2Touched = ["al-rent", "al-food", "al-transport", "al-data", "al-utilities"].some((id) => {
      const field = document.getElementById(id)?.closest(".field");
      return field && !field.hasAttribute("data-sd");
    });
    if (step2Touched) {
      step1.classList.remove('active');
      step1.removeAttribute('aria-current');
      step2.classList.add('active');
      step2.setAttribute('aria-current', 'step');
      step2.removeAttribute('aria-disabled');
    } else {
      step1.classList.add('active');
      step1.setAttribute('aria-current', 'step');
      step2.classList.remove('active');
      step2.removeAttribute('aria-current');
      step2.setAttribute('aria-disabled', 'true');
    }
  }

  /* Split preset chips: highlight active preset matching current splits */
  const currentNeeds = Math.round(Math.max(0, pm(g("bg-needs").value) || 0));
  const currentWants = Math.round(Math.max(0, pm(g("bg-wants").value) || 0));
  const currentSave = Math.round(Math.max(0, pm(g("bg-save").value) || 0));
  const currentPreset = `${currentNeeds},${currentWants},${currentSave}`;
  document.querySelectorAll('[data-preset]').forEach(btn => {
    if (btn.dataset.preset === currentPreset) {
      btn.classList.add('active');
    } else {
      btn.classList.remove('active');
    }
  });

  /* Fill-from-plan buttons: disable when plan incomplete (reuse smart-fields offer rail pattern) */
  document.querySelectorAll('[data-fill-from-plan]').forEach(btn => {
    if (!planComplete) {
      btn.setAttribute('aria-disabled', 'true');
      btn.style.opacity = '0.45';
      btn.style.pointerEvents = 'none';
    } else {
      btn.removeAttribute('aria-disabled');
      btn.style.opacity = '';
      btn.style.pointerEvents = '';
    }
  });

  /* === E10 (A10-C1/C3) — the actuals mirror, rebuilt to measure something REAL.
     E9 shipped a panel with no per-bucket actual input anywhere on the page. It
     MANUFACTURED one by rescaling the single aggregate spend:

         actualAmt = planAmt / plan.needs × spent
         variance  = planAmt × (spent/needs − 1)

     Because planAmt/needs is a CONSTANT share, sign(variance) was the same for
     every bucket — one finding printed five times. The five badges could never
     disagree and could never say "rent over, food under", the only case that
     teaches anything. That rescaling is GONE; nothing on this page invents an
     actual any more.

     The panel now scores what the visitor actually types, per bucket, into the
     five optional al-act-* fields above: variance = actual − plan, each one
     reading its own field, so the badges are structurally independent.
       · a bucket with a BLANK actual shows no amount and no badge — it says so
         in words instead. Unknown is never priced as ₦0.
       · if NO bucket has an actual, the whole variance panel withholds. There is
         no fallback to the fabricated rescaling; there is no fallback at all.
       · ownership travels WITH the numbers: the Example badge sits inside the
         panel, next to the figures it describes, not only in a sibling note.
     The heading, the badge and the disclosure each live in their OWN element,
     and #al-mirror-own is written by exactly one line below — so no later write
     can destroy the disclosure the way E9's innerHTML overwrite did. */
  const scored = AL_BUCKETS.map((b) => ({ b, plan: r2.buckets.find((x) => x.id === b)?.amount ?? 0, actual: actualOf(b) }));
  const anyScored = scored.some((s) => s.actual !== null);
  /* Ownership of the FIGURE ON SHOW: the plan half is derived from income, the
     splits and the five shares. While any of those still wears SAMPLE the
     numbers are our worked example — the same sd() gate seedwarn and the copy
     button already read, not a new truth source. */
  const planOurs = ["bg-inc", "bg-needs", "bg-wants", "bg-save"].some(isOurs)
    || shareIds.some(isOurs) || !sharesSet;
  const headEl = t("al-mirror-h");
  const badgeEl = t("al-mirror-badge");
  const ownEl = t("al-mirror-own");
  const rowsEl = t("al-actuals");
  /* E14 — with a junk plan id there is no plan column to score against, so the
     whole panel withholds instead of pricing "Rent / housing ₦56" off a figure
     the visitor never typed. Same predicate, same empty-state treatment. */
  if (empty || !planComplete || planJunked) {
    headEl.hidden = true; badgeEl.hidden = true; ownEl.hidden = true;
    rowsEl.hidden = true; rowsEl.innerHTML = "";
    t("al-reconcile").hidden = true; t("al-reconcile").textContent = "";
    t("al-reconcile-fix").hidden = true;
    t("al-onplan").hidden = true; t("al-onplan").textContent = "";
  } else {
    headEl.hidden = false;
    /* The Example badge rides the panel itself whenever the plan figures on
       show are ours — ownership travels with the numbers, never a section away. */
    badgeEl.hidden = !planOurs;
    ownEl.hidden = false;
    if (!anyScored) {
      /* No actual anywhere: the panel withholds rather than inventing one, and
         says in words WHY it is empty and how to fill it. */
      ownEl.textContent = "Our example, not yours — the naira beside each bucket is your plan, not your spending. Type what you actually spent in any bucket above; a bucket you leave blank keeps its plan amount but prints no \"you spent\" figure and no badge, because we have nothing real to score it against.";
      rowsEl.innerHTML = "";
      rowsEl.hidden = true;
      t("al-reconcile").hidden = true; t("al-reconcile").textContent = "";
      t("al-reconcile-fix").hidden = true;
      t("al-onplan").hidden = true; t("al-onplan").textContent = "";
    } else {
      const n = scored.filter((s) => s.actual !== null).length;
      ownEl.textContent = `Variance = what you entered, minus that bucket's plan. ${n} of 5 buckets scored from what you typed; the other ${5 - n} still show their plan only — no "you spent" figure and no badge, because we have nothing real to score them against.${planOurs ? " The plan figures are still our worked example — touch income, a split or a share to make them yours." : ""}`;
      let html = "";
      /* E14: the plan column of a bucket is that bucket's share of needs, so a
         junk share means this column is the reader's number, not the one typed.
         It withholds exactly like the #al-rows figure above it, per bucket, so
         a "250," in rent dashes rent and leaves food priced honestly. */
      const planTxt = (b: string): string => (planJunked || malformedOf("al-" + b) ? "—" : nn(scored.find((x) => x.b === b)?.plan ?? 0));
      for (const s of scored) {
        const bucket = r2.buckets.find((x) => x.id === s.b);
        if (!bucket) continue;
        if (s.actual === null) {
          /* Honest unknown state: the plan figure is fine to show (it IS the
             plan), but there is no actual, so there is nothing to compare and no
             badge. No fabricated amount is printed anywhere in this row. */
          html += `<div class="actuals-row" tabindex="0" data-goto="${ACT_ID[s.b]}"><span>${bucket.label}</span><b>${planTxt(s.b)}</b><span class="actuals-none">— add yours to score it</span></div>`;
          continue;
        }
        /* E14: with the plan figure unreadable there is nothing to compare this
           actual against, so the badge withholds with it rather than printing
           "OVER ₦99,944" computed from a share nobody typed. What the visitor
           entered still prints — that part is true. */
        const planBad = planJunked || malformedOf("al-" + s.b);
        if (planBad) {
          html += `<div class="actuals-row" tabindex="0" data-goto="${ACT_ID[s.b]}"><span>${bucket.label}</span><b>—</b><span class="actuals-diff">you entered ${nn(s.actual)}</span></div>`;
          continue;
        }
        const variance = s.actual - s.plan;
        let badgeClass = "verdict-badge--info";
        let badgeText = "ON PLAN";
        if (variance > 0) { badgeClass = "verdict-badge--action"; badgeText = `OVER ${nn(variance)}`; }
        else if (variance < 0) { badgeClass = "verdict-badge--good"; badgeText = `UNDER ${nn(-variance)}`; }
        html += `<div class="actuals-row" tabindex="0" data-goto="${ACT_ID[s.b]}"><span>${bucket.label}</span><b>${planTxt(s.b)}</b><span class="actuals-diff">you entered ${nn(s.actual)}</span><span class="verdict-badge ${badgeClass}">${badgeText}</span></div>`;
      }
      rowsEl.innerHTML = html;
      rowsEl.hidden = false;
      /* E12-7 — "ON PLAN" badges used to be the end of the interaction. When
         every scored bucket matches its plan exactly, say what it means and
         where to go next. */
      const onPlanEl = t("al-onplan");
      const scoredRows = scored.filter((s) => s.actual !== null);
      if (scoredRows.length > 0 && scoredRows.every((s) => s.actual === s.plan)) {
        onPlanEl.hidden = false;
        onPlanEl.textContent = `ON PLAN on all ${scoredRows.length} scored bucket${scoredRows.length > 1 ? "s" : ""} — if your month really matches the plan, the plan is holding; put the savings slice to work in Savings Goal Calculator.`;
      } else {
        onPlanEl.hidden = true;
        onPlanEl.textContent = "";
      }
      /* E11-8 — the aggregate never met the buckets. A11 proved a ₦150,000
         "Spent on needs" sitting beside ₦80,000 of scored buckets with the
         contradiction never mentioned — two numbers about the same money, on the
         same screen, silently disagreeing. Say it. When the visitor has scored at
         least one bucket AND their aggregate needs spend is entered, the buckets
         must sum to that aggregate or one of the two is wrong; we do not know
