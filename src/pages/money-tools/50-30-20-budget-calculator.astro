---
import ToolShell from "../../components/ToolShell.astro";
import { budget503020, budget503020Compare, BUDGET_SEED_INCOME } from "../../lib/budget";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
const income = BUDGET_SEED_INCOME;
const seed = budget503020(income);
/* The seed month must be INTERNALLY CONSISTENT, because this is the first
   thing every visitor sees. It was not: income 250,000 at 50/30/20 puts needs
   at 125,000, while "Spent on needs" shipped 140,000 — so the flagship tool
   opened on ₦-15,000 of needs remaining, i.e. on a negative number, on a page
   whose entire argument is that its figures are honest. Wants had the same
   fault (-15,000). Income and the 50/30/20 split are untouched (BUDGET_SEED_INCOME
   is asserted by the vectors gate and named in the page's own sourced context
   line), so only the three ACTUAL-spend seeds move, and they now describe one
   real month: 120,000 spent on needs (5,000 under plan), 65,000 on wants
   (10,000 under), 40,000 put to savings (10,000 SHORT of the 20% the plan asks
   for). 225,000 spent of 250,000 earned. Every "left" figure is non-negative,
   and the one gap the example still shows — savings 10,000 light — is the
   honest, instructive one for a budget tool to show. */
const seedActuals = { needs: 120000, wants: 65000, savings: 40000 };
const chk = budget503020Compare(income, 0.5, 0.3, 0.2, seedActuals.needs, seedActuals.wants, seedActuals.savings);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="50/30/20 Budget Calculator, Nigeria - GWill Finance" description="Split any income into needs, wants, savings — then check real spending against the plan and see what is left." slug="50-30-20-budget-calculator" tool="50/30/20 Budget Calculator" lede="Half for needs, a third for wants, a fifth for future-you. Set the income, check your actual spending, keep the remainder." verified="Plan vs actual checker · splits adjustable" faqs={[
  { q: "Is 50/30/20 realistic on a Nigerian salary?", a: "As a direction, yes; as law, adjust. High rent cities may need 60/20/20 for a season — the tool accepts custom splits." },
  { q: "What counts as savings?", a: "Anything future-you keeps: emergency fund, investments, debt repayment. Not the money sitting in your spending account." },
]}

  badge="The 50/30/20 rule · Simple budgeting",
  copy={[["p", "The 50/30/20 rule is the most popular budgeting method for a reason: it is simple enough to remember and flexible enough to stick to. You divide your take-home pay into three buckets, 50% to needs, 30% to wants, 20% to savings and debt repayment. No complicated categories, no spreadsheet required. It is a starting point you can adjust as your life changes."],["p", "Needs are the things you cannot function without: rent or mortgage, food, transport to work, utility bills, and the minimum payments on your debt. Wants are everything else, the takeaways, the subscriptions you barely use, the upgrade you do not need. The rule&#039;s real value is forcing you to draw that line honestly. Most budgets that fail do so because wants quietly sneak into the needs column."],["p", "In Nigeria, high inflation and rising costs make strict needs-heavy budgets common, housing and food can easily consume well over 50%. That is fine. Treat 50/30/20 as a target to move toward, not a rule to feel guilty about. Start by tracking what your needs actually cost, then push the savings slice up over time. Even starting at 10% savings and inching toward 20% beats saving nothing at all. Use your take-home (net) pay, the money that actually lands in your account, not your gross."],["p", "The 20% savings-and-debt bucket is the seed that grows your future. Once you are saving, put it to work, see it compound with our compound interest calculator, or set a specific target with our savings goal calculator. And remember inflation erodes any goal, our inflation-adjusted calculator shows what you truly need to save."],["p", "Strict 50/30/20 assumes your big needs cost about half your take-home. In high-cost Nigerian cities, rent and food alone can push well past that, which is not a failure of the rule, just a reality to plan around. The important part is to keep the savings slice conscious and growing, even if the mix leans heavier on needs. Adjust the three sliders above to whatever split your numbers actually support, rather than forcing a 50/30/20 square peg."],["p", "50/30/20 gives you the three big numbers. To turn them into a budget you can actually spend against, break the needs bucket into real Nigerian categories, rent, food, transport, data, utilities. Our budget allocator takes this same 50/30/20 split and digs into the needs half, showing exactly how much of each takes you to rent, food, transport and more, with every category editable so the plan always adds up."],["p", "Start from your take-home pay, never your gross. Whatever your income, the goal is the same: give every naira a job, so nothing leaks away unnoticed."],["p", "The rule fails when people treat it as a rigid law instead of a compass. One classic mistake is budgeting on gross pay, which inflates every bucket and leaves you chasing money that never landed. Another is stuffing the wants bucket with expenses that are really needs in disguise, the \"basic\" phone plan you upgraded twice, the meal delivery that quietly became dinner. And the third is ignoring the leftover entirely: if your three percentages do not sum to 100, the leftover has no job, so it disappears into the void of everyday spending."],["p", "The fix for all three is honest categorising. Budget on what hits your account. When something feels like a want, ask whether you would genuinely afford to drop it this month, if it is a bill you must pay, it belongs in needs. And make sure your split adds up. The calculator below flags any unallocated remainder so you can add it to savings rather than let it vanish."],["p", "Freelancers, commission earners and seasonal workers face a question the 50/30/20 rule glosses over: what is your \"take-home\" when every month is different? The workable answer is to base the budget on your average of the last three months, not your best month. Budget on the average, and when a good month arrives, sweep the surplus past the 20% savings slice rather than inflating your wants."],["p", "Because the rule is percentage-based, it scales with whatever number you enter, that is precisely why this tool takes a single income figure and lets you adjust the three splits. Set the income to your moving average and the buckets adjust automatically, so a lean month is no longer a mystery and a strong month becomes a chance to save more."],["h2", "Budgeting questions"],["h3", "What is the 50/30/20 rule?"],["p", "A simple budget that puts 50% of your take-home pay toward needs, 30% toward wants, and 20% toward savings and paying down debt."],["h3", "How much should I allocate from a ₦250,000 salary?"],["p", "About ₦125,000 for needs, ₦75,000 for wants, and ₦50,000 for savings/debt each month."],["h3", "Should I use gross or net income?"],["p", "Use your take-home (net) pay, the amount that actually reaches your account after tax, because that is what you can genuinely spend and save."],["h3", "What counts as a need versus a want?"],["p", "Needs are what you cannot do without: housing, food, transport, utilities, minimum debt payments. Wants are the rest, dining out, entertainment, upgrading your phone. If in doubt, it is a want."]]},
  disclaimer="This calculator is for informational guidance only and is not financial advice. The 50/30/20 rule is a budgeting framework, not a guarantee of outcomes, adjust it to your circumstances and confirm major decisions with a licensed adviser.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<div class="tgrid c3">
<div class="field"><label for="bg-inc">Monthly income ₦</label><input id="bg-inc" type="text" value={income} inputmode="decimal"></div>
<div class="field"><label for="bg-needs">Needs %</label><input id="bg-needs" type="text" max="100" value="50" inputmode="decimal" placeholder="50"></div>
<div class="field"><label for="bg-wants">Wants %</label><input id="bg-wants" type="text" max="100" value="30" inputmode="decimal" placeholder="30"></div>
<div class="field"><label for="bg-save">Savings %</label><input id="bg-save" type="text" max="100" value="20" inputmode="decimal" placeholder="20"></div>
<div class="field"><label for="bg-spn">Spent on needs ₦</label><input id="bg-spn" type="text" value={String(seedActuals.needs)} inputmode="decimal"></div>
<div class="field"><label for="bg-spw">Spent on wants ₦</label><input id="bg-spw" type="text" value={String(seedActuals.wants)} inputmode="decimal"></div>
<div class="field"><label for="bg-sps">Put to savings ₦</label><input id="bg-sps" type="text" value={String(seedActuals.savings)} inputmode="decimal"></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Your three buckets</p>
<p class="receipt-fig" id="bg-fig">₦{n(seed.needs)} · ₦{n(seed.wants)} · ₦{n(seed.savings)}</p>
<p class="receipt-sub" id="bg-sub">Needs · wants · savings — leftover <span id="bg-else">₦{n(seed.else)}</span></p>
<p class="receipt-sub" id="bg-sumnote"></p>
<p class="receipt-note" id="bg-warn" hidden></p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row"><span>Needs left</span><b id="bg-rn">₦{n(chk.needs_remaining)}</b></div>
<div class="receipt-row"><span>Wants left</span><b id="bg-rw">₦{n(chk.wants_remaining)}</b></div>
<div class="receipt-row"><span>Savings gap</span><b id="bg-rs">₦{n(chk.savings_remaining)}</b></div>
<p class="receipt-foot">Plan vs actual · unassigned stays visible</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
</div>
</ToolShell>
<script>
import { budget503020, budget503020Compare } from "../../lib/budget";
import { formatGrouped } from "../../lib/format";
import { pm, pmBlank } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig } from "../../data/tool-fields";
/* F1 — fleet-wide negative shape (the crypto tool's winner): a negative prints
   −₦X (U+2212 minus before the symbol), never ₦-X. format.ts stays
   PHP-parity-pinned (it mirrors gwill_paye_number), so this is fixed per page
   on the two pages whose figures can actually go negative. */
const nn = (v: number) => (v < 0 ? "−" : "") + "₦" + formatGrouped(Math.abs(v), 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
function render() {
  /* F8 — every clamped negative says so: -x is priced as ₦0 in all seven
     inputs, so the rail names the rewrite instead of staying silent. */
  const bgNeg = ["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].some((id) => pm(g(id).value) < 0);
  t("bg-warn").hidden = !bgNeg;
  t("bg-warn").textContent = bgNeg ? "Negative entries are treated as ₦0." : "";
  const inc = Math.max(0, pm(g("bg-inc").value) || 0);
  const np = Math.max(0, pm(g("bg-needs").value) || 0) / 100;
  const wp = Math.max(0, pm(g("bg-wants").value) || 0) / 100;
  const svp = Math.max(0, pm(g("bg-save").value) || 0) / 100;
  const plan = budget503020(inc, np, wp, svp);
  /* THE ZERO LAW: every figure declares the ids it is derived from. A split the
     visitor never entered cannot print a gold ₦0 bucket. */
  sfFig(t("bg-fig"), ["bg-inc", "bg-needs", "bg-wants", "bg-save"], `${nn(plan.needs)} · ${nn(plan.wants)} · ${nn(plan.savings)}`);
  sfFig(t("bg-else"), ["bg-inc", "bg-needs", "bg-wants", "bg-save"], nn(plan.else));
  /* B4-FIX2 — a split the visitor never entered cannot print a gold bucket:
     garbage ("abc" in a split) reads as un-entered, exactly like a cleared
     field, so the demand line below matches the blank state. */
  const anyEmpty = ["bg-needs", "bg-wants", "bg-save"].some((id) => pmBlank(g(id).value));
  const total = Math.round((np + wp + svp) * 100);
  t("bg-sumnote").textContent = anyEmpty
    ? "Set all three splits — an empty split is not a zero"
    : (total === 100 ? "" : `Splits add to ${total}% — buckets use your exact percentages`);
  const c = budget503020Compare(inc, np, wp, svp,
    Math.max(0, pm(g("bg-spn").value) || 0),
    Math.max(0, pm(g("bg-spw").value) || 0),
    Math.max(0, pm(g("bg-sps").value) || 0));
  sfFig(t("bg-rn"), ["bg-inc", "bg-needs", "bg-spn"], nn(c.needs_remaining));
  sfFig(t("bg-rw"), ["bg-inc", "bg-wants", "bg-spw"], nn(c.wants_remaining));
  sfFig(t("bg-rs"), ["bg-inc", "bg-save", "bg-sps"], nn(c.savings_remaining));
  sfEmpty(sfIsEmpty("50-30-20-budget-calculator", gv));
}
["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].forEach((id) => g(id).addEventListener("input", render));
smartFields.register(TOOL_FIELDS["50-30-20-budget-calculator"]);
sfBind("50-30-20-budget-calculator", gv);
render();
</script>
