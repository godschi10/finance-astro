---
import ToolShell from "../../components/ToolShell.astro";
import { budget503020, budget503020Compare, BUDGET_SEED_INCOME } from "../../lib/budget";
import { budgetAllocator } from "../../lib/allocator";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
const income = BUDGET_SEED_INCOME;
const seed = budget503020(income);
/* The seed month must be INTERNALLY CONSISTENT, because this is the first
   thing every visitor sees. It was not: income 250,000 at 50/30/20 puts needs
   at 125,000, while "Spent on needs" shipped 140,000 — so the flagship tool
   opened on ₦-15,000 of needs remaining, i.e. on a negative number, on a page
   whose entire argument is that its figures are honest. Wants had the same
   fault (-15,000). Income and the 50/30/20 split are untouched (BUDGET_SEED_INCOME
   is asserted by the vectors gate and named in the page's own sourced context
   line), so only the three ACTUAL-spend seeds move, and they now describe one
   real month: 120,000 spent on needs (5,000 under plan), 65,000 on wants
   (10,000 under), 40,000 put to savings (10,000 SHORT of the 20% the plan asks
   for). 225,000 spent of 250,000 earned. Every "left" figure is non-negative,
   and the one gap the example still shows — savings 10,000 light — is the
   honest, instructive one for a budget tool to show. */
const seedActuals = { needs: 120000, wants: 65000, savings: 40000 };
const chk = budget503020Compare(income, 0.5, 0.3, 0.2, seedActuals.needs, seedActuals.wants, seedActuals.savings);
/* Step 2 seed: the needs half of the SAME income, itemised with the allocator
   engine's own defaults (rent 40 / food 25 / transport 15 / data 10 / bills 7).
   One income in, both steps out — the page opens on one continuous journey. */
const al = budgetAllocator(income);
const seedRent = al.buckets.find((b) => b.id === "rent")?.amount ?? 0;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="50/30/20 Budget Calculator, Nigeria - GWill Finance" description="Split any income into needs, wants and savings, check real spending against the plan — then break the needs half into rent, food, transport, data and bills, all on one page." slug="50-30-20-budget-calculator" tool="50/30/20 Budget Calculator" lede="Half for needs, 30% for wants, a fifth for future-you. Set the income, check your actual spending, then itemise the needs half — two steps, one page." verified="Two steps, one page · plan vs actual checker · needs-half buckets" faqs={[
  { q: "Is 50/30/20 realistic on a Nigerian salary?", a: "As a direction, yes; as law, adjust. High rent cities may need 60/20/20 for a season — the tool accepts custom splits." },
  { q: "What counts as savings?", a: "Anything future-you keeps: emergency fund, investments, debt repayment. Not the money sitting in your spending account." },
  { q: "Where exactly does the needs half go?", a: "Step 2 on this same page breaks your plan's needs figure into rent, food, transport, data and bills, with every share tunable. One tool, one journey — no second page." },
]}

  badge="The 50/30/20 rule · Simple budgeting",
  copy={[["p", "The 50/30/20 rule is the most popular budgeting method for a reason: it is simple enough to remember and flexible enough to stick to. You divide your take-home pay into three buckets, 50% to needs, 30% to wants, 20% to savings and debt repayment. No complicated categories, no spreadsheet required. It is a starting point you can adjust as your life changes."],["p", "Needs are the things you cannot function without: rent or mortgage, food, transport to work, utility bills, and the minimum payments on your debt. Wants are everything else, the takeaways, the subscriptions you barely use, the upgrade you do not need. The rule&#039;s real value is forcing you to draw that line honestly. Most budgets that fail do so because wants quietly sneak into the needs column."],["p", "In Nigeria, high inflation and rising costs make strict needs-heavy budgets common, housing and food can easily consume well over 50%. That is fine. Treat 50/30/20 as a target to move toward, not a rule to feel guilty about. Start by tracking what your needs actually cost, then push the savings slice up over time. Even starting at 10% savings and inching toward 20% beats saving nothing at all. Use your take-home (net) pay, the money that actually lands in your account, not your gross."],["p", "The 20% savings-and-debt bucket is the seed that grows your future. Once you are saving, put it to work, see it compound with our compound interest calculator, or set a specific target with our savings goal calculator. And remember inflation erodes any goal, our inflation-adjusted calculator shows what you truly need to save."],["p", "Strict 50/30/20 assumes your big needs cost about half your take-home. In high-cost Nigerian cities, rent and food alone can push well past that, which is not a failure of the rule, just a reality to plan around. The important part is to keep the savings slice conscious and growing, even if the mix leans heavier on needs. Adjust the three percentage fields above to whatever split your numbers actually support, rather than forcing a 50/30/20 square peg."],["p", "50/30/20 gives you the three big numbers. To turn them into a budget you can actually spend against, break the needs bucket into real Nigerian categories, rent, food, transport, data, utilities. Step 2 of this same calculator, below the receipt, takes this same split and digs into the needs half, showing exactly how many naira go to rent, food, transport, data and bills, with every share editable so the plan always adds up."],["p", "Start from your take-home pay, never your gross. Whatever your income, the goal is the same: give every naira a job, so nothing leaks away unnoticed."],["p", "The rule fails when people treat it as a rigid law instead of a compass. One classic mistake is budgeting on gross pay, which inflates every bucket and leaves you chasing money that never landed. Another is stuffing the wants bucket with expenses that are really needs in disguise, the \"basic\" phone plan you upgraded twice, the meal delivery that quietly became dinner. And the third is ignoring the leftover entirely: if your three percentages do not sum to 100, the leftover has no job, so it disappears into the void of everyday spending."],["p", "The fix for all three is honest categorising. Budget on what hits your account. When something feels like a want, ask whether you would genuinely afford to drop it this month, if it is a bill you must pay, it belongs in needs. And make sure your split adds up. The calculator above flags any unallocated remainder so you can add it to savings rather than let it vanish."],["p", "Freelancers, commission earners and seasonal workers face a question the 50/30/20 rule glosses over: what is your \"take-home\" when every month is different? The workable answer is to base the budget on your average of the last three months, not your best month. Budget on the average, and when a good month arrives, sweep the surplus past the 20% savings slice rather than inflating your wants."],["p", "Because the rule is percentage-based, it scales with whatever number you enter, that is precisely why this tool takes a single income figure and lets you adjust the three splits. Set the income to your moving average and the buckets adjust automatically, so a lean month is no longer a mystery and a strong month becomes a chance to save more."],["h2", "Budgeting questions"],["h3", "What is the 50/30/20 rule?"],["p", "A simple budget that puts 50% of your take-home pay toward needs, 30% toward wants, and 20% toward savings and paying down debt."],["h3", "How much should I allocate from a ₦250,000 salary?"],["p", "About ₦125,000 for needs, ₦75,000 for wants, and ₦50,000 for savings/debt each month."],["h3", "Should I use gross or net income?"],["p", "Use your take-home (net) pay, the amount that actually reaches your account after tax, because that is what you can genuinely spend and save."],["h3", "What counts as a need versus a want?"],["p", "Needs are what you cannot do without: housing, food, transport, utilities, minimum debt payments. Wants are the rest, dining out, entertainment, upgrading your phone. If in doubt, it is a want."]]},
  related={[
    { href: `${base}money-tools/compound-interest-calculator/`, title: "Compound Interest Calculator", excerpt: "Put the 20% to work — project your savings year by year." },
    { href: `${base}money-tools/savings-goal-calculator/`, title: "Savings Goal Calculator", excerpt: "Name the target and deadline — get the exact monthly price." },
    { href: `${base}money-tools/inflation-savings-calculator/`, title: "Inflation Savings Calculator", excerpt: "Inflate the goal first, then price what you truly need to save." },
  ]}
  disclaimer="This calculator is for informational guidance only and is not financial advice. The 50/30/20 rule is a budgeting framework, not a guarantee of outcomes, adjust it to your circumstances and confirm major decisions with a licensed adviser.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<p class="receipt-note" id="bg-memdate" hidden></p>
<p class="receipt-note" id="bg-live" hidden></p>
<div class="tgrid c3" id="bg-top">
<div class="field"><label for="bg-inc">Monthly income ₦</label><input id="bg-inc" type="text" value={income} inputmode="decimal"></div>
<div class="field"><label for="bg-needs">Needs %</label><input id="bg-needs" type="text" max="100" value="50" inputmode="decimal" placeholder="50"></div>
<div class="field"><label for="bg-wants">Wants %</label><input id="bg-wants" type="text" max="100" value="30" inputmode="decimal" placeholder="30"></div>
<div class="field"><label for="bg-save">Savings %</label><input id="bg-save" type="text" max="100" value="20" inputmode="decimal" placeholder="20"></div>
<div class="field"><label for="bg-spn">Spent on needs ₦</label><input id="bg-spn" type="text" value={String(seedActuals.needs)} inputmode="decimal"></div>
<div class="field"><label for="bg-spw">Spent on wants ₦</label><input id="bg-spw" type="text" value={String(seedActuals.wants)} inputmode="decimal"></div>
<div class="field"><label for="bg-sps">Put to savings ₦</label><input id="bg-sps" type="text" value={String(seedActuals.savings)} inputmode="decimal"></div>
</div>
<p class="receipt-note" id="bg-seedwarn" hidden></p>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Plan buckets</p>
<p class="receipt-fig" id="bg-fig">₦{n(seed.needs)} · ₦{n(seed.wants)} · ₦{n(seed.savings)}</p>
<p class="receipt-sub" id="bg-sub">Needs · wants · savings — leftover <span id="bg-else">₦{n(seed.else)}</span></p>
<p class="receipt-sub" id="bg-sumnote"></p>
<p class="receipt-note" id="bg-warn" hidden></p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row" data-goto="bg-spn" tabindex="0" role="button" style="cursor:pointer" title="See the field behind this figure"><span>Needs left <span aria-hidden="true">›</span></span><b id="bg-rn">₦{n(chk.needs_remaining)}</b></div>
<div class="receipt-row" data-goto="bg-spw" tabindex="0" role="button" style="cursor:pointer" title="See the field behind this figure"><span>Wants left <span aria-hidden="true">›</span></span><b id="bg-rw">₦{n(chk.wants_remaining)}</b></div>
<div class="receipt-row" data-goto="bg-sps" tabindex="0" role="button" style="cursor:pointer" title="See the field behind this figure"><span>Savings left to save <span aria-hidden="true">›</span></span><b id="bg-rs">₦{n(chk.savings_remaining)}</b></div>
<p class="receipt-note" id="bg-pasted" hidden></p>
<p class="receipt-note" id="bg-whatnow" hidden></p>
<p class="receipt-foot hint">Plan vs actual: leftover = income your splits didn't assign</p>
<p class="receipt-foot hint">Wants left = plan wants minus spent on wants</p>
<p class="receipt-foot hint">Savings left to save = plan savings minus put to savings</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
<p class="receipt-note"><a href="#step2">See where the needs money goes ↓</a> · <button type="button" class="btn b-ghost b-sm" id="bg-copy">Copy example plan</button><span id="bg-copywhy" data-trust="example"> — cold, this copies our example.</span><span id="bg-copied" hidden> — copied.</span></p>
<div class="receipt-div" aria-hidden="true"></div>
<h3 id="step2">Step 2 — where the needs money goes</h3>
<p>One tool, one journey. This is the plan's needs figure from step 1 — the same income, the same split — itemised into real Nigerian lines: rent, food, transport, data, bills. Knowing you should spend <span id="bg-step2-needs">₦{n(seed.needs)}</span> on needs is useful; knowing rent takes about <span id="bg-step2-rent">₦{n(seedRent)}</span> of it is actionable. The shares below are indicative starting points, not laws — tune any bucket and the naira follows instantly, always reconciling back to your income.</p>
<p class="receipt-note"><a href="#bg-top">↑ Adjust income &amp; split</a></p>
<p class="receipt-note" id="bg-mini" hidden></p>
<div class="tgrid c3" style="margin-top:14px">
{al.buckets.filter((b) => b.id !== "other").map((b) => (
<div class="field"><label for={`al-${b.id}`}>{b.label} % of needs</label><input id={`al-${b.id}`} type="text" max="100" value={(b.share * 100).toFixed(0)} inputmode="decimal" data-al-bucket={b.id}></div>
))}
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Needs budget (<span data-sf-fig id="al-pct">50%</span> of income): <span data-sf-fig id="al-needs">₦{n(al.needs)}</span></p>
<div id="al-rows">
{al.buckets.map((b) => (
<div class="receipt-row"><span>{b.label}</span><b data-al-amt={b.id}>₦{n(b.amount)}</b></div>
))}
</div>
<p class="receipt-note" id="al-warn" hidden></p>
<p class="receipt-note" id="al-actuals" hidden></p>
<p class="receipt-foot">Shares of needs — naira follows instantly</p>
<p class="receipt-foot hint">Other needs is whatever is left after the named shares</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
<p class="receipt-note" id="bg-resetnote">Reset wipes what you typed and restores our example — it cannot be undone.</p>
</div>
</ToolShell>
<script>
import { budget503020, budget503020Compare } from "../../lib/budget";
import { budgetAllocator } from "../../lib/allocator";
import { formatGrouped } from "../../lib/format";
import { pm, pmBlank } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig } from "../../data/tool-fields";
/* F1 — fleet-wide negative shape (the crypto tool's winner): a negative prints
   −₦X (U+2212 minus before the symbol), never ₦-X. format.ts stays
   PHP-parity-pinned (it mirrors gwill_paye_number), so this is fixed per page
   on the two pages whose figures can actually go negative. */
const nn = (v: number) => (v < 0 ? "−" : "") + "₦" + formatGrouped(Math.abs(v), 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
/* Badge reads, module scope: render() uses them for the seedwarn gate and the
   copy handler below uses the same badges, so one definition serves both. */
const hasBadge = (id: string, attr: string) => {
  const fi = document.getElementById(id);
  const f = fi && (fi as HTMLElement).closest ? (fi as HTMLElement).closest(".field") : null;
  return !!(f && (f as Element).hasAttribute(attr));
};
function render() {
  /* F8 — every clamped negative says so: -x is priced as ₦0 in all seven
     inputs, so the rail names the rewrite instead of staying silent. */
  const bgNeg = ["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].some((id) => pm(g(id).value) < 0);
  /* Recovery soft spot 1 (A4): 999999999 income printed ₦500,000,000 plan
     figures with no line saying the number is absurd — figures were the only
     signal. The honest line reuses the fleet's own too-large vocabulary
     verbatim (salary-tax "That gross looks unusually large — double-check
     the figure", same ₦100M threshold), so no new clause family is invented. */
  const bgHuge = pm(g("bg-inc").value) > 100000000;
  t("bg-warn").hidden = !(bgNeg || bgHuge);
  t("bg-warn").textContent = (bgNeg ? "Negative entries are treated as ₦0." : "")
    + ((bgNeg && bgHuge) ? " " : "")
    + (bgHuge ? "That income looks unusually large — double-check the figure." : "");
  const inc = Math.max(0, pm(g("bg-inc").value) || 0);
  const np = Math.max(0, pm(g("bg-needs").value) || 0) / 100;
  const wp = Math.max(0, pm(g("bg-wants").value) || 0) / 100;
  const svp = Math.max(0, pm(g("bg-save").value) || 0) / 100;
  const plan = budget503020(inc, np, wp, svp);
  /* THE ZERO LAW: every figure declares the ids it is derived from. A split the
     visitor never entered cannot print a gold ₦0 bucket. */
  sfFig(t("bg-fig"), ["bg-inc", "bg-needs", "bg-wants", "bg-save"], `${nn(plan.needs)} · ${nn(plan.wants)} · ${nn(plan.savings)}`);
  sfFig(t("bg-else"), ["bg-inc", "bg-needs", "bg-wants", "bg-save"], nn(plan.else));
  /* B4-FIX2 — a split the visitor never entered cannot print a gold bucket:
     garbage ("abc" in a split) reads as un-entered, exactly like a cleared
     field, so the demand line below matches the blank state. */
  const total = Math.round((np + wp + svp) * 100);
  /* FATIGUE CUT — the old sentence lived here ("Set all three splits — an
     empty split is not a zero"), a second teacher for the one "empty ≠ zero"
     rule. It now speaks in the Nothing-to-compute rail's own voice
     (guardOffer, tool-fields.ts: "Nothing to compute yet — X is empty, not
     zero"), naming the exact missing split(s) in the fields' own words
     (text-nodes-only labels, so SAMPLE/LAST USED badges can never garble it
     — the BREAK-1 lesson). One voice for the rule instead of two; the error
     path below is untouched. */
  const splitLabel = (id: string) => {
    const l = document.querySelector(`label[for="${id}"]`);
    if (!l) return id;
    let s = "";
    l.childNodes.forEach((n) => { if (n.nodeType === 3) s += n.textContent || ""; });
    return s.trim() || id;
  };
  const missingSplits = ["bg-needs", "bg-wants", "bg-save"].filter((id) => pmBlank(g(id).value));
  /* E4 census gate: `empty` is needed above (F-P2) as well as below. It reads
     VALUES only (sfIsEmpty), never badge state, so judging it here instead of
     at the foot of render() changes nothing — first paint included. */
  const empty = sfIsEmpty("50-30-20-budget-calculator", gv);
  /* F-P2 — the empty/partial state fired TWO rail-voice lines at once: this
     sumnote ("Needs % and Wants % … are empty, not zero") AND the offer rail
     ~40px below ("Monthly income ₦ and Needs % …"). The offer now carries the
     ONE union sentence (its `needs` in tool-fields.ts names income + all three
     splits, so guardOffer's single clause already says every missing id), so
     this line stands down whenever the offer rail is active. Same information,
     one line fewer. F-P3 — a shown-but-empty sumnote is a visible nothing
     (cold + every 100%-split state painted a blank <p>), so the element hides
     with its empty text instead of holding whitespace. */
  const offerRail = !empty && ["bg-inc", "bg-needs", "bg-wants", "bg-save"].some((id) => pmBlank(g(id).value));
  const sumnote = t("bg-sumnote");
  if (offerRail) { sumnote.textContent = ""; sumnote.hidden = true; }
  else if (missingSplits.length) {
    sumnote.hidden = false;
    sumnote.textContent = `Nothing to compute yet — ${missingSplits.map(splitLabel).join(" and ")} ${missingSplits.length > 1 ? "are" : "is"} empty, not zero.`;
  } else if (total === 100) { sumnote.textContent = ""; sumnote.hidden = true; }
  else {
    /* Recovery soft spot 2 (A4): the old line stated the FACT ("Splits add to
       250%") and prescribed nothing — the fix is named in the SAME line, no
       new line, no new clause family. */
    sumnote.hidden = false;
    sumnote.textContent = `Splits add to ${total}% — buckets use your exact percentages, so bring them back to 100%.`;
  }
  const c = budget503020Compare(inc, np, wp, svp,
    Math.max(0, pm(g("bg-spn").value) || 0),
    Math.max(0, pm(g("bg-spw").value) || 0),
    Math.max(0, pm(g("bg-sps").value) || 0));
  sfFig(t("bg-rn"), ["bg-inc", "bg-needs", "bg-spn"], nn(c.needs_remaining));
  sfFig(t("bg-rw"), ["bg-inc", "bg-wants", "bg-spw"], nn(c.wants_remaining));
  sfFig(t("bg-rs"), ["bg-inc", "bg-save", "bg-sps"], nn(c.savings_remaining));
  /* STEP 2 — the needs half, itemised. Same income, same split: the needs
     figure feeding these buckets IS plan.needs, so step 1 → step 2 is one
     continuous journey — change income or split and both steps move. */
  const shares: Record<string, number> = {};
  const shareIds: string[] = [];
  document.querySelectorAll("[data-al-bucket]").forEach((el) => {
    const inp = el as HTMLInputElement;
    shares[inp.dataset.alBucket as string] = Math.max(0, pm(inp.value) || 0) / 100;
    shareIds.push(inp.id);
  });
  const r2 = budgetAllocator(inc, np, wp, svp, shares);
  sfFig(t("al-needs"), ["bg-inc", "bg-needs"], nn(r2.needs));
  /* T3 — the step-2 label names the LIVE split, never a fixed "half": at a
     60/20/20 split "Needs half: ₦150,000" was a live lie. Same live-span
     pattern E2 used for the intro (sfFig withholds as "—" while blank). */
  sfFig(t("al-pct"), ["bg-inc", "bg-needs"], `${Math.round(np * 100)}%`);
  /* F-A2-1 — the step-2 intro names live figures, never the seed's. sfFig
     withholds them as "—" while the inputs are blank, exactly like the
     receipt, so no ₦0 is ever printed in prose. */
  sfFig(t("bg-step2-needs"), ["bg-inc", "bg-needs"], nn(r2.needs));
  const rentAmt = r2.buckets.find((b) => b.id === "rent")?.amount ?? 0;
  sfFig(t("bg-step2-rent"), ["bg-inc", "bg-needs", "al-rent"], nn(rentAmt));
  const shareSum = Object.values(shares).reduce((a, b) => a + b, 0);
  const planned = r2.needs * shareSum;
  /* Every clamped negative says so: -x is priced as ₦0 in income, splits and
     every share, so the rail names the rewrite instead of staying silent. */
  const alNeg = ["bg-inc", "bg-needs"].concat(shareIds).some((id) => pm((document.getElementById(id) as HTMLInputElement).value) < 0);
  const alNegSfx = alNeg ? " Negative entries are treated as ₦0." : "";
  /* A field still wearing SAMPLE has not been touched; one wearing LAST USED
     holds the visitor's own remembered number. Both are the spine's own
     badges, read off the DOM — no new state kept here (hasBadge, module scope). */
  if (r2.needs > 0 && planned > r2.needs) {
    t("al-warn").hidden = false;
    /* F-A2-7 — a remembered tune must not read as a scold: when the overage
       rides on LAST USED shares, the warn says so instead of greeting the
       returner with a warning new visitors never see. The maths never moves. */
    const memSfx = shareIds.some((id) => hasBadge(id, "data-r")) ? " Includes shares from your last visit — trim any bucket to fit." : "";
    t("al-warn").textContent = `Over by ${nn(planned - r2.needs)} — buckets add to ${(shareSum * 100).toFixed(0)}% of needs. Trim shares to 100% or less.` + memSfx + alNegSfx;
  } else {
    t("al-warn").hidden = !alNeg;
    t("al-warn").textContent = alNeg ? "Negative entries are treated as ₦0." : "";
  }
  const box = t("al-rows");
  box.innerHTML = "";
  for (const b of r2.buckets) {
    const div = document.createElement("div");
    div.className = "receipt-row";
    const lab = document.createElement("span"); lab.textContent = b.label;
    const amt = document.createElement("b");
    amt.setAttribute("data-al-amt", b.id);
    /* The residual "Other needs" row is what is left of needs after every
       named share, so it waits on ALL of them, not on one. */
    sfFig(amt, b.id === "other" ? ["bg-inc", "bg-needs"].concat(shareIds) : ["bg-inc", "bg-needs", "al-" + b.id], nn(b.amount));
    div.appendChild(lab); div.appendChild(amt); box.appendChild(div);
  }
  /* F-A2-6 — over-100% must not swallow the residual: the engine (rightly,
     untouched — it lives outside this file) omits "Other needs" at zero, so
     the page re-states it here as the honest negative step 1 already prints.
     Exactly-100% stays omitted: ₦0 of other is nothing to show. */
  if (r2.needs > 0 && planned > r2.needs && !r2.buckets.some((b) => b.id === "other")) {
    const div = document.createElement("div");
    div.className = "receipt-row";
    const lab = document.createElement("span"); lab.textContent = "Other needs";
    const amt = document.createElement("b");
    amt.setAttribute("data-al-amt", "other");
    sfFig(amt, ["bg-inc", "bg-needs"].concat(shareIds), nn(r2.needs - planned));
    div.appendChild(lab); div.appendChild(amt); box.appendChild(div);
  }
  sfEmpty(empty);
  /* F2 — the receipt sits below the fold at 390px, so a split change used to
     recompute figures the visitor could not see. This one line lives beside
     the fields and mirrors the plan, so every edit is visibly answered. */
  const splitsSet = ["bg-inc", "bg-needs", "bg-wants", "bg-save"].every((id) => !pmBlank(g(id).value));
  const live = t("bg-live");
  /* A hidden line carries no text: the rails contract reads note prose
    verbatim, so a stale "Plan now: ₦…" must not sit in the DOM behind hidden. */
  if (empty || !splitsSet) { live.hidden = true; live.textContent = ""; }
  else {
    live.hidden = false;
    live.textContent = `Plan now: ${nn(plan.needs)} needs · ${nn(plan.wants)} wants · ${nn(plan.savings)} savings`;
  }
  /* F-A2-3 — the seed-actuals ambush: income or split typed, but the spends
     still wear SAMPLE (ours, never entered). Name them before they paint the
     first triple negative as the visitor's month. */
  const sd = (id: string) => hasBadge(id, "data-sd");
  const seedWarn = t("bg-seedwarn");
  const planTouched = ["bg-inc", "bg-needs", "bg-wants", "bg-save"].some((id) => !sd(id));
  /* Name exactly which spends are still ours: after the visitor types one real
     figure, "the spends below" would smear their number with our example. */
  const seedIds = ["bg-spn", "bg-spw", "bg-sps"].filter(sd);
  if (!empty && planTouched && seedIds.length) {
    seedWarn.hidden = false;
    const nm = seedIds.map((id) => id === "bg-spn" ? "needs" : id === "bg-spw" ? "wants" : "savings").join(" and ");
    seedWarn.textContent = seedIds.length === 3
      ? "Heads up: the spends below are still our example, not yours — type what you really spent."
      : `Heads up: the ${nm} ${seedIds.length > 1 ? "spends are" : "spend is"} still our example — type what you really spent.`;
  } else { seedWarn.hidden = true; seedWarn.textContent = ""; }
  /* F-A2-4 + MF-1 — a negative must say what now: name the overage and the
     one honest action (trim the spend, or move the split). Step 2 plans from
     the plan figure either way, so say that too. */
  const wn = t("bg-whatnow");
  const overNW: Array<{ name: string; over: number }> = [];
  if (c.needs_remaining < 0) overNW.push({ name: "needs", over: -c.needs_remaining });
  if (c.wants_remaining < 0) overNW.push({ name: "wants", over: -c.wants_remaining });
  /* Savings reads opposite: remaining>0 is "still to save" (self-explanatory,
     the seed's own story), remaining<0 is OVER-put — ahead of plan, not short
     of it. Only the confusing sign gets the gloss, never a scold for saving. */
  const savOver = c.savings_remaining < 0 ? -c.savings_remaining : 0;
  if (!empty && (overNW.length || savOver > 0)) {
    const bits: string[] = [];
    if (overNW.length) {
      const nm = overNW.map((o) => o.name).join(" and ");
      const tot = overNW.reduce((a, o) => a + o.over, 0);
      bits.push(`${nm} ${nn(tot)} over — spend less there or raise the ${nm} split % above`);
    }
    if (savOver > 0) bits.push(`savings ${nn(savOver)} over plan — ahead of it; leave it banked or move the split if needs run tight`);
    wn.hidden = false;
    wn.textContent = bits.join("; ") + ". Step 2 still itemises the plan figure, not the overspend.";
  } else { wn.hidden = true; wn.textContent = ""; }
  /* MF-6 — the both-steps mini plan: FATIGUE CUT keeps only the pair the
     tuner cannot see from step 2 (needs + rent). Wants/savings restated the
     live line two screens up; rent is the actionable one here. Same guard as
     the live line: no figures on an empty page. */
  const mini = t("bg-mini");
  if (empty || !splitsSet) { mini.hidden = true; mini.textContent = ""; }
  else {
    mini.hidden = false;
    const rentTxt = pmBlank(g("al-rent").value) ? "—" : nn(rentAmt);
    mini.textContent = `Mini plan — needs ${nn(plan.needs)} · rent ${rentTxt} of needs`;
  }
  /* Discovery (A4 bottom-3): the copy button's cold honesty must be visible
     PRE-tap, not just in the clipboard payload. The static span beside the
     button says it copies our example; the moment every field is the
     visitor's own (the same all-typed predicate the copy handler uses) the
     span stands down, so it never mislabels a "My plan" copy. Empty pages
     refuse copies, so the span waits there too. */
  const cwhy = document.getElementById("bg-copywhy");
  const copyBtn = document.getElementById("bg-copy");
  if (cwhy && copyBtn) {
    const typedFld = (id: string) => !hasBadge(id, "data-sd") && !pmBlank(g(id).value);
    const allTyped = ["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].every(typedFld);
    const planTyped = ["bg-inc", "bg-needs", "bg-wants", "bg-save"].every(typedFld);
    if (empty) {
      cwhy.hidden = false;
      cwhy.textContent = " — cold, this copies our example.";
      cwhy.setAttribute("data-trust", "example");
      copyBtn.textContent = "Copy example plan";
    } else if (allTyped) {
      cwhy.hidden = true;
      copyBtn.textContent = "Copy my plan";
    } else if (planTyped) {
      cwhy.hidden = false;
      cwhy.textContent = " — copies the example plan (your splits, our spends).";
      cwhy.setAttribute("data-trust", "computed");
      copyBtn.textContent = "Copy plan summary";
    } else {
      cwhy.hidden = false;
      cwhy.textContent = " — cold, this copies our example.";
      cwhy.setAttribute("data-trust", "example");
      copyBtn.textContent = "Copy example plan";
    }
  }
  /* MF-4 — the actuals mirror: step 2 never itemises the overspend (it shares
     out the plan), so it says the comparison aloud where the buckets are.
     T1 — the same plan-touched gate as seedwarn, in seedwarn's own words:
     until the visitor touches a plan input AND the spend itself, the figures
     are our example, so the mirror reads as example, never "You spent". */
  const am = t("al-actuals");
  /* F-P1 — cold painted the plan THREE times (live + mini + mirror) before a
     keystroke. While step-1 is untouched seeds the mirror waits; a spend typed
     alone still raises the Example voice (the history-trap path), so the gate
     is "nobody touched anything", not "plan untouched".
     F-P5 — a ₦0 plan is a plan that doesn't exist: the mirror withholds
     exactly where copy refuses (the same plan-complete guard as the copy
     handler below), so a kept spend + cleared plan never scolds
     "₦95,000 over" against a plan nobody entered. */
  const planComplete = ["bg-inc", "bg-needs", "bg-wants", "bg-save"].every((id) => !pmBlank(g(id).value));
  const step1Touched = planTouched || !sd("bg-spn");
  if (!empty && planComplete && !pmBlank(g("bg-spn").value) && step1Touched) {
    const spent = Math.max(0, pm(g("bg-spn").value) || 0);
    const yours = planTouched && !sd("bg-spn");
    am.hidden = false;
    if (spent > plan.needs) {
      am.textContent = yours
        ? `You spent ${nn(spent)} vs ${nn(plan.needs)} plan on needs — ${nn(spent - plan.needs)} over. Tune the buckets below against the plan, then trim the spend above.`
        : `Example: ${nn(spent)} vs ${nn(plan.needs)} plan on needs — ${nn(spent - plan.needs)} over. Our example, not yours — type what you really spent to score your month.`;
    } else {
      am.textContent = yours
        ? `You spent ${nn(spent)} vs ${nn(plan.needs)} plan on needs — within plan. The buckets below share out the plan figure.`
        : `Example: ${nn(spent)} vs ${nn(plan.needs)} plan on needs — within plan. Our example, not yours — the buckets below share out the plan figure.`;
    }
  } else { am.hidden = true; am.textContent = ""; }
  /* MF-5 + F9 — the memory date, visible: the spine dates LAST USED only in a
     hover title (no touch path), so the page reads the spine's own key and
     prints the day. A copied plan goes stale on the next keystroke, so the
     confirmation hides here too. */
  t("bg-copied").hidden = true;
  const md = t("bg-memdate");
  let memTxt = "";
  try {
    const raw = localStorage.getItem("gwill-sf-50-30-20");
    if (raw) {
      const s = JSON.parse(raw);
      if (s && s.t) {
        const days = Math.floor((Date.now() - s.t) / 864e5);
        const rel = days <= 0 ? "today" : days === 1 ? "yesterday" : days + " days ago";
        const dst = new Date(s.t).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
        memTxt = `Last saved ${rel} (${dst}) — only LAST USED pills are yours.`;
      }
    }
  } catch {}
  if (memTxt && !empty) { md.hidden = false; md.textContent = memTxt; }
  else { md.hidden = true; md.textContent = ""; }
}
["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].forEach((id) => g(id).addEventListener("input", render));
document.querySelectorAll("[data-al-bucket]").forEach((el) => el.addEventListener("input", render));
/* BADGE SETTLE — the spine strips SAMPLE and writes memory on the document
   bubble, AFTER the target-phase render above has already run. Badge-reading
   lines (seedwarn, the remembered-warn suffix, the memory date) would sit one
   keystroke late without this; the re-render is idempotent and writes nothing
   the first pass did not already own. */
document.addEventListener("input", () => setTimeout(render, 0));
/* F3 — "Use this" writes the plan into actuals, collapsing Needs left to ₦0.
   The compare must survive the click: say what happened, and lift the note the
   moment the visitor types their real figure. render() never touches the note,
   so it stands until the visitor takes the field over (or Reset/Clear moves it). */
let pasted = false;
document.addEventListener("click", (e) => {
  const u = (e.target as HTMLElement).closest?.('.offer b[data-use="bg-spn"]');
  if (!u || u.getAttribute("aria-disabled")) return;
  pasted = true;
  const note = t("bg-pasted");
  note.hidden = false;
  note.textContent = "Pasted the plan into actuals — Needs left matches by construction, not by verdict. Type what you really spent to score your month.";
});
g("bg-spn").addEventListener("input", () => {
  if (!pasted) return;
  pasted = false;
  t("bg-pasted").hidden = true;
  t("bg-pasted").textContent = "";
});
smartFields.register(TOOL_FIELDS["50-30-20-budget-calculator"]);
sfBind("50-30-20-budget-calculator", gv);
/* MF-7 — tap-a-row to compare: the receipt rows answer with the fields they
   are derived from (the offer already lives at the Spent-on-needs field, so
   the row takes the visitor to it). Existing behaviour only: scroll + focus,
   the same focus that selects a SAMPLE field. */
document.querySelectorAll(".receipt-row[data-goto]").forEach((row) => {
  const go = () => {
    const id = (row as HTMLElement).dataset.goto as string;
    const target = document.getElementById(id) as HTMLInputElement | null;
    if (!target) return;
    target.scrollIntoView({ behavior: "smooth", block: "center" });
    target.focus({ preventScroll: true });
  };
  row.addEventListener("click", go);
  /* KEYBOARD — the rows are tabbable buttons (tabindex/role in markup), so
     Enter/Space must do what a tap does. Same go(), no new behaviour. */
  row.addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
      e.preventDefault();
      go();
    }
  });
});
/* MF-5 — plan save: copy the live plan as one line. The "copied" word hides
   on the next render (the figures it copied are stale by then).
   T2 — "My plan" is TRUE only when all seven step-1 fields are the
   visitor's own (no SAMPLE badge, real digits entered): cold it would
   export our example as theirs, empty it would export a ₦0 plan. So
   all-typed copies "My plan"; a touched-but-partial page copies the same
   figures labelled as our example; an empty (or plan-incomplete) page
   refuses with the waiting line and copies nothing — never ₦0. */
const copyBtn = document.getElementById("bg-copy");
if (copyBtn) copyBtn.addEventListener("click", async () => {
  const done = t("bg-copied");
  const planIds = ["bg-inc", "bg-needs", "bg-wants", "bg-save"];
  const typed = (id: string) => !hasBadge(id, "data-sd") && !pmBlank(g(id).value);
  /* Refuse only when the figures would be invented: a blank plan input prices
     as ₦0, and ₦0 is never copied. Cold (all SAMPLE, all valued) is NOT a
     refusal — it copies the example, honestly labelled. */
  if (sfIsEmpty("50-30-20-budget-calculator", gv) || planIds.some((id) => pmBlank(g(id).value))) {
    done.textContent = " — nothing to copy yet — enter your numbers above.";
    done.hidden = false;
    return;
  }
  const allTyped = ["bg-inc", "bg-needs", "bg-wants", "bg-save", "bg-spn", "bg-spw", "bg-sps"].every(typed);
  const i2 = Math.max(0, pm(g("bg-inc").value) || 0);
  const p2 = budget503020(i2,
    Math.max(0, pm(g("bg-needs").value) || 0) / 100,
    Math.max(0, pm(g("bg-wants").value) || 0) / 100,
    Math.max(0, pm(g("bg-save").value) || 0) / 100);
  const summary = allTyped
    ? `My 50/30/20 plan (income ${nn(i2)}): needs ${nn(p2.needs)}, wants ${nn(p2.wants)}, savings ${nn(p2.savings)}.`
    : `EXAMPLE: Our 50/30/20 example (income ${nn(i2)}): needs ${nn(p2.needs)}, wants ${nn(p2.wants)}, savings ${nn(p2.savings)}. Type your own numbers to make it yours.`;
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(summary);
    else throw new Error("no clipboard");
    done.textContent = " — copied.";
  } catch { done.textContent = " — copy failed here; long-press the plan line above."; }
  done.hidden = false;
});
render();
</script>
