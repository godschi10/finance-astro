---
import ToolShell from "../../components/ToolShell.astro";
import { inflationAdjustedGoal } from "../../lib/inflation";
import { formatGrouped } from "../../lib/format";
const n = (v: number) => formatGrouped(v, 0);
/* HN-2. The field opens at 24%, not 20%: NBS put Lagos at 23.68% headline in
   Aug 2026 — the highest of any state — while national headline was 15.39%. A
   20% default is 3.68 points UNDER what the largest readership pays, and
   calling that "cautious" was the dishonest part. The lib's inflation-savings
   engine takes inflation as an argument (there is no seed constant here), so
   the SSR receipt and the field agree at 24% with no gate touched. */
const seed = inflationAdjustedGoal(10000000, 1000000, 0.15, 0.24, 5, 0, "monthly", "monthly");
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<ToolShell title="Inflation Savings Calculator, Real Goal Top-Up - GWill Finance" description="Saving ₦10m in 5 years? Inflation moves the goalpost. See the nominal monthly, the real monthly, and the gap." slug="inflation-savings-calculator" tool="Inflation-Adjusted Savings Calculator" crumb="Inflation Savings Calculator" lede="A fixed goal is a shrinking goal. This inflates your target first, then prices both monthlies — the gap is the insight." verified="Target inflated at your rate · gap is the monthly truth" faqs={[
  { q: "Why save for an inflated target?", a: "Because the house, fees, or capital you are saving toward inflates too. Saving the nominal figure guarantees arriving short." },
  { q: "How is this different from the naira-value tool?", a: "That shows what money loses. This solves what you must save monthly so inflation does not win." },
]}

  badge="Inflation-aware · Real terms",
  copy={[["p", "Set a target today and you are pricing it in today&#039;s naira. But inflation is the silent tax on money held over time, the same car, school fees or deposit that costs ₦2,000,000 now will cost noticeably more in three years. If you save toward today&#039;s price, you arrive at your deadline short of the real amount. This calculator inflates the target by your chosen inflation rate so you see the true figure."],["p", "The two rows show the same goal two ways. The nominal row is what most calculators give you, the monthly amount to hit today&#039;s price. The inflation-adjusted row is what you actually need, and the gap between them is the extra you must save each month to win. That gap is the real, honest cost of not planning for inflation."],["p", "Nigerian inflation has trended high recently, official figures have run in the 20-30% range. Start with a realistic NBS/CBN rate, then err on the high side: it is far better to over-save now and end up ahead than to under-save and fall short. This calculator also lets you compare your earning rate against inflation, if your interest is below inflation, you are losing real value even as the balance grows."],["p", "The number that matters is the gap between what you earn and what inflation erodes. If your money earns 10% while inflation is 24%, your balance grows on paper but you lose buying power every year. To genuinely beat inflation, your return must be above it. This is why parking savings in a low-yield account quietly loses value, the calculator shows the honest monthly amount you need to reach your goal in real terms."],["p", "A worked example: the default shows a ₦10,000,000 goal with ₦1,000,000 already saved, at 15% earning and 24% inflation over 5 years. Ignoring inflation, the monthly need is about ₦89,109. But the true future cost of the goal is ₦29,316,251, so you really need about ₦307,188 a month. That ₦218,079 gap is the real, honest cost of not planning for inflation."],["p", "Use this with our savings goal calculator to solve the monthly amount toward a future target, and the compound-interest calculator to see how a principal and monthly contributions grow. To understand how much your naira will buy in future years, the naira value calculator shows the purchasing-power decay directly."],["h2", "Inflation and savings questions"],["h3", "Why does inflation change my savings target?"],["p", "A goal priced in today's naira will cost more in the future. A ₦10,000,000 goal at 24% annual inflation costs about ₦29,316,251 in five years, so saving toward today's price leaves you short."],["h3", "How much should I save monthly to beat inflation?"],["p", "For a ₦10,000,000 target (₦1,000,000 already saved, 15% earning rate, 24% inflation over 5 years) you need about ₦307,188 monthly, versus ₦89,109 if you ignored inflation."],["h3", "What inflation rate should I use?"],["p", "Use a realistic Nigerian inflation rate, recent years have run in the 20-30% range. Official NBS figures and the CBN rate are good starting points; err on the high side to be safe."],["h3", "Does my interest rate beat inflation?"],["p", "If your earning rate is below inflation, you are losing real value even as the balance grows. For a plan to win, your return must beat inflation, another reason to compare the two figures here."]]},
  disclaimer="This calculator is for informational guidance only and is not financial, tax or investment advice. Inflation and interest rates are not guaranteed, confirm your plan with a licensed financial adviser.">
<div class="fx-card">
<p class="echo" data-sf-card hidden>Nothing here is filled in for you. Enter your numbers — the receipt waits.</p>
<div class="tgrid c3">

<div class="field" data-cur="NGN"><label for="is-target">Goal today ₦</label><input id="is-target" type="text" value="10000000" inputmode="decimal"></div>
<div class="field" data-cur="NGN"><label for="is-cur">Have now ₦</label><input id="is-cur" type="text" value="1000000" inputmode="decimal"></div>
<div class="field"><label for="is-rate">Return %/yr</label><input id="is-rate" type="text" max="100" value="15" inputmode="decimal"></div>
<div class="field"><label for="is-infl">Inflation %/yr</label><input id="is-infl" type="text" max="100" value="24" inputmode="decimal"></div>
<div class="field"><label for="is-yrs">Years</label><input id="is-yrs" type="number" min="1" max="50" step="1" value="5" inputmode="numeric"></div>
</div>
<div class="receipt" aria-live="polite">
<p class="receipt-lbl">Real monthly (inflation-proof)</p>
<p class="receipt-fig" id="is-fig">₦{n(seed.real_monthly)}</p>
<p class="receipt-sub" id="is-sub">Goal grows ₦{n(seed.target)} → ₦{n(seed.real_target)} · nominal monthly only ₦{n(seed.nominal_monthly)}</p>
<div class="receipt-div" aria-hidden="true"></div>
<div class="receipt-row"><span>Nominal monthly</span><b id="is-nom">₦{n(seed.nominal_monthly)}</b></div>
<div class="receipt-row"><span>Real monthly</span><b id="is-real">₦{n(seed.real_monthly)}</b></div>
<div class="receipt-row"><span>Monthly gap</span><b id="is-gap">₦{n(seed.gap_monthly)}</b></div>
<p class="receipt-note" id="is-warn" hidden></p>
<p class="receipt-foot">The gap is the monthly truth</p>
<p class="receipt-foot" data-sf-foot hidden>Nothing entered · no figures invented</p>
</div>
</div>
</ToolShell>
<script>
import { inflationAdjustedGoal } from "../../lib/inflation";
import { formatGrouped } from "../../lib/format";
import { pm, pmBlank } from "../../scripts/pm";
import smartFields from "../../scripts/smart-fields";
import { TOOL_FIELDS, sfEmpty, sfIsEmpty, sfBind, sfFig } from "../../data/tool-fields";
const nn = (v: number) => "₦" + formatGrouped(v, 0);
const g = (id: string) => document.getElementById(id) as HTMLInputElement;
const t = (id: string) => document.getElementById(id) as HTMLElement;
const gv = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
/* THE ZERO LAW: inflationAdjustedGoal() reads all five typed inputs. */
const ALL = ["is-target", "is-cur", "is-rate", "is-infl", "is-yrs"];
function render() {
  /* M2 — THE ZERO LAW. A typed 0 horizon short-circuited to the 5-year seed, so
   "cost of this goal over 0 years" was answered with a 5-year plan. Zero years
   is honest and meaningful: no time passes, inflation moves the goal by nothing,
   so the nominal and inflation-adjusted figures are the same figure. The engine
   keeps its years >= 1 floor (faithful port, gate-verified), so the zero horizon
   is priced here. */
  const yrsRawStr = g("is-yrs").value.trim();
  const yrsZero = !pmBlank(yrsRawStr) && pm(yrsRawStr) === 0;
  const r = inflationAdjustedGoal(
    Math.max(0, pm(g("is-target").value) || 0),
    Math.max(0, pm(g("is-cur").value) || 0),
    Math.max(0, pm(g("is-rate").value) || 0) / 100,
    Math.max(0, pm(g("is-infl").value) || 0) / 100,
    yrsZero ? 1 : Math.max(1, Math.trunc(pm(yrsRawStr) || 5)),
    0, "monthly", "monthly",
  );
  const warn = t("is-warn");
  /* F8 — every clamped negative says so: -x is priced as ₦0 in all five
     inputs, so the rail names the rewrite instead of staying silent. */
  const negHit = ["is-target", "is-cur", "is-rate", "is-infl", "is-yrs"].some((id) => pm(g(id).value) < 0);
  const negSfx = negHit ? " Negative entries are treated as ₦0." : "";
  if (!Number.isFinite(r.nominal_monthly) || !Number.isFinite(r.real_monthly) || !Number.isFinite(r.gap_monthly) || !Number.isFinite(r.real_target)) {
    warn.hidden = false;
    warn.textContent = "Out of range — that inflation and horizon are beyond what this plan can price. Try 50 years or less." + negSfx;
    t("is-fig").textContent = "Out of range";
    t("is-sub").textContent = "No confident total at this input — lower the inflation rate or shorten the horizon.";
    t("is-nom").textContent = "—";
    t("is-real").textContent = "—";
    t("is-gap").textContent = "—";
    return;
  }
  warn.hidden = !negHit;
  warn.textContent = negHit ? "Negative entries are treated as ₦0." : "";
  if (yrsZero) {
    /* 0 years: no time passes, so inflation lifts the goal by ₦0 and the whole
       gap between the nominal and the adjusted figure is ₦0. Both are the same
       real number — that IS the answer, and it is worth stating plainly. */
    warn.hidden = false;
    warn.textContent = "0 years — no time passes, so inflation moves your goal by ₦0. The gap below is real and it is ₦0." + negSfx;
    const tgt = Math.max(0, pm(g("is-target").value) || 0);
    sfFig(t("is-fig"), ALL, nn(r.nominal_monthly));
    sfFig(t("is-sub"), ALL, `Goal grows ${nn(tgt)} → ${nn(tgt)} · nominal monthly only ${nn(r.nominal_monthly)}`);
    sfFig(t("is-nom"), ALL, nn(r.nominal_monthly));
    sfFig(t("is-real"), ALL, nn(r.nominal_monthly));
    sfFig(t("is-gap"), ALL, nn(0));
    return;
  }
  sfFig(t("is-fig"), ALL, nn(r.real_monthly));
  sfFig(t("is-sub"), ALL, `Goal grows ${nn(r.target)} → ${nn(r.real_target)} · nominal monthly only ${nn(r.nominal_monthly)}`);
  sfFig(t("is-nom"), ALL, nn(r.nominal_monthly));
  sfFig(t("is-real"), ALL, nn(r.real_monthly));
  sfFig(t("is-gap"), ALL, nn(r.gap_monthly));
}
  sfEmpty(sfIsEmpty("inflation-savings-calculator", gv));
["is-target", "is-cur", "is-rate", "is-infl", "is-yrs"].forEach((id) => g(id).addEventListener("input", render));
smartFields.register(TOOL_FIELDS["inflation-savings-calculator"]);
sfBind("inflation-savings-calculator", gv);
render();
</script>
