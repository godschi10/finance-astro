---
// ── MERGE 2026-10-07 (King's order: "2" MERGE) ─────────────────────────────
// The Budget Allocator is now STEP 2 inside the 50/30/20 page — one tool, one
// journey. This file is no longer a second copy of the needs-half buckets; it
// is a pointer to the canonical URL, so the buckets are rendered at exactly
// ONE address and this path carries no duplicate content for a crawler to
// weigh. Follows the repo's own precedent exactly
// (src/pages/category/investing/fixed-income/index.astro tail): meta refresh 0
// + link rel=canonical + meta robots noindex,follow + human fallback link.
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const origin = (Astro.site?.toString() ?? "https://godschi10.github.io").replace(/\/$/, "");
const target = `${base}money-tools/50-30-20-budget-calculator/`;
const targetAbs = `${origin}${target}`;
const label = "Budget Allocator";
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>{label} — GWill Finance</title>
    <link rel="canonical" href={targetAbs} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <main>
      <h1>{label} has moved</h1>
      <p>The needs-half buckets now live as step 2 of the 50/30/20 calculator. Taking you there now — if nothing happens, <a href={target}>open the 50/30/20 Budget Calculator</a>.</p>
    </main>
  </body>
</html>
