---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
// The featured-stamp sheet (R7), imported HERE rather than in the layout: every
// selector in it is `.feat`-descendant-scoped and this homepage is the only page
// in the build that emits .feat markup, so it stops landing in the other 78 pages'
// inlined cascade (-856 B each).
//
// CASCADE, measured not assumed (2026-10-05): Astro emits a page's OWN stylesheet
// BEFORE the layout's, so this sheet now leads the cascade block instead of trailing
// it — the reverse of what the Layout import comment assumed. That is safe here
// because r7.css is order-independent by construction (its own header: "every rule
// here is a NEW selector-or-combinator at equal-or-higher specificity than the
// verbatim rule it corrects"), and the build proves it: for every real element
// .feat-img -> .feat .feat-img (0,2,0) beats .feat-img / .ac-img,.feat-img (0,1,0);
// .feat-emoji -> .feat .feat-img>span.feat-emoji (0,3,1) beats .feat-emoji (0,1,0)
// and .feat-img>span:first-child (0,2,1); the ::before/::after plate layers and the
// :has(>img) guard have no competitor in any sheet. No rule relies on source order.
import "../styles/r7.css";
import { SITE, CATEGORIES, catBySlug, FEATURED_SLUG } from "../data/site";
import { allArticles, fmtMonthYear, APPS } from "../data/content";
import { TOOL_MANIFEST } from "../data/tool-manifest";

// Faithful port of front-page.php (gwill-finance-theme 1.13.39), sections 2-8.
// Section 1 (template bootstrap) has no markup; the stray unmatched </div> at
// front-page.php:117 is deliberately NOT reproduced — it is a theme bug that the
// browser's parser drops, and the live DOM has exactly 5 children in <main>.
//
// Featured: the theme picks a fixed post (theme mod gwill_featured_post_id,
// live = post 5). The port names the same article.
// Grid: WP renders "the newest 9 posts, featured NOT excluded"; the port's
// archive is smaller, so it renders every article under the same rule.
const posts = await allArticles();
const featured = posts.find((p) => p.slug === FEATURED_SLUG) ?? posts[0];
const grid = posts.slice(0, 9);
const fcat = catBySlug(featured.data.category);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
// 2026-09-30 King order: the stats strip must print REAL current counts, not
// invented ones ("2+ All data current" was fabricated). Counts are computed
// from the actual site content at BUILD time — articles from the content
// collection, apps from APPS data, calculators from the tool manifest — so they
// can never drift out of date again.
//
// SITE-2 (copy-truth leg, 2026-10-09): the calculator count used to come from a
// readdirSync() of src/pages/money-tools, which returned 16 while /money-tools/
// listed 15 cards. The extra file was budget-allocator.astro — merged into
// 50-30-20 on 2026-10-07 (the King's "2" MERGE order), so its URL is now only a
// pointer page, not a listed tool. Counting the directory therefore advertised
// a tool the hub does not show. The count now comes from TOOL_MANIFEST, the ONE
// list the hub renders in its print order, which already excludes the merged
// allocator — so the stat and the cards cannot disagree again without this
// same list changing on both.
const importedTools = TOOL_MANIFEST;
const furl = `${base}articles/${featured.slug}/`;
// WP prints the featured excerpt through wp_trim_words( get_the_excerpt(), 32 ).
const trim32 = (s: string) => {
  const w = s.trim().split(/\s+/);
  return w.length > 32 ? w.slice(0, 32).join(" ") + "…" : s;
};
---
<Layout title="Nigerian Money, Explained - GWill Finance" description={SITE.description} crumb="" forms>
<!-- ══════ 2. hero ══════ -->
<section class="hero">
<div class="hero-grain"></div>
<div class="con" style="max-width:none;padding-top:0;padding-bottom:0">
<div class="hero-tag">₦ Nigerian Finance · Honest Guides</div>
<h1 class="hero-h"><span class="g">Nigerian money.</span><br><span class="w">Explained.</span></h1>
<p class="hero-sub">Savings, investing, dollar accounts, crypto, and every fintech app worth your attention. Tested by Gwill. No jargon. No AI slop.</p>
<div class="hero-acts">
<a class="bh" href={`${base}articles/`}>Browse all articles →</a>
<a class="bhg" href={`${base}money-tools/`}>Money Calculators</a>
</div>
<div class="hero-cats">
<span class="hero-cats-lbl">Topics:</span>
{CATEGORIES.map((c) => (<a class={`db ${c.chip}`} href={`${base}category/${c.slug}/`}>{c.name}</a>))}
</div>
</div>
</section>

<!-- SITE-2 (copy-truth leg, 2026-10-09): the guides label used to read "In-depth
     guides". Six of the ten posts on page 1 of /articles/ are 2–3 minute reads,
     so "In-depth" overstated what the number counts. Reworded to the plain
     "Guides" rather than deriving an "in-depth" subset: the only length field
     the posts carry is hand-authored readMins, and it does not agree with their
     own word counts (a 7-minute post of 316 words, an 11-minute post of 355
     words, a 2-minute post of 482 words), so any threshold would be invented
     rather than derived. The count is unchanged and still computed from the
     collection. -->
<!-- ══════ 3. stats strip ══════ -->
<div class="stat-strip">
<div class="si"><div class="si-n">{posts.length}</div><div class="si-l">Guides</div></div>
<div class="si"><div class="si-n">{APPS.length}</div><div class="si-l">Finance apps reviewed</div></div>
<div class="si"><div class="si-n">{importedTools.length}</div><div class="si-l">Money calculators</div></div>
<div class="si"><div class="si-n">₦ 0</div><div class="si-l">Free to read</div></div>
</div>

<!-- ══════ 4. featured article ══════ -->
<div class="con sg">
<div class="shd"><h2 class="stitle">Featured Article</h2></div>
<div class="feat">
<div class={`feat-img ${fcat.art}`}><span class="feat-emoji">{fcat.emoji}</span></div>
<div class="feat-body">
<a class={`badge ${fcat.badge}`} href={`${base}category/${featured.data.category}/`}>{fcat.name}</a>
<div class="feat-t"><a href={furl}>{featured.data.title}</a></div>
<div class="feat-ex">{trim32(featured.data.description)}</div>
<div class="feat-meta">
<span>{fmtMonthYear(featured.data.pubDate)}</span><span class="feat-dot"></span>
<span>{featured.data.readMins} min read</span><span class="feat-dot"></span>
<span>{featured.data.author}</span>
<a class="btn b-gold b-sm" style="margin-left:auto" href={furl}>Read →</a>
</div>
</div>
</div>
</div>

<!-- ══════ 5. latest articles grid ══════ -->
<div class="con sg" id="latest">
<div class="shd">
<h2 class="stitle">Latest Articles</h2>
<a class="slink" href={`${base}articles/`}>View all →</a>
</div>
<!-- ══════ 6. category filter pills ══════ -->
<div class="cp-strip" data-gwill-filter style="margin-bottom:20px" role="group" aria-label="Filter articles by category">
<button type="button" class="cp on" data-gwill-cat="" aria-pressed="true">All</button>
{CATEGORIES.map((c) => (<button type="button" class="cp" data-gwill-cat={c.slug} aria-pressed="false">{c.name}</button>))}
</div>
<div id="gwill-posts-grid">
<div class="g3">
{grid.map((p) => (
<ArticleCard slug={p.slug} title={p.data.title} excerpt={p.data.description} category={p.data.category} date={fmtMonthYear(p.data.pubDate)} readMins={p.data.readMins} author={p.data.author} image={p.data.image} imageAlt={p.data.imageAlt} imageSrcset={p.data.imageSrcset} />
))}
</div>
</div>
<!-- ══════ 7. ad slots ══════ -->
<div class="ad-bg" style="margin-top:28px"></div>
</div>

<!-- ══════ 8. newsletter band ══════ -->
<div class="con sg" id="newsletter">
<div class="nl-s">
<div class="nl-copy">
<h2 class="nl-h">Nigerian money news, weekly.</h2>
<p>Rate changes, app reviews, and the financial moves worth making. Free, no spam, unsubscribe anytime.</p>
<div class="nl-meta"><span>✓ Free</span><span class="dot"></span><span>✓ No spam</span><span class="dot"></span><span>✓ Unsubscribe anytime</span></div>
</div>
<div class="gwill-newsletter">
<p class="gwill-newsletter__prompt">
Get new posts in your inbox.	</p>
<form class="gwill-form gwill-form--newsletter" method="post" data-success-url={`${base}newsletter-thanks/`} novalidate>
<div class="gwill-honey" aria-hidden="true">
<label for="gwill_hp_gwill-newsletter-1">Leave this blank</label>
<input type="text" name="gwill_hp" id="gwill_hp_gwill-newsletter-1" tabindex="-1" autocomplete="off">
</div>
<input type="hidden" name="action" value="gwill_contact_form">
<input type="hidden" name="gwill_form_id" value="newsletter">
<div class="gwill-form--newsletter__fields">
<div class="gwill-form__field">
<label for="email_gwill-newsletter-1" class="screen-reader-text">
Email				</label>
<input type="email" id="email_gwill-newsletter-1" name="gwill_email" placeholder="Your email" required autocomplete="email">
</div>
<button type="submit" class="gwill-form__submit">
<span class="gwill-form__submit-text">Subscribe</span>
<span class="gwill-form__submit-loading" aria-hidden="true">Subscribing…</span>
</button>
</div>
<div class="gwill-form__status" role="alert" aria-live="polite"></div>
</form>
</div>
</div>
</div>

<script is:inline>
(function(){
"use strict";
try{
// ── 1. pill-strip chrome — port of main.js §13/14/15, behaviour 1:1 ───────
var supportsScrollOptions=(function(){
try{
var p=document.createElement("div");
p.style.cssText="width:50px;overflow:auto;position:absolute;top:-9999px";
p.innerHTML="<div style='width:100px;height:1px'></div>";
document.body.appendChild(p);
if(typeof p.scrollBy!=="function"){document.body.removeChild(p);return false;}
p.scrollBy({left:7});
var ok=p.scrollLeft>0;
document.body.removeChild(p);
return ok;
}catch(e){return false;}
})();
var scrollStrip=function(el,delta,smooth){
if(supportsScrollOptions){el.scrollBy({left:delta,behavior:smooth?"smooth":"auto"});}
else{el.scrollLeft+=delta;}
};
window.gwillRevealStripActive=function(strip){
var wrap=strip.parentElement;
if(!wrap||!wrap.classList.contains("has-overflow"))return;
var on=strip.querySelector(".cp.on");
if(!on)return;
var or=on.getBoundingClientRect(),wr=wrap.getBoundingClientRect(),delta=0;
if(or.right>wr.right-40){delta=or.right-(wr.right-40);}
else if(or.left<wr.left+40){delta=or.left-(wr.left+40);}
if(delta)scrollStrip(strip,delta,false);
};
Array.prototype.forEach.call(document.querySelectorAll(".cp-strip"),function(strip){
if(strip.getAttribute("data-gwill-scroll"))return;
strip.setAttribute("data-gwill-scroll","1");
var wrap=document.createElement("div");
wrap.className="cp-strip-wrap";
if(strip.style.flex)wrap.style.flex=strip.style.flex;
strip.parentNode.insertBefore(wrap,strip);
wrap.appendChild(strip);
var prev=document.createElement("button");
prev.type="button";
prev.className="cp-scroll-btn cp-scroll-prev";
prev.setAttribute("aria-label","Scroll categories left");
prev.innerHTML="‹";
var next=document.createElement("button");
next.type="button";
next.className="cp-scroll-btn cp-scroll-next";
next.setAttribute("aria-label","Scroll categories right");
next.innerHTML="›";
wrap.appendChild(prev);
wrap.appendChild(next);
var update=function(){
var overflow=strip.scrollWidth>strip.clientWidth+2;
wrap.classList.toggle("has-overflow",overflow);
if(!overflow){wrap.classList.remove("can-prev","can-next");prev.disabled=true;next.disabled=true;return;}
wrap.classList.toggle("can-prev",strip.scrollLeft>2);
wrap.classList.toggle("can-next",strip.scrollLeft<strip.scrollWidth-strip.clientWidth-2);
prev.disabled=!wrap.classList.contains("can-prev");
next.disabled=!wrap.classList.contains("can-next");
};
prev.addEventListener("click",function(){scrollStrip(strip,-Math.round(strip.clientWidth*0.7),true);});
next.addEventListener("click",function(){scrollStrip(strip,Math.round(strip.clientWidth*0.7),true);});
strip.addEventListener("scroll",update,{passive:true});
window.addEventListener("resize",function(){update();window.gwillRevealStripActive(strip);});
window.addEventListener("load",function(){update();window.gwillRevealStripActive(strip);});
setTimeout(function(){update();window.gwillRevealStripActive(strip);},300);
update();
window.gwillRevealStripActive(strip);
// ── 2. arrow-key navigation — main.js §15 ────────────────────────────────
strip.addEventListener("keydown",function(e){
if(e.key!=="ArrowLeft"&&e.key!=="ArrowRight")return;
var pills=Array.prototype.filter.call(strip.querySelectorAll(".cp"),function(p){return !p.disabled;});
if(!pills.length)return;
var i=pills.indexOf(document.activeElement);
if(i===-1)return;
e.preventDefault();
var nx=pills[(e.key==="ArrowRight"?i+1:i-1+pills.length)%pills.length];
if(nx)nx.focus();
});
});

// ── 3. category filter ────────────────────────────────────────────────────
// WP swaps the grid through admin-ajax (action=gwill_filter_posts). A static
// build has no endpoint, so the identical visible result is produced locally:
// same active-pill state, same empty state and copy, no network call, no
// spinner. Same rules as category-filter.js — clicking the active pill does
// nothing, and the result replaces the grid body.
var fstrip=document.querySelector("[data-gwill-filter]");
if(fstrip){
var fgrid=document.getElementById("gwill-posts-grid");
var original=fgrid?fgrid.innerHTML:"";
var EMPTY='<p class="gwill-filter-empty">No articles here yet, check back soon.</p>';
var fpills=Array.prototype.slice.call(fstrip.querySelectorAll("[data-gwill-cat]"));
fpills.forEach(function(b){
b.addEventListener("click",function(){
if(b.classList.contains("on"))return;
fpills.forEach(function(x){
x.classList.toggle("on",x===b);
x.setAttribute("aria-pressed",x===b?"true":"false");
});
var cat=b.getAttribute("data-gwill-cat")||"";
if(!fgrid)return;
if(!cat){fgrid.innerHTML=original;}
else{
var hits=Array.prototype.filter.call(fgrid.querySelectorAll(".ac"),function(c){
return c.getAttribute("data-cat")===cat;
});
if(!hits.length){fgrid.innerHTML=EMPTY;}
else{
if(!fgrid.querySelector(".ac"))fgrid.innerHTML=original;
Array.prototype.forEach.call(fgrid.querySelectorAll(".ac"),function(c){
c.style.display=(c.getAttribute("data-cat")===cat)?"":"none";
});
}
}
window.gwillRevealStripActive(fstrip);
});
});
}

// ── 4. card image fade-in — category-filter.js adds .gwill-img-in ─────────
Array.prototype.forEach.call(document.querySelectorAll("#gwill-posts-grid img"),function(img){
var done=function(){img.classList.add("gwill-img-in");};
if(img.complete)done();else{img.addEventListener("load",done);img.addEventListener("error",done);}
});

// ── 5. newsletter — shared gwill-forms.js path ─────────────────────────────
// KING FINGERPRINT FIX 2026-10-04: the old inline stub ("This form isn't
// connected yet…") contradicted the live list — /newsletter/ subscribes for
// real through gwill-forms.js, and this form carries the same gwill-form class
// + data-success-url, so the stub only blocked real subscriptions. Deleted the
// hijack; the shared path owns the submit now (same "Subscribing…" →
// /newsletter-thanks/ contract as /newsletter/).
}catch(e){}
})();

// ── 6. M3 (DESIGN-LANGUAGE): hub cards once-in-view translateY(6px)+fade ──
// 0.55s, fires once. .m3-armed is added HERE (by JS) — no-JS never arms and
// cards stay fully visible. Armed only when IntersectionObserver exists; a 2s
// safety reveals only cards STRANDED IN VIEWPORT (below-fold keeps its scroll
// reveal). Article prose never animates (fidelity-protected).
try{
(function(){
var mgrid=document.getElementById("gwill-posts-grid");
if(!mgrid||typeof IntersectionObserver==="undefined")return;
var mcards=mgrid.querySelectorAll(".ac");
if(!mcards.length)return;
document.documentElement.classList.add("m3-armed");
var mreveal=function(c){c.classList.add("m3-in");};
var mio=new IntersectionObserver(function(entries){
for(var i=0;i<entries.length;i++){
if(entries[i].isIntersecting){mreveal(entries[i].target);mio.unobserve(entries[i].target);}
}
},{rootMargin:"0px 0px -40px 0px",threshold:0.05});
Array.prototype.forEach.call(mcards,function(c){mio.observe(c);});
setTimeout(function(){
Array.prototype.forEach.call(mcards,function(c){
var r=c.getBoundingClientRect();
if(r.top<window.innerHeight&&r.bottom>0)mreveal(c);
});
},2000);
})();
}catch(e){}
</script>
</Layout>
