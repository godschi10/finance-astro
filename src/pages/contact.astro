---
// Port of template-contact.php (Template Name: Contact), imported from the
// live https://finance.fitnesslova.qzz.io/contact/ capture 2026-09-30.
// Anatomy mirrored: .phd (breadcrumb + h1 + the template's default hero sub)
// → .con (banner ad, .cl-layout: left .page-surface with the routed form
// partial (contact-routed.php, fields/options/hint verbatim), right sidebar
// .sw "Contact Details" (✉ hi@gwillchijioke.com / ⏱ Response within 48 hours
// / 📍 Nigeria — the live rendered values), .sw "Work With Me" (pitch + the
// four green ✓ offers + red ✗ "Paid \"positive review\" deals", inline styles
// verbatim from the template), .sw "Newsletter" + form partial keyed
// gwill-newsletter-2 like the live page → leaderboard ad).
// The form is REAL in this port: the WP admin-ajax leg is replaced by the
// comments-api Worker /forms endpoint (gwill-forms.js), so submissions are
// validated, honeypotted, rate-limited, and stored in D1 (the /api/forms/list
// desk; email forwarding activates as soon as RESEND_API_KEY/EMAIL_TO secrets
// are set on the Worker).
import Layout from "../layouts/Layout.astro";
import ContactRoutedForm from "../components/ContactRoutedForm.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const offers = ["Sponsored Articles", "App Review Features", "Newsletter Sponsorships", "Affiliate Arrangements"];
const offerStyle = "display:flex;gap:8px;align-items:center;padding:10px 12px;background:var(--green-muted);border:1px solid var(--green-border);border-radius:var(--r-sm);font-size:12px;font-weight:700;color:var(--green)";
const noStyle = "display:flex;gap:8px;align-items:center;padding:10px 12px;background:var(--red-muted);border:1px solid var(--red-border);border-radius:var(--r-sm);font-size:12px;font-weight:700;color:var(--red)";
---
<Layout title="Contact - GWill Finance" description="Contact GWill Finance: partnerships, sponsored content, app review requests, or reader questions. Response within 48 hours." crumb="Contact">
<div class="phd">
  <nav class="gwill-breadcrumbs" aria-label="Breadcrumb">
    <ol class="gwill-breadcrumbs__list">
      <li class="gwill-breadcrumbs__item"><a href={base}><span>Home</span></a></li>
      <li class="gwill-breadcrumbs__item gwill-breadcrumbs__item--current"><span aria-current="page">Contact</span></li>
    </ol>
  </nav>
  <h1>Contact</h1>
  <p>Partnerships, sponsored content, app review requests, or reader questions. I respond within 48 hours.</p>
</div>
<div class="con" style="margin-top:36px;padding-bottom:48px">
  <div class="ad-bg"></div>
  <div class="cl-layout">
    <div class="page-surface">
      <ContactRoutedForm uid="gwill-routed-1" />
    </div>
    <div>
      <div class="sw">
        <div class="sw-t">Contact Details</div>
        <div style="display:flex;flex-direction:column">
          <div class="contact-sidebar-item"><div class="ci">✉</div>hi@gwillchijioke.com</div>
          <div class="contact-sidebar-item"><div class="ci">⏱</div>Response within 48 hours</div>
          <div class="contact-sidebar-item"><div class="ci">📍</div>Nigeria</div>
        </div>
      </div>
      <div class="sw">
        <div class="sw-t">Work With Me</div>
        <p class="fz12 fw3 cm-c lh mb12">I'm open to sponsored content and brand partnerships for fintech companies whose products I can honestly recommend.</p>
        <div style="display:flex;flex-direction:column;gap:8px">
          {offers.map((o) => (<div style={offerStyle}><span>✓</span>{o}</div>))}
          <div style={noStyle}><span>✗</span>Paid "positive review" deals</div>
        </div>
      </div>
      <div class="sw">
        <div class="sw-t">Newsletter</div>
        <p class="fz11 fw3 cd lh mb12">Weekly finance digest. Free.</p>
        <NewsletterForm id="gwill-newsletter-2" />
      </div>
    </div>
  </div>
  <div class="ad-bg" style="margin-top:28px"></div>
</div>
</Layout>
