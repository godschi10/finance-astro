---
import Layout from "../layouts/Layout.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<Layout title="Newsletter Thanks - GWill Finance" description="Newsletter confirmation page. The list opens at launch." crumb="Subscribed" noCanonical={true}>
<section class="con sg" aria-labelledby="thanks-h">
  <div class="hold">
    <span class="phase-tag">You are early</span>
    <h1 class="hold-title" id="thanks-h">No subscription yet — and that is honest.</h1>
    <p style="margin-top:8px">You reached the confirmation page before the list opens. Nothing was collected, nothing was sent. When delivery goes live, this is the page that will confirm your subscription.</p>
    <p style="margin-top:12px"><a class="slink" href={`${base}newsletter/`}>← Back to the newsletter page</a></p>
  </div>
</section>
</Layout>
