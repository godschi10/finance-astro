---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ArchivePagination from "../../components/ArchivePagination.astro";
import { CATEGORIES } from "../../data/site";
import { allArticles, fmtMonthYear } from "../../data/content";
import { paginate } from "../../lib/pagination";

// Faithful port of the theme's all-articles archive (the WP posts page),
// captured from the live origin 2026-09-29
// (finance-truth/archives/wp-all-articles.html + wp-all-articles-p2.html):
//   .phd: breadcrumbs (Home › All Articles, aria-current) + h1 "All Articles"
//     + p "Honest, tested finance guides for Nigerians. No filler. No AI slop."
//   .con style="margin-top:28px;padding-bottom:40px": .flex.aic.jsb.g16.mb20
//     toolbar (flex-wrap:wrap) = .cp-strip (flex:1; "All" .cp.on + the 9
//     categories) + the site search-form (WP's toolbar form submits to /;
//     the port's static search route is /search/), then .g3 of .ac cards,
//     then nav.navigation.pagination + div style="margin-top:28px" ad slot.
// WP paginates at posts_per_page = 10; page N lives at /articles/page/N/.
// Static index route (no dynamic segment) — the collection is loaded directly.
const posts = await allArticles();
const pages = paginate(posts);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const rows = pages[0].map((p) => ({
  slug: p.slug,
  title: p.data.title,
  excerpt: p.data.description,
  date: fmtMonthYear(p.data.pubDate),
  readMins: p.data.readMins,
  author: p.data.author,
  category: p.data.category,
}));
---
<Layout title="All Articles - GWill Finance" description="Every Nigerian money guide: savings, investing, crypto, banking, remittance, and dollar accounts. Tested by Gwill, free to read." crumb="All Articles">
<section class="phd" aria-labelledby="articles-h">
  <nav class="bc" aria-label="Breadcrumb">
    <span class="bc-i"><a href={base}>Home</a></span>
    <span class="bc-s">›</span>
    <span class="bc-i" aria-current="page">All Articles</span>
  </nav>
  <h1 id="articles-h">All Articles</h1>
  <p>Honest, tested finance guides for Nigerians. No filler. No AI slop.</p>
</section>
<section class="con" style="margin-top:28px;padding-bottom:40px">
  <div class="flex aic jsb g16 mb20" style="flex-wrap:wrap">
    <div class="cp-strip" style="flex:1" role="group" aria-label="Filter articles by category">
      <a class="cp on" href={`${base}articles/`} aria-current="page">All</a>
      {CATEGORIES.map((c) => (
        <a class="cp" href={`${base}category/${c.slug}/`}>{c.name}</a>
      ))}
    </div>
    <form role="search" aria-label="Site search" method="get" class="search-form" action={`${base}search/`}>
      <label class="search-label">
        <span class="screen-reader-text">Search for:</span>
        <svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <input type="search" class="search-field" value="" name="q" placeholder="Search articles…">
      </label>
      <button type="submit" class="search-submit" aria-label="Submit search"><span>Search</span></button>
    </form>
  </div>
  <div class="g3">
    {rows.map((p) => (
      <ArticleCard slug={p.slug} title={p.title} excerpt={p.excerpt} category={p.category} date={p.date} readMins={p.readMins} author={p.author} />
    ))}
  </div>
  <ArchivePagination current={1} total={pages.length} archivePath="articles" />
  <div style="margin-top:28px">
    <div class="ad-bg"></div>
  </div>
</section>
</Layout>
