---
/**
 * Article (single post) — port of gwill-finance-theme single.php (1.13.39).
 *
 * Class vocabulary, element order, conditionals and copy strings are the
 * theme's; the source of truth for every line is documented in
 * /home/opc/work/article-port/01-article-markup.md (file:line citations there).
 *
 * WordPress-only internals and how this port stands in for them:
 *   .art-cover        — emitted only when has_post_thumbnail() (single.php:106).
 *                       Every port article now carries a featured image, so the
 *                       cover renders: WP's get_the_post_thumbnail('gwill-hero')
 *                       markup — 1200×675, eager + fetchpriority=high, srcset
 *                       1200/1024/768/300 against local uploads.
 *                       exactly as WordPress omits it.
 *   ad slots          — gwill_finance_ad_slot() emits nothing when ads are off
 *                       or no code is configured (single.php cond. 12-13). The
 *                       live WordPress article serves nothing at all four left
 *                       -column/comment slots, so nothing is emitted here.
 *   .comments-area    — gated on comments_open() || get_comments_number()
 *                       (single.php:211). This is a static build with no comment
 *                       backend, and emitting a form that cannot post would be a
 *                       fake control, so the block is absent by design and
 *                       recorded in PENDING-WORK.md.
 *   avatars           — get_avatar() output baked as the author's Gravatar URL,
 *                       same hash/d=wavatar/r=g query and same srcset 2x as the
 *                       live page serves.
 *   TOC anchor ids    — WordPress injects them server-side at the_content
 *                       priority 9 (inc/table-of-contents.php:36-79). Here
 *                       rehype-slug does it at build time, so the ids are in the
 *                       served HTML and the TOC hrefs match by construction.
 *   .art-sub          — NOT a WordPress element. King asked for a post subtitle
 *                       after the title; WordPress has no equivalent, so it is
 *                       designed in the theme's own idiom (see docs/port/08).
 */
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import AuthorSocials from "../../components/AuthorSocials.astro";
import VibeComments from "../../components/VibeComments.astro";
// The article-page slice of the theme stylesheet, imported HERE rather than in
// the layout so its ~70 KB lands only on article pages instead of being inlined
// into all 53.
import "../../styles/article.css";
import "../../styles/embeds.css";
// Comments: the plugin's sheet FIRST, the theme's override SECOND — the order
// inc/enqueue.php:491-505 guarantees (the override declares 'vibe-comments' as
// a dependency so WP prints it last). Imported here rather than in the layout
// because WP enqueues both only on singulars (is_singular() && !is_front_page()).
import "../../styles/vibe-comments.base.css";
import "../../styles/vibe-comments.gold.css";
import { catBySlug } from "../../data/site";
import {
  allArticles,
  authorBySlug,
  fmtLongMonthYear,
  fmtMonthYear,
  relatedTo,
} from "../../data/content";

export async function getStaticPaths() {
  const posts = await allArticles();
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
const all = await allArticles();
const entry = all.find((p) => p.slug === slug)!;
const { Content, headings } = await entry.render();
const d = entry.data;
const cat = catBySlug(d.category);
const author = authorBySlug(d.authorSlug);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const url = `${base}articles/${entry.slug}/`;
const origin = (Astro.site?.toString() ?? "https://godschi10.github.io").replace(/\/$/, "");
const pageUrl = `${origin}${url}`;
const catUrl = `${base}category/${cat.slug}/`;
const authorUrl = `${base}author/${d.authorSlug}/`;

// ── Comments (single.php:212-226) ───────────────────────────────────────────
// The Worker that replaced WordPress admin-ajax for the comments surface.
const COMMENTS_API = "https://comments-api.gwill.workers.dev";

// The heading count, baked at build time — parity with WP, which bakes the
// stored comment count in before rendering (comments.php:42-52). Non-fatal by
// design: an unreachable or slow Worker degrades to 0, which renders the
// heading empty exactly as WP does for a post with no comments, and the client
// patches it to the live total the moment Load Comments is clicked.
let commentCount = 0;
try {
  const cr = await fetch(`${COMMENTS_API}/count?post=${encodeURIComponent(entry.slug)}`, {
    signal: AbortSignal.timeout(4000),
  });
  const cj = await cr.json();
  commentCount = Number(cj?.data?.count ?? cj?.count ?? 0) || 0;
} catch {
  commentCount = 0;
}

// single.php:40 — the TOC is built from h2 + h3 in document order, and the SAME
// list gates both the mobile dropdown and the sidebar widget: they are never
// independently present (single.php cond. 1).
//
// inc/table-of-contents.php:99 builds that list from the RENDERED content with
// DOMXPath '//h2 | //h3' — every heading counts, however it was authored. Astro's
// markdown `headings` only sees markdown-parsed headings, so a post whose body is
// a byte-captured WordPress document (raw HTML blocks — the Gutenberg showcase)
// yields an EMPTY TOC while WordPress renders a full one. Fall back to the
// theme's own pass over the raw body when the markdown list is empty.
const rawHtmlToc = (body: string) => {
  const out: { depth: number; slug: string; text: string }[] = [];
  // inc/table-of-contents.php:99 reads the RENDERED document via DOMXPath, so
  // its heading text is entity-DECODED (DOM textContent). Our raw-HTML source
  // keeps entities encoded, so decode them here; Astro then escapes exactly
  // once, the same bytes live WP serves. Double-escaping printed "&amp;" on
  // the phone TOC (King's verdict, 2026-09-25).
  const decode = (s: string) =>
    s
      .replace(/&lt;/g, "<")
      .replace(/&gt;/g, ">")
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, "'")
      .replace(/&#x27;/g, "'")
      .replace(/&#x3D;/g, "=")
      .replace(/&amp;/g, "&");
  const re = /<h([23])[^>]*\bid="([^"]+)"[^>]*>([\s\S]*?)<\/h\1>/gi;
  let m: RegExpExecArray | null;
  while ((m = re.exec(body)) !== null) {
    out.push({
      depth: Number(m[1]),
      slug: m[2],
      text: decode(m[3].replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim()),
    });
  }
  return out;
};
const mdToc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const toc = mdToc.length ? mdToc : rawHtmlToc(entry.body ?? "");

// single.php:151-153 — rawurlencode() (RFC 3986: %20 for spaces, not '+'), and
// WhatsApp is built from title + one literal space + permalink before encoding.
// King's order 2026-09-26: share buttons carry inline SVG glyphs (14px,
// currentColor) from the same family as the footer's social icons, and the
// row centers (article.css §3.x below). X/LinkedIn paths = the footer's own
// brand paths; WhatsApp = simple-icons (CC0); link = in-house chain glyph.
const SHARE_ICON = {
  x: '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>',
  linkedin: '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452z"></path></svg>',
  whatsapp: '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>',
  link: '<svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6.05 3.05a2.5 2.5 0 0 1 3.536 0l1.414 1.414a2.5 2.5 0 0 1 0 3.536l-.353.353a.5.5 0 0 1-.708 0L6.05 4.464a.5.5 0 0 1 0-.707l.353-.353Z"/><path d="M4.282 8a2.5 2.5 0 0 0 0 3.536l2.829 2.828a2.5 2.5 0 0 0 3.535 0l.354-.353a.5.5 0 0 0 0-.708l-1.06-1.06a.5.5 0 0 0-.708 0l-.353.353a1 1 0 0 1-1.415 0l-2.12-2.12a1 1 0 0 1 0-1.415l.352-.353a.5.5 0 0 0 0-.707L4.636 7.293a.5.5 0 0 0-.707 0l-.353.354Z"/></svg>',
};

const raw = encodeURIComponent;
const xUrl = `https://twitter.com/intent/tweet?text=${raw(d.title)}&url=${raw(pageUrl)}`;
const liUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${raw(pageUrl)}`;
const waUrl = `https://api.whatsapp.com/send?text=${raw(`${d.title} ${pageUrl}`)}`;

// single.php:98 — the "Updated" fragment is shown only when the modified DATE
// differs at day precision, so a post edited the day it was published shows none.
const isoDay = (x: Date) => x.toISOString().slice(0, 10);
const showUpdated = !!d.updated && isoDay(d.updated) !== isoDay(d.pubDate);

// single.php:180-202 — same-category posts first (WP: category__in, count 3,
// date DESC), with the theme's fallback to the most recent posts. Rendered in
// the theme's .g2 grid using the theme's own card part.
const related = relatedTo(all, entry, 3);

// single.php:161 — the author's description, falling back to the theme's own
// sentence when none is set. This port has an authored description, so the
// theme's logic prints it; the fallback is kept for completeness.
const FALLBACK_BIO =
  "Web developer and finance writer. I build this site and write everything on it. I test every app before recommending it. Based in Nigeria.";
const bio = author.bio?.trim() ? author.bio : FALLBACK_BIO;

// get_avatar(), single.php:92 (20px, class art-avatar) and :158 (48px, lazy).
const GRAVATAR =
  "https://secure.gravatar.com/avatar/7d222093d563709bc3e8455fbf3164e5588becb2cb0c969dd8f5a9bd62754a86";

// The newsletter blocks are gated on the same two options in WordPress
// (single.php cond. 11), both of which default to on.
const newsletter = true;

// Extracted in the frontmatter on purpose: an inline /{6,}/ quantifier inside a
// markup expression breaks the Astro compiler's brace matching (it closed the
// expression at the quantifier's brace and emitted invalid JS).
const ytId = d.videoUrl ? (d.videoUrl.match(/(?:v=|youtu\.be\/)([\w-]{6,})/)?.[1] ?? "") : "";

const ld = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.description,
  author: { "@type": "Person", name: d.author },
  datePublished: isoDay(d.pubDate),
  ...(d.updated ? { dateModified: isoDay(d.updated) } : {}),
  mainEntityOfPage: pageUrl,
};
---

<Layout title={`${d.title} - GWill Finance`} description={d.description} crumb={d.title}>
<script type="application/ld+json" set:html={ld(articleLd)}></script>

<!-- single.php:43 — reading progress -->
<div class="prog"><div class="prog-f"></div></div>

<div class="con" style="padding-bottom:48px">
  <div class="sb-layout">
    <div>
      <!-- Article header lives INSIDE the left column (v1.0.130) so the sidebar
           TOC starts at the top beside the title (single.php:49-53). -->
      <div class="art-hd">
        <!-- 3. breadcrumb (single.php:57-81) -->
        <div class="bc">
          <a href={base}>Home</a>
          <span class="bc-s">›</span>
          <a href={catUrl}>{cat.name}</a>
          <span class="bc-s">›</span>
          <span>{d.title}</span>
        </div>

        <a class={`badge ${cat.badge}`} style="margin-bottom:14px;display:inline-flex" href={catUrl}>{cat.name}</a>

        <!-- 4. article header (single.php:88-101) -->
        <h1 class="art-t">{d.title}</h1>

        <!-- NOT in WordPress: the post subtitle King asked for, designed in the
             theme's idiom (docs/port/08-article-subtitle.md). Falls back to the
             excerpt so every post reads complete. -->
        <p class="art-sub">{d.subtitle ?? d.description}</p>

        <div class="art-meta">
          <span class="art-author">
            <img
              class="avatar avatar-20 photo art-avatar"
              src={`${GRAVATAR}?s=20&d=wavatar&r=g`}
              srcset={`${GRAVATAR}?s=40&d=wavatar&r=g 2x`}
              alt={d.author}
              height="20"
              width="20"
              decoding="async"
            />
            <a class="art-author-link" href={authorUrl}>{d.author}</a>
          </span>
          <span class="art-dot"></span>
          <span>{fmtLongMonthYear(d.pubDate)}</span><span class="art-dot"></span>
          <span>{d.readMins} min read</span>
          {showUpdated ? (<span class="art-dot"></span>) : null}
          {showUpdated ? (<span>Updated {fmtMonthYear(d.updated!)}</span>) : null}
        </div>
      </div>

      <div class="art-reading-surface">
        {/* single.php:106-120 — the cover renders only when has_post_thumbnail();
            get_the_post_thumbnail(null, 'gwill-hero') markup: 1200×675, eager,
            fetchpriority=high, full srcset, alt from gwill_featured_image_alt(). */}
        {d.image && (
          <div class="art-cover">
            <img
              width="1200"
              height="675"
              src={d.image}
              class="attachment-gwill-hero size-gwill-hero wp-post-image"
              alt={d.imageAlt ?? ""}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              srcset={d.imageSrcset}
              sizes="(max-width: 1200px) 100vw, 1200px"
            />
          </div>
        )}
        <div class="art-surface-pad">
          <!-- Mobile TOC dropdown (single.php:125-136) — shown by CSS on phones only -->
          {toc.length > 0 && (
            <div class="toc-dropdown toc-mobile" id="gwill-toc-mobile">
              <button type="button" class="toc-summary" aria-expanded="true" aria-controls="gwill-toc-mobile-list">
                <span>In this article</span>
                <span class="toc-caret" aria-hidden="true">▾</span>
              </button>
              <div class="toc-list" id="gwill-toc-mobile-list">
                {toc.map((h) => (
                  <a href={`#${h.slug}`} class={h.depth === 3 ? "toc-sub" : undefined}>{h.text}</a>
                ))}
              </div>
            </div>
          )}

          <!-- Affiliate disclosure (single.php:139-142) -->
          <div class="discl mb24">
            <span class="discl-i">⚠</span>
            <p class="discl-t"><strong>Affiliate disclosure.</strong> Some links in this article earn me a commission if you sign up through them, at no extra cost to you. I only recommend apps I have personally tested. This never changes my ratings.</p>
          </div>

          <div class="art-body">
            {ytId && (
              <div class="video-facade" data-video={ytId}>
                <span class="video-emoji" aria-hidden="true">▶</span>
                <p><strong>Video walkthrough</strong><br><span>Watch on YouTube — loads only when you press play.</span></p>
                <button type="button" class="btn b-gold b-sm" data-play>Play video</button>
              </div>
            )}
            <Content />
          </div>

          <!-- Share row (single.php:149-155): three links plus the copy button -->
          <div class="share-row">
            <span class="share-l">Share</span>
            <a class="share-b" target="_blank" rel="noopener noreferrer" href={xUrl} aria-label="Share on X (Twitter)"><Fragment set:html={SHARE_ICON.x} />X (Twitter)</a>
            <a class="share-b" target="_blank" rel="noopener noreferrer" href={liUrl} aria-label="Share on LinkedIn"><Fragment set:html={SHARE_ICON.linkedin} />LinkedIn</a>
            <a class="share-b" target="_blank" rel="noopener noreferrer" href={waUrl} aria-label="Share on WhatsApp"><Fragment set:html={SHARE_ICON.whatsapp} />WhatsApp</a>
            <button class="share-b" type="button" data-copy={pageUrl} aria-label="Copy link"><Fragment set:html={SHARE_ICON.link} />Copy Link</button>
          </div>

          <!-- Author box (single.php:157-175) -->
          <div class="abio mt20">
            <div class="aav">
              <img
                class="avatar avatar-48 photo"
                src={`${GRAVATAR}?s=48&d=wavatar&r=g`}
                srcset={`${GRAVATAR}?s=96&d=wavatar&r=g 2x`}
                alt={d.author}
                height="48"
                width="48"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div>
              <div class="an-name">{d.author}</div>
              <div class="abio-t">{bio}</div>
              <AuthorSocials socials={author.socials ?? {}} />
            </div>
          </div>
        </div>
      </div>

      <!-- 5. related posts (single.php:183-204) -->
      {related.length > 0 && (
        <div class="mt40">
          <div class="shd" style="margin-bottom:16px"><h2 class="stitle">Related Articles</h2></div>
          <div class="g2">
            {related.map((p) => (
              <ArticleCard
                slug={p.slug}
                title={p.data.title}
                excerpt={p.data.description}
                category={p.data.category}
                date={fmtMonthYear(p.data.pubDate)}
                readMins={p.data.readMins}
                author={p.data.author}
                image={p.data.image}
                imageAlt={p.data.imageAlt}
                imageSrcset={p.data.imageSrcset}
              />
            ))}
          </div>
        </div>
      )}

      <!-- 6. comments (single.php:212-226): .comments-area.mt48 wrapping
           comments_template() and the #gwill-comment-ads slots — the position
           WP renders it, between the related posts and the mobile newsletter. -->
      <VibeComments count={commentCount} postSlug={entry.slug} apiBase={COMMENTS_API} />

      <!-- Mobile newsletter block (single.php:228-236); CSS shows it on phones -->
      {newsletter && (
        <div class="m-nl-wrap">
          <div class="m-nl">
            <h3>Weekly digest.</h3>
            <p>Rate changes, app reviews, money moves. Free.</p>
            <NewsletterForm id="gwill-newsletter-1" />
          </div>
        </div>
      )}
    </div>

    <!-- 7-8. in-article sidebar: TOC, square ad box, digest (single.php:243-286) -->
    <aside class="article-sidebar" style="position:sticky;top:72px;align-self:start">
      {toc.length > 0 && (
        <div class="sw">
          <div class="sw-t">In This Article</div>
          <div class="toc-scroll">
            {toc.map((h, i) => (
              <div class={`toc-i${i === 0 ? " cur" : ""}`}>
                <a href={`#${h.slug}`}>
                  {h.depth === 3 ? (<span class="toc-g"></span>) : (<span class="toc-bar"></span>)}
                  {h.text}
                </a>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Unconditional wrapper (single.php:274). WordPress serves this as an
           empty box on the live article because no square ad code is
           configured; the wrapper's inline style is the theme's. -->
      <div class="sw" style="padding:0;overflow:hidden;border:1px solid var(--border)"></div>

      {newsletter && (
        <div class="sw">
          <div class="sw-t">Weekly digest.</div>
          <p class="fz11 fw3 cd lh mb12">Rate changes, app reviews, money moves. Free.</p>
          <NewsletterForm id="gwill-newsletter-2" />
        </div>
      )}
    </aside>
  </div>
</div>

<script is:inline>
/* <![CDATA[ */
var GwillLightbox = {"i18n":{"lightbox":"Image lightbox","enlarge":"Enlarge image","close":"Close","prev":"Previous image","next":"Next image"}};
/* ]]> */
</script>
<script>
  import "../../scripts/article.js";
  import "../../scripts/lightbox.js";
</script>
</Layout>
