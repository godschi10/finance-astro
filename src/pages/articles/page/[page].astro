---
import Layout from "../../../layouts/Layout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import ArchivePagination from "../../../components/ArchivePagination.astro";
import { CATEGORIES } from "../../../data/site";
import { allArticles, fmtMonthYear } from "../../../data/content";
import { paginate } from "../../../lib/pagination";

// /articles/page/N/ — WP's paginated posts page (posts_per_page = 10).
// Page 1 is /articles/ (index.astro); this route emits pages 2..N and only
// exists when the corpus actually exceeds one page. Markup mirrors
// wp-all-articles-p2.html: same .phd header, same toolbar, page-N card slice,
// pagination with the current number as <span class="page-numbers current">.
export async function getStaticPaths() {
  const posts = await allArticles();
  const pages = paginate(posts);
  if (pages.length < 2) return [];
  return pages.slice(1).map((slice, i) => ({
    params: { page: String(i + 2) },
    props: {
      current: i + 2,
      total: pages.length,
      rows: slice.map((p) => ({
        slug: p.slug,
        title: p.data.title,
        excerpt: p.data.description,
        date: fmtMonthYear(p.data.pubDate),
        readMins: p.data.readMins,
        author: p.data.author,
        category: p.data.category,
      })),
    },
  }));
}

const { current, total, rows } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<Layout title={`All Articles - Page ${current} - GWill Finance`} description="Every Nigerian money guide: savings, investing, crypto, banking, remittance, and dollar accounts. Tested by Gwill, free to read." crumb="All Articles">
<section class="phd" aria-labelledby="articles-h">
  <nav class="bc" aria-label="Breadcrumb">
    <span class="bc-i"><a href={base}>Home</a></span>
    <span class="bc-s">›</span>
    <span class="bc-i"><a href={`${base}articles/`}>All Articles</a></span>
    <span class="bc-s">›</span>
    <span class="bc-i" aria-current="page">Page {current}</span>
  </nav>
  <h1 id="articles-h">All Articles</h1>
  <p>Honest, tested finance guides for Nigerians. No filler. No AI slop.</p>
</section>
<section class="con" style="margin-top:28px;padding-bottom:40px">
  <div class="flex aic jsb g16 mb20" style="flex-wrap:wrap">
    <div class="cp-strip" style="flex:1" role="group" aria-label="Filter articles by category">
      <a class="cp on" href={`${base}articles/`}>All</a>
      {CATEGORIES.map((c) => (
        <a class="cp" href={`${base}category/${c.slug}/`}>{c.name}</a>
      ))}
    </div>
    <form role="search" aria-label="Site search" method="get" class="search-form" action={`${base}search/`}>
      <label class="search-label">
        <span class="screen-reader-text">Search for:</span>
        <svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        <input type="search" class="search-field" value="" name="q" placeholder="Search articles…">
      </label>
      <button type="submit" class="search-submit" aria-label="Submit search"><span>Search</span></button>
    </form>
  </div>
  <div class="g3">
    {rows.map((p) => (
      <ArticleCard slug={p.slug} title={p.title} excerpt={p.excerpt} category={p.category} date={p.date} readMins={p.readMins} author={p.author} />
    ))}
  </div>
  <ArchivePagination current={current} total={total} archivePath="articles" />
  <div style="margin-top:28px">
    <div class="ad-bg"></div>
  </div>
</section>
</Layout>
