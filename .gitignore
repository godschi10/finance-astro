node_modules/
dist/
.astro/

# Generated by scripts/vectors-check.mjs (esbuild bundle of vectors-entry.ts)
scripts/.vectors-bundle.cjs

# Generated by `npm run gen:og` (first step of `npm run build`) — Astro still
# copies public/ → dist/, so the cards ship without being tracked
public/images/og/

# Future secrets (none tracked today) — never stage env files
.env
.env.*

# Foreman runtime scratch — regenerated by every foreman invocation, never ours to keep.
# Committed in d582a25 by mistake and removed in b854c11; ignored so it stops reappearing.
.foreman/

# Live working ledger for the team — a running scratchpad of daily work, not project
# documentation. Stays on disk at the repo root where daily work and the Manager's notes
# reference it; untracked so a public repo does not publish the in-progress log.
PENDING-WORK.md

# One-round audit scratch left in the repo root — screenshots, results JSON and the
# throwaway runner from a single round (run id a7-503020). Proof of that round, not
# project assets. Untracked so a public repo does not publish throwaway artefacts;
# left on disk locally so the round can still be re-read.
a7-*.png
a7-results.json
a7-test.mjs
test-budget.mjs
